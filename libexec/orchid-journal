#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"; rt="$(orchid_runtime "$repo")"
sub="${1:-}"; shift || true
case "$sub" in
  add)
    verb_lock_guard "$repo"
    task=""; kind="note"; unfenced=0
    while [ $# -gt 0 ]; do case "$1" in
      --task) task="$2"; shift 2;; --kind) kind="$2"; shift 2;;
      # For out-of-run writers only (currently just orchid-answer); deliberately
      # undocumented — not a general-purpose epoch bypass. Left out of usage/help.
      --unfenced) unfenced=1; shift;;
      *) break;; esac; done
    text="$*"
    if [ "$unfenced" -eq 1 ]; then e="-"; else epoch_require "$repo"; e="$ORCHID_EPOCH"; fi
    # ORCHID_ACTOR is kernel-set (runners/orchid-tick exports it before
    # spawning the orchestrator engine; the launcher's ORCHID_* allowlist
    # forwards it into the child, whose `orchid` verb calls -- including
    # this one -- inherit it), trusted-within-machine like every other
    # ORCHID_* env var. The invariant this line enforces for EVERY caller,
    # present and future: the actor string that lands in the journal always
    # carries the epoch exactly once. Some callers (runners/orchid-tick) set
    # ORCHID_ACTOR already epoch-marked (tick-e<epoch>); others
    # (libexec/orchid-merge's two `ORCHID_ACTOR="${ORCHID_ACTOR:-orchestrator}"`
    # call sites) set a bare name and have always relied on this verb to
    # append " e$e" itself -- the same appending this line did pre-v1m3 for
    # the unset case. Distinguish the two shapes instead of always appending
    # (which would double the epoch onto "...tick-e7") or never appending
    # (which would silently drop the epoch from "orchestrator", breaking
    # orchid-merge's callers and the documented actor+epoch invariant):
    #   - unset                                -> "operator e$e" (unchanged default)
    #   - already epoch-marked (tick-e<n> or a
    #     prior "<name> e<n>")                 -> verbatim
    #   - anything else (a bare caller-supplied
    #     name, e.g. orchid-merge's "orchestrator") -> "$ORCHID_ACTOR e$e"
    if [ -n "${ORCHID_ACTOR:-}" ]; then
      case "$ORCHID_ACTOR" in
        *tick-e[0-9]*|*' e'[0-9]*) actor="$ORCHID_ACTOR" ;;
        *) actor="$ORCHID_ACTOR e$e" ;;
      esac
    else
      actor="operator e$e"
    fi
    entry="## $(date -u +%Y-%m-%dT%H:%M:%SZ) ${task:-run} $kind ($actor)"
    { [ -f "$state/journal.md" ] && cat "$state/journal.md"; echo; echo "$entry"; echo "$text"; } \
      | atomic_write "$state/journal.md"
    if [ -n "$task" ]; then
      mkdir -p "$rt/journal-index"
      { [ -f "$rt/journal-index/$task" ] && tail -n 40 "$rt/journal-index/$task"; echo "$entry"; echo "$text"; } \
        | atomic_write "$rt/journal-index/$task"
    fi ;;
  tail) n=20; [ "${1:-}" = "-n" ] && n="$2"; tail -n $(( n * 4 )) "$state/journal.md" 2>/dev/null || true ;;
  show)
    [ "${1:-}" = "--task" ] || orchid_die "usage: journal show --task <id>"
    cat "$rt/journal-index/$2" 2>/dev/null || grep -A2 " $2 " "$state/journal.md" 2>/dev/null || true ;;
  *) orchid_die "usage: orchid journal add|tail|show" ;;
esac

#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"
orchid_cli_validate journal "$@"
set -- ${ORCHID_CLI_ARGS[@]+"${ORCHID_CLI_ARGS[@]}"}
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"; rt="$state/runtime"
sub="${1:-}"; shift || true

# --task is a flat journal label, never a path. Existing parents and the
# final file must belong to this repository's exact journal-index namespace
# before either a read or a journal-first append. Missing cache stays missing.
_journal_index_target() {
  local label="$1" physical_repo physical_index expected_index parent
  case "$label" in
    ''|.|..|*/*|*$'\n'*|*$'\r'*)
      orchid_cli_usage_error journal "--task requires a flat, single-line label (got '$label')"
      return 2 ;;
  esac
  for parent in "$state" "$rt" "$rt/journal-index"; do
    if [ -L "$parent" ] || { [ -e "$parent" ] && [ ! -d "$parent" ]; }; then
      printf 'orchid: journal index parent must be an owned directory: %s\n' "$parent" >&2
      return 1
    fi
  done
  physical_repo="$(orchid_physical_dir "$repo")" || return 1
  expected_index="$physical_repo/.orchid/runtime/journal-index"
  physical_index="$(_orchid_physical_path "$rt/journal-index")" || return 1
  if [ "$physical_index" != "$expected_index" ]; then
    printf 'orchid: journal index escapes its owned path: %s\n' "$rt/journal-index" >&2
    return 1
  fi
  _journal_index="$rt/journal-index/$label"
  if [ -L "$_journal_index" ] ||
     { [ -e "$_journal_index" ] && [ ! -f "$_journal_index" ]; }; then
    printf 'orchid: journal index must be an owned regular file: %s\n' "$_journal_index" >&2
    return 1
  fi
}

# HELP AHEAD OF THE EPOCH FENCE (dogfood F45). Help is how an operator finds
# out what to do when the run state is ALREADY wrong, so it must not be
# answered by INV-02. First position only, and both spellings -- see the fuller
# note on libexec/orchid-task's gate, which is the authority for this rule.
case "$sub" in
  add)
    task=""; kind="note"; unfenced=0; task_set=0
    while [ $# -gt 0 ]; do case "$1" in
      --task) task="$2"; task_set=1; shift 2;; --kind) kind="$2"; shift 2;;
      --) shift; break;;
      # For out-of-run writers only (currently just orchid-answer); deliberately
      # undocumented — not a general-purpose epoch bypass. Left out of usage/help.
      --unfenced) unfenced=1; shift;;
      *) break;; esac; done
    text="$*"
    if [ "$task_set" -eq 1 ]; then
      index_rc=0; _journal_index_target "$task" || index_rc=$?
      [ "$index_rc" -eq 0 ] || exit "$index_rc"
    fi
    verb_lock_guard "$repo"
    if [ "$unfenced" -eq 1 ]; then e="-"; else epoch_require "$repo"; e="$ORCHID_EPOCH"; fi
    # ORCHID_ACTOR is kernel-set (runners/orchid-tick exports it before
    # spawning the orchestrator engine; the launcher's ORCHID_* allowlist
    # forwards it into the child, whose `orchid` verb calls -- including
    # this one -- inherit it), trusted-within-machine like every other
    # ORCHID_* env var. The invariant this line enforces for EVERY caller,
    # present and future: the actor string that lands in the journal always
    # carries the epoch exactly once. Some callers (runners/orchid-tick) set
    # ORCHID_ACTOR already epoch-marked (tick-e<epoch>); others
    # (libexec/orchid-merge's two `ORCHID_ACTOR="${ORCHID_ACTOR:-orchestrator}"`
    # call sites) set a bare name and have always relied on this verb to
    # append " e$e" itself -- the same appending this line did pre-v1m3 for
    # the unset case. Distinguish the two shapes instead of always appending
    # (which would double the epoch onto "...tick-e7") or never appending
    # (which would silently drop the epoch from "orchestrator", breaking
    # orchid-merge's callers and the documented actor+epoch invariant):
    #   - unset                                -> "operator e$e" (unchanged default)
    #   - already epoch-marked (tick-e<n> or a
    #     prior "<name> e<n>")                 -> verbatim
    #   - anything else (a bare caller-supplied
    #     name, e.g. orchid-merge's "orchestrator") -> "$ORCHID_ACTOR e$e"
    if [ -n "${ORCHID_ACTOR:-}" ]; then
      case "$ORCHID_ACTOR" in
        *tick-e[0-9]*|*' e'[0-9]*) actor="$ORCHID_ACTOR" ;;
        *) actor="$ORCHID_ACTOR e$e" ;;
      esac
    else
      actor="operator e$e"
    fi
    entry="## $(date -u +%Y-%m-%dT%H:%M:%SZ) ${task:-run} $kind ($actor)"
    { [ -f "$state/journal.md" ] && cat "$state/journal.md"; echo; echo "$entry"; echo "$text"; } \
      | atomic_write "$state/journal.md"
    if [ "$task_set" -eq 1 ]; then
      mkdir -p "$rt/journal-index"
      { [ -f "$_journal_index" ] && tail -n 40 "$_journal_index"; echo "$entry"; echo "$text"; } \
        | atomic_write "$_journal_index"
    fi ;;
  tail)
    n=20
    [ "${1:-}" != -n ] || n="$2"
    # Never evaluate caller text as Bash arithmetic. The digit bound keeps
    # multiplication within the signed 64-bit integer range on Bash 3.2.
    case "$n" in
      ''|*[!0-9]*) orchid_cli_usage_error journal "-n requires a nonnegative integer (got '$n')"; exit 2 ;;
    esac
    if [ "${#n}" -gt 18 ]; then
      orchid_cli_usage_error journal "-n accepts at most 18 decimal digits (got '$n')"
      exit 2
    fi
    tail -n "$(( 10#$n * 4 ))" "$state/journal.md" 2>/dev/null || true ;;

  show)
    [ "${1:-}" = "--task" ] || orchid_die "usage: journal show --task <id>"
    index_rc=0; _journal_index_target "$2" || index_rc=$?
    [ "$index_rc" -eq 0 ] || exit "$index_rc"
    cat "$_journal_index" 2>/dev/null || grep -F -A2 -- " $2 " "$state/journal.md" 2>/dev/null || true ;;
  *) orchid_die "usage: orchid journal add|tail|show" ;;
esac

#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"
# HELP AHEAD OF THE EPOCH FENCE (dogfood F45). Help is how an operator finds
# out what to do when the run state is ALREADY wrong, so it must not be
# answered by INV-02. First position only, and both spellings -- see the fuller
# note on libexec/orchid-task's gate, which is the authority for this rule.
case "${1:-}" in
  --help|-h) printf '%s\n' "usage: orchid requirements import <file>"; exit 0 ;;
esac
case "${2:-}" in
  --help|-h) printf '%s\n' "usage: orchid requirements import <file>"; exit 0 ;;
esac
epoch_require "$repo"
# Re-exported explicitly (already present from the caller, since
# epoch_require only validates it) so the fact that `journal add` below
# depends on it is not accidental — mirrors orchid-merge's convention.
export ORCHID_EPOCH

sub="${1:-}"; shift || true

case "$sub" in
  import)
    verb_lock_guard "$repo"
    src="${1:-}"
    [ -n "$src" ] || orchid_die "usage: orchid requirements import <file>"
    [ -f "$src" ] || orchid_die "no such file: $src"

    roadmap="$state/roadmap.md"
    [ -f "$roadmap" ] || orchid_die "no roadmap — run orchid init first"
    status="$(fm_get "$roadmap" run_status)"
    # requirements.md is the operator-owned EXCEPTION (kernel.md's ownership
    # table): authored by hand anywhere, imported by this verb, but
    # immutable once the run has left `planning` — a plan was drafted
    # against a requirements snapshot; changing it out from under an
    # in-flight run would silently invalidate that plan.
    [ "$status" = planning ] || orchid_die "requirements are immutable after plan (run_status: $status)"

    # Journal-first (INV-08): the reason the requirements snapshot changed
    # is durable before the snapshot itself changes, so a crash between the
    # two writes leaves at most an orphan journal entry (benign,
    # re-runnable) rather than a silently-replaced requirements.md with no
    # record of why — the same ordering orchid-run's `advance`/`accept` and
    # orchid-plan's `apply` use.
    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind plan_revision \
      "requirements imported from $(basename "$src")"
    cat "$src" | atomic_write "$state/requirements.md"
    echo "imported: $(basename "$src") -> requirements.md"
    ;;
  *) orchid_die "usage: orchid requirements import <file>" ;;
esac

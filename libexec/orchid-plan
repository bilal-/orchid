#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
# lessons.sh before plancheck.sh: the cross-check's "this run started here"
# boundary IS `lessons consolidate`'s, and there must be exactly one of them.
source "$ORCHID_ROOT/lib/lessons.sh"; source "$ORCHID_ROOT/lib/plancheck.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"
epoch_require "$repo"
export ORCHID_EPOCH

sub="${1:-}"; shift || true
case "$sub" in
  apply)
    # v1-m3: `apply` is the LAST step of PROTOCOL PLANNING, run only once the
    # plan-critique loop has settled -- draft, `runners/orchid-launch plan
    # plan_critic critique`, `orchid jobs reconcile`, fold `findings[]` from
    # `.orchid/reviews/plan-a<n>-plan_critic.json` back into the draft,
    # repeat until nothing left is at/above `medium` severity. No verb
    # change here: that loop only ever edits `.orchid/roadmap.md`/tasks/
    # directly (this verb's own doc-comment below already covers why that's
    # permitted pre-commit), and this verb still just commits whatever
    # currently sits in `.orchid/` -- it has no opinion on whether a
    # critique loop preceded it.
    verb_lock_acquire "$repo"
    # Release-on-EXIT, set IMMEDIATELY after acquire so nothing between here
    # and orchid_commit_durable below (--reason validation, roadmap/
    # integration-branch checks, each an `orchid_die` exit point) can leak
    # the lock. orchid_commit_durable (lib/common.sh) composes its OWN
    # temp-worktree cleanup with whatever EXIT trap is already armed when it
    # is called -- this one -- rather than installing a second, competing
    # trap that would just clobber it; it restores this exact trap before
    # returning, so it is still the one active for the rest of this arm too.
    trap 'verb_lock_release "$repo"' EXIT
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$reason" ] || orchid_die "plan apply requires --reason (INV-08)"

    roadmap="$state/roadmap.md"
    # v0 assumption (documented in the brief): the operator runs this from a
    # checkout where .orchid/ IS present — the integration branch itself, or
    # a worktree of it. roadmap.md missing here means that assumption does
    # not hold; die with a clear message rather than silently committing an
    # empty/partial .orchid/ snapshot.
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"

    integ="$(config_get "$repo" integration_branch orchid/integration)"
    git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1 \
      || orchid_die "integration branch '$integ' does not exist"

    # T021: the carry-forward cross-check, run HERE -- after the cheap
    # structural refusals, before anything is committed -- because this is
    # the last moment at which a plan can still be changed for free. r-002's
    # requirements omitted a defect r-001 had already found and journaled,
    # and it blocked a task hours into the run; the information existed and
    # nothing forced its use (lesson L016, applied to knowledge). So the
    # refusal is the point: an operator may cover a carried item with a task
    # or `orchid plan defer` it with a reason, but may not leave it
    # UNCONSIDERED. Read-only -- it never mutates .orchid/ and never
    # touches the integration branch -- so exiting here under the EXIT trap
    # armed above releases the verb lock and leaves nothing behind.
    crosscheck_rc=0
    plancheck_report "$state" || crosscheck_rc=$?
    if [ "$crosscheck_rc" -ne 0 ]; then
      # The REFUSAL is scoped to `run_status: planning` -- the phase it
      # actually gates, and the only phase in which its release valve is
      # open. `orchid plan defer` itself refuses once planning is over (a
      # deferral is a decision about a plan, and after apply the way to pick
      # an item up is a task), so enforcing the refusal on a later,
      # out-of-procedure `plan apply` would leave an operator unable to
      # either cover the item (the plan is committed) or defer it (the verb
      # is closed) -- a dead end with no recorded way out, which is exactly
      # what this check was told not to become. The REPORT is unconditional
      # either way: the items are named on every apply, so nothing carried
      # forward ever goes quiet, which is the property being bought here.
      if [ "$(fm_get "$roadmap" run_status)" = planning ]; then
        echo "orchid: plan apply refused — cover or defer the items above, then re-run (orchid plan crosscheck re-reports without committing)" >&2
        exit "$crosscheck_rc"
      fi
      echo "orchid: the carried-forward item(s) above are still unconsidered, but run_status has left planning — reported, not refused; pick one up with a task (orchid plan crosscheck re-reports at any time)" >&2
    fi

    # v1-m4 Task 1: the temp-worktree + CAS + sync-back mechanics below (once
    # this arm's own inline code) now live in lib/common.sh's
    # orchid_commit_durable, shared with `orchid run accept` and `orchid
    # config commit`. This arm's own CAS discipline (Fix 3) is UNCHANGED:
    # neither the journal reason nor the planning->running transition may
    # land in the CURRENT checkout's .orchid until the compare-and-swap
    # inside the helper has actually succeeded — otherwise a concurrent
    # commit to $integ leaves local state claiming a transition the
    # integration branch never received. Both mutations are applied by
    # `plan_apply_hook` below, which the helper invokes ONLY against the
    # temp worktree's OWN copy (never $repo directly) before it commits —
    # local .orchid is only ever touched by the helper's own post-CAS-
    # success sync-back, or, on CAS failure, to record the failure itself.
    plan_apply_hook() {
      local wt="$1" wt_roadmap status
      wt_roadmap="$wt/.orchid/roadmap.md"
      status="$(fm_get "$wt_roadmap" run_status)"

      # Journal-first (INV-08) still holds *within* this commit: the reason
      # is written to the worktree's journal.md before the run_status edit
      # below. `journal add` enforces its own epoch fencing, so lend the
      # worktree a throwaway runtime/epoch equal to the one already
      # validated at the top of this script (via epoch_require), then strip
      # runtime/ back out — runtime/ is never durable and must never ride
      # into a commit on the integration branch (orchid_commit_durable's own
      # copy-in step already excludes it, but this arm minted a fresh one
      # here for the nested `journal add` call, so it must clean up after
      # itself too).
      mkdir -p "$wt/.orchid/runtime"
      echo "$ORCHID_EPOCH" > "$wt/.orchid/runtime/epoch"
      ORCHID_REPO="$wt" ORCHID_EPOCH="$ORCHID_EPOCH" \
        "$ORCHID_ROOT/bin/orchid" journal add --kind plan_revision "$reason"
      rm -rf "$wt/.orchid/runtime"

      # Plan apply is the sole writer of run_status's planning->running edge
      # (kernel.md's ownership table: "orchid plan apply ... run_status").
      # Applied here, into the worktree, so it rides in the same commit as
      # the journal entry above.
      if [ "$status" = planning ]; then
        fm_set "$wt_roadmap" run_status running
      fi
    }
    ORCHID_COMMIT_DURABLE_HOOK=plan_apply_hook
    orchid_commit_durable "$repo" "orchid: plan apply" .orchid
    unset ORCHID_COMMIT_DURABLE_HOOK

    echo "applied: $integ -> $ORCHID_COMMIT_DURABLE_SHA"
    ;;
  crosscheck)
    # T021: the same report `plan apply` refuses on, run on its own so the
    # critique loop of PROTOCOL.md PLANNING step 2 can consult it while the
    # draft is still cheap to change. Read-only: no lock (it mutates
    # nothing, and holding one would refuse a concurrent read for no
    # reason), no journal entry, no commit. Exit 3 -- not 1 -- when items
    # are left unconsidered, so a wrapper can tell "the plan is not ready"
    # apart from "the command failed".
    crosscheck_rc=0
    plancheck_report "$state" || crosscheck_rc=$?
    exit "$crosscheck_rc"
    ;;
  defer)
    # T021: record the operator's explicit decision NOT to cover a
    # carried-forward item in this plan. This is the release valve that
    # keeps the cross-check from being a hard refusal on work someone has
    # genuinely chosen to postpone -- and it is a decision with a name and a
    # reason attached, journaled before it counts for anything, rather than
    # a --force flag that erases the whole question in one word.
    verb_lock_guard "$repo"
    id="${1:-}"; shift || true
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    # A flag in the item-id position means the id was omitted, not that a
    # flag is a valid id: without this the next refusal would be the
    # confusing "requires --reason" for a command that supplied one.
    case "${id:-}" in -*) id="" ;; esac
    [ -n "$id" ] || orchid_die "usage: orchid plan defer <item-id> --reason \"...\""
    # An item id is one token of a one-line report (`L<nnn>` or `<run>#<n>`),
    # so whitespace in it is a caller that scraped too much -- and it must be
    # refused HERE, not left to the membership check below. `grep -qxF`
    # matches a multi-line pattern LINE BY LINE, so a doubled id passes as
    # "known"; the deferral then journals as two lines ("deferred <line1>",
    # then "<line2>: <reason>"), and plancheck_deferral -- which matches the
    # single line "deferred <id>: " -- finds nothing. The operator is told the
    # decision was recorded while the item stays unconsidered, which is the
    # precise silent pass this whole cross-check exists to close.
    case "$id" in
      *[[:space:]]*) orchid_die "item id must not contain whitespace: '$(printf '%s' "$id" | tr -s '[:space:]' ' ')'" ;;
    esac
    [ -n "$reason" ] || orchid_die "plan defer requires --reason (INV-08)"
    # journal.md is line-oriented and this entry is matched back by its
    # first line; a reason carrying its own newline could forge a second
    # deferral line, so it is refused here rather than silently truncated
    # (same guard, same wording, as `orchid lessons add`'s _no_newline).
    case "$reason" in
      *$'\n'*) orchid_die "--reason must not contain embedded newlines (the deferral is one journal line -- flatten it first)" ;;
    esac

    roadmap="$state/roadmap.md"
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"
    run_status="$(fm_get "$roadmap" run_status)"
    [ "$run_status" = planning ] || \
      orchid_die "plan defer requires run_status planning (current: $run_status) — deferring a carried-forward item is a PLANNING decision, and after plan apply the way to pick one up is a task"

    # An id that is not on the carried-forward list is refused, never
    # recorded: a typo'd deferral would otherwise read as a decision while
    # leaving the real item unconsidered -- the silent pass this whole check
    # exists to close. The known ids are printed so the next attempt is a
    # copy-paste.
    known="$(plancheck_item_ids "$state")"
    if ! grep -qxF "$id" <<<"$known"; then
      if [ -z "$known" ]; then
        orchid_die "nothing is carried forward into this plan, so there is nothing to defer (orchid plan crosscheck)"
      fi
      orchid_die "'$id' is not a carried-forward item of this plan — known ids: $(printf '%s' "$known" | tr '\n' ' ')"
    fi
    if plancheck_deferral "$state/journal.md" "$id" >/dev/null; then
      orchid_die "$id is already deferred — the decision is journaled (orchid journal tail); revisit it by covering the item with a task instead"
    fi

    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind plan_deferral \
      "deferred $id: $reason"
    echo "$id: deferred (this plan does not cover it)"
    ;;
  *) orchid_die "usage: orchid plan apply --reason \"...\" | orchid plan crosscheck | orchid plan defer <item-id> --reason \"...\"" ;;
esac

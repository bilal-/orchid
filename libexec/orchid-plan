#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"
epoch_require "$repo"
export ORCHID_EPOCH

sub="${1:-}"; shift || true
case "$sub" in
  apply)
    # v1-m3: `apply` is the LAST step of PROTOCOL PLANNING, run only once the
    # plan-critique loop has settled -- draft, `runners/orchid-launch plan
    # plan_critic critique`, `orchid jobs reconcile`, fold `findings[]` from
    # `.orchid/reviews/plan-a<n>-plan_critic.json` back into the draft,
    # repeat until nothing left is at/above `medium` severity. No verb
    # change here: that loop only ever edits `.orchid/roadmap.md`/tasks/
    # directly (this verb's own doc-comment below already covers why that's
    # permitted pre-commit), and this verb still just commits whatever
    # currently sits in `.orchid/` -- it has no opinion on whether a
    # critique loop preceded it.
    verb_lock_acquire "$repo"
    # Provisional release-on-EXIT, set IMMEDIATELY after acquire so nothing
    # between here and the temp-worktree trap below (--reason validation,
    # roadmap/integration-branch checks, each an `orchid_die` exit point) can
    # leak the lock. Superseded a few lines down once `wt` exists and
    # `plan_cleanup` takes over EXIT -- that later trap folds this same
    # verb_lock_release call into its own string, composed by hand.
    trap 'verb_lock_release "$repo"' EXIT
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$reason" ] || orchid_die "plan apply requires --reason (INV-08)"

    roadmap="$state/roadmap.md"
    # v0 assumption (documented in the brief): the operator runs this from a
    # checkout where .orchid/ IS present — the integration branch itself, or
    # a worktree of it. roadmap.md missing here means that assumption does
    # not hold; die with a clear message rather than silently committing an
    # empty/partial .orchid/ snapshot.
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"

    integ="$(config_get "$repo" integration_branch orchid/integration)"
    git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1 \
      || orchid_die "integration branch '$integ' does not exist"

    # CAS discipline (Fix 3): neither the journal reason nor the
    # planning->running transition may land in the CURRENT checkout's
    # .orchid until the compare-and-swap below has actually succeeded —
    # otherwise a concurrent commit to $integ between here and update-ref
    # leaves local state claiming a transition ("running", reason
    # journaled) that the integration branch never received. Both
    # mutations are deferred and applied into the TEMP WORKTREE's copy
    # instead (below, after it's populated), so they ride into the commit
    # this verb is building; local .orchid is only ever touched AFTER CAS
    # success (sync-back) or, on CAS failure, to record the failure itself
    # (Fix 3c below). Source of truth for journal.md/roadmap.md is the temp
    # worktree until CAS succeeds, local from that instant on.
    integ_head="$(git -C "$repo" rev-parse "refs/heads/$integ")"

    # Never switch the user's checkout: stage + commit in a detached temp
    # worktree of the integration branch, then advance the branch ref via a
    # compare-and-swap update-ref (mirrors orchid-merge's pattern exactly —
    # this is what "mirror init's temp-worktree pattern" cashes out to once
    # the branch already exists and may be the very branch the operator is
    # sitting on: `git worktree add <name>` of an already-checked-out branch
    # would fail, so this only ever touches it via a detached worktree + ref
    # update, never a named checkout).
    wt=""
    plan_cleanup() {
      if [ -n "$wt" ]; then
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
        rm -rf "$wt" 2>/dev/null || true
        git -C "$repo" worktree prune >/dev/null 2>&1 || true
      fi
    }
    # Composed by hand (not verb_lock_guard): this arm already owns the EXIT
    # trap for temp-worktree cleanup, so the verb lock's release is folded
    # into the SAME trap string rather than installed as a second, competing
    # `trap ... EXIT` that would just clobber this one.
    trap 'plan_cleanup; verb_lock_release "$repo"' EXIT
    wt="$(mktemp -d "${TMPDIR:-/tmp}/orchid-plan.XXXXXX")"
    git -C "$repo" worktree add -q --detach "$wt" "$integ_head" >/dev/null 2>&1 \
      || orchid_die "cannot create temp worktree at $integ_head"

    # Copy in ALL current .orchid/ durable state, excluding runtime/
    # (rsync-less: rebuild .orchid/ in the worktree fully from the current
    # checkout's .orchid/ minus runtime/, so deletions on the source side are
    # reflected too, not just additions/edits).
    rm -rf "$wt/.orchid"
    mkdir -p "$wt/.orchid"
    for entry in "$state"/*; do
      [ -e "$entry" ] || continue
      name="$(basename "$entry")"
      [ "$name" = runtime ] && continue
      cp -R "$entry" "$wt/.orchid/$name"
    done

    # --- Fix 3: apply BOTH deferred mutations into the WORKTREE's copy
    # only, so they ride into the commit below. Local .orchid is untouched
    # until CAS succeeds (sync-back, further down).
    wt_roadmap="$wt/.orchid/roadmap.md"
    status="$(fm_get "$wt_roadmap" run_status)"

    # Journal-first (INV-08) still holds *within* this commit: the reason
    # is written to the worktree's journal.md before the run_status edit
    # below. `journal add` enforces its own epoch fencing, so lend the
    # worktree a throwaway runtime/epoch equal to the one already validated
    # at the top of this script (via epoch_require), then strip runtime/
    # back out before `git add` — runtime/ is never durable and must never
    # ride into a commit on the integration branch.
    mkdir -p "$wt/.orchid/runtime"
    echo "$ORCHID_EPOCH" > "$wt/.orchid/runtime/epoch"
    ORCHID_REPO="$wt" ORCHID_EPOCH="$ORCHID_EPOCH" \
      "$ORCHID_ROOT/bin/orchid" journal add --kind plan_revision "$reason"
    rm -rf "$wt/.orchid/runtime"

    # Plan apply is the sole writer of run_status's planning->running edge
    # (kernel.md's ownership table: "orchid plan apply ... run_status").
    # Applied here, into the worktree, so it rides in the same commit as
    # the journal entry above.
    if [ "$status" = planning ]; then
      fm_set "$wt_roadmap" run_status running
    fi

    git -C "$wt" add .orchid
    if git -C "$wt" diff --cached --quiet -- .orchid; then
      orchid_die "nothing to apply — no .orchid changes since last plan apply"
    fi
    git -C "$wt" commit -q -m "orchid: plan apply"
    new_sha="$(git -C "$wt" rev-parse HEAD)"

    # Compare-and-swap: only advance refs/heads/$integ if it still points at
    # the integ_head this call read at the top (same discipline as
    # orchid-merge's update-ref) — refuses rather than clobbering a
    # concurrent commit.
    if ! git -C "$repo" update-ref "refs/heads/$integ" "$new_sha" "$integ_head"; then
      # Fix 3c: CAS failure. The commit built above is unreferenced (never
      # touches local state or any branch) and is left for gc. The
      # integration branch moved concurrently — journal that fact to the
      # LOCAL journal (the operator must see it; this IS a deliberate
      # local-only mutation, the sole exception to "local untouched until
      # CAS success") and die nonzero. Local roadmap is completely
      # untouched: no planning->running transition, since that edit only
      # ever existed inside the orphaned worktree commit.
      moved_to="$(git -C "$repo" rev-parse "refs/heads/$integ" 2>/dev/null || echo "?")"
      ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind intervention \
        "plan apply CAS failure — integration branch '$integ' changed concurrently (expected $integ_head, now $moved_to) — retry orchid plan apply"
      orchid_die "update-ref CAS failed: integration branch '$integ' changed concurrently (expected $integ_head) — retry orchid plan apply"
    fi

    # CAS succeeded: the worktree's just-committed journal.md and
    # roadmap.md are supersets of local's (identical prior content plus the
    # two mutations applied above) — copy them back over local atomically.
    # This is the ONLY point the current checkout's .orchid changes.
    cat "$wt/.orchid/journal.md" | atomic_write "$state/journal.md"
    cat "$wt/.orchid/roadmap.md" | atomic_write "$state/roadmap.md"

    echo "applied: $integ -> $new_sha"
    ;;
  *) orchid_die "usage: orchid plan apply --reason \"...\"" ;;
esac

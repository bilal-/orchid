#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
# lessons.sh before plancheck.sh: the cross-check's "this run started here"
# boundary IS `lessons consolidate`'s, and there must be exactly one of them.
source "$ORCHID_ROOT/lib/lessons.sh"; source "$ORCHID_ROOT/lib/plancheck.sh"
# findings.sh: the critique-round series `plan rounds` reports (F40).
source "$ORCHID_ROOT/lib/findings.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"
# HELP AHEAD OF THE EPOCH FENCE (dogfood F45). Help is how an operator finds
# out what to do when the run state is ALREADY wrong, so it must not be
# answered by INV-02. First position only, and both spellings -- see the fuller
# note on libexec/orchid-task's gate, which is the authority for this rule.
case "${1:-}" in
  --help|-h) printf '%s\n' "usage: orchid plan apply --reason \"...\" | orchid plan crosscheck | orchid plan rounds | orchid plan defer <item-id> --reason \"...\""; exit 0 ;;
esac
case "${2:-}" in
  --help|-h) printf '%s\n' "usage: orchid plan apply --reason \"...\" | orchid plan crosscheck | orchid plan rounds | orchid plan defer <item-id> --reason \"...\""; exit 0 ;;
esac
# `rounds` IS ANSWERED HERE, ahead of the epoch fence below, because it is a
# read-only report and the argument is INV-17's: the critique loop consults it
# while the draft is still cheap to change, and a report gated on run state is
# the one thing you cannot read when the run state is what went wrong. It
# writes nothing, locks nothing and journals nothing, so there is no INV-02
# interest in it at all. Its fenced siblings above are unchanged.
if [ "${1:-}" = rounds ]; then
    # F40: the critique loop's convergence signal. Read-only, exactly as
    # `crosscheck` is and for the same reason -- the loop consults it while the
    # draft is still cheap to change, and a report gated on run state is the one
    # thing you cannot read when the run state is what went wrong (INV-17).
    #
    # WHAT THIS CAN AND CANNOT SEE, stated in the output rather than left for a
    # reader to discover. Identity is the finding's TITLE, case-folded and
    # whitespace-collapsed. That detects a verbatim repeat. It does NOT detect
    # the same objection re-worded -- which is one of the three things F40 says
    # an operator cannot distinguish -- and a re-worded repeat is reported here
    # as one resolved plus one new. On r-002's own critique series every round
    # scores zero repeats for exactly that reason. The TOTALS column is what
    # survives rewording, and it is what exposed the regression: 10, 7, 5, 8.
    rounds_series="$(findings_round_series "$state" plan)"
    if [ -z "$rounds_series" ]; then
      echo "no critique rounds filed for this plan (reviews/plan-a<N>-*.json)"
      exit 0
    fi
    printf 'round\ttotal\tnew\trepeat\tresolved\n'
    printf '%s\n' "$rounds_series"
    # THE VERDICT IS ABOUT THE TOTALS, because that is the term that survives a
    # critic rewording its findings. A round that did not reduce the count is
    # named individually; the series is converging only if every round reduced.
    rounds_prev=""; rounds_bad=""
    while IFS=$'\t' read -r rr rtot _ _ _; do
      [ -n "$rr" ] || continue
      if [ -n "$rounds_prev" ] && [ "$rtot" -ge "$rounds_prev" ]; then
        rounds_bad="$rounds_bad $rr"
      fi
      rounds_prev="$rtot"
    done <<< "$rounds_series"
    if [ -n "$rounds_bad" ]; then
      echo "not converging: round(s)$rounds_bad did not reduce the finding count — a loop that re-asks an identically-answered question spends rounds without moving, and the count is the term a re-worded finding cannot hide behind"
      echo "identity is the finding title; a re-worded repeat reads above as one resolved plus one new, so 'repeat' is a floor on repetition and never a ceiling"
      exit 3
    fi
    echo "converging: every round reduced the finding count"
    echo "identity is the finding title; a re-worded repeat reads above as one resolved plus one new, so 'repeat' is a floor on repetition and never a ceiling"
    exit 0

fi
epoch_require "$repo"
export ORCHID_EPOCH

sub="${1:-}"; shift || true

case "$sub" in
  apply)
    # v1-m3: `apply` is the LAST step of PROTOCOL PLANNING, run only once the
    # plan-critique loop has settled -- draft, `runners/orchid-launch plan
    # plan_critic critique`, `orchid jobs reconcile`, fold `findings[]` from
    # `.orchid/reviews/plan-a<n>-plan_critic.json` back into the draft,
    # repeat until nothing left is at/above `medium` severity. No verb
    # change here: that loop only ever edits `.orchid/roadmap.md`/tasks/
    # directly (this verb's own doc-comment below already covers why that's
    # permitted pre-commit), and this verb still just commits whatever
    # currently sits in `.orchid/` -- it has no opinion on whether a
    # critique loop preceded it.
    verb_lock_acquire "$repo"
    # Release-on-EXIT, set IMMEDIATELY after acquire so nothing between here
    # and orchid_commit_durable below (--reason validation, roadmap/
    # integration-branch checks, each an `orchid_die` exit point) can leak
    # the lock. orchid_commit_durable (lib/common.sh) composes its OWN
    # temp-worktree cleanup with whatever EXIT trap is already armed when it
    # is called -- this one -- rather than installing a second, competing
    # trap that would just clobber it; it restores this exact trap before
    # returning, so it is still the one active for the rest of this arm too.
    trap 'verb_lock_release "$repo"' EXIT
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$reason" ] || orchid_die "plan apply requires --reason (INV-08)"

    roadmap="$state/roadmap.md"
    # v0 assumption (documented in the brief): the operator runs this from a
    # checkout where .orchid/ IS present — the integration branch itself, or
    # a worktree of it. roadmap.md missing here means that assumption does
    # not hold; die with a clear message rather than silently committing an
    # empty/partial .orchid/ snapshot.
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"

    integ="$(config_get "$repo" integration_branch orchid/integration)"
    git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1 \
      || orchid_die "integration branch '$integ' does not exist"

    # T021: the carry-forward cross-check, run HERE -- after the cheap
    # structural refusals, before anything is committed -- because this is
    # the last moment at which a plan can still be changed for free. r-002's
    # requirements omitted a defect r-001 had already found and journaled,
    # and it blocked a task hours into the run; the information existed and
    # nothing forced its use (lesson L016, applied to knowledge). So the
    # refusal is the point: an operator may cover a carried item with a task
    # or `orchid plan defer` it with a reason, but may not leave it
    # UNCONSIDERED. Read-only -- it never mutates .orchid/ and never
    # touches the integration branch -- so exiting here under the EXIT trap
    # armed above releases the verb lock and leaves nothing behind.
    crosscheck_rc=0
    plancheck_report "$state" || crosscheck_rc=$?
    if [ "$crosscheck_rc" -ne 0 ]; then
      # The refusal is on the VERB, in every run_status -- not scoped to
      # `planning`. It was scoped once, and that scoping was the last bypass
      # left in this gate: `plan apply` is a legal verb after planning too
      # (it commits whatever durable `.orchid/` state is current, journaling
      # `plan_revision`), so a revision that DELETES the one task covering a
      # carried item -- or that lands the moment the run leaves planning by
      # any route -- committed the item out of consideration with a printed
      # warning and exit 0. A gate that reports rather than refuses on the
      # very edit that uncovers an item is enforcing nothing about that
      # edit; it is enforcing something about when the operator happens to
      # make it.
      #
      # It is not the dead end the brief rules out, because the remedy moved
      # with it: `orchid plan defer` is legal in the same set of statuses
      # this verb is (see the defer arm -- the run_status precondition it
      # used to carry was removed in the same change, for exactly this
      # reason). At every refusal here, both ways out are open -- cover the
      # item with a task in the plan being applied, or record the decision
      # not to -- so the operator is never between two closed doors. Pairing
      # the two is the whole point: a refusal is only a gate if the state it
      # fires in still admits its own remedy.
      #
      # `orchid run accept` also commits durable `.orchid/` state and is
      # deliberately NOT gated: it refuses unless run_status is `accepting`,
      # so it can neither apply a plan nor take a run out of `planning`, and
      # a carried item still standing at acceptance is carried into the NEXT
      # run's cross-check by `run new` rather than lost. Gating the run's own
      # closing commit would stop a finished run from being recorded, which
      # buys nothing here.
      #
      # Exit 4 is the cross-check saying it could not READ the previous run's
      # record at all (a missing archive, a missing archived journal, a
      # roadmap that cannot say which run this is). It gets its own sentence
      # because neither remedy below applies to it: there is no item to cover
      # and none to defer, and telling an operator to do either -- under a
      # report that listed nothing -- is the same misdirection as passing the
      # plan would have been.
      #
      # Exit 5 is the same shape one level further down: the cross-check
      # could not build its own workspace (no scratch directory under
      # TMPDIR), so it listed nothing for a reason that has nothing to do
      # with this plan or with the previous run. Its own sentence for its own
      # repair -- naming the previous run's record here would send an
      # operator to restore an archive that is sitting there intact.
      if [ "$crosscheck_rc" -eq 5 ]; then
        echo "orchid: plan apply refused — the carry-forward cross-check could not run (above); give it a writable TMPDIR, then re-run (orchid plan crosscheck re-reports without committing)" >&2
      elif [ "$crosscheck_rc" -eq 4 ]; then
        echo "orchid: plan apply refused — the carry-forward cross-check could not be answered (above); repair the previous run's record, then re-run (orchid plan crosscheck re-reports without committing)" >&2
      else
        echo "orchid: plan apply refused — cover the item(s) above with a task in this plan, or record the decision (orchid plan defer <id> --reason \"...\"), then re-run (orchid plan crosscheck re-reports without committing)" >&2
      fi
      exit "$crosscheck_rc"
    fi

    # ---- THE CRITIQUE LOOP HAS STOPPED MOVING (dogfood F40) -------------
    # `orchid plan rounds` reports the series; nothing makes anyone read it,
    # and lesson L016 is precisely that a mechanism nothing forces you to use
    # is not a fix. r-002's own critique ran 10, 7, 5, 8 findings before a
    # fifth round approved, and the round that went UP was visible to nobody.
    #
    # SAME SHAPE AS THE REWORK LOOP'S STOP, deliberately rather than a second
    # invention: `rework_nonconvergence_max` already refuses to spend another
    # round re-asking an identically-answered question, and this is that rule
    # one loop earlier. The predicate is shared with the report
    # (findings_rounds_stalled) so the two can never disagree about what
    # stalled means, and it is narrower than what the report PRINTS -- only
    # consecutive non-reducing rounds at the END of the series, so a blip the
    # loop has since recovered from does not stop a plan that is converging.
    #
    # AND IT PAIRS WITH ITS OWN REMEDY, which is the whole difference between
    # a gate and a wall, exactly as the cross-check above pairs with `plan
    # defer`: make the next round reduce the count, or raise the bound. Both
    # doors are open in the state this fires in.
    crit_max="$(config_get "$repo" critique_nonconvergence_max 3)"
    case "$crit_max" in ''|*[!0-9]*) crit_max=3 ;; esac
    if [ "$crit_max" -gt 0 ] && findings_rounds_stalled "$state" plan "$crit_max"; then
      echo "orchid: plan apply refused — the plan critique has now run $crit_max consecutive round(s) without reducing its finding count (critique_nonconvergence_max=$crit_max), so another round would re-ask a question the last ones already answered the same way. See which rounds and which findings: orchid plan rounds. Then either make the next round reduce the count -- the report separates a repeat from a new objection, and a repeat is the critic saying the draft did not change where it mattered -- or raise critique_nonconvergence_max if this loop really should get more rounds of the same question." >&2
      exit 3
    fi

    # v1-m4 Task 1: the temp-worktree + CAS + sync-back mechanics below (once
    # this arm's own inline code) now live in lib/common.sh's
    # orchid_commit_durable, shared with `orchid run accept` and `orchid
    # config commit`. This arm's own CAS discipline (Fix 3) is UNCHANGED:
    # neither the journal reason nor the planning->running transition may
    # land in the CURRENT checkout's .orchid until the compare-and-swap
    # inside the helper has actually succeeded — otherwise a concurrent
    # commit to $integ leaves local state claiming a transition the
    # integration branch never received. Both mutations are applied by
    # `plan_apply_hook` below, which the helper invokes ONLY against the
    # temp worktree's OWN copy (never $repo directly) before it commits —
    # local .orchid is only ever touched by the helper's own post-CAS-
    # success sync-back, or, on CAS failure, to record the failure itself.
    plan_apply_hook() {
      local wt="$1" wt_roadmap status
      wt_roadmap="$wt/.orchid/roadmap.md"
      status="$(fm_get "$wt_roadmap" run_status)"

      # Journal-first (INV-08) still holds *within* this commit: the reason
      # is written to the worktree's journal.md before the run_status edit
      # below. `journal add` enforces its own epoch fencing, so lend the
      # worktree a throwaway runtime/epoch equal to the one already
      # validated at the top of this script (via epoch_require), then strip
      # runtime/ back out — runtime/ is never durable and must never ride
      # into a commit on the integration branch (orchid_commit_durable's own
      # copy-in step already excludes it, but this arm minted a fresh one
      # here for the nested `journal add` call, so it must clean up after
      # itself too).
      mkdir -p "$wt/.orchid/runtime"
      echo "$ORCHID_EPOCH" > "$wt/.orchid/runtime/epoch"
      ORCHID_REPO="$wt" ORCHID_EPOCH="$ORCHID_EPOCH" \
        "$ORCHID_ROOT/bin/orchid" journal add --kind plan_revision "$reason"
      rm -rf "$wt/.orchid/runtime"

      # Plan apply is the sole writer of run_status's planning->running edge
      # (kernel.md's ownership table: "orchid plan apply ... run_status").
      # Applied here, into the worktree, so it rides in the same commit as
      # the journal entry above.
      if [ "$status" = planning ]; then
        fm_set "$wt_roadmap" run_status running
      fi
    }
    ORCHID_COMMIT_DURABLE_HOOK=plan_apply_hook
    orchid_commit_durable "$repo" "orchid: plan apply" .orchid
    unset ORCHID_COMMIT_DURABLE_HOOK

    echo "applied: $integ -> $ORCHID_COMMIT_DURABLE_SHA"
    ;;
  crosscheck)
    # T021: the same report `plan apply` refuses on, run on its own so the
    # critique loop of PROTOCOL.md PLANNING step 2 can consult it while the
    # draft is still cheap to change. Read-only: no lock (it mutates
    # nothing, and holding one would refuse a concurrent read for no
    # reason), no journal entry, no commit. Exit 3 -- not 1 -- when items
    # are left unconsidered, so a wrapper can tell "the plan is not ready"
    # apart from "the command failed".
    crosscheck_rc=0
    plancheck_report "$state" || crosscheck_rc=$?
    exit "$crosscheck_rc"
    ;;
  defer)
    # T021: record the operator's explicit decision NOT to cover a
    # carried-forward item in this plan. This is the release valve that
    # keeps the cross-check from being a hard refusal on work someone has
    # genuinely chosen to postpone -- and it is a decision with a name and a
    # reason attached, journaled before it counts for anything, rather than
    # a --force flag that erases the whole question in one word.
    verb_lock_guard "$repo"
    id="${1:-}"; shift || true
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    # A flag in the item-id position means the id was omitted, not that a
    # flag is a valid id: without this the next refusal would be the
    # confusing "requires --reason" for a command that supplied one.
    case "${id:-}" in -*) id="" ;; esac
    [ -n "$id" ] || orchid_die "usage: orchid plan defer <item-id> --reason \"...\""
    # An item id is one token of a one-line report (`L<nnn>` or `<run>#<n>`),
    # so whitespace in it is a caller that scraped too much -- and it must be
    # refused HERE, not left to the membership check below. `grep -qxF`
    # matches a multi-line pattern LINE BY LINE, so a doubled id passes as
    # "known"; the deferral then journals as two lines ("deferred <line1>",
    # then "<line2>: <reason>"), and plancheck_deferral -- which matches the
    # single line "deferred <id>: " -- finds nothing. The operator is told the
    # decision was recorded while the item stays unconsidered, which is the
    # precise silent pass this whole cross-check exists to close.
    case "$id" in
      *[[:space:]]*) orchid_die "item id must not contain whitespace: '$(printf '%s' "$id" | tr -s '[:space:]' ' ')'" ;;
    esac
    [ -n "$reason" ] || orchid_die "plan defer requires --reason (INV-08)"
    # journal.md is line-oriented and this entry is matched back by its
    # first line; a reason carrying its own newline could forge a second
    # deferral line, so it is refused here rather than silently truncated
    # (same guard, same wording, as `orchid lessons add`'s _no_newline).
    case "$reason" in
      *$'\n'*) orchid_die "--reason must not contain embedded newlines (the deferral is one journal line -- flatten it first)" ;;
    esac

    roadmap="$state/roadmap.md"
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"
    # NO run_status precondition, deliberately. This verb once required
    # `planning`, on the reasoning that a deferral is a decision about a plan
    # and that after `plan apply` the way to pick an item up is a task. That
    # reasoning is still the ADVICE -- a task is the better answer once the
    # run is moving -- but as a REFUSAL it was what forced `plan apply` to
    # stop gating after planning: the one remedy for a mid-run revision that
    # uncovers an item was closed, so refusing that revision would have
    # stranded the operator, and the gate was scoped away instead. Only one
    # of the two could keep its restriction, and the gate is worth more than
    # the advice. `plan apply` is legal in every status; a carried item can
    # therefore be uncovered in every status; so the decision that answers
    # for one has to be recordable in every status too. Everything that made
    # a deferral trustworthy is untouched: it names one id, that id must be
    # genuinely carried forward, it carries a reason, it is journaled under a
    # kind the brokered surface refuses, and it comes back next run.

    # An id that is not on the carried-forward list is refused, never
    # recorded: a typo'd deferral would otherwise read as a decision while
    # leaving the real item unconsidered -- the silent pass this whole check
    # exists to close. The known ids are printed so the next attempt is a
    # copy-paste.
    #
    # An UNANSWERABLE carry-forward question (exit 4 -- no archive for the
    # run this one carries from, no journal inside it, no readable run_id) is
    # refused here on its own terms rather than read as an empty list. The
    # empty list's message is "nothing is carried forward into this plan, so
    # there is nothing to defer", which in that state is a statement the
    # command cannot support: it did not find an empty ledger, it failed to
    # find the ledger. plancheck_item_ids has already printed WHICH record it
    # could not read.
    known=""; ids_rc=0
    known="$(plancheck_item_ids "$state")" || ids_rc=$?
    if [ "$ids_rc" -ne 0 ]; then
      orchid_die "the carried-forward list could not be built (see above), so '$id' cannot be checked against it — a deferral names one item of that list; repair the previous run's record, then re-run (orchid plan crosscheck)"
    fi
    if ! grep -qxF "$id" <<<"$known"; then
      if [ -z "$known" ]; then
        orchid_die "nothing is carried forward into this plan, so there is nothing to defer (orchid plan crosscheck)"
      fi
      orchid_die "'$id' is not a carried-forward item of this plan — known ids: $(printf '%s' "$known" | tr '\n' ' ')"
    fi
    if plancheck_deferral "$state/journal.md" "$id" >/dev/null; then
      orchid_die "$id is already deferred — the decision is journaled (orchid journal tail); revisit it by covering the item with a task instead"
    fi

    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind plan_deferral \
      "deferred $id: $reason"
    echo "$id: deferred (this plan does not cover it)"
    ;;
  *) orchid_die "usage: orchid plan apply --reason \"...\" | orchid plan crosscheck | orchid plan rounds | orchid plan defer <item-id> --reason \"...\"" ;;
esac

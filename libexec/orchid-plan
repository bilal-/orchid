#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"
epoch_require "$repo"
export ORCHID_EPOCH

sub="${1:-}"; shift || true
case "$sub" in
  apply)
    # v1-m3: `apply` is the LAST step of PROTOCOL PLANNING, run only once the
    # plan-critique loop has settled -- draft, `runners/orchid-launch plan
    # plan_critic critique`, `orchid jobs reconcile`, fold `findings[]` from
    # `.orchid/reviews/plan-a<n>-plan_critic.json` back into the draft,
    # repeat until nothing left is at/above `medium` severity. No verb
    # change here: that loop only ever edits `.orchid/roadmap.md`/tasks/
    # directly (this verb's own doc-comment below already covers why that's
    # permitted pre-commit), and this verb still just commits whatever
    # currently sits in `.orchid/` -- it has no opinion on whether a
    # critique loop preceded it.
    verb_lock_acquire "$repo"
    # Release-on-EXIT, set IMMEDIATELY after acquire so nothing between here
    # and orchid_commit_durable below (--reason validation, roadmap/
    # integration-branch checks, each an `orchid_die` exit point) can leak
    # the lock. orchid_commit_durable (lib/common.sh) composes its OWN
    # temp-worktree cleanup with whatever EXIT trap is already armed when it
    # is called -- this one -- rather than installing a second, competing
    # trap that would just clobber it; it restores this exact trap before
    # returning, so it is still the one active for the rest of this arm too.
    trap 'verb_lock_release "$repo"' EXIT
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$reason" ] || orchid_die "plan apply requires --reason (INV-08)"

    roadmap="$state/roadmap.md"
    # v0 assumption (documented in the brief): the operator runs this from a
    # checkout where .orchid/ IS present — the integration branch itself, or
    # a worktree of it. roadmap.md missing here means that assumption does
    # not hold; die with a clear message rather than silently committing an
    # empty/partial .orchid/ snapshot.
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"

    integ="$(config_get "$repo" integration_branch orchid/integration)"
    git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1 \
      || orchid_die "integration branch '$integ' does not exist"

    # v1-m4 Task 1: the temp-worktree + CAS + sync-back mechanics below (once
    # this arm's own inline code) now live in lib/common.sh's
    # orchid_commit_durable, shared with `orchid run accept` and `orchid
    # config commit`. This arm's own CAS discipline (Fix 3) is UNCHANGED:
    # neither the journal reason nor the planning->running transition may
    # land in the CURRENT checkout's .orchid until the compare-and-swap
    # inside the helper has actually succeeded — otherwise a concurrent
    # commit to $integ leaves local state claiming a transition the
    # integration branch never received. Both mutations are applied by
    # `plan_apply_hook` below, which the helper invokes ONLY against the
    # temp worktree's OWN copy (never $repo directly) before it commits —
    # local .orchid is only ever touched by the helper's own post-CAS-
    # success sync-back, or, on CAS failure, to record the failure itself.
    plan_apply_hook() {
      local wt="$1" wt_roadmap status
      wt_roadmap="$wt/.orchid/roadmap.md"
      status="$(fm_get "$wt_roadmap" run_status)"

      # Journal-first (INV-08) still holds *within* this commit: the reason
      # is written to the worktree's journal.md before the run_status edit
      # below. `journal add` enforces its own epoch fencing, so lend the
      # worktree a throwaway runtime/epoch equal to the one already
      # validated at the top of this script (via epoch_require), then strip
      # runtime/ back out — runtime/ is never durable and must never ride
      # into a commit on the integration branch (orchid_commit_durable's own
      # copy-in step already excludes it, but this arm minted a fresh one
      # here for the nested `journal add` call, so it must clean up after
      # itself too).
      mkdir -p "$wt/.orchid/runtime"
      echo "$ORCHID_EPOCH" > "$wt/.orchid/runtime/epoch"
      ORCHID_REPO="$wt" ORCHID_EPOCH="$ORCHID_EPOCH" \
        "$ORCHID_ROOT/bin/orchid" journal add --kind plan_revision "$reason"
      rm -rf "$wt/.orchid/runtime"

      # Plan apply is the sole writer of run_status's planning->running edge
      # (kernel.md's ownership table: "orchid plan apply ... run_status").
      # Applied here, into the worktree, so it rides in the same commit as
      # the journal entry above.
      if [ "$status" = planning ]; then
        fm_set "$wt_roadmap" run_status running
      fi
    }
    ORCHID_COMMIT_DURABLE_HOOK=plan_apply_hook
    orchid_commit_durable "$repo" "orchid: plan apply" .orchid
    unset ORCHID_COMMIT_DURABLE_HOOK

    echo "applied: $integ -> $ORCHID_COMMIT_DURABLE_SHA"
    ;;
  *) orchid_die "usage: orchid plan apply --reason \"...\"" ;;
esac

#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/archetype.sh"
source "$ORCHID_ROOT/lib/hooks.sh"; source "$ORCHID_ROOT/lib/envelope.sh"
source "$ORCHID_ROOT/lib/resolver.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"
epoch_require "$repo"
# task set/advance below run as child processes of THIS verb; ORCHID_EPOCH
# must already be exported for epoch_require (above) to have succeeded, so
# it is already present in the environment and propagates automatically —
# exported here again, explicitly, so that fact is not accidental.
export ORCHID_EPOCH

id="${1:-}"
[ -n "$id" ] || orchid_die "usage: orchid merge <task-id>"
tf="$state/tasks/$id.md"
[ -f "$tf" ] || orchid_die "no task $id"

# FIRST check, ahead of even the status gate below: a `outcome=report`
# archetype (e.g. `review`) declares no transition into `merging` at all
# (archetype_validate's meta-contract enforces that), so its tasks could
# only ever fail the "not in merging" check below -- but that message would
# misleadingly suggest merge is just being run too early, when the real
# answer is "never, by design." Refused here with its own message instead,
# regardless of the task's current status.
archetype="$(fm_get "$tf" archetype)"; [ -n "$archetype" ] || archetype=feature
if [ "$(archetype_outcome "$archetype")" = report ]; then
  echo "merge refused: archetype '$archetype' outcome=report never advances the integration branch (exit 3)" >&2
  exit 3
fi

status="$(fm_get "$tf" status)"
[ "$status" = merging ] || orchid_die "task $id is not in merging (status: $status)"

base_sha="$(fm_get "$tf" base_sha)"
candidate_sha="$(fm_get "$tf" candidate_sha)"
[ -n "$base_sha" ] && [ -n "$candidate_sha" ] || orchid_die "task $id missing base_sha/candidate_sha"

task_branch="$(fm_get "$tf" branch)"
[ -n "$task_branch" ] || orchid_die "task $id has no branch recorded"

integ="$(config_get "$repo" integration_branch orchid/integration)"
git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1 \
  || orchid_die "integration branch '$integ' does not exist"

# --- before_merge kernel gate (v1-m3 Task 6; exit-code registry: 2 unknown
# verb, 3 illegal transition, 5 rebase_rereview_required, 12 input_overflow,
# 13 plugin validation failure, 14 no eligible engine, 15 hook handler
# failure -- new here) -----------------------------------------------------
# The ONE hook point the kernel itself enforces (PROTOCOL.md's other four
# hook points are enforced only by the orchestrator actually invoking them,
# never here). Required-ness and the binding itself are RE-DERIVED from
# hooks_for + whatever has actually reconciled to disk by gate time --
# nothing about a binding is ever stashed on a manifest or the task's own
# frontmatter (Task 5's reviewer note). An `optional` entry NEVER gates,
# envelope or not; only a `:required` entry can refuse this verb, and every
# required entry must pass on its own -- one entry's ok envelope never
# satisfies a different required entry.
#
# Binding resolution: a filed hook envelope carries no field naming which
# binding entry produced it, so a required entry <id> is satisfied only by
# an envelope whose OWN `.engine` matches <id>'s qualified manifest id --
# resolved via resolve_engine_qualified_id (resolve_engine_dir + that dir's
# own `id=`), NEVER assumed to be the literal "orchid/<id>" string: that
# shape only holds for first-party plugins, and hardcoding it here would
# make any `:required`-bound third-party engine (a real "acme/<name>"
# manifest id) permanently unsatisfiable -- a hard merge deadlock for
# exactly the kind of plugin this milestone's third-party lifecycle ships.
# The "orchid/<id>" fallback inside resolve_engine_qualified_id only fires
# when <id> cannot be resolved to an installed dir at all, which keeps
# older/simpler fixtures working without assuming every real engine follows
# that shape. This is the documented v1 contract for disambiguating
# multiple required bindings on the same point -- not an incidental detail,
# the deliberate resolution.
#
# attempt mirrors the reviewer gate's own formula (attempts+1, libexec/
# orchid-task's reviewing->arbitrating gate); the base filename AND its
# `.N.json` collision siblings (a relaunch landing a second accepted
# envelope for the same slot) are both considered, same as that gate.
hook_bindings="$(hooks_for "$repo" before_merge)"
if [ -n "$hook_bindings" ]; then
  gate_attempt=$(( $(fm_get "$tf" attempts) + 1 ))
  while IFS= read -r hb_line; do
    [ -n "$hb_line" ] || continue
    hb_id="$(cut -f1 <<< "$hb_line")"; hb_req="$(cut -f2 <<< "$hb_line")"
    [ "$hb_req" = required ] || continue
    hb_qid="$(resolve_engine_qualified_id "$hb_id")"
    hb_ok=0
    for hb_ef in "$state/reviews/$id-a$gate_attempt-hook-before_merge"*.json; do
      [ -e "$hb_ef" ] || continue
      [ "$(envelope_field "$hb_ef" '.status // empty' 2>/dev/null || true)" = ok ] || continue
      [ "$(envelope_field "$hb_ef" '.candidate_sha // empty' 2>/dev/null || true)" = "$candidate_sha" ] || continue
      [ "$(envelope_field "$hb_ef" '.engine // empty' 2>/dev/null || true)" = "$hb_qid" ] || continue
      hb_ok=1; break
    done
    if [ "$hb_ok" -ne 1 ]; then
      echo "merge blocked: required before_merge hook '$hb_id' has no ok envelope for this candidate" >&2
      exit 15
    fi
  done <<< "$hook_bindings"
fi

# Whole verb runs under the run lock (serializes concurrent merges); trap is
# installed only AFTER a successful acquire, mirroring orchid-run's pattern.
lock_acquire "$repo" >/dev/null || orchid_die "cannot acquire lock"
wt=""
out_tmp=""
merge_cleanup() {
  # Note: this is an EXIT trap — it does not run on SIGKILL (-9). An
  # operator (or an OOM-killer) that SIGKILLs the orchestrator process while
  # this script is mid-merge leaves the temp worktree directory AND its
  # `git worktree` registration behind: nothing can run to clean either up.
  # The registration is reclaimed the same way a normal stale worktree would
  # be — `git worktree prune` (here, and available to an operator directly,
  # or via `orchid doctor` once it grows a check for this) — and the leaked
  # directory under $TMPDIR is ordinary temp-file litter.
  if [ -n "$wt" ]; then
    git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
    rm -rf "$wt" 2>/dev/null || true
    git -C "$repo" worktree prune >/dev/null 2>&1 || true
  fi
  # Merge-evidence temp file: guard against leaking it on a mid-path failure
  # between its creation and its normal removal below.
  if [ -n "$out_tmp" ]; then
    rm -f "$out_tmp" 2>/dev/null || true
  fi
  lock_release "$repo"
}
trap merge_cleanup EXIT

integ_head="$(git -C "$repo" rev-parse "refs/heads/$integ")"

if [ "$integ_head" != "$base_sha" ]; then
  # Stale base: rebase the task branch onto integ HEAD. On a clean rebase
  # this always mints a new commit SHA (new parent), which is exactly what
  # makes the old candidate's reviews detectably stale (INV-07).
  #
  # Where the rebase runs depends on where task_branch is (or isn't)
  # currently checked out:
  #   1. Frontmatter records a `worktree`, and task_branch is ALREADY checked
  #      out there (a live implementer checkout, verified directly via `git
  #      -C <wt> rev-parse --abbrev-ref HEAD` — not merge's own bookkeeping):
  #      rebase IN PLACE in that worktree. No temp worktree is created, so
  #      there is no "branch already checked out" conflict to hit, and the
  #      worktree is never at risk from merge_cleanup's `wt` teardown — this
  #      path never assigns to `wt`, only to `rebase_wt`.
  #   2. task_branch is not checked out anywhere: unchanged — mint a temp
  #      worktree (`wt`) of that branch, rebase there, discard it after.
  #   3. task_branch IS checked out somewhere, but that somewhere is not the
  #      recorded frontmatter worktree (or none was recorded): the temp
  #      `worktree add` below fails and the explicit-die-with-path branch
  #      fires, naming the actual checkout path. Full detached-rebase fix
  #      (rebasing without ever needing the branch checked out at all) is
  #      tracked for B2 beyond this; this only makes today's failure clear.
  fm_worktree="$(fm_get "$tf" worktree)"
  rebase_wt=""
  if [ -n "$fm_worktree" ] && [ -e "$fm_worktree" ]; then
    fm_wt_branch="$(git -C "$fm_worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ "$fm_wt_branch" = "$task_branch" ] && rebase_wt="$fm_worktree"
  fi

  if [ -n "$rebase_wt" ]; then
    if ! git -C "$rebase_wt" rebase "$integ_head" >/dev/null 2>&1; then
      git -C "$rebase_wt" rebase --abort >/dev/null 2>&1 || true
      "$ORCHID_ROOT/bin/orchid" task advance "$id" rework --reason "rebase conflict"
      exit 1
    fi
    new_candidate="$(git -C "$rebase_wt" rev-parse HEAD)"
  else
    wt="$(mktemp -d "${TMPDIR:-/tmp}/orchid-merge.XXXXXX")"
    if ! wt_err="$(git -C "$repo" worktree add -q "$wt" "$task_branch" 2>&1)"; then
      # Make the failure diagnosable: the common cause is the branch already
      # being checked out elsewhere (e.g. the operator's own working copy), in
      # which case name both the branch and the exact checkout path (parsed
      # from `git worktree list`) instead of a bare "cannot create" message.
      if printf '%s' "$wt_err" | grep -qiE "already (checked out|used by worktree)"; then
        # git's own message conventions differ by version ("already checked
        # out at '<path>'" vs "already used by worktree at '<path>'") but both
        # end in "at '<path>'" — extract directly; fall back to parsing
        # `git worktree list` if that ever fails to match.
        checkout_path="$(printf '%s' "$wt_err" | sed -nE "s/.*at '(.*)'.*/\1/p" | head -n1)"
        [ -n "$checkout_path" ] || checkout_path="$(git -C "$repo" worktree list 2>/dev/null \
          | awk -v b="[$task_branch]" '$NF == b { print $1; exit }')"
        orchid_die "cannot create temp worktree for $task_branch: branch is already checked out at '${checkout_path:-<see: git worktree list>}'"
      fi
      orchid_die "cannot create temp worktree for $task_branch: $wt_err"
    fi
    if ! git -C "$wt" rebase "$integ_head" >/dev/null 2>&1; then
      git -C "$wt" rebase --abort >/dev/null 2>&1 || true
      "$ORCHID_ROOT/bin/orchid" task advance "$id" rework --reason "rebase conflict"
      exit 1
    fi
    new_candidate="$(git -C "$wt" rev-parse HEAD)"
  fi
  # Edge case: if this rebase turns out to be a no-op — the candidate's
  # commits were already reachable from integ_head (e.g. an empty replay) —
  # `new_candidate` can end up EQUAL to the pre-rebase candidate_sha. The
  # "always mints a new SHA" framing above is the common case, not a
  # guarantee. Safety does not depend on the SHA actually changing here: the
  # unconditional `rm -f` two lines down invalidates prior evidence
  # regardless, so the INV-11 sha-binding gate still forces a re-verify even
  # when the candidate identity happened not to move.
  "$ORCHID_ROOT/bin/orchid" task set "$id" base_sha "$integ_head"
  "$ORCHID_ROOT/bin/orchid" task set "$id" candidate_sha "$new_candidate"
  # Rebase minted a new candidate SHA, so any prior verify/merge evidence is
  # now evidence about a candidate that no longer exists. merge is the one
  # actor that invalidates it this way, so merge must delete it here — this
  # makes INV-07 kernel-enforced via the INV-11 gate (no log => advance to
  # reviewing dies, forcing an unconditional re-verify).
  rm -f "$state/reviews/$id-verify.log" "$state/reviews/$id-merge.log"
  # T010, the same invalidation applied to the OPERATOR HAND-OFF. An
  # acknowledgement records that a human performed this candidate's
  # execution-requiring mechanical steps -- a lint fix, a checksum re-pin, a
  # mode bit. The rebase just minted a DIFFERENT candidate, so that
  # acknowledgement is a statement about a tree that no longer exists and
  # must not be inherited by the rebased one, exactly as the verify evidence
  # above is not. Without this the sha binding alone would already refuse it
  # (handoff_ack no longer equals candidate_sha), and this call is the
  # belt-and-braces half: it makes the invalidation an explicit, journalled
  # event an operator can see, rather than a silent mismatch. Routed through
  # the verb, never fm_set: `handoff_ack` has exactly one writer, and the
  # call is a no-op that journals nothing when no hand-off was recorded.
  "$ORCHID_ROOT/bin/orchid" task handoff "$id" --clear \
    --reason "rebase minted candidate $new_candidate; a hand-off performed against $candidate_sha does not carry over (INV-07)" >/dev/null
  # Normative per kernel.md's decision-journal table: the rebase-reset is a
  # judgment-bearing event (evidence invalidated, re-review now mandatory) —
  # journal it as `rebase_review` so the decision trail shows why re-verify
  # was forced, not just that it was.
  ORCHID_ACTOR="${ORCHID_ACTOR:-orchestrator}" "$ORCHID_ROOT/bin/orchid" journal add --task "$id" --kind rebase_review \
    "base $base_sha -> $integ_head, candidate $candidate_sha -> $new_candidate; evidence invalidated"
  "$ORCHID_ROOT/bin/orchid" task advance "$id" testing
  echo "rebase_rereview_required $id: base $base_sha -> $integ_head, candidate $candidate_sha -> $new_candidate"
  exit 5
fi

# Base current: merge the candidate in a detached temp worktree — never the
# user's checkout — then run the verification suite there before touching
# the integration ref.
wt="$(mktemp -d "${TMPDIR:-/tmp}/orchid-merge.XXXXXX")"
git -C "$repo" worktree add -q --detach "$wt" "$integ_head" >/dev/null 2>&1 \
  || orchid_die "cannot create temp worktree at $integ_head"

if ! git -C "$wt" merge --no-ff -q -m "orchid: merge $id" "$candidate_sha" >/dev/null 2>&1; then
  git -C "$wt" merge --abort >/dev/null 2>&1 || true
  "$ORCHID_ROOT/bin/orchid" task advance "$id" rework --reason "merge conflict"
  exit 1
fi
merged_sha="$(git -C "$wt" rev-parse HEAD)"

# Command source: task frontmatter first, config fallback second — same
# resolution order as `orchid verify`.
cmd="$(fm_get "$tf" verification_commands)"
[ -n "$cmd" ] || cmd="$(config_get "$repo" verify)"
[ -n "$cmd" ] || orchid_die "no verification_commands on task $id and no config 'verify' set — nothing to run"

mkdir -p "$state/reviews"
log="$state/reviews/$id-merge.log"
out_tmp="$(mktemp "${TMPDIR:-/tmp}/orchid-merge-verify.XXXXXX")"

rc=0
( cd "$wt" && bash -c "$cmd" ) >"$out_tmp" 2>&1 || rc=$?

{
  echo "date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "sha: $merged_sha"
  echo "cwd: $wt"
  echo "command: $cmd"
  echo "---"
  cat "$out_tmp"
  echo "exit: $rc"
} | atomic_write "$log"
rm -f "$out_tmp"

if [ "$rc" -eq 0 ]; then
  # Compare-and-swap: `update-ref <ref> <new> <old>` only succeeds if <ref>
  # STILL points at <old> (integ_head, read at the top of this script). If a
  # concurrent merge landed on integration in the window between that read
  # and this write, the CAS refuses — the task stays in `merging` (safe to
  # retry) rather than silently clobbering the concurrent commit or
  # reporting a success that didn't happen.
  if ! git -C "$repo" update-ref "refs/heads/$integ" "$merged_sha" "$integ_head"; then
    ORCHID_ACTOR="${ORCHID_ACTOR:-orchestrator}" "$ORCHID_ROOT/bin/orchid" journal add --task "$id" --kind intervention \
      "merge CAS failed: update-ref refs/heads/$integ expected $integ_head but it moved concurrently; task remains in merging for retry"
    orchid_die "update-ref CAS failed: integration branch '$integ' changed concurrently (expected $integ_head) — retry orchid merge $id"
  fi
  "$ORCHID_ROOT/bin/orchid" task advance "$id" "done"
  echo "merged $id: $integ -> $merged_sha"
  exit 0
fi

"$ORCHID_ROOT/bin/orchid" task advance "$id" rework --reason "validation_failed: see reviews/$id-merge.log"
exit 1

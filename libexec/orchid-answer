#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"
# v1-m4 Task 7 (inbox hardening): needed for _manifest_split_csv, the same
# bash-3.2-safe trimmed-CSV-split helper every other comma-list config value
# in this codebase already shares (role.<id>=, capabilities=, hook.<point>=,
# ...) -- answer_allowlist below reuses it rather than inventing a second
# split idiom.
source "$ORCHID_ROOT/lib/manifest.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"; rt="$(orchid_runtime "$repo")"
verb_lock_guard "$repo"

qid=""; choice=""; nonce_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --nonce)
      [ -n "${2:-}" ] || orchid_die "--nonce requires a value"
      nonce_arg="$2"; shift 2 ;;
    -*) orchid_die "usage: orchid answer <qid> <choice> [--nonce <n>]" ;;
    *)
      if [ -z "$qid" ]; then qid="$1"
      elif [ -z "$choice" ]; then choice="$1"
      else orchid_die "usage: orchid answer <qid> <choice> [--nonce <n>]"
      fi
      shift ;;
  esac
done
[ -n "$qid" ] && [ -n "$choice" ] || orchid_die "usage: orchid answer <qid> <choice> [--nonce <n>]"

qf="$rt/answers/$qid.question"
[ -f "$qf" ] || orchid_die "unknown question $qid (no .question file — orchid notify never minted it, or runtime was wiped)"

# Recover task/nonce from the .question file (libexec/orchid-notify's own
# format: "task: <id|none>" then "nonce: <value>", an optional
# "choices: <csv>" line, then the free-text body).
# Read individually rather than assuming a fixed line count so a
# pre-v1-m4-Task-7 .question file (no nonce line at all -- shouldn't exist
# in practice since notify always mints one now, but a stale runtime dir
# from before this change is exactly that) degrades to "no nonce on this
# question" rather than misreading the body as a nonce.
task_line="$(head -n1 "$qf")"; task_id="${task_line#task: }"
[ "$task_id" = "none" ] && task_id=""
qnonce="$(grep -m1 '^nonce: ' "$qf" 2>/dev/null | sed 's/^nonce: //')"
# Declared choice set: a `choices: a,b,c` line (CSV) written by `orchid
# notify --choice ...` between the nonce line and the free-text body. Most
# questions declare none — the guard below then never fires and free text
# stays accepted, so nothing minted before choice sets changes behavior.
qchoices="$(grep -m1 '^choices: ' "$qf" 2>/dev/null | sed 's/^choices: //')" || qchoices=""
# A scraped line that could not have been minted by `--choice` (mint-side
# refuses whitespace in a value) is body prose that merely starts with
# "choices: " — ignore it rather than gate free text on a sentence.
case "$qchoices" in *[[:space:]]*) qchoices="" ;; esac

# -- Expiry (answer_expiry_s, default 86400) --------------------------------
# Applies UNCONDITIONALLY (local terminal and remote sender alike) — the
# .question file's own mtime is the only signal on disk for "how long has
# this sat unanswered," read through lib/common.sh's `file_mtime` — the one
# portable GNU/BSD mtime probe this codebase has, shared with lock_acquire
# and libexec/orchid-jobs' stall/gc checks. Its default fallback of 0 is what
# the "cannot date it" branch below keys on.
#
# Expired -> die AND leave a journal note (unfenced, same as every other write
# this un-fenced verb makes — see the un-fenced rationale below) so the expiry
# is visible in the run's history, not just a silent refusal on stderr.
qf_mtime="$(file_mtime "$qf")"
expiry_s="$(config_get "$repo" answer_expiry_s 86400)"
now="$(date -u +%s)"
# Review fix (Minor #10): if BOTH `stat` variants fail, `qf_mtime` is 0 --
# the age can't be determined at all. Failing OPEN here (treating "unknown
# age" as "not expired," which the original `[ "$qf_mtime" -gt 0 ] && ...`
# guard did by simply skipping the whole check) would let an unbounded-age
# question be answered regardless of answer_expiry_s. Fail CLOSED instead:
# refuse plainly, same journal-then-die shape as a genuine expiry below.
if [ "$qf_mtime" -le 0 ]; then
  if [ -n "$task_id" ]; then
    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --unfenced --task "$task_id" --kind blocker_expired "$qid: refused (unable to determine question age -- stat failed on its .question file)" || true
  else
    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --unfenced --kind blocker_expired "$qid: refused (unable to determine question age -- stat failed on its .question file)" || true
  fi
  orchid_die "cannot determine $qid's age (stat failed on its .question file) -- refusing to answer rather than skip the expiry check"
fi
if [ $(( now - qf_mtime )) -gt "$expiry_s" ]; then
  if [ -n "$task_id" ]; then
    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --unfenced --task "$task_id" --kind blocker_expired "$qid: expired (unanswered > ${expiry_s}s)" || true
  else
    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --unfenced --kind blocker_expired "$qid: expired (unanswered > ${expiry_s}s)" || true
  fi
  orchid_die "$qid has expired (unanswered for more than ${expiry_s}s — see answer_expiry_s)"
fi

# -- Nonce + allowlist hardening ---------------------------------------------
# Review finding (round 2, Critical): gating this purely on ORCHID_ANSWER_
# SENDER being set let ANY caller bypass every check just by omitting that
# env var — a remote caller (or an injected instruction) doesn't need to
# forge anything; it just has to not set it. The gate is now the REPO'S
# OWN CONFIG, not a self-asserted env var:
#
#   answer_allowlist NOT configured -> no remote answer path exists at all
#   (no channel/skill was ever set up to attack) -> current lenient local
#   behavior: no nonce, no allowlist check, for anyone.
#
#   answer_allowlist configured -> hardening is ON, unconditionally, for
#   EVERY caller:
#     - --nonce is ALWAYS required and must match the question's own
#       recorded nonce, whether or not ORCHID_ANSWER_SENDER is set. This is
#       what closes the bypass: omitting the sender var no longer skips
#       anything, since the nonce check does not look at that var at all.
#     - ORCHID_ANSWER_SENDER, when set, ADDITIONALLY requires that identity
#       to appear in answer_allowlist.
#     - ORCHID_ANSWER_SENDER, when unset, is treated as "local-with-nonce":
#       the operator is trusted to be local precisely because they can only
#       have obtained the nonce from this machine's own BLOCKERS.md/
#       .question file (both now carry it — libexec/orchid-notify) or from
#       the outbound channel message itself; there is no sender identity to
#       check against the allowlist in that case, so only the nonce gates.
allowlist="$(config_get "$repo" answer_allowlist "")"
if [ -n "$allowlist" ]; then
  [ -n "$qnonce" ] || orchid_die "$qid has no nonce on record — refusing (stale question file predates nonce hardening; answer_allowlist is configured)"
  [ -n "$nonce_arg" ] || orchid_die "--nonce is required (answer_allowlist is configured)"
  [ "$nonce_arg" = "$qnonce" ] || orchid_die "--nonce does not match $qid's recorded nonce — refusing"

  if [ -n "${ORCHID_ANSWER_SENDER:-}" ]; then
    allowed=0
    while IFS= read -r entry; do
      [ "$entry" = "$ORCHID_ANSWER_SENDER" ] && allowed=1
    done < <(_manifest_split_csv "$allowlist")
    [ "$allowed" -eq 1 ] || orchid_die "sender '$ORCHID_ANSWER_SENDER' is not in answer_allowlist — refusing (set answer_allowlist to permit it)"
  fi
fi

# -- Declared choice set -----------------------------------------------------
# Lesson L028 in the answer medium: a refusal names what WOULD be accepted.
# When the question declared a set, a value outside it is refused — and the
# refusal lists the valid choices, so a typo ("aprove") is caught here
# instead of being recorded silently as if it were a decision. Questions
# with no declared set keep today's free-text contract in full.
if [ -n "$qchoices" ]; then
  choice_ok=0
  while IFS= read -r valid_choice; do
    if [ "$valid_choice" = "$choice" ]; then choice_ok=1; fi
  done < <(_manifest_split_csv "$qchoices")
  if [ "$choice_ok" -ne 1 ]; then
    orchid_die "'$choice' is not among $qid's declared choices — valid: ${qchoices//,/ | }"
  fi
fi

af="$rt/answers/$qid.answer"
# v0 TOCTOU: this existence check and the write below are not atomic together,
# so two concurrent `answer` calls for the same qid can both pass this check.
if [ -f "$af" ]; then
  prev="$(cat "$af")"
  if [ "$prev" = "$choice" ]; then
    echo "already answered"
    exit 0
  fi
  orchid_die "$qid answered differently (already '$prev', refusing '$choice')"
fi

# v0b2: deliberately UN-FENCED — the one other deliberate INV-02 exception
# in the verb set besides `jobs gc`, for a different reason than gc's.
#
# gc's exception (see libexec/orchid-jobs) holds because gc only ever
# touches runtime/ litter, nothing durable, so there is nothing for the
# epoch fence to protect. `answer` is not that: the journal append below
# IS durable state. The exception here is deliberate anyway, because of
# *when* an answer arrives: per docs/specs/operations.md's remote-interaction
# seam, `orchid answer <qid> <choice>` is invoked by an operator/channel/
# AgentSkill from OUTSIDE any run turn — there is often no active epoch at
# all (no run currently started/resumed), and even when one exists, the
# human answering has no reason to know or carry it. Gating this verb on
# `ORCHID_EPOCH` would make a blocker's answer unrecordable for as long as
# no run happens to be active, which defeats the entire point of an async
# inbox: the answer must be capturable the moment it arrives, then merely
# consumed by the next tick. So: the runtime-only `.answer` file write is
# un-fenced exactly like gc's runtime writes, AND the durable journal append
# below is *also* un-fenced (never gated on epoch) — but it is never skipped
# or made non-durable; it goes through `orchid journal add --unfenced`,
# which stamps the entry `e-` (epoch-unknown) instead of skipping the write.
mkdir -p "$rt/answers"
printf '%s\n' "$choice" | atomic_write "$af"

# Recover the originating task from the question file's first line
# ("task: <id|none>", written by `orchid notify`) so the resolution lands
# in the same task-scoped journal view as the original blocker.
if [ -n "$task_id" ]; then
  ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --unfenced --task "$task_id" --kind blocker_resolved "$qid: $choice"
else
  ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --unfenced --kind blocker_resolved "$qid: $choice"
fi

echo "$qid: $choice"

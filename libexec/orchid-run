#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/lessons.sh"; source "$ORCHID_ROOT/lib/drive.sh"
# plancheck.sh after lessons.sh, whose _lessons_journal_start_date it uses:
# `advance` is one of the two verbs that can take a run OUT of planning, and
# T021's carry-forward cross-check gates both (see the advance arm below).
source "$ORCHID_ROOT/lib/plancheck.sh"
repo="${ORCHID_REPO:-$PWD}"; rt="$(orchid_runtime "$repo")"; state="$(orchid_state "$repo")"

# run_status transition table (kernel.md's normative table, v0b2 ownership
# verbs): every edge below is legal for `run advance`; anything else,
# including reversed/skipped edges, is refused with exit 3 — the same
# illegal-transition contract `orchid task advance` uses.
#
# ->complete is deliberately ABSENT from this table, full stop — not just
# reachable-only-from-accepting. `accepting:complete` used to be a legal
# advance-table edge, which made `run advance complete --reason x` a
# complete bypass of the acceptance evidence gate (no --evidence, no
# reviews/acceptance.log write, just a bare state flip). `run advance`
# below now special-cases `$to = complete` and refuses it unconditionally,
# from ANY state, before this table is even consulted. `orchid run accept
# --reason --evidence` is the ONLY path to `complete`; it sets run_status
# directly with its own from=accepting + evidence-file guard and never
# calls legal_run, so it is untouched by this table either way.
#
# blocked:running is the recoverable-block edge: kernel.md requires "no
# hand-editing, ever", so a run parked in `blocked` must be resumable by an
# operator through a legal verb call, not by hand-editing roadmap.md.
# `run advance` already hard-requires --reason on every edge (INV-08, see
# below), so this is a fenced, journaled `intervention` like any other
# operator judgment call.
legal_run() { case "$1:$2" in
  planning:running|running:accepting|running:blocked|\
  accepting:running|blocked:running) return 0 ;;
  *:blocked) return 0 ;;
  *) return 1 ;;
esac; }

sub="${1:-}"; shift || true
case "$sub" in
  start|resume)
    # v0b2: both start and resume require initialized state. resume exists to
    # recover an existing run after a crash/restart, not to bootstrap one —
    # letting it proceed against an uninitialized repo would mint a fresh
    # epoch/lease for state that was never created (same guard as start).
    [ -d "$(orchid_state "$repo")/tasks" ] || [ -f "$(orchid_state "$repo")/roadmap.md" ] || \
      orchid_die "not initialized — run orchid init"
    lock_msg="$(lock_acquire "$repo")" || orchid_die "cannot acquire lock"
    trap 'lock_release "$repo"' EXIT
    e=$(( $(epoch_current "$repo") + 1 ))
    echo "$e" | atomic_write "$rt/epoch"
    jq -n --arg e "$e" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{epoch:($e|tonumber), refreshed_at:$t}' | atomic_write "$rt/lease.json"
    case "$lock_msg" in
      *lock-broken*)
        ORCHID_EPOCH="$e" "$ORCHID_ROOT/bin/orchid" journal add --kind intervention \
          "stale lock broken: $lock_msg" ;;
    esac
    echo "epoch: $e"
    ;;
  refresh-lease)
    e="$(epoch_current "$repo")"
    jq -n --arg e "$e" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{epoch:($e|tonumber), refreshed_at:$t}' | atomic_write "$rt/lease.json"
    ;;
  release-lease)
    # v1-m4: clean-session-exit affordance (the live-run incident this
    # closes: after a session's own FINAL tick, `run new`/the pump were both
    # blocked for up to pump_stale_s by that same session's own still-fresh
    # lease — there was no way to signal "I am genuinely done", short of an
    # operator hand-backdating lease.json). PROTOCOL.md's COMPLETION ends
    # with this call, right after `run accept`. Writes `released: true` into
    # lease.json alongside the usual epoch/refreshed_at shape; both `run
    # new`'s own freshness guard (below) and runners/orchid-pump's lease-
    # staleness check treat a released lease as immediately stale,
    # regardless of how recently refreshed_at itself was stamped.
    #
    # Epoch-fenced, unlike refresh-lease above: a STALE session (one whose
    # epoch a newer `run resume`/`start` has already superseded — e.g. a
    # crashed session's own delayed cleanup call finally running) must never
    # be able to mark the CURRENT owner's lease released out from under it.
    epoch_require "$repo"; export ORCHID_EPOCH
    e="$(epoch_current "$repo")"
    jq -n --arg e "$e" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{epoch:($e|tonumber), refreshed_at:$t, released:true}' | atomic_write "$rt/lease.json"
    echo "lease released"
    ;;
  boundary)
    # v1.1 Track 2: the JUDGMENT BOUNDARY record -- the single, named place
    # where "deterministic policy deliberately refused to decide this" is
    # written down. `runners/orchid-drive` is its only routine writer, and it
    # writes it through THIS verb rather than touching the file, so the record
    # is fenced, journaled and single-writer-owned exactly like every other
    # cross-process piece of `.orchid/` state (kernel.md, "no hand-editing,
    # ever"). `runners/orchid-pump` is its only routine reader, and it reads
    # it through `show` for the same reason.
    #
    # The record lives under runtime/ rather than in the durable tree on
    # purpose: it is a statement about THIS pass of THIS run's local
    # coordination between the driver and whatever wakes next, not a
    # historical fact worth committing. Every boundary is journaled when it is
    # set, so the durable record of "we stopped here, and why" survives
    # regardless.
    #
    # Schema (schema: 1): {schema, kind, task, reason, epoch, at}. `kind` is
    # one of the kernel-owned set in lib/drive.sh (planning, blocked-task,
    # review-evidence, review-conflict, hook-failure, worktree-conflict,
    # operator-handoff, task-prerequisite, run-complete, operator-decision) --
    # anything else is refused, so a boundary can never be minted for a
    # condition this kernel has no defined meaning for.
    #
    # Exit codes: `show` exits 16 (the dedicated judgment-boundary code) when
    # a boundary IS recorded, and 0 when none is -- so "is a decision
    # outstanding in this run?" is answerable from an exit status alone, with
    # no output parsing anywhere. That is the question it answers, and it is
    # not "can this run make progress": one task's boundary parks that task,
    # never the roadmap, and `orchid drive` keeps walking and advancing every
    # other task while this record stands.
    bsub="${1:-}"; shift || true
    bfile="$rt/boundary.json"
    case "$bsub" in
      show)
        if [ -f "$bfile" ] && jq -e '.schema == 1' "$bfile" >/dev/null 2>&1; then
          cat "$bfile"
          exit 16
        fi
        echo "boundary: none"
        exit 0
        ;;
      set)
        verb_lock_guard "$repo"
        epoch_require "$repo"; export ORCHID_EPOCH
        bkind=""; btask=""; breason=""
        while [ $# -gt 0 ]; do case "$1" in
          --kind)
            [ -n "${2:-}" ] || orchid_die "--kind requires a value"
            bkind="$2"; shift 2 ;;
          --task)
            [ -n "${2:-}" ] || orchid_die "--task requires a value"
            btask="$2"; shift 2 ;;
          --reason)
            [ -n "${2:-}" ] || orchid_die "--reason requires a value"
            breason="$2"; shift 2 ;;
          *) shift ;;
        esac; done
        [ -n "$bkind" ] || orchid_die "usage: orchid run boundary set --kind <kind> [--task <id>] --reason \"...\""
        drive_boundary_kind_valid "$bkind" || orchid_die "unknown boundary kind '$bkind' (one of: planning, blocked-task, review-evidence, review-conflict, hook-failure, worktree-conflict, operator-handoff, task-prerequisite, run-complete, operator-decision)"
        [ -n "$breason" ] || orchid_die "run boundary set requires --reason (INV-08)"
        if [ -n "$btask" ] && [ ! -f "$state/tasks/$btask.md" ]; then
          orchid_die "no task $btask"
        fi
        # Idempotent by content: the driver re-derives the same boundary on
        # every pass for as long as the underlying condition holds, so an
        # unchanged record must not re-journal it once per pass.
        bprev_kind=""; bprev_task=""; bprev_reason=""
        if [ -f "$bfile" ]; then
          bprev_kind="$(jq -r '.kind // ""' "$bfile" 2>/dev/null || echo "")"
          bprev_task="$(jq -r '.task // ""' "$bfile" 2>/dev/null || echo "")"
          bprev_reason="$(jq -r '.reason // ""' "$bfile" 2>/dev/null || echo "")"
        fi
        if [ "$bprev_kind" = "$bkind" ] && [ "$bprev_task" = "$btask" ] && [ "$bprev_reason" = "$breason" ]; then
          echo "boundary unchanged: $bkind${btask:+ ($btask)}"
          exit 0
        fi
        jq -n --arg k "$bkind" --arg t "$btask" --arg r "$breason" \
          --arg e "$(epoch_current "$repo")" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          '{schema:1, kind:$k, task:$t, reason:$r, epoch:($e|tonumber? // 0), at:$at}' \
          | atomic_write "$bfile"
        bjargs=(--kind blocker)
        [ -z "$btask" ] || bjargs=(--task "$btask" --kind blocker)
        ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add "${bjargs[@]}" \
          "judgment boundary [$bkind]: $breason"
        echo "boundary: $bkind${btask:+ ($btask)}"
        ;;
      clear)
        verb_lock_guard "$repo"
        epoch_require "$repo"; export ORCHID_EPOCH
        breason=""
        while [ $# -gt 0 ]; do case "$1" in
          --reason)
            [ -n "${2:-}" ] || orchid_die "--reason requires a value"
            breason="$2"; shift 2 ;;
          *) shift ;;
        esac; done
        [ -n "$breason" ] || orchid_die "run boundary clear requires --reason (INV-08)"
        if [ ! -f "$bfile" ]; then
          echo "boundary: none"
          exit 0
        fi
        bprev_kind="$(jq -r '.kind // ""' "$bfile" 2>/dev/null || echo "")"
        bprev_task="$(jq -r '.task // ""' "$bfile" 2>/dev/null || echo "")"
        rm -f "$bfile"
        bjargs=(--kind intervention)
        [ -z "$bprev_task" ] || bjargs=(--task "$bprev_task" --kind intervention)
        ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add "${bjargs[@]}" \
          "judgment boundary cleared [${bprev_kind:-unknown}]: $breason"
        echo "boundary cleared: ${bprev_kind:-unknown}"
        ;;
      *) orchid_die "usage: orchid run boundary set|clear|show" ;;
    esac
    ;;
  advance)
    verb_lock_guard "$repo"
    epoch_require "$repo"; export ORCHID_EPOCH
    to="${1:-}"; shift || true
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$to" ] || orchid_die "usage: orchid run advance <status> --reason \"...\""
    [ -n "$reason" ] || orchid_die "run advance requires --reason (INV-08)"

    # Evidence-gate bypass, closed: `advance` may never grant `complete`,
    # from any run_status, regardless of what legal_run's table says —
    # refused before the roadmap is even read, so nothing is mutated.
    [ "$to" = complete ] && { echo "orchid: use: orchid run accept --evidence" >&2; exit 3; }

    roadmap="$state/roadmap.md"
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"
    from="$(fm_get "$roadmap" run_status)"
    legal_run "$from" "$to" || { echo "orchid: illegal run_status $from -> $to" >&2; exit 3; }

    # T021: LEAVING PLANNING is what the carry-forward cross-check gates, and
    # `plan apply` is not the only verb that does it. Gating apply alone left
    # a bypass that needed no forgery and no flag: `run advance running`
    # first, THEN `plan apply` -- the plan commits with the refusal already
    # scoped out, and every carried-forward item leaves planning with no
    # per-item record at all. A gate that is skipped by doing the same two
    # things in the other order is not enforcing anything, so the check moves
    # to the property it actually means: no run_status edge out of `planning`
    # while a carried item is neither covered by a task nor deferred.
    #
    # `from = planning`, not `to = running`, because `planning -> blocked` is
    # legal too and `blocked -> running` after it would reach the same place
    # in two hops -- and once out of planning, `orchid plan defer` is closed,
    # so the item could never be recorded at all. Gating the EXIT edge closes
    # both hops at the one point where both remedies are still open: the run
    # is still in planning here, so the operator can cover the item with a
    # task or `orchid plan defer` it, exactly as at a refused `plan apply`.
    # That is why this is not the dead end the brief rules out.
    #
    # Read-only and placed before the journal write, so a refusal mutates
    # nothing. Every mid-run edge (running->accepting, blocked->running,
    # accepting->running) is deliberately untouched: those are not this
    # gate's question, and re-litigating a plan there could strand a live
    # run over a task file that has since been renamed.
    if [ "$from" = planning ]; then
      crosscheck_rc=0
      plancheck_report "$state" || crosscheck_rc=$?
      if [ "$crosscheck_rc" -ne 0 ]; then
        echo "orchid: run advance $from -> $to refused — a carried-forward item may not leave planning unconsidered; cover it with a task or record the decision (orchid plan defer <id> --reason \"...\"), then re-run" >&2
        exit "$crosscheck_rc"
      fi
    fi

    # `->complete` is the acceptance gate closing; every other edge is a
    # plain operator intervention (kernel.md's journal-kind table).
    kind=intervention
    [ "$to" = complete ] && kind=acceptance
    # Journal first (INV-08): the reason is recorded before the state
    # change it justifies.
    ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind "$kind" "run_status $from -> $to: $reason"
    fm_set "$roadmap" run_status "$to"
    echo "run_status: $from -> $to"
    ;;
  accept)
    verb_lock_guard "$repo"
    epoch_require "$repo"; export ORCHID_EPOCH
    reason=""; evidence=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      --evidence)
        [ -n "${2:-}" ] || orchid_die "--evidence requires a value"
        evidence="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$reason" ] || orchid_die "run accept requires --reason (INV-08)"
    [ -n "$evidence" ] || orchid_die "run accept requires --evidence <path>"
    [ -f "$evidence" ] || orchid_die "no such evidence file: $evidence"

    roadmap="$state/roadmap.md"
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"
    from="$(fm_get "$roadmap" run_status)"
    run_id="$(fm_get "$roadmap" run_id)"; [ -n "$run_id" ] || run_id='r-001'

    # v1-m4 Task 1 fix wave (review Important): a completed run's record
    # must never be uncommitted-only, but "state already set locally;
    # commit retryable" has to be REAL, not just worded that way -- the
    # naive "just re-run orchid run accept" is false on its own: run_status
    # is already `complete` by the time orchid_commit_durable is called
    # below, and the `from = accepting` guard a few lines down would
    # otherwise refuse a bare retry outright. So `from = complete` is its
    # OWN branch here, handling exactly that retry: it never re-runs the
    # state transition or evidence copy (already done, and must not be
    # re-journaled a second time) -- it only ever re-attempts the durable
    # commit. Distinguishing "commit genuinely missing" from "already fully
    # accepted AND committed" is a cheap check: compare the run_status the
    # INTEGRATION BRANCH'S OWN committed roadmap.md shows right now against
    # `complete` -- if it isn't, the accept commit from a prior attempt
    # never landed.
    if [ "$from" = complete ]; then
      integ="$(config_get "$repo" integration_branch orchid/integration)"
      committed_status=""
      if git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1; then
        committed_roadmap="$(mktemp)"
        if git -C "$repo" show "refs/heads/$integ:.orchid/roadmap.md" > "$committed_roadmap" 2>/dev/null; then
          committed_status="$(fm_get "$committed_roadmap" run_status)"
        fi
        rm -f "$committed_roadmap"
      fi
      [ "$committed_status" != complete ] || \
        orchid_die "run $run_id already accepted and committed (run_status: complete on $integ) — nothing to retry"
      ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind intervention \
        "accept commit retried after CAS failure"
    else
      # Shorthand for accepting->complete only: requires an acceptance
      # evidence file, unlike the bare `run advance complete` escape hatch
      # above.
      [ "$from" = accepting ] || orchid_die "run accept requires run_status accepting (current: $from)"

      mkdir -p "$state/reviews"
      cat "$evidence" | atomic_write "$state/reviews/acceptance.log"
      ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind acceptance "run_status accepting -> complete: $reason"
      fm_set "$roadmap" run_status complete
    fi

    # The durable commit itself: every other ownership verb (`run advance`,
    # `task advance`, ...) mutates $repo/.orchid directly and never
    # commits at all -- orchid_commit_durable (lib/common.sh), called here
    # with no ORCHID_COMMIT_DURABLE_HOOK, simply commits whatever is
    # CURRENTLY on disk (the mutations above, plus anything else that
    # accumulated locally over the run's whole lifetime -- every task
    # verb/journal entry/requirements import that ran without an
    # intervening `plan apply`) onto the integration branch. On CAS
    # failure it journals its OWN `intervention` entry and dies nonzero --
    # the run_status/evidence-log/journal mutations are already on disk
    # regardless (either from this call, above, or a prior one), so a
    # SUBSEQUENT `orchid run accept` call is the real retry path: it lands
    # here again with `from = complete` and re-attempts exactly this commit
    # (branch just above), never touching the evidence/journal/run_status
    # a second time.
    orchid_commit_durable "$repo" "orchid: run accepted ($run_id)" .orchid

    echo "run_status: accepting -> complete"
    ;;
  new)
    # v1-m3 Task 11: run rollover -- archives the just-finished run's
    # tasks/reviews/journal.md/roadmap.md/BLOCKERS.md under runs/<old-run-
    # id>/, carries forward ONLY context.md + ACTIVE lessons (kernel.md's
    # defined inheritance boundary -- retired/superseded lessons are left
    # behind, not archived elsewhere either: they remain visible only via
    # git history / the old journal that recorded their retirement), resets
    # roadmap.md to a fresh `run_status: planning` with `run_id`
    # incremented, and journals the rollover as the FIRST entry of a
    # brand-new journal.md. Mirrors `orchid plan apply`'s temp-worktree +
    # CAS + sync-back pattern exactly (see that verb's own comments for the
    # full rationale) -- generalized here to more paths than apply's two
    # (journal.md/roadmap.md), since a rollover touches nearly everything
    # under .orchid/.
    verb_lock_acquire "$repo"
    trap 'verb_lock_release "$repo"' EXIT
    # v1-m3 final review (TRIVIA): clear crash debris a PRIOR, differently-
    # PID'd `run new` may have left behind -- the shadow-dir swap further
    # below names its two temp dirs "$state.new.$$"/"$state.old.$$" (THIS
    # process's own pid), so a rollover that crashed mid-swap under a
    # different pid leaves its own same-shaped debris sitting beside
    # .orchid/ forever (nothing else ever globs for it to clean it up).
    # Safe here, under the verb lock already acquired above (so a
    # genuinely concurrent in-flight `run new` can never have its OWN
    # still-live shadow/old dirs swept out from under it) and before this
    # invocation mints its own. `rm -rf` on a non-matching glob is a silent
    # no-op (the -f flag alone guards it, no nullglob needed), so this is a
    # no-op in the common case of no debris at all.
    rm -rf "$state".old.* "$state".new.*
    # INV-02: every sibling mutating arm (advance, accept) fences the epoch
    # before touching state; this one must too, or a stale ORCHID_EPOCH
    # (from a zombie orchestrator, a pre-crash session, etc.) could execute
    # the entire rollover.
    epoch_require "$repo"; export ORCHID_EPOCH
    reason=""
    while [ $# -gt 0 ]; do case "$1" in
      --reason)
        [ -n "${2:-}" ] || orchid_die "--reason requires a value"
        reason="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$reason" ] || orchid_die "run new requires --reason (INV-08)"

    # v1-m3 final review (IMPORTANT 3): a live orchestrator session refreshes
    # runtime/lease.json every pass (PROTOCOL.md THE TICK steps 1+5) -- `run
    # new` rewrites nearly all of .orchid/ (archive + reset), so racing it
    # against a session that is still actively ticking would tear that
    # session's state out from under it mid-flight. Same lease-staleness
    # idiom runners/orchid-pump uses to decide "is anyone still driving this
    # run" (pump_stale_s, default 900; the two-line GNU/BSD `date` parse is
    # duplicated rather than shared, same call this codebase already made for
    # the pump vs. libexec/orchid-jobs' iso_to_epoch -- see the pump's own
    # header comment). A missing or unparseable lease reads as "no live
    # session" here, exactly like the pump's own missing-lease handling.
    lease_file="$rt/lease.json"
    if [ -f "$lease_file" ]; then
      # v1-m4: `released: true` (orchid run release-lease, PROTOCOL.md
      # COMPLETION) is a clean-session-exit affordance -- the session that
      # wrote it is genuinely gone, not merely between refreshes, so it must
      # read as immediately stale here regardless of how recently
      # refreshed_at itself was stamped (closes the live-run incident: an
      # operator having to hand-backdate lease.json to unblock `run new`
      # after a session's own final tick).
      released="$(jq -r '.released // false' "$lease_file" 2>/dev/null || echo false)"
      if [ "$released" != true ]; then
        refreshed_at="$(jq -r '.refreshed_at // ""' "$lease_file" 2>/dev/null || echo "")"
        refreshed_epoch=0
        if [ -n "$refreshed_at" ]; then
          refreshed_epoch="$(date -u -d "$refreshed_at" +%s 2>/dev/null \
            || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$refreshed_at" +%s 2>/dev/null \
            || echo 0)"
        fi
        if [ "$refreshed_epoch" -gt 0 ]; then
          stale_s="$(config_get "$repo" pump_stale_s 900)"
          lease_age=$(( $(date -u +%s) - refreshed_epoch ))
          if [ "$lease_age" -lt "$stale_s" ]; then
            orchid_die "a live orchestrator session may still be running (lease refreshed ${lease_age}s ago); wait for the lease to lapse or stop the session"
          fi
        fi
      fi
    fi

    roadmap="$state/roadmap.md"
    [ -f "$roadmap" ] || orchid_die "no roadmap in current checkout — run from the integration branch (or a worktree of it) after orchid init"
    from_status="$(fm_get "$roadmap" run_status)"
    case "$from_status" in
      complete|blocked) ;;
      *) orchid_die "run new requires run_status complete|blocked (current: $from_status)" ;;
    esac

    old_run_id="$(fm_get "$roadmap" run_id)"; [ -n "$old_run_id" ] || old_run_id='r-001'
    # r-NNN -> r-(NNN+1), forced base-10 (a leading-zero string like "001"
    # would otherwise be misread as octal by bash arithmetic). Guarded
    # explicitly, before any arithmetic, so a malformed/hand-edited run_id
    # dies with a clean message rather than a raw bash arithmetic-syntax
    # error (or worse, an octal-parse surprise on a stray non-digit).
    case "$old_run_id" in
      r-[0-9]*) old_num="${old_run_id#r-}" ;;
      *) old_num="" ;;
    esac
    case "$old_num" in
      ''|*[!0-9]*) orchid_die "roadmap.md run_id '$old_run_id' is not in the expected r-NNN shape -- cannot compute the next run id" ;;
    esac
    new_run_id="$(printf 'r-%03d' $((10#$old_num + 1)))"

    integ="$(config_get "$repo" integration_branch orchid/integration)"
    git -C "$repo" rev-parse --verify -q "refs/heads/$integ" >/dev/null 2>&1 \
      || orchid_die "integration branch '$integ' does not exist"
    integ_head="$(git -C "$repo" rev-parse "refs/heads/$integ")"

    wt=""
    run_new_cleanup() {
      if [ -n "$wt" ]; then
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
        rm -rf "$wt" 2>/dev/null || true
        git -C "$repo" worktree prune >/dev/null 2>&1 || true
      fi
    }
    trap 'run_new_cleanup; verb_lock_release "$repo"' EXIT
    wt="$(mktemp -d "${TMPDIR:-/tmp}/orchid-run-new.XXXXXX")"
    git -C "$repo" worktree add -q --detach "$wt" "$integ_head" >/dev/null 2>&1 \
      || orchid_die "cannot create temp worktree at $integ_head"

    # Full copy of current .orchid/ (minus runtime/) into the worktree --
    # same rebuild-from-scratch approach `orchid plan apply` uses, so every
    # mutation below lands only in the worktree's copy until CAS succeeds.
    rm -rf "$wt/.orchid"; mkdir -p "$wt/.orchid"
    for entry in "$state"/*; do
      [ -e "$entry" ] || continue
      name="$(basename "$entry")"
      [ "$name" = runtime ] && continue
      cp -R "$entry" "$wt/.orchid/$name"
    done
    wt_state="$wt/.orchid"

    # 1. Archive: tasks/, reviews/, journal.md, roadmap.md, BLOCKERS.md move
    # to runs/<old_run_id>/ verbatim -- durable history, never touched
    # again.
    mkdir -p "$wt_state/runs/$old_run_id"
    for p in tasks reviews journal.md roadmap.md BLOCKERS.md; do
      [ -e "$wt_state/$p" ] && mv "$wt_state/$p" "$wt_state/runs/$old_run_id/$p"
    done

    # 2. context.md carries forward untouched (already sitting in
    # wt_state/context.md from the full copy above -- nothing to do).

    # 3. lessons.md carries forward ACTIVE blocks only (kernel.md's defined
    # inheritance boundary) -- superseded/retired blocks are dropped from
    # the live file going forward, not archived elsewhere; they remain
    # visible via git history on the archived run's journal that recorded
    # them. lessons_active_only strips the leading "# Lessons" heading
    # along with every non-active block (it only ever extracts "## "
    # blocks), so it is re-added by hand here to keep the on-disk file's
    # usual shape -- unlike lib/pack.sh's two call sites, which hand the
    # headless block output straight to a request pack and never restore it.
    if [ -f "$wt_state/lessons.md" ]; then
      active_tmp="$(mktemp)"
      lessons_active_only "$wt_state/lessons.md" > "$active_tmp"
      if [ -s "$active_tmp" ]; then
        { printf '# Lessons\n\n'; cat "$active_tmp"; } > "$wt_state/lessons.md"
      else
        rm -f "$wt_state/lessons.md"
      fi
      rm -f "$active_tmp"
    fi

    # 4. Fresh tasks/, reviews/, roadmap.md (planning, run_id incremented),
    # BLOCKERS.md -- the new run starts exactly like `orchid init` leaves
    # one, minus the fresh journal.md (written next, step 5, so its very
    # first entry can name the archived run).
    mkdir -p "$wt_state/tasks" "$wt_state/reviews"
    printf -- '---\nrun_status: planning\nrun_id: %s\n---\n# Roadmap\n' "$new_run_id" > "$wt_state/roadmap.md"
    echo "# Blockers" > "$wt_state/BLOCKERS.md"
    echo "# Journal" > "$wt_state/journal.md"

    # 5. First entry of the FRESH journal.md names the archived run (kind
    # intervention) -- journal-first-in-spirit even though there is no
    # "state change" left to guard here (the archival IS the state change,
    # already staged into the worktree above); this is the same throwaway-
    # epoch trick `orchid plan apply` uses so `journal add`'s own epoch
    # fencing is satisfied against the WORKTREE's runtime, not local's.
    mkdir -p "$wt_state/runtime"
    echo "$ORCHID_EPOCH" > "$wt_state/runtime/epoch"
    ORCHID_REPO="$wt" ORCHID_EPOCH="$ORCHID_EPOCH" \
      "$ORCHID_ROOT/bin/orchid" journal add --kind intervention \
      "run rollover: $old_run_id archived to runs/$old_run_id/ -> $new_run_id: $reason"
    rm -rf "$wt_state/runtime"

    git -C "$wt" add .orchid
    if git -C "$wt" diff --cached --quiet -- .orchid; then
      orchid_die "nothing to roll over"
    fi
    git -C "$wt" commit -q -m "orchid: run new ($old_run_id -> $new_run_id)"
    new_sha="$(git -C "$wt" rev-parse HEAD)"

    # Compare-and-swap, same discipline as orchid-plan apply/orchid-merge.
    if ! git -C "$repo" update-ref "refs/heads/$integ" "$new_sha" "$integ_head"; then
      moved_to="$(git -C "$repo" rev-parse "refs/heads/$integ" 2>/dev/null || echo "?")"
      ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" journal add --kind intervention \
        "run new CAS failure — integration branch '$integ' changed concurrently (expected $integ_head, now $moved_to) — retry orchid run new"
      orchid_die "update-ref CAS failed: integration branch '$integ' changed concurrently (expected $integ_head) — retry orchid run new"
    fi

    # CAS succeeded: sync the WHOLE durable .orchid/ tree back from the
    # worktree (minus runtime/, which stays local-only and is never touched
    # here) -- unlike plan apply's two-file sync-back, a rollover replaces
    # nearly everything (tasks/, reviews/, journal.md, roadmap.md,
    # BLOCKERS.md, lessons.md all change; runs/<old>/ newly appears).
    #
    # Shadow-dir swap, NOT a per-entry rm+cp loop (post-review fix): a
    # naive "for each top-level entry: rm -rf then cp -R" loop has an
    # observable window, per entry, where that one path is simply GONE
    # from local .orchid -- a kill between roadmap.md's rm and its cp
    # lands EXACTLY the Task 2 split-brain shape (roadmap.md absent,
    # tasks/ still present from before). Instead: build the COMPLETE new
    # state in a sibling shadow directory first (this can take as long as
    # it needs -- nothing observable has changed yet), carry the LIVE
    # runtime/ over into it (never the worktree's, which never had one, so
    # in-flight epoch/lease/verb-lock bookkeeping survives untouched), then
    # swap it in with two directory renames. mv within the same parent
    # directory (both are direct children of "$repo") is a single
    # filesystem rename, not a recursive copy -- so each half of the swap
    # is atomic, and the only observable window is BETWEEN the two mv
    # calls, when "$state" briefly does not exist at all.
    #
    # If the process dies in exactly that window, .orchid/ carries no
    # DURABLE content at all (no tasks/, roadmap.md, journal.md, ...) --
    # never split-brain, since orchid_split_brain requires tasks/ or
    # journal.md present WITHOUT roadmap.md, and none of those exist either
    # way here. It is not, however, necessarily wholly absent from disk: this
    # arm's own EXIT trap (`run_new_cleanup`, then `verb_lock_release`)
    # still fires on most failure paths, and `verb_lock_release` ->
    # `orchid_runtime` recreates a bare `.orchid/runtime` directory as a
    # mkdir -p side effect regardless of what state .orchid/ is in --  so a
    # crash landing exactly here can leave `.orchid/` existing but holding
    # only that empty runtime/ dir. Either way, `orchid doctor`/`status` see
    # a plain not-an-orchid-repo, not a mismatched one. Recovery is a single
    # command run from $repo: `git checkout HEAD -- .orchid` -- HEAD is a
    # symbolic ref to refs/heads/$integ (the assumption every verb in this
    # file makes: $repo has the integration branch itself checked out), and
    # that ref was ALREADY advanced to $new_sha by the CAS above, so this
    # restores exactly the just-rolled-over committed state (runtime/ is
    # gitignored and never was part of it -- a fresh `orchid run
    # start|resume` mints a new epoch/lease afterward regardless, same as
    # any other crash recovery).
    shadow="$state.new.$$"; old="$state.old.$$"
    rm -rf "$shadow" "$old"
    mkdir -p "$shadow"
    for entry in "$wt_state"/*; do
      [ -e "$entry" ] || continue
      name="$(basename "$entry")"
      [ "$name" = runtime ] && continue
      cp -R "$entry" "$shadow/$name"
    done
    [ -d "$state/runtime" ] && cp -R "$state/runtime" "$shadow/runtime"
    mv "$state" "$old"
    mv "$shadow" "$state"
    rm -rf "$old"

    echo "run rolled over: $old_run_id -> $new_run_id (archived to runs/$old_run_id/)"
    ;;
  *) orchid_die "usage: orchid run start|resume|refresh-lease|release-lease|boundary|advance|accept|new" ;;
esac

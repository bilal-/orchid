#!/bin/bash -p
set -euo pipefail

# This libexec file is a bare tier handoff, but it is also directly
# executable. Resolve its own installed location under the same fixed helper
# path the runners use rather than trusting an inherited ORCHID_ROOT. Preserve
# the original operator PATH only as inert data for runners/orchid-drive.
unset __orchid_entry_defer_restore
if [ "${__orchid_entry_context:-}" != 1 ]; then
  unset __orchid_entry_context __orchid_entry_path_was_set
  unset __orchid_entry_operator_path
  __orchid_entry_context=1
  __orchid_entry_path_was_set="${PATH+x}"
  __orchid_entry_operator_path="${PATH-}"
  export __orchid_entry_context __orchid_entry_path_was_set
  export __orchid_entry_operator_path
fi
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH
self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"
export ORCHID_ROOT

# tier-1 -> tier-2 boundary, exactly like `orchid service` (libexec/orchid-
# service) and for the same reason: `drive` executes one deterministic pass
# of THE TICK, and a pass legitimately spawns role jobs through the tier-2
# spawner. Tier-1 verbs must never spawn or detach a process (INV-01), so
# this file's whole job IS the handoff -- no argument parsing, no validation,
# no epoch fencing. `runners/orchid-drive` (tier 2) owns all of it.
exec /bin/bash -p "$ORCHID_ROOT/runners/orchid-drive" "$@"

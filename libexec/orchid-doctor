#!/bin/bash -p
set -euo pipefail

# Resolve direct and dispatched entry through the same privileged interpreter
# and fixed helper path used by unattended runners. The operator PATH remains
# inert until the trust gate and its provenance have been printed; doctor then
# restores it for ordinary environment/plugin readiness checks.
unset __orchid_entry_defer_restore
if [ "${__orchid_entry_context:-}" != 1 ]; then
  unset __orchid_entry_context __orchid_entry_path_was_set
  unset __orchid_entry_operator_path
  __orchid_entry_context=1
  __orchid_entry_path_was_set="${PATH+x}"
  __orchid_entry_operator_path="${PATH-}"
  export __orchid_entry_context __orchid_entry_path_was_set
  export __orchid_entry_operator_path
fi
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH
self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"
export ORCHID_ROOT
__orchid_entry_defer_restore=1

source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/manifest.sh"
source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/roles.sh"; source "$ORCHID_ROOT/lib/resolver.sh"
source "$ORCHID_ROOT/lib/capsuite.sh"; source "$ORCHID_ROOT/lib/ledger.sh"
source "$ORCHID_ROOT/lib/hooks.sh"; source "$ORCHID_ROOT/lib/trust.sh"
# v1-m4 T006, for the notify return-leg check below: spawn.sh for the
# launcher's own env hygiene around the inbound probe (never re-invented
# here).
source "$ORCHID_ROOT/lib/spawn.sh"
repo="${ORCHID_REPO:-$PWD}"; fails=0
ok()   { echo "ok: $*"; }
bad()  { echo "FAIL: $*"; fails=$((fails+1)); }

# Inspect and render the gate before making the operator PATH executable
# again. Later readiness checks intentionally use that PATH (for example,
# capsuite required-binary discovery), but cannot retroactively alter this
# already-emitted decision or its trusted identity provenance.
unattended_trust_inspect "$repo"
if [ "$ORCHID_UNATTENDED_STATE" = trusted ]; then
  printf 'ok: unattended trust: '
else
  printf 'WARN: unattended trust (headless execution gated): '
fi
unattended_trust_summary_loaded
# A scheduled pump discards its own stdout and stderr, and cannot open the
# repo-local service log until after the gate. Its refusals land in the
# machine-local trust store instead; this is where an operator finds them.
if unattended_refusal_log="$(unattended_trust_refusal_log_path)"; then
  echo "WARN: unattended trust denied a scheduled/service invocation on this machine; most recent entries (time, surface, repo, state, why) from $unattended_refusal_log:"
  tail -n 5 "$unattended_refusal_log" | sed 's/^/  /'
fi
_orchid_entry_restore_operator_path

# --greenfield (v1-m2 Task 9): the ONLY flag. Skips exactly the two checks
# that cannot hold pre-scaffold -- everything else below runs unchanged.
greenfield=0
while [ $# -gt 0 ]; do case "$1" in
  --greenfield) greenfield=1; shift ;;
  *) orchid_die "usage: orchid doctor [--greenfield]" ;;
esac; done
# Plugin discovery report -- printed BEFORE role checks (role resolution
# depends on which plugins exist at all, so an operator should see the full
# discovery picture, including any collision, before the per-role verdicts
# below). Shells out to `orchid plugins list` rather than re-implementing
# discovery here so the two can never drift apart; a nonzero exit from it
# means INV-10 tripped (a duplicate id somewhere in the discovered set),
# which is a doctor FAIL, not a warning.
echo "plugins:"
if plugins_out="$(ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" plugins list 2>&1)"; then
  plugins_rc=0
else
  plugins_rc=$?
fi
echo "$plugins_out" | sed 's/^/  /'
[ "$plugins_rc" -eq 0 ] && ok "plugin discovery: no collisions" || bad "plugin discovery: collision(s) detected (see plugins: section above)"

# Plugin manifest validation -- shells to `orchid plugins validate --all`
# (same short-lived-subprocess pattern as `plugins list` above, INV-01 fine)
# so doctor and `orchid plugins validate` can never disagree about what's
# malformed. A permission opted into via `permissions=` but not actually set
# anywhere the launcher will run from is a WARNING here (the plugin is still
# runnable; the adapter reports its own auth failure at runtime, per
# lib/manifest.sh's manifest_validate) -- it must never fail the exit code.
# A genuinely malformed manifest (validate's aggregate exit 13) IS a doctor
# FAIL, exit 1.
if validate_out="$(ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" plugins validate --all 2>&1)"; then
  validate_rc=0
else
  validate_rc=$?
fi
perm_warnings="$(echo "$validate_out" | grep -E '^warn:.*permission .* requested, not set' || true)"
[ -z "$perm_warnings" ] || echo "$perm_warnings" | sed 's/^/  /'
[ "$validate_rc" -eq 0 ] && ok "plugin manifests: validate clean" || bad "plugin manifests: validate failed (see above)"
git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 && ok "git repository" || bad "git repository"
# jq readiness is two questions, not one. This check runs after the operator
# PATH has been restored above, but the unattended gate printed further up
# resolves tools on the fixed PATH the runners pin -- so a bare `command -v`
# here could report `ok jq` about a jq the gate cannot see, and did. Ask both
# questions through the same helper the gate uses (lib/trust.sh), and when the
# two PATHs disagree say which surface is short instead of leaving the
# contradiction for the operator to discover from a denied scheduled run.
if unattended_tool_probe jq; then
  ok jq
elif [ "$ORCHID_UNATTENDED_TOOL_STATE" = interactive-only ]; then
  # Interactive orchid works; only headless execution is affected, and the
  # unattended gate is a warning here, never a doctor failure.
  ok "jq (operator PATH)"
  echo "WARN: $ORCHID_UNATTENDED_TOOL_DETAIL"
else
  bad "jq missing: $ORCHID_UNATTENDED_TOOL_DETAIL"
fi
git -C "$repo" worktree list >/dev/null 2>&1 && ok "worktree support" || bad "worktree support"

if [ "$greenfield" -eq 1 ]; then
  echo "note: greenfield: verify command deferred to scaffold task"
else
  [ -n "$(config_get "$repo" verify)" ] && ok "verify command configured" || bad "verify command (set 'verify=' in orchid.config)"
fi

# The RESOLVED pack budget, with where the value came from (T027, dogfood F29).
# Printed rather than judged: no value is wrong here, but not knowing which one
# is live has now wedged two runs. `pack_budget_bytes` is the budget every pack
# is built against (lib/pack.sh), and a pack that overflows it fails the LAUNCH
# (exit 12, `input_overflow`) before any engine starts -- so an operator
# debugging "nothing ever runs" needs the effective number, not the one they
# believe they set. The layer that surprises people is named explicitly: the
# chain is anchored on the TARGET repository, so the orchid installation's own
# orchid.config is read only when the installation IS the target -- which is
# exactly what happens when orchid drives its own repository, and is why the
# line below names the two cases separately instead of claiming the file is
# never consulted. On any other target it contributes nothing, however
# plausible a global default it looks; $HOME/.orchid/config is the file that
# does that job.
pack_budget="$(config_get "$repo" pack_budget_bytes 65536)"
pack_budget_root_note="The orchid installation's own $ORCHID_ROOT/orchid.config is NOT part of that chain — set a cross-repo default in $HOME/.orchid/config instead."
[ "$repo" != "$ORCHID_ROOT" ] || pack_budget_root_note="This target IS the orchid installation, so $ORCHID_ROOT/orchid.config is the repo layer above — on any OTHER target it would contribute nothing."
echo "note: pack budget: pack_budget_bytes=$pack_budget (from: $(config_provenance "$repo" pack_budget_bytes)) — resolution order: \$ORCHID_PACK_BUDGET_BYTES, then $repo/orchid.config, then $HOME/.orchid/config, then the built-in default 65536. $pack_budget_root_note"
for role in orchestrator implementer reviewer arbiter plan_critic; do
  # v1-m2: role.* is a failover chain, not a scalar. Only the PRIMARY (chain
  # entry 1) gates the doctor exit code -- missing/unresolvable primary is
  # still a FAIL, exactly as before. Every entry after it is a note: whether
  # it has actually passed the capability suite (lib/capsuite.sh, m1) for
  # this role, so an operator can see at a glance which fallbacks are really
  # armed vs. merely configured.
  chain="$(resolve_role_chain "$repo" "$role")"
  idx=0; primary=""; primary_ok=1; line=""
  while IFS= read -r eng; do
    [ -n "$eng" ] || continue
    idx=$((idx + 1))
    if [ "$idx" -eq 1 ]; then
      primary="$eng"
      if exe="$(resolve_engine_exe "$eng" 2>/dev/null)"; then
        line="$eng (primary: $exe)"
      else
        primary_ok=0
      fi
    else
      if capsuite_passed "$eng" "$role"; then
        state="capsuite passed"
      else
        state="capsuite UNVERIFIED — run orchid plugins test $eng $role"
      fi
      line="$line, $eng (fallback: $state)"
    fi
  done <<< "$chain"
  if [ "$primary_ok" -eq 1 ]; then
    tag=""; [ "$(config_provenance "$repo" "role.$role")" != default ] && tag=" [unverified]"
    ok "role $role -> $line$tag"
  else
    bad "role $role -> $primary: no engine plugin on search path (see docs/engines/$primary.md)"
  fi
done
# Custom role bindings (v1-m3 Task 7): any `role.<id>`/`role.<id>.blocking`
# config key whose id is NOT one of the five built-ins above is a custom
# role plugin binding. A custom role has no default chain at all (lib/
# resolver.sh's resolve_role_chain exits 14 for an unbound one) -- what
# doctor gates here is different from the built-in loop's "is an engine on
# the search path": there must be a DISCOVERABLE descriptor.role for the
# role itself (lib/roles.sh's _role_file search path) before an engine
# binding even means anything, since without a descriptor there is no
# requires/forbids to check eligibility against at all.
while IFS= read -r crole; do
  [ -n "$crole" ] || continue
  if ! cfile="$(_role_file "$crole" 2>/dev/null)"; then
    bad "role $crole: descriptor lookup ambiguous -- duplicate role on the search path (INV-10)"
    continue
  fi
  if [ ! -f "$cfile" ]; then
    bad "role $crole: custom role has a config binding but no discoverable descriptor.role (checked \$ORCHID_PLUGIN_PATH/roles/$crole, ~/.orchid/plugins/roles/$crole, $ORCHID_ROOT/roles/$crole.role)"
    continue
  fi
  # resolve_role_chain exits 14 (its own "no binding for custom role" stderr
  # message) when the descriptor IS discoverable but nothing ever bound
  # role.$crole itself (e.g. only role.$crole.blocking was set) -- this is
  # a real, reachable misconfiguration (_role_custom_names names a role
  # from EITHER key), and under this script's `set -euo pipefail` an
  # unguarded `var="$(cmd | tr ...)"` here would aborts the ENTIRE doctor
  # run right here, silently, skipping every check still to come (lockfile
  # drift, integration branch, split-brain) -- guarded explicitly so a FAIL
  # is printed and the loop (and the rest of doctor) continues instead.
  if ! chain_line="$(resolve_role_chain "$repo" "$crole" 2>/dev/null | tr '\n' ',')"; then
    bad "role $crole: no binding (set role.$crole=<engine>[,fallback])"
    continue
  fi
  chain_line="${chain_line%,}"
  # hook_bindings=<point>:<plugin-id>,... (optional, descriptor-only, doctor
  # display ONLY in m3 -- never consulted for gating, lib/roles.sh's header
  # comment). Each point is checked against the closed kernel hook-point set
  # (lib/hooks.sh's hook_point_valid) -- an unknown point is a WARN, never a
  # FAIL: this is descriptive metadata about the role plugin, not something
  # doctor enforces.
  hook_bindings="$(_cfg_file_get "$cfile" hook_bindings)"
  hookline=""
  if [ -n "$hook_bindings" ]; then
    hookline=" (hooks: $hook_bindings)"
    while IFS= read -r hb; do
      [ -n "$hb" ] || continue
      pt="${hb%%:*}"
      hook_point_valid "$pt" || echo "warn: role $crole: hook_bindings names unknown hook point '$pt'"
    done < <(_manifest_split_csv "$hook_bindings")
  fi
  ok "role $crole -> $chain_line (custom, descriptor: $cfile)$hookline"
done < <(_role_custom_names "$repo")
# Plugin lockfile drift (Task 7) -- only runs when a lock already exists
# (orchid-init writes one best-effort; a repo that never locked simply has
# no opinion here). Drift is a WARNING, not a FAIL, in v1-m1 -- it surfaces
# what changed for the operator to judge but never flips doctor's exit code.
lockfile="$repo/.orchid/plugins.lock"
if [ -f "$lockfile" ]; then
  if lock_out="$(ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" plugins verify-lock 2>&1)"; then
    ok "plugin lock: no drift ($lockfile)"
  elif grep -qi "corrupt" <<<"$lock_out"; then
    # A corrupt/unparsable lockfile (merge conflict, truncation, ...) is a
    # distinct condition from drift -- the message must say "corrupt", not
    # "drift", so an operator doesn't mistake "the file won't even parse"
    # for "a plugin changed". Still non-fatal in v1-m1 (same policy as
    # drift): this only WARNs, never flips doctor's exit code.
    echo "WARN: plugin lock is corrupt ($lockfile):"
    echo "$lock_out" | sed 's/^/  /'
  else
    echo "WARN: plugin lock drift detected ($lockfile):"
    echo "$lock_out" | sed 's/^/  /'
  fi
fi
# -- notify return leg (v1-m4 T006) -----------------------------------------
# Doctor already validates the notify plugin the way it validates any other
# plugin (the `plugins list`/`plugins validate --all` sections above): its
# manifest parses, its required binary exists. That answers ONE question --
# can this repo SEND a blocker to a channel. It has never answered the other
# one: can an ANSWER get back.
#
# Those are different facts, and this run learned the difference the
# expensive way: a channel gateway was down for a day, blockers still
# reached the operator's phone, the operator answered, and every answer
# vanished with no local trace -- because outbound needs only a CLI on this
# machine, while inbound needs a persistent agent on the channel side that
# runs `orchid answer` against this repo. Orchid ships no inbound listener of
# its own and neither starts nor supervises that agent, so its liveness is
# not portably observable from here.
#
# So this block reports the two facts SEPARATELY and never derives the second
# from the first. Everything here is ADVISORY -- WARN/note only, never `bad`:
# a run with no channel at all is entirely legitimate (BLOCKERS.md + the
# terminal is a complete surface), and an unreachable return leg is a thing
# an operator must SEE, not a reason to refuse to work.
#
# THE INBOUND LEG IS ACTUALLY PROBED, not guessed at from local files. A
# plugin MAY declare an `inbound_probe=<argv-token>` in its manifest (docs/
# specs/plugins.md, "The inbound probe"); doctor then runs its entrypoint in
# that read-only mode and reports what the plugin ITSELF determined. Where no
# probe is declared, doctor says so plainly -- but "no way to tell" must
# never be asserted on behalf of a plugin that can in fact tell.
notify_channel="$(config_get "$repo" notify.channel "")"
notify_allowlist="$(config_get "$repo" answer_allowlist "")"
if [ -z "$notify_channel" ] && [ -z "$notify_allowlist" ]; then
  ok "notify return leg: no notify channel configured (notify.channel unset) — blockers surface in BLOCKERS.md and the terminal only; nothing sends off-machine and nothing is expected to answer from off-machine"
else
  notify_plugin="$(config_get "$repo" notify.plugin openclaw)"
  notify_to="$(config_get "$repo" notify.to "")"
  notify_dir=""; notify_ep=""
  # Fact 1 -- OUTBOUND. Deliberately worded as send capability alone. Only
  # `notify.channel` puts a plugin on the sending path at all (runners/
  # orchid-pump drains nothing without it), so a repo that set only
  # `answer_allowlist` is not misreported against a plugin it never picked.
  if [ -z "$notify_channel" ]; then
    echo "note: notify outbound: notify.channel is unset, so nothing is ever sent off-machine (answer_allowlist alone only affects who may answer)"
  elif ! notify_resolve="$(resolve_notify_dir "$notify_plugin" 2>&1)"; then
    # 2>&1, not 2>/dev/null: resolve_notify_dir has THREE distinct failures
    # and only one of them is "not installed". An INV-10 duplicate (the same
    # plugin name under two roots) and a rejected traversing name both
    # explain themselves on stderr, and discarding that left an operator
    # chasing a missing plugin that is in fact installed twice.
    if [ -n "$notify_resolve" ]; then
      echo "WARN: notify outbound: notify.plugin '$notify_plugin' is not usable — nothing can be sent: $notify_resolve"
    else
      echo "WARN: notify outbound: notify.plugin '$notify_plugin' does not resolve to a plugin on the search path — nothing can be sent"
    fi
  else
    notify_dir="$notify_resolve"
    notify_ep="$(manifest_get "$notify_dir" entrypoint send)"
    notify_problems=0
    if [ ! -x "$notify_dir/$notify_ep" ]; then
      echo "WARN: notify outbound: '$notify_plugin' resolves ($notify_dir) but its entrypoint '$notify_ep' is not executable — nothing can be sent (fix: chmod +x $notify_dir/$notify_ep)"
      notify_problems=1
    fi
    notify_missing=""
    while IFS= read -r nbin; do
      [ -n "$nbin" ] || continue
      command -v "$nbin" >/dev/null 2>&1 || notify_missing="$notify_missing $nbin"
    done < <(_manifest_split_csv "$(manifest_get "$notify_dir" requires_binaries)")
    if [ -n "$notify_missing" ]; then
      echo "WARN: notify outbound: '$notify_plugin' resolves ($notify_dir) but required binaries are missing from PATH:$notify_missing — blockers will queue in runtime/outbox and retry until send_retry_max, then quarantine"
      notify_problems=1
    fi
    # CONFIG the resolved plugin actually requires (`requires_config=`, its
    # own manifest's declaration -- not a hardcoded key list here, since the
    # two shipped plugins genuinely differ: openclaw's send does
    # `to=${ORCHID_NOTIFY_TO:?...}` and declares notify.to, while hermes
    # treats an empty notify.to as "home channel" and does not). Without
    # this, doctor reported outbound `ok` on a resolvable plugin with a
    # present binary while EVERY queued blocker failed on an unset key,
    # retried to send_retry_max and quarantined -- green doctor, zero
    # delivered messages, which is precisely the unproven-ok this task
    # exists to remove.
    notify_cfg_missing=""
    while IFS= read -r nkey; do
      [ -n "$nkey" ] || continue
      [ -n "$(config_get "$repo" "$nkey" "")" ] || notify_cfg_missing="$notify_cfg_missing $nkey"
    done < <(_manifest_split_csv "$(manifest_get "$notify_dir" requires_config)")
    if [ -n "$notify_cfg_missing" ]; then
      echo "WARN: notify outbound: '$notify_plugin' declares config it cannot send without, and it is unset:$notify_cfg_missing — every queued blocker will fail, retry to send_retry_max and quarantine (set it in orchid.config)"
      notify_problems=1
    fi
    if [ "$notify_problems" -eq 0 ]; then
      ok "notify outbound: '$notify_plugin' resolves, its required binaries are present, and the config it declares is set ($notify_dir/$notify_ep) — SEND capability only: no send is attempted here, and this says nothing about whether a reply can come back"
    fi
  fi

  # Fact 2 -- INBOUND, the return leg. Reported from the PLUGIN's own probe
  # where one exists, and from nothing at all where one doesn't.
  notify_probe=""
  [ -n "$notify_dir" ] && notify_probe="$(manifest_get "$notify_dir" inbound_probe)"
  if [ -z "$notify_channel" ]; then
    echo "note: notify inbound (the return leg): nothing to probe — notify.channel is unset, so no channel carries a reply in either direction"
  elif [ -z "$notify_dir" ]; then
    echo "WARN: notify inbound (the return leg): NOT PROBED — the configured notify plugin did not resolve (see the outbound line above), so there is nothing here to ask about the return path."
  elif [ -z "$notify_probe" ]; then
    echo "WARN: notify inbound (the return leg): NOT VERIFIED — notify plugin '$notify_plugin' declares no inbound probe (no 'inbound_probe=' in $notify_dir/plugin.conf) and orchid runs no inbound listener of its own, so nothing here can tell whether a reply can get back. An answer reaches this repo only when something on the CHANNEL side runs 'ORCHID_REPO=\"$repo\" orchid answer <qid> <choice> --nonce <n>' on this machine. Outbound send capability is a separate fact above and does not imply this one."
  elif [ ! -x "$notify_dir/$notify_ep" ]; then
    echo "WARN: notify inbound (the return leg): NOT PROBED — '$notify_plugin' declares an inbound probe but its entrypoint '$notify_ep' is not executable (see the outbound line above)."
  else
    # Short-lived, bounded subprocess -- the same INV-01-fine pattern as the
    # `plugins list`/`plugins validate` shell-outs above, under the launcher's
    # own env hygiene (env -i + spawn_child_env, stdin /dev/null) so a probe
    # sees exactly what `send` would. The 10s deadline is fixed, not
    # configurable: doctor is an interactive command and a hung gateway must
    # never hang it -- a probe that cannot answer in 10s has answered
    # "undetermined" for this purpose.
    notify_probe_env=()
    while IFS= read -r nline; do
      [ -n "$nline" ] || continue
      notify_probe_env+=("$nline")
    done < <(ORCHID_NOTIFY_CHANNEL="$notify_channel" ORCHID_NOTIFY_TO="$notify_to" spawn_child_env "$notify_dir")
    # Output goes to a FILE, not through `$(with_timeout ...)`: with_timeout
    # runs both the child and its watcher under `set -m`, and a command
    # substitution would capture the shell's own job-control chatter about
    # killing that watcher along with the probe's line. Same helper-function
    # + redirect + `set +e` shape runners/orchid-tick uses around the very
    # same helper, for the same reason.
    notify_probe_tmp="$(mktemp)"
    _notify_run_probe() {
      if [ "${#notify_probe_env[@]}" -gt 0 ]; then
        env -i "${notify_probe_env[@]}" "$notify_dir/$notify_ep" "$notify_probe" \
          </dev/null > "$notify_probe_tmp" 2>&1
      else
        env -i "$notify_dir/$notify_ep" "$notify_probe" \
          </dev/null > "$notify_probe_tmp" 2>&1
      fi
    }
    set +e
    with_timeout 10 _notify_run_probe
    notify_probe_rc=$?
    set -e
    notify_probe_out="$(head -n1 "$notify_probe_tmp" 2>/dev/null || true)"
    rm -f "$notify_probe_tmp"
    case "$notify_probe_rc" in
      0)
        # `ok` is earned here and nowhere else in this block: the plugin
        # POSITIVELY determined its own transport is up. The second sentence
        # is not decoration -- it is the honest bound on what was proven.
        ok "notify inbound (the return leg): '$notify_plugin' probed its channel and reports it REACHABLE — ${notify_probe_out:-(no detail)}. That proves the transport your reply travels back over is up; it does NOT prove a channel-side agent is installed there that turns your reply into an 'orchid answer' call against this repo, which orchid neither starts nor supervises."
        ;;
      1)
        echo "WARN: notify inbound (the return leg): '$notify_plugin' probed its channel and reports it NOT REACHABLE — ${notify_probe_out:-(no detail)}. Answers sent on this channel are being lost with no local trace; answer on this machine with the command BLOCKERS.md prints until it is back."
        ;;
      124)
        echo "WARN: notify inbound (the return leg): UNDETERMINED — '$notify_plugin''s inbound probe did not answer within 10s and was killed. That is not evidence either way; a channel that slow to answer doctor is worth checking by hand."
        ;;
      *)
        echo "WARN: notify inbound (the return leg): UNDETERMINED — '$notify_plugin''s inbound probe could not tell (exit $notify_probe_rc): ${notify_probe_out:-(no detail)}. Reported as unknown rather than ok, deliberately."
        ;;
    esac
  fi

  # Local evidence -- separate from the probe, and about a different thing:
  # whether answers have ever actually LANDED here. A .question with no
  # .answer beside it is a blocker this repo raised and never heard back
  # about; if the operator believes they answered it, the return leg is
  # exactly what failed.
  #
  # ONE exclusion, and it mirrors `orchid answer`'s own refusal exactly:
  # a question EXPIRED past `answer_expiry_s` can never be answered
  # (libexec/orchid-answer dies on it), so warning about one forever is the
  # false alarm that teaches an operator to skim past the line that would
  # have caught a real outage.
  #
  # This deliberately does NOT filter on the originating task's status.
  # An earlier pass excluded any question whose task was not `blocked`, aimed
  # at `orchid task unblock` (which moves a blocked task to rework without
  # ever writing runtime/answers, leaving its question answer-less by design).
  # That filter was wrong, and wrong in the dangerous direction:
  # libexec/orchid-answer NEVER READS TASK STATUS -- it gates on the question
  # file, expiry, nonce/allowlist and no prior answer, and nothing else. A
  # question on a task sitting in `merging` or `arbitrating` is fully
  # answerable, and those are exactly the ones runners/orchid-drive's boundary
  # notifier raises (hook-failure, worktree-conflict, operator-handoff,
  # task-prerequisite, operator-decision, and non-arbitrable review-conflict
  # all notify with the task in whatever status it holds -- operator-handoff
  # always with the task in `testing`, task-prerequisite with it in `testing`
  # or `merging`). Excluding them dropped the majority of real lost-answer
  # evidence. `not blocked` is far wider than `was blocked, then locally
  # resolved`; the locally-resolved case is left to age out through the same
  # expiry above, which bounds the stale warning to answer_expiry_s instead of
  # buying that quiet by discarding answerable blockers.
  notify_answers_dir="$repo/.orchid/runtime/answers"
  notify_expiry="$(config_get "$repo" answer_expiry_s 86400)"
  case "$notify_expiry" in ''|*[!0-9]*) notify_expiry=86400 ;; esac
  notify_q_total=0; notify_q_live=0; notify_q_answered=0; notify_q_stale=0
  notify_oldest=0; notify_now="$(date -u +%s)"
  if [ -d "$notify_answers_dir" ]; then
    for notify_qf in "$notify_answers_dir"/*.question; do
      [ -f "$notify_qf" ] || continue
      notify_q_total=$(( notify_q_total + 1 ))
      notify_qid="$(basename "$notify_qf" .question)"
      if [ -f "$notify_answers_dir/$notify_qid.answer" ]; then
        notify_q_answered=$(( notify_q_answered + 1 )); continue
      fi
      # Age, by the SAME portable mtime probe (lib/common.sh's `file_mtime`,
      # whose default fallback of 0 this branch relies on) and the SAME key
      # libexec/orchid-answer's own expiry check uses -- an unreadable mtime
      # is bucketed with expired for the same reason `answer` refuses it:
      # unanswerable either way.
      notify_m="$(file_mtime "$notify_qf")"
      if [ "$notify_m" -le 0 ] || [ $(( notify_now - notify_m )) -gt "$notify_expiry" ]; then
        notify_q_stale=$(( notify_q_stale + 1 )); continue
      fi
      notify_q_live=$(( notify_q_live + 1 ))
      notify_age=$(( notify_now - notify_m ))
      # A full `if`, not `[ ... ] && ...`: this is the LAST command in the
      # loop body, so a false test would make the whole `for` (and the `if`
      # around it) return 1 under this script's `set -e`.
      if [ "$notify_age" -gt "$notify_oldest" ]; then notify_oldest="$notify_age"; fi
    done
  fi
  notify_stale_note=""
  [ "$notify_q_stale" -gt 0 ] && notify_stale_note=" ($notify_q_stale further question(s) ignored as unanswerable: expired past answer_expiry_s=${notify_expiry}s, which is the one refusal 'orchid answer' itself enforces)"
  # NEVER a positive all-clear. The strongest true statement available here is
  # an ABSENCE -- no question is currently unanswered -- and the absence of
  # waiting questions is not evidence the return leg works: a channel that
  # drops every reply looks identical to a healthy one until something is
  # actually asked. Say the absence, then name what it does not prove.
  notify_inbound_bound="that is an absence, not a working return leg: it does not prove a reply sent on the channel would arrive, only that nothing is outstanding to prove it with"
  if [ "$notify_q_live" -gt 0 ]; then
    echo "WARN: notify inbound: $notify_q_live blocker(s) in $notify_answers_dir are still waiting for an answer (oldest: ${notify_oldest}s, still within answer_expiry_s=${notify_expiry}s). If any of them were already answered on the channel, nothing delivered that answer back here — check the channel-side agent before answering again.$notify_stale_note"
  elif [ "$notify_q_answered" -gt 0 ]; then
    echo "note: notify inbound: no question is currently unanswered and still answerable; $notify_q_answered of $notify_q_total on record have an .answer — $notify_inbound_bound, and a recorded answer does not distinguish a channel delivery from an operator typing 'orchid answer' locally.$notify_stale_note"
  elif [ "$notify_q_total" -gt 0 ]; then
    echo "note: notify inbound: no question is currently unanswered and still answerable — $notify_inbound_bound.$notify_stale_note"
  else
    echo "note: notify inbound: no blocker has been raised in this repo yet, so there is no local evidence either way"
  fi
  if [ -n "$notify_channel" ] && [ -z "$notify_allowlist" ]; then
    echo "note: notify inbound: answer_allowlist is unset, so no remote answering identity has been declared here and 'orchid answer' requires no nonce from anyone (libexec/orchid-answer) — set it if a channel-side agent is meant to answer"
  fi
fi
integ="$(config_get "$repo" integration_branch orchid/integration)"
if git -C "$repo" rev-parse --verify -q "$integ" >/dev/null 2>&1 || \
   git -C "$repo" rev-parse --verify -q HEAD >/dev/null 2>&1; then
  ok "integration branch exists or creatable"
elif [ "$greenfield" -eq 1 ]; then
  # Unborn HEAD, no integration branch yet -- will be creatable once
  # `orchid init --greenfield` lands its own root commit.
  ok "integration branch exists or creatable (greenfield: root commit pending)"
else
  bad "integration branch exists or creatable: no HEAD to branch from and $integ absent"
fi
# Split-brain checkout (v1-m3 Task 2, F7): `orchid init` restores the
# user's own branch on exit -- durable .orchid state lives only on the
# integration branch. A checkout with task-verb-built state (tasks/ or
# journal.md) but no roadmap.md is neither uninitialized nor healthy; FAIL
# it by name so the operator switches checkouts rather than debug a
# missing roadmap.
if orchid_split_brain "$repo"; then
  bad "split-brain checkout: work from the integration branch or a worktree of it — see 'orchid init' output"
else
  ok "no split-brain checkout state"
fi
# Task-file integrity (T034, dogfood F34). A task whose file was destroyed
# mid-flight -- the shape F34 found, and the one that took out r-002's own
# `.orchid/tasks/T002.md` -- does not present as damage anywhere else: the file
# is still there, `task list` prints a row of empty fields for it, and a run
# looking for it simply behaves as though the task stopped existing. Nobody
# goes looking for a zero-byte file, so the check has to come to them.
#
# Read-only and per-file, like every other doctor check: it names the path and
# what is wrong with it, and never repairs anything. It is a FAIL rather than a
# WARN because an unparseable task file is not a degraded state the run can
# continue through -- every kernel verb that touches that task reads its
# frontmatter first.
task_files_dir="$(orchid_state "$repo")/tasks"
task_files_total=0; task_files_bad=0
if [ -d "$task_files_dir" ]; then
  for task_file in "$task_files_dir"/*.md; do
    [ -f "$task_file" ] || continue
    task_files_total=$((task_files_total + 1))
    if ! task_file_why="$(fm_check "$task_file" id)"; then
      task_files_bad=$((task_files_bad + 1))
      bad "task file ${task_file#"$repo"/}: $task_file_why — this is a DAMAGED task file, not a task with nothing in it; every verb that reads this task reads its frontmatter first. Recover it with 'git log --all --oneline -- ${task_file#"$repo"/}' then 'git checkout <sha> -- ${task_file#"$repo"/}' (a review pack under .orchid/runtime/packs/ may also carry a copy)"
    fi
  done
fi
if [ "$task_files_total" -eq 0 ]; then
  ok "task files: none on disk yet (nothing to check)"
elif [ "$task_files_bad" -eq 0 ]; then
  ok "task files: $task_files_total present, each with parseable frontmatter and an id"
fi
# Stale integration checkout (v1-m3 final review, CRITICAL 2): see
# lib/common.sh's orchid_stale_checkout for the full signature this detects
# (a live run's 6638-line silent revert). Report-only, like every other
# doctor check -- it never touches the index or working tree itself.
#
# v1-m4 Task 1: the remedy text itself used to recommend a bare `git
# checkout HEAD -- .`, which is exactly what clobbered the r-001 run's own
# uncommitted `.orchid/` state when an operator followed it literally --
# ':(exclude).orchid' scopes the refresh to everything EXCEPT `.orchid/`,
# so it never touches durable run state; the config half of this same
# incident now has its own safe path anyway (`orchid config commit`).
#
# T029 (dogfood finding F31): that scoped refresh is HALF the remedy, and on
# its own it does not clear this check -- the excluded `.orchid/` paths keep
# their staged deletions, which is the very signature read above. The text is
# no longer written here at all: `orchid status` prints the same recovery, the
# two drifted from correct together, and lib/common.sh's
# orchid_stale_checkout_remedy now holds the single copy (and the argument for
# why it is two commands, in that order).
if orchid_stale_checkout "$repo"; then
  bad "$(orchid_stale_checkout_remedy)"
else
  ok "no stale integration checkout state"
fi
[ -d "$repo/.orchid/plugins" ] && echo "note: repo-local plugins require 'orchid plugins trust <dir>' to execute (see plugins: section above for current trust status, INV-09)"
[ "$fails" -eq 0 ] || exit 1

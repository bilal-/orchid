#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"
repo="${ORCHID_REPO:-$PWD}"

# --greenfield (v1-m2 Task 9): the ONLY new flag. On a repo with an unborn
# HEAD (no commits yet -- `git rev-parse -q --verify HEAD` fails), init is
# where the integration branch first needs a real HEAD to branch from
# (`git branch $integ HEAD` cannot resolve HEAD otherwise), so init mints the
# root commit itself before falling through into the rest of this script
# completely unchanged. On a repo that already has commits, --greenfield is
# a no-op modifier -- the block below never runs (unborn_head=0), and the
# flag is otherwise ignored.
greenfield=0
while [ $# -gt 0 ]; do case "$1" in
  --greenfield) greenfield=1; shift ;;
  *) shift ;;
esac; done

if git -C "$repo" rev-parse -q --verify HEAD >/dev/null 2>&1; then
  unborn_head=0
else
  unborn_head=1
fi

if [ "$unborn_head" -eq 1 ]; then
  [ "$greenfield" -eq 1 ] || \
    orchid_die "no commits yet (unborn HEAD) — run 'orchid init --greenfield' to create a root commit first"
  # Greenfield never adopts a pre-existing pile silently: the directory must
  # be empty apart from .git itself before the root commit is minted. This is
  # a raw directory-listing check, deliberately stronger than `git status
  # --porcelain` below (which would miss a stray file the user's own
  # not-yet-committed .gitignore happens to exclude). orchid_list_dir
  # (lib/common.sh) does the one-level listing with plain globbing --
  # find(1)'s depth-limiting primaries are not POSIX. `grep -Fxv` exits
  # nonzero when nothing survives the .git filter, which under `set -e` +
  # pipefail is exactly the wanted-empty case -- hence `|| true`.
  stray="$(orchid_list_dir "$repo" | grep -Fxv .git || true)"
  if [ -n "$stray" ]; then
    orchid_die "orchid init --greenfield requires an empty directory (found: $(printf '%s' "$stray" | tr '\n' ' ' | sed 's/ *$//')) — greenfield never adopts a pre-existing pile silently"
  fi
  git -C "$repo" commit --allow-empty -m "orchid: root"
fi

[ -z "$(git -C "$repo" status --porcelain)" ] || orchid_die "working tree not clean — commit or stash first (orchid never touches user work)"
integ="$(config_get "$repo" integration_branch orchid/integration)"
state="$(orchid_state "$repo")"; orchid_runtime "$repo" >/dev/null
cur="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
git -C "$repo" rev-parse --verify -q "$integ" >/dev/null && orchid_die "branch $integ exists"
cleanup() {
  rc=$?
  if [ "$rc" -ne 0 ]; then
    # Unstage the skeleton paths, then restore/remove them from the working
    # tree too — a plain `reset` only clears the index and would leave the
    # new files behind as untracked residue after switching branches back.
    git -C "$repo" reset -q "$cur" -- .orchid .gitignore 2>/dev/null || true
    git -C "$repo" checkout -q "$cur" -- .gitignore 2>/dev/null || rm -f "$repo/.gitignore"
    git -C "$repo" checkout -q "$cur" -- .orchid 2>/dev/null || true
    git -C "$repo" clean -fdq -- .orchid 2>/dev/null || true
    git -C "$repo" checkout -q "$cur" 2>/dev/null || true
    git -C "$repo" branch -D "$integ" 2>/dev/null || true
  else
    git -C "$repo" checkout -q "$cur" 2>/dev/null || true
    # v1-m3 Task 2 (F7): "$state/tasks" and "$state/reviews" were mkdir -p'd
    # directly on disk, BEFORE the branch switch to $integ, purely so the
    # `git add .orchid` commit below would have somewhere to look -- git
    # never tracks an empty directory, so neither dir was ever actually
    # committed to $integ either. Checking back out to $cur (which never
    # had .orchid tracked at all) leaves them behind as untracked ghost
    # directories on the OPERATOR'S OWN branch -- exactly the shape
    # orchid_split_brain (lib/common.sh) looks for, so a healthy,
    # just-completed init would otherwise immediately misreport itself as
    # split-brain. `rmdir` only removes an EMPTY directory, so this is a
    # guaranteed no-op in the one case it could matter (some other process
    # already populated one of these before this trap ran).
    rmdir "$state/tasks" "$state/reviews" 2>/dev/null || true
  fi
}
trap cleanup EXIT
git -C "$repo" branch "$integ" HEAD
mkdir -p "$state/tasks" "$state/reviews"
printf -- '---\nrun_status: planning\nrun_id: r-001\n---\n# Roadmap\n' > "$state/roadmap.md"
echo "# Requirements (author by hand, then: orchid requirements import <file>)" > "$state/requirements.md"
echo "# Blockers" > "$state/BLOCKERS.md"
echo "# Baseline" > "$state/baseline.md"
echo "# Journal" > "$state/journal.md"
if ! grep -q '^\.orchid/runtime/$' "$repo/.gitignore" 2>/dev/null; then
  if [ -f "$repo/.gitignore" ] && [ ! -r "$repo/.gitignore" ]; then
    orchid_die "cannot read .gitignore"
  fi
  { if [ -f "$repo/.gitignore" ]; then cat "$repo/.gitignore"; fi; echo ".orchid/runtime/"; } | atomic_write "$repo/.gitignore"
fi
# Task 7: an initial plugins.lock, pinning the default role bindings' plugin
# reality (built-ins included, not just overrides) so a later `verify-lock`/
# `doctor` run can catch drift on so much as a stock built-in adapter.
# Best-effort -- init must never fail because this couldn't run.
ORCHID_REPO="$repo" "$ORCHID_ROOT/bin/orchid" plugins lock >/dev/null 2>&1 || true
git -C "$repo" checkout -q "$integ"
# `-f` on `.orchid` alone, and never on `.gitignore` (T037): a repository
# that already excludes `.orchid/` -- an operator who added that line to keep
# orchid's bookkeeping out of their product, which is a reasonable thing to
# want -- otherwise fails right here, on git's own "paths are ignored by one
# of your .gitignore files", before the run exists at all. The full rationale
# for why run state may be force-staged while orchid.config may not is in
# lib/common.sh's orchid_commit_durable; the short version is that these
# bytes are orchid's own and the run does not exist unless they are
# committed. What that operator actually wants -- run state that never
# reaches their product -- is answered by orchid-merge's containment warning
# and the pre-push run-state guard installed just below, not by leaving init
# broken.
#
# `:(exclude).orchid/runtime` is not optional here: `runtime/` exists on disk
# by this point (orchid_runtime created it above) and `-f` switches off the
# very ignore rule that keeps the lock, the epoch and lease.json out of the
# commit. The exclusion, not the ignore file, is what keeps them out now.
git -C "$repo" add -f -- .orchid ':(exclude).orchid/runtime'
git -C "$repo" add -- .gitignore
git -C "$repo" commit -q -m "orchid: initialize run state"

# v1-m4 Task 2 (push prevention): install `.git/hooks/pre-push` as a
# defense-in-depth guard against pushing orchid-managed refs to origin --
# PROTOCOL.md's Preamble already forbids this outright ("No external
# mutation ... the operator alone moves anything to origin"), but a live run
# violated it anyway (a task branch pushed to origin twice) with nothing in
# place to stop it. `push_guard` (config, default true; any falsy spelling
# -- false, 0, no -- skips installing it, same convention
# role_binding_blocking uses) gates whether this runs at all. Hooks live
# under the git dir, never inside a commit -- `git rev-parse
# --git-common-dir` resolves the SHARED hooks dir even when invoked from a
# worktree (task worktrees all share one hooks dir with the main checkout),
# and is resolved relative to $repo (not the caller's cwd) since init may be
# invoked with ORCHID_REPO pointing elsewhere.
# Never overwrites a pre-existing pre-push hook of the user's own -- that
# hook is authoritative regardless of what it does; skip and say so.
#
# Post-review fix (Important): the template's integration-branch check used
# to `grep orchid.config` at PUSH time -- but a pre-push hook's cwd is
# whatever checkout triggered the push, which for a real task-branch push is
# a TASK WORKTREE, and `orchid.config` is an untracked, repo-root-only file
# that is simply absent there. A customized `integration_branch` would
# silently fall back to the hook's own hardcoded default, bypassing that leg
# of the guard entirely. Fixed by resolving ONCE, here, at install time
# instead -- substituting `__INTEGRATION_BRANCH__` into templates/pre-push.sh
# -- and baking the resolved name into the installed hook file, so the hook
# itself never has to locate or read `orchid.config` again.
#
# The install itself now lives in lib/common.sh's orchid_install_push_guard --
# the escaping, the shared-hooks-dir resolution, the never-overwrite rule and
# the `push_guard` config gate all moved there UNCHANGED, and this call is the
# whole of what used to be here. It moved because this verb runs exactly once
# in a repository's life (line 49 above: `branch $integ exists` is fatal), so
# a repository initialized by an older orchid could never receive a newer hook
# -- the T037 run-state leg included, which is the leg the reported leak needed
# and never had. `orchid start`'s existing-repository path calls the same
# function, which is where such a repository actually gets the upgrade.
orchid_install_push_guard "$repo" "$integ"

echo "initialized: $integ"
# v1-m3 Task 2 operator UX (F7): init just restored the operator onto
# their OWN branch (see `cleanup` above) -- durable .orchid state (the
# roadmap.md just committed) lives only on $integ. Spelling out the
# integration branch and the exact worktree command up front heads off the
# split-brain checkout this task's other half detects: an operator who
# stays on their own branch and runs task verbs there builds untracked
# .orchid state with no roadmap, which `orchid doctor`/`status`/pump now
# flag as split-brain.
echo "integration branch: $integ"
echo "next: git worktree add ../$(basename "$repo")-orchid $integ && cd ../$(basename "$repo")-orchid"

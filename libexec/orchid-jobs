#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/roles.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/envelope.sh"
source "$ORCHID_ROOT/lib/capsuite.sh"; source "$ORCHID_ROOT/lib/ledger.sh"
source "$ORCHID_ROOT/lib/review.sh"; source "$ORCHID_ROOT/lib/hooks.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"; rt="$(orchid_runtime "$repo")"
jobs_dir="$rt/jobs"; spool_dir="$rt/spool"; quarantine_dir="$rt/quarantine"
sub="${1:-}"; shift || true

# Moves $src into quarantine as <basename>.reason-<reason>, never clobbering
# a prior drop of the same basename: on collision, appends .2, .3, ... until
# a free path is found. A same-named forged/replayed file must never destroy
# earlier forensic evidence.
quarantine_file() {
  local src="$1" reason="$2" base dest n
  base="$(basename "$src")"
  dest="$quarantine_dir/$base.reason-$reason"
  n=2
  while [ -e "$dest" ]; do
    dest="$quarantine_dir/$base.reason-$reason.$n"
    n=$((n + 1))
  done
  mv "$src" "$dest"
}

# Kills a stuck job: prefers the process-group signal (so the whole engine
# tree dies), but only when pgid is a real positive group id. pgid can be
# 0/invalid (e.g. a manifest written before an engine actually started, or
# corrupt data); `kill -- -0` in that case would signal OUR OWN process
# group, not the job's — so guard it and fall back to killing pid directly.
kill_stuck() {
  local pgid="$1" pid="$2"
  if [ "$pgid" -gt 0 ] 2>/dev/null; then
    kill -- "-$pgid" 2>/dev/null || true
  elif [ "$pid" -gt 0 ] 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
}

# Parses an ISO-8601 UTC timestamp (the exact shape `orchid-task`'s now()
# emits, e.g. 2026-07-24T12:00:00Z) to epoch seconds; portable across GNU
# date (-d) and BSD/macOS date (-j -f), since jobs check runs on both. Empty
# or unparseable input yields 0, so callers can treat that as "no anchor"
# rather than crashing the tick.
iso_to_epoch() {
  local iso="$1"
  [ -n "$iso" ] || { echo 0; return; }
  date -u -d "$iso" +%s 2>/dev/null && return
  date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" +%s 2>/dev/null && return
  echo 0
}

case "$sub" in
  prepare)
    # tier-1: mints identity + writes the manifest only; never spawns (INV-01).
    verb_lock_guard "$repo"
    epoch_require "$repo"
    task="$1"; role="$2"; operation="$3"; shift 3
    override_engine=""; hook_point=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --engine)
          [ -n "${2:-}" ] || orchid_die "--engine requires a value"
          override_engine="$2"; shift 2 ;;
        --hook)
          [ -n "${2:-}" ] || orchid_die "--hook requires a value"
          hook_point="$2"; shift 2 ;;
        *) orchid_die "usage: orchid jobs prepare <task> <role> <op> [--engine <name>] [--hook <point>]" ;;
      esac
    done
    # `hook` op (v1-m3): --hook <point> is mandatory for it and meaningless
    # for anything else -- caught here, before any manifest/engine work, so
    # a mis-typed op or a stray --hook on a non-hook job never mints a
    # half-configured job.
    if [ "$operation" = hook ]; then
      [ -n "$hook_point" ] || orchid_die "operation 'hook' requires --hook <point>"
      hook_point_valid "$hook_point" || orchid_die "unknown hook point '$hook_point'"
    elif [ -n "$hook_point" ]; then
      orchid_die "--hook is only valid with operation 'hook'"
    fi
    # `plan` (v1-m3): the reserved task id for a plan-scoped critique job
    # (`orchid task create` refuses it as a real task id -- libexec/orchid-
    # task). There is no `.orchid/tasks/plan.md` to read attempts/base/
    # candidate from: attempt instead counts prior critique rounds via the
    # durable `reviews/plan-a*-<role>.json` files reconcile has already
    # landed (same counter this attempt itself will file under), and base/
    # candidate stay empty -- a plan pack has no diff to bind to. Every
    # other task keeps reading its task file exactly as before.
    #
    # v1-m3 final review (IMPORTANT 4): a plan-scoped HOOK job (`role` is the
    # literal string "hook", per the Preamble's launch shape) never files
    # under `plan-a<n>-hook.json` -- reconcile's own hook branch (below, "$m_op
    # = hook") always names the destination `plan-a<n>-hook-<point>.json`,
    # keyed on hook_point, since the role positional carries no meaning for a
    # hook job. Globbing on `plan-a*-$role.json` (i.e. `plan-a*-hook.json`)
    # therefore never matches anything a prior plan-hook attempt actually
    # landed -- every plan hook attempt was silently stuck at 1 forever. Glob
    # on the same hook-point-aware shape reconcile files under instead.
    if [ "$task" = plan ]; then
      attempt=1
      if [ "$operation" = hook ]; then
        for rf in "$state/reviews/plan-a"*"-hook-$hook_point.json"; do
          [ -e "$rf" ] || continue
          attempt=$((attempt + 1))
        done
      else
        for rf in "$state/reviews/plan-a"*"-$role.json"; do
          [ -e "$rf" ] || continue
          attempt=$((attempt + 1))
        done
      fi
      base_sha=""; candidate_sha=""
    else
      tf="$state/tasks/$task.md"
      [ -f "$tf" ] || orchid_die "no task $task"
      attempt=$(( $(fm_get "$tf" attempts) + 1 ))
      base_sha="$(fm_get "$tf" base_sha)"; candidate_sha="$(fm_get "$tf" candidate_sha)"
    fi
    if [ "$operation" = hook ]; then
      # Hook engine resolution (v1-m3): NAME comes from the `hook.<point>=`
      # config binding, never from the role chain -- resolve_role_available
      # is deliberately not consulted here (hooks are name-bound by config,
      # not role-eligibility-bound; this is config-is-policy, INV-05-
      # compatible since the kernel only ever branches on the CONTENTS of a
      # config value, never on a hardcoded plugin name). `--engine`, when
      # given, still must name one of THIS point's bound plugin-ids -- it
      # selects among an already-configured set, it does not add to it (F5's
      # --engine is deliberately more permissive for role dual-review; hook
      # bindings are not).
      hook_bindings="$(hooks_for "$repo" "$hook_point")"
      [ -n "$hook_bindings" ] || \
        { echo "orchid: no hook bound for point '$hook_point' (set hook.$hook_point=<plugin-id>[:required])" >&2; exit 14; }
      # Captured into a plain variable, then matched via herestring -- NOT
      # `hooks_for ... | grep -qxF ...` piped straight off a live producer.
      # Same SIGPIPE-under-pipefail hazard orchid-task's legal() documents
      # (a `grep -q` early-exit can kill a still-writing producer and
      # pipefail then reports ITS signal-kill status instead of grep's own
      # match) -- moot here since hook_bindings is already fully
      # materialized, but the herestring form sidesteps the question
      # entirely rather than relying on that timing.
      bound_ids="$(printf '%s\n' "$hook_bindings" | cut -f1)"
      if [ -n "$override_engine" ]; then
        if ! grep -qxF "$override_engine" <<< "$bound_ids"; then
          bound_list="$(printf '%s' "$bound_ids" | tr '\n' ',')"; bound_list="${bound_list%,}"
          echo "orchid: engine '$override_engine' is not bound to hook point '$hook_point' (bound: $bound_list)" >&2
          exit 14
        fi
        engine="$override_engine"
      else
        engine="$(head -n1 <<< "$bound_ids")"
      fi
      dir="$(resolve_engine_dir "$engine")" \
        || { echo "orchid: engine '$engine' for hook point '$hook_point' not found on search path" >&2; exit 14; }
      hook_kind="$(manifest_get "$dir" kind)"
      case "$hook_kind" in
        engine|hook) ;;
        *) echo "orchid: engine '$engine' is kind=$hook_kind; hook point '$hook_point' requires kind=engine or hook" >&2; exit 14 ;;
      esac
    elif [ -n "$override_engine" ]; then
      # F5: --engine names ANY discovered engine, not just one the role's own
      # failover chain would have picked -- this is how the SECOND dual-
      # review slot (lib/review.sh's review_routing) actually gets launched.
      # Validated exactly like resolve_role_checked/resolve_role_available
      # already validate a chain entry: discovered, then role-eligible
      # (role_eligibility_reason, the single requires/forbids walk) -- never
      # an engine-name branch (INV-05), and never silently accepted.
      dir="$(resolve_engine_dir "$override_engine")" \
        || { echo "orchid: engine '$override_engine' for role '$role' not found on search path" >&2; exit 14; }
      reason="$(role_eligibility_reason "$role" "$dir")" \
        || { echo "orchid: engine $override_engine $reason for role $role" >&2; exit 14; }
      engine="$override_engine"
    else
      # resolve_role_available (v1-m2): walks the role's failover chain and
      # already prints its own "orchid: no eligible engine available for role
      # ..." diagnostic to stderr on failure -- propagate its exit 14 verbatim
      # rather than re-wrapping it (prepare is tier-1: mint-manifest-only, so
      # there is nothing else to clean up here before exiting).
      engine="$(resolve_role_available "$repo" "$role")" || exit 14
    fi
    epoch="$(epoch_current "$repo")"
    suffix="$(xxd -p -l2 /dev/urandom 2>/dev/null || printf '%04x' $$)"
    job_id="j-e${epoch}-${task}-a${attempt}-${suffix}"
    mkdir -p "$jobs_dir" "$spool_dir"
    manifest="$jobs_dir/$job_id.json"; output="$spool_dir/$job_id.json"
    jq -n --arg job_id "$job_id" --arg task "$task" --argjson attempt "$attempt" \
      --arg role "$role" --arg operation "$operation" --arg engine "$engine" \
      --arg log "$rt/logs/$job_id.log" --arg output "$output" \
      --arg base_sha "$base_sha" --arg candidate_sha "$candidate_sha" \
      --arg hook_point "$hook_point" \
      '{job_id:$job_id, task:$task, attempt:$attempt, role:$role, operation:$operation,
        engine:$engine, pid:0, pgid:0, started_at:0, log:$log, output:$output,
        base_sha:$base_sha, candidate_sha:$candidate_sha, hook_point:$hook_point}' | atomic_write "$manifest"
    echo "$manifest"
    ;;
  check)
    # Read-and-runtime-only: reports/kills by pgid, never mutates durable state.
    stall_s=$(( $(config_get "$repo" stall_minutes 10) * 60 ))
    timeout_s=$(( $(config_get "$repo" timeout_minutes 60) * 60 ))
    now="$(date +%s)"
    for f in "$jobs_dir"/*.json; do
      [ -e "$f" ] || continue
      task="$(jq -r .task "$f")"; pid="$(jq -r .pid "$f")"
      # v0b2: task wall-clock backstop — independent of this job's own
      # liveness/status, so checked (and printed) regardless of which of the
      # arms below the same manifest also falls into. Report-only: `jobs
      # check` never kills for a budget overrun, the orchestrator escalates
      # it via protocol (`task advance ... blocked`).
      tf_budget="$state/tasks/$task.md"
      if [ -f "$tf_budget" ]; then
        t_started="$(fm_get "$tf_budget" started_at)"
        t_budget="$(fm_get "$tf_budget" wallclock_budget_s)"
        if [ -n "$t_started" ] && [ -n "$t_budget" ]; then
          t_started_epoch="$(iso_to_epoch "$t_started")"
          if [ "$t_started_epoch" -gt 0 ] && [ $(( now - t_started_epoch )) -gt "$t_budget" ]; then
            printf '%s\tbudget-exceeded\n' "$task"
          fi
        fi
      fi
      if [ "$pid" = 0 ]; then printf '%s\tprepared\n' "$task"; continue; fi
      if ! kill -0 "$pid" 2>/dev/null; then printf '%s\tdead\n' "$task"; continue; fi
      pgid="$(jq -r .pgid "$f")"; log="$(jq -r .log "$f")"; started_at="$(jq -r .started_at "$f")"
      log_mtime="$(file_mtime "$log")"
      if [ "$log_mtime" -gt 0 ] && [ $(( now - log_mtime )) -gt "$stall_s" ]; then
        kill_stuck "$pgid" "$pid"
        printf '%s\tstalled\n' "$task"
      elif [ $(( now - started_at )) -gt "$timeout_s" ]; then
        kill_stuck "$pgid" "$pid"
        printf '%s\ttimeout\n' "$task"
      else
        printf '%s\trunning\n' "$task"
      fi
    done
    ;;
  reconcile)
    # Moves durable state into reviews/ (and deletes manifests), so — despite
    # being otherwise read-and-runtime-only like `check` — this is fenced too.
    verb_lock_guard "$repo"
    epoch_require "$repo"
    mkdir -p "$quarantine_dir" "$state/reviews"
    # v0b2: a spool file bigger than this is quarantined on size alone,
    # before any JSON parsing — a cheap, early defense against a runaway or
    # forged tier-3 adapter dumping an oversized payload into the spool dir.
    spool_max="$(config_get "$repo" spool_max_bytes 262144)"
    for f in "$spool_dir"/*.json; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      sz="$(wc -c < "$f" | tr -d ' ')"
      if [ "$sz" -gt "$spool_max" ]; then
        quarantine_file "$f" oversize
        echo "quarantined: $base (oversize)"
        continue
      fi
      if ! envelope_validate "$f" 2>/dev/null; then
        quarantine_file "$f" malformed
        echo "quarantined: $base (malformed)"
        continue
      fi
      jid="$(envelope_field "$f" .job_id)"
      manifest=""
      for mf in "$jobs_dir"/*.json; do
        [ -e "$mf" ] || continue
        [ "$(jq -r .job_id "$mf")" = "$jid" ] || continue
        manifest="$mf"; break
      done
      if [ -z "$manifest" ]; then
        quarantine_file "$f" unknown-job
        echo "quarantined: $base (unknown-job)"
        continue
      fi
      m_task="$(jq -r .task "$manifest")"; e_task="$(envelope_field "$f" .task)"
      m_base="$(jq -r .base_sha "$manifest")"; m_cand="$(jq -r .candidate_sha "$manifest")"
      m_op="$(jq -r .operation "$manifest")"
      m_role="$(jq -r .role "$manifest")"; m_engine="$(jq -r .engine "$manifest")"
      e_base="$(envelope_field "$f" '.base_sha // empty')"
      e_cand="$(envelope_field "$f" '.candidate_sha // empty')"
      # operation/role/engine: cross-checked against the manifest whenever the
      # envelope carries them. Today's real adapters always carry `operation`
      # (required by envelope_validate whenever status is "ok") and `engine`
      # (its OWN manifest's qualified `id=`, e.g. "orchid/<name>" for a
      # first-party plugin or a third-party publisher's own "acme/<name>" --
      # resolved below via resolve_engine_qualified_id, never assumed); `role`
      # is not currently emitted by any adapter, so this arm is forward-
      # looking (v1 adapters or forged envelopes could add it) — the
      # `// empty` pattern makes all three optional the same way
      # base_sha/candidate_sha already were, so fixtures that omit them are
      # unaffected.
      e_op="$(envelope_field "$f" '.operation // empty')"
      e_role="$(envelope_field "$f" '.role // empty')"
      e_engine="$(envelope_field "$f" '.engine // empty')"
      m_engine_qid="$(resolve_engine_qualified_id "$m_engine")"
      mismatch=0
      [ "$m_task" = "$e_task" ] || mismatch=1
      [ -z "$e_base" ] || [ "$e_base" = "$m_base" ] || mismatch=1
      # candidate_sha cross-check: skipped for IMPLEMENT. For review/critique,
      # candidate_sha is an INPUT (it pins the candidate under review), minted
      # into the manifest at `jobs prepare` time and echoed back by the
      # adapter — so it must still match. For implement, candidate_sha is an
      # OUTPUT the engine produces; the manifest was prepared before any
      # candidate existed (it holds the task's pre-launch, typically empty,
      # value), so it can never equal the real candidate the envelope
      # reports. Cross-checking it here would quarantine every legitimate
      # implement envelope (real dogfood F4). base_sha (the input the engine
      # started from) is still checked above regardless of operation.
      if [ "$m_op" != "implement" ]; then
        [ -z "$e_cand" ] || [ "$e_cand" = "$m_cand" ] || mismatch=1
      fi
      [ -z "$e_op" ] || [ "$e_op" = "$m_op" ] || mismatch=1
      [ -z "$e_role" ] || [ "$e_role" = "$m_role" ] || mismatch=1
      [ -z "$e_engine" ] || [ "$e_engine" = "$m_engine_qid" ] || mismatch=1
      if [ "$mismatch" -eq 1 ]; then
        quarantine_file "$f" mismatch
        echo "quarantined: $base (mismatch)"
        continue
      fi
      attempt="$(jq -r .attempt "$manifest")"; role="$(jq -r .role "$manifest")"
      status="$(envelope_field "$f" .status)"
      verdict="$(envelope_field "$f" '.verdict // "n/a"')"
      retry_after="$(envelope_field "$f" '.retry_after // empty')"
      # A durable reviews/<task>-a<attempt>-<role>.json that already exists
      # (a relaunch of the same attempt landed a second accepted envelope —
      # e.g. a crash-recovery relaunch before `attempts` was bumped) must
      # never be silently overwritten: both are forensic evidence. Keep both
      # via a counter suffix, same pattern as quarantine_file above.
      #
      # `hook` op (v1-m3): filed under `hook-<point>` instead of `<role>` --
      # the role positional carries no meaning for a hook job (engine
      # resolution above never consulted it; it's the config binding by
      # point that named the engine), so it must never appear in the durable
      # filename. `hook_point` rides on the manifest (recorded at prepare
      # time), never the envelope, so this is trustworthy even though the
      # cross-check above never validated a `hook_point` field one way or
      # the other.
      if [ "$m_op" = hook ]; then
        m_hook_point="$(jq -r '.hook_point // empty' "$manifest")"
        dest_base="$state/reviews/$m_task-a$attempt-hook-$m_hook_point"
      else
        dest_base="$state/reviews/$m_task-a$attempt-$role"
      fi
      dest="$dest_base.json"
      n=2
      while [ -e "$dest" ]; do
        dest="$dest_base.$n.json"
        n=$((n + 1))
      done
      mv "$f" "$dest"
      rm -f "$manifest"
      # Ledger-mark from the MANIFEST's engine (never the envelope's
      # self-reported one, even when present -- the cross-check above
      # already quarantined any envelope whose reported engine disagreed,
      # but this is our own durable record, not forgeable input).
      ledger_mark "$repo" "$m_engine" "$status" "$retry_after"
      printf '%s\t%s\t%s\n' "$m_task" "$status" "$verdict"
    done
    ;;
  gc)
    # Runtime-only cleanup: reaps DEAD jobs' litter (manifest -> quarantine,
    # plus its pack dir/request file/log) once past --older-than-s, and
    # separately sweeps orphaned pack/request entries that have no manifest
    # and no pending spool envelope. Unlike prepare/reconcile (which mutate
    # durable state under .orchid/tasks or .orchid/reviews), gc only ever
    # touches runtime/ — manifests, packs, requests, logs, quarantine — so
    # there is nothing here for INV-02's epoch fence to protect; it is
    # deliberately un-fenced (no epoch_require call in this arm). It also
    # never kills anything: it only reaps pids that are ALREADY dead
    # (`kill -0` already failing), so INV-01's tier-1 "no spawn/kill" posture
    # holds trivially — there is no kill call to guard here at all.
    reap_prepared=0
    older_than_s_arg=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --reap-prepared) reap_prepared=1; shift ;;
        --older-than-s)
          [ -n "${2:-}" ] || orchid_die "--older-than-s requires a value"
          older_than_s_arg="$2"; shift 2 ;;
        *) orchid_die "usage: orchid jobs gc [--older-than-s N] | orchid jobs gc --reap-prepared [--older-than-s N]" ;;
      esac
    done
    mkdir -p "$quarantine_dir"
    now="$(date +%s)"

    # --reap-prepared (v1-m4): a SEPARATE, exclusive mode from the ordinary
    # dead-job reap below -- targets EXACTLY the pid==0 "prepared, never
    # launched" manifests the ordinary loop deliberately skips (see its own
    # comment just below), closing the live incident where an orphaned
    # prepare-but-never-launch manifest (e.g. `runners/orchid-launch` dying
    # between `jobs prepare` and the actual spawn) sat forever, re-reported
    # as `prepared` by every `jobs check` call across two whole runs. A
    # never-launched manifest's own `started_at` is always 0 (jobs prepare
    # mints it that way), so age is instead measured off the manifest FILE's
    # own mtime -- the only signal on disk for "how long has this sat
    # prepared". Ordinary `gc` (no --reap-prepared) is UNCHANGED: it still
    # skips every pid==0 manifest outright, so this must be invoked as its
    # own explicit pass (e.g. a separate cron line) rather than folded into
    # the default. Same suspect-fields validation as the dead-job reap below
    # (job_id must match the exact shape `jobs prepare` generates) --
    # quarantined as `.reason-gc-suspect`, never reaped, on any mismatch. No
    # epoch fence here either, for the same reason the whole `gc` arm
    # isn't fenced (runtime-only; see the arm's own header comment).
    if [ "$reap_prepared" -eq 1 ]; then
      older_than_s="${older_than_s_arg:-3600}"
      for f in "$jobs_dir"/*.json; do
        [ -e "$f" ] || continue
        pid="$(jq -r .pid "$f")"
        [ "$pid" = 0 ] || continue   # only never-launched manifests
        mtime="$(file_mtime "$f")"
        age=$(( now - mtime ))
        [ "$age" -gt "$older_than_s" ] || continue   # too young: untouched
        job_id="$(jq -r .job_id "$f")"
        suspect=0
        echo "$job_id" | grep -qE '^j-e[0-9]+-[A-Za-z0-9_-]+-a[0-9]+-[0-9a-f]+$' || suspect=1
        if [ "$suspect" -eq 1 ]; then
          base="$(basename "$f")"
          quarantine_file "$f" gc-suspect
          echo "gc-skip $base (suspect fields)"
          continue
        fi
        quarantine_file "$f" gc-prepared
        rm -rf "$rt/packs/$job_id" "$rt/requests/$job_id.json"
        echo "gc-prepared $job_id"
      done
      exit 0
    fi

    older_than_s="${older_than_s_arg:-$(config_get "$repo" gc_older_than_s 86400)}"
    for f in "$jobs_dir"/*.json; do
      [ -e "$f" ] || continue
      pid="$(jq -r .pid "$f")"
      [ "$pid" != 0 ] || continue          # never started: not "dead", just prepared
      if kill -0 "$pid" 2>/dev/null; then continue; fi   # still alive: untouched
      started_at="$(jq -r .started_at "$f")"
      age=$(( now - started_at ))
      [ "$age" -gt "$older_than_s" ] || continue         # dead but too young: untouched
      job_id="$(jq -r .job_id "$f")"
      log_f="$(jq -r .log "$f")"
      # v0b2: job_id/log are read straight from manifest JSON content, which
      # could be corrupted or hand-edited — they must be validated before
      # being used to build rm -rf targets, or a bad manifest could steer a
      # delete anywhere on disk. job_id must match the exact shape `prepare`
      # generates (no slashes, no ..); log must resolve under $rt/logs/ (no
      # ..). Anything else is suspect: leave every runtime file in place and
      # just quarantine the manifest itself as gc-suspect so it surfaces,
      # instead of silently reaping it.
      suspect=0
      echo "$job_id" | grep -qE '^j-e[0-9]+-[A-Za-z0-9_-]+-a[0-9]+-[0-9a-f]+$' || suspect=1
      case "$log_f" in
        *..*) suspect=1 ;;
      esac
      case "$log_f" in
        "$rt"/logs/*) ;;
        *) suspect=1 ;;
      esac
      if [ "$suspect" -eq 1 ]; then
        base="$(basename "$f")"
        quarantine_file "$f" gc-suspect
        echo "gc-skip $base (suspect fields)"
        continue
      fi
      quarantine_file "$f" gc-dead
      rm -rf "$rt/packs/$job_id" "$rt/requests/$job_id.json" "$log_f"
      echo "gc $job_id"
    done
    # Orphan sweep: a pack dir or request file with no manifest AND no
    # pending spool envelope waiting on it. A job that finished normally
    # (reconcile already deleted its manifest and moved its spool envelope
    # to reviews/) leaves neither pack nor request litter behind on its own,
    # so any pack/request found here with truly nothing referencing it is
    # genuine litter — most commonly from a crash between launch and
    # reconcile. The dead-manifest loop above already removed its own
    # pack/request, so those never reach this loop as orphans too.
    # job_id here is a basename taken from directory enumeration of $p
    # itself (an entry gc just observed on disk under $rt/packs or
    # $rt/requests), never from manifest JSON content — so, unlike the
    # dead-reap loop above, there is no manifest-controlled string here to
    # validate; $p is already a real path rooted under runtime/.
    for p in "$rt/packs"/* "$rt/requests"/*; do
      [ -e "$p" ] || continue
      job_id="$(basename "$p")"; job_id="${job_id%.json}"
      [ -e "$jobs_dir/$job_id.json" ] && continue
      [ -e "$spool_dir/$job_id.json" ] && continue
      rm -rf "$p"
      echo "gc-orphan $p"
    done
    ;;
  review-plan)
    # tier-1, read-only: pure routing diagnostics over durable state + config
    # + engine discovery -- no mutation anywhere, so (unlike prepare/
    # reconcile) this is deliberately NOT epoch-fenced. Consulted by the
    # orchestrator before dispatching each reviewer slot (PROTOCOL, Task 10).
    task="$1"
    tf="$state/tasks/$task.md"
    [ -f "$tf" ] || orchid_die "no task $task"
    review_routing "$repo" "$task"
    ;;
  *) orchid_die "usage: orchid jobs prepare|check|reconcile|gc|review-plan" ;;
esac

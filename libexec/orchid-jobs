#!/usr/bin/env bash
set -euo pipefail
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/envelope.sh"
repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"; rt="$(orchid_runtime "$repo")"
jobs_dir="$rt/jobs"; spool_dir="$rt/spool"; quarantine_dir="$rt/quarantine"
sub="${1:-}"; shift || true

# Moves $src into quarantine as <basename>.reason-<reason>, never clobbering
# a prior drop of the same basename: on collision, appends .2, .3, ... until
# a free path is found. A same-named forged/replayed file must never destroy
# earlier forensic evidence.
quarantine_file() {
  local src="$1" reason="$2" base dest n
  base="$(basename "$src")"
  dest="$quarantine_dir/$base.reason-$reason"
  n=2
  while [ -e "$dest" ]; do
    dest="$quarantine_dir/$base.reason-$reason.$n"
    n=$((n + 1))
  done
  mv "$src" "$dest"
}

# Kills a stuck job: prefers the process-group signal (so the whole engine
# tree dies), but only when pgid is a real positive group id. pgid can be
# 0/invalid (e.g. a manifest written before an engine actually started, or
# corrupt data); `kill -- -0` in that case would signal OUR OWN process
# group, not the job's — so guard it and fall back to killing pid directly.
kill_stuck() {
  local pgid="$1" pid="$2"
  if [ "$pgid" -gt 0 ] 2>/dev/null; then
    kill -- "-$pgid" 2>/dev/null || true
  elif [ "$pid" -gt 0 ] 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
}

case "$sub" in
  prepare)
    # tier-1: mints identity + writes the manifest only; never spawns (INV-01).
    epoch_require "$repo"
    task="$1"; role="$2"; operation="$3"
    tf="$state/tasks/$task.md"
    [ -f "$tf" ] || orchid_die "no task $task"
    engine="$(resolve_role "$repo" "$role")"
    attempt=$(( $(fm_get "$tf" attempts) + 1 ))
    epoch="$(epoch_current "$repo")"
    suffix="$(xxd -p -l2 /dev/urandom 2>/dev/null || printf '%04x' $$)"
    job_id="j-e${epoch}-${task}-a${attempt}-${suffix}"
    mkdir -p "$jobs_dir" "$spool_dir"
    manifest="$jobs_dir/$job_id.json"; output="$spool_dir/$job_id.json"
    jq -n --arg job_id "$job_id" --arg task "$task" --argjson attempt "$attempt" \
      --arg role "$role" --arg operation "$operation" --arg engine "$engine" \
      --arg log "$rt/logs/$job_id.log" --arg output "$output" \
      --arg base_sha "$(fm_get "$tf" base_sha)" --arg candidate_sha "$(fm_get "$tf" candidate_sha)" \
      '{job_id:$job_id, task:$task, attempt:$attempt, role:$role, operation:$operation,
        engine:$engine, pid:0, pgid:0, started_at:0, log:$log, output:$output,
        base_sha:$base_sha, candidate_sha:$candidate_sha}' | atomic_write "$manifest"
    echo "$manifest"
    ;;
  check)
    # Read-and-runtime-only: reports/kills by pgid, never mutates durable state.
    stall_s=$(( $(config_get "$repo" stall_minutes 10) * 60 ))
    timeout_s=$(( $(config_get "$repo" timeout_minutes 60) * 60 ))
    now="$(date +%s)"
    for f in "$jobs_dir"/*.json; do
      [ -e "$f" ] || continue
      task="$(jq -r .task "$f")"; pid="$(jq -r .pid "$f")"
      if [ "$pid" = 0 ]; then printf '%s\tprepared\n' "$task"; continue; fi
      if ! kill -0 "$pid" 2>/dev/null; then printf '%s\tdead\n' "$task"; continue; fi
      pgid="$(jq -r .pgid "$f")"; log="$(jq -r .log "$f")"; started_at="$(jq -r .started_at "$f")"
      log_mtime="$(stat -f %m "$log" 2>/dev/null || stat -c %Y "$log" 2>/dev/null || echo 0)"
      if [ "$log_mtime" -gt 0 ] && [ $(( now - log_mtime )) -gt "$stall_s" ]; then
        kill_stuck "$pgid" "$pid"
        printf '%s\tstalled\n' "$task"
      elif [ $(( now - started_at )) -gt "$timeout_s" ]; then
        kill_stuck "$pgid" "$pid"
        printf '%s\ttimeout\n' "$task"
      else
        printf '%s\trunning\n' "$task"
      fi
    done
    ;;
  reconcile)
    # Moves durable state into reviews/ (and deletes manifests), so — despite
    # being otherwise read-and-runtime-only like `check` — this is fenced too.
    epoch_require "$repo"
    mkdir -p "$quarantine_dir" "$state/reviews"
    # v0b2: a spool file bigger than this is quarantined on size alone,
    # before any JSON parsing — a cheap, early defense against a runaway or
    # forged tier-3 adapter dumping an oversized payload into the spool dir.
    spool_max="$(config_get "$repo" spool_max_bytes 262144)"
    for f in "$spool_dir"/*.json; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      sz="$(wc -c < "$f" | tr -d ' ')"
      if [ "$sz" -gt "$spool_max" ]; then
        quarantine_file "$f" oversize
        echo "quarantined: $base (oversize)"
        continue
      fi
      if ! envelope_validate "$f" 2>/dev/null; then
        quarantine_file "$f" malformed
        echo "quarantined: $base (malformed)"
        continue
      fi
      jid="$(envelope_field "$f" .job_id)"
      manifest=""
      for mf in "$jobs_dir"/*.json; do
        [ -e "$mf" ] || continue
        [ "$(jq -r .job_id "$mf")" = "$jid" ] || continue
        manifest="$mf"; break
      done
      if [ -z "$manifest" ]; then
        quarantine_file "$f" unknown-job
        echo "quarantined: $base (unknown-job)"
        continue
      fi
      m_task="$(jq -r .task "$manifest")"; e_task="$(envelope_field "$f" .task)"
      m_base="$(jq -r .base_sha "$manifest")"; m_cand="$(jq -r .candidate_sha "$manifest")"
      m_op="$(jq -r .operation "$manifest")"
      m_role="$(jq -r .role "$manifest")"; m_engine="$(jq -r .engine "$manifest")"
      e_base="$(envelope_field "$f" '.base_sha // empty')"
      e_cand="$(envelope_field "$f" '.candidate_sha // empty')"
      # operation/role/engine: cross-checked against the manifest whenever the
      # envelope carries them. Today's real adapters always carry `operation`
      # (required by envelope_validate whenever status is "ok") and `engine`
      # (as "orchid/<name>", vs. the manifest's bare resolved name); `role` is
      # not currently emitted by any adapter, so this arm is forward-looking
      # (v1 adapters or forged envelopes could add it) — the `// empty`
      # pattern makes all three optional the same way base_sha/candidate_sha
      # already were, so fixtures that omit them are unaffected.
      e_op="$(envelope_field "$f" '.operation // empty')"
      e_role="$(envelope_field "$f" '.role // empty')"
      e_engine="$(envelope_field "$f" '.engine // empty')"
      mismatch=0
      [ "$m_task" = "$e_task" ] || mismatch=1
      [ -z "$e_base" ] || [ "$e_base" = "$m_base" ] || mismatch=1
      [ -z "$e_cand" ] || [ "$e_cand" = "$m_cand" ] || mismatch=1
      [ -z "$e_op" ] || [ "$e_op" = "$m_op" ] || mismatch=1
      [ -z "$e_role" ] || [ "$e_role" = "$m_role" ] || mismatch=1
      [ -z "$e_engine" ] || [ "$e_engine" = "orchid/$m_engine" ] || mismatch=1
      if [ "$mismatch" -eq 1 ]; then
        quarantine_file "$f" mismatch
        echo "quarantined: $base (mismatch)"
        continue
      fi
      attempt="$(jq -r .attempt "$manifest")"; role="$(jq -r .role "$manifest")"
      status="$(envelope_field "$f" .status)"
      verdict="$(envelope_field "$f" '.verdict // "n/a"')"
      # A durable reviews/<task>-a<attempt>-<role>.json that already exists
      # (a relaunch of the same attempt landed a second accepted envelope —
      # e.g. a crash-recovery relaunch before `attempts` was bumped) must
      # never be silently overwritten: both are forensic evidence. Keep both
      # via a counter suffix, same pattern as quarantine_file above.
      dest="$state/reviews/$m_task-a$attempt-$role.json"
      n=2
      while [ -e "$dest" ]; do
        dest="$state/reviews/$m_task-a$attempt-$role.$n.json"
        n=$((n + 1))
      done
      mv "$f" "$dest"
      rm -f "$manifest"
      printf '%s\t%s\t%s\n' "$m_task" "$status" "$verdict"
    done
    ;;
  *) orchid_die "usage: orchid jobs prepare|check|reconcile" ;;
esac

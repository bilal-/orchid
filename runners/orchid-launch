#!/usr/bin/env bash
set -euo pipefail
# tier-2, effectful: the ONLY engine spawner (INV-06). Everything upstream of
# the spawn line (jobs prepare, pack_build, the request document) is
# read/write-only; only the line marked below ever launches a plugin.
self="$0"
while [ -L "$self" ]; do
  t="$(readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/pack.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/spawn.sh"
source "$ORCHID_ROOT/lib/hooks.sh"

task="${1:-}"; role="${2:-}"; operation="${3:-}"
[ -n "$task" ] && [ -n "$role" ] && [ -n "$operation" ] \
  || orchid_die "usage: orchid-launch <task-id> <role> <operation> [--engine <name>] [--hook <point>]"
shift 3
override_engine=""; hook_point_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --engine)
      [ -n "${2:-}" ] || orchid_die "--engine requires a value"
      override_engine="$2"; shift 2 ;;
    --hook)
      [ -n "${2:-}" ] || orchid_die "--hook requires a value"
      hook_point_arg="$2"; shift 2 ;;
    *) orchid_die "usage: orchid-launch <task-id> <role> <operation> [--engine <name>] [--hook <point>]" ;;
  esac
done

repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"; rt="$(orchid_runtime "$repo")"

# tier-1 mints the job identity + manifest; never spawns (INV-01). --engine
# and --hook are forwarded to prepare VERBATIM -- prepare owns the only
# validation (discovered + role-eligible for --engine on a role job;
# discovered + kind=engine|hook, name-bound by the hook.<point> config, for a
# hook job), this launcher never re-validates either (F5).
prepare_args=("$task" "$role" "$operation")
[ -z "$override_engine" ] || prepare_args+=(--engine "$override_engine")
[ -z "$hook_point_arg" ] || prepare_args+=(--hook "$hook_point_arg")
manifest="$("$ORCHID_ROOT/bin/orchid" jobs prepare "${prepare_args[@]}")"

# T027 rework: RECORD, ON THE MANIFEST ITSELF, that this launcher exited
# without spawning. Everything between here and the spawn line can fail --
# an engine binary that will not resolve, a pack that overflows its budget --
# and each of those leaves behind a manifest that is indistinguishable, on
# disk, from one whose launcher was killed asynchronously (a machine reboot,
# an operator's Ctrl-C, the driver itself being felled mid-pass).
#
# They must not be treated the same, because ONE OF THEM CAN SAY WHY. A
# synchronous non-zero exit is returned to whoever ran this launcher, and when
# that caller is runners/orchid-drive it journals the failure and spends a rung
# of the escalation ladder for it in that same pass. Some passes later the
# driver's ageing sweep meets the corpse of that very failure, and without this
# mark all it can see is "prepared, never launched" -- the launcher's own exit
# status, the single most useful thing anyone will ever learn about the
# incident, is nowhere on disk. So the mark is written by the only process that
# knows it.
#
# WHAT IT IS NOT is a claim that the failure has been ACCOUNTED FOR. It is
# written here, BEFORE that caller has journaled or charged anything, so a pass
# felled in between would leave a manifest asserting "already reported" about a
# failure nobody reported -- and a sweep that skipped on the mark would skip it
# forever. Whether a rung has been spent is decided instead by the receipt the
# charge itself writes (`[ladder job <job_id>]` in the journal; lib/drive.sh's
# drive_failure_charged), which cannot exist before the charge does. This mark
# is diagnosis; that receipt is accounting.
#
# ONLY FOR A LAUNCH THAT NEVER SPAWNED, which is what the pid and log guards
# below decide together -- the same pair every other reader of this manifest
# uses. A failure AFTER the spawn (the pid stamp itself failing, say) leaves an
# engine running with a log and no pid recorded, and that is a different class
# with a different owner: the driver waits on it while its log grows and
# escalates it once as `unstamped` when the log goes quiet. Marking that one
# "already reported" would suppress the only account it ever gets.
#
# Best-effort by construction: this must never turn a launch failure into a
# different launch failure, so every step is guarded and the trap always
# returns 0. A mark that fails to land degrades to exactly the old behaviour
# (the sweep escalates the orphan on age), never to something worse. The pid
# guard also makes it inert after a successful spawn, so the sole writer of
# `pid` is still the stamp below.
#
# `local rc=$?` on its own line, before anything else runs: it is the launcher's
# pending exit status and any command in front of it would replace it.
mark_launch_failure() {
  local rc=$?
  local upd
  [ "$rc" -ne 0 ] || return 0
  [ -f "$manifest" ] || return 0
  [ "$(jq -r '.pid // 0' "$manifest" 2>/dev/null || echo 1)" = 0 ] || return 0
  # `${log:-}` because a failure early enough has not read that field yet; an
  # unset log is an absent log, which is this class.
  if [ -n "${log:-}" ] && [ -e "$log" ]; then return 0; fi
  upd="$(jq --argjson rc "$rc" '.launch_exit = $rc' "$manifest" 2>/dev/null)" || return 0
  [ -n "$upd" ] || return 0
  printf '%s\n' "$upd" | atomic_write "$manifest" || true
  return 0
}
trap mark_launch_failure EXIT

job_id="$(jq -r .job_id "$manifest")"; engine="$(jq -r .engine "$manifest")"
attempt="$(jq -r .attempt "$manifest")"; output="$(jq -r .output "$manifest")"
log="$(jq -r .log "$manifest")"
base_sha="$(jq -r .base_sha "$manifest")"; candidate_sha="$(jq -r .candidate_sha "$manifest")"
# hook_point: read back from the manifest (prepare's own recording), not the
# locally-parsed flag -- authoritative, and "" for every non-hook job.
hook_point="$(jq -r '.hook_point // empty' "$manifest")"

# v1-m4 Task 3 (worktree-read review packs): the engine + its plugin dir are
# resolved HERE, BEFORE pack_build, not down at the spawn site below -- this
# resolution is read-only (no exec; INV-06 only gates the actual spawn line
# further down) so hoisting it is safe, and pack_build needs the resolved
# engine's capability fact to decide whether a big diff may skip diff.patch
# for diff.stat. `exe`/`plugin_dir` are reused unchanged at the spawn site
# below -- resolved exactly once, never twice.
exe="$(resolve_engine_exe "$engine")" || orchid_die "cannot resolve engine '$engine'"
plugin_dir="$(dirname "$exe")"

# Capability fact for pack_build, in the SAME positional slot the hook
# branch already uses for hook_point (mutually exclusive: hook ops never
# reach the review/critique branch, and vice versa) -- pack.sh stays
# resolver-dumb, handed only the fact, never a dir/engine name to resolve
# itself. Built as the space-bounded "have" string idiom (lib/review.sh's
# _review_worktree_capable) rather than `manifest_capabilities | grep -q`:
# this script runs under `set -o pipefail`, and grep -q's early exit on its
# first match would SIGPIPE the manifest_capabilities writer, corrupting the
# pipeline's exit status.
pack_extra="$hook_point"
if [ "$operation" = review ] || [ "$operation" = critique ]; then
  wt_have=" "
  while IFS= read -r wt_atom; do
    [ -n "$wt_atom" ] && wt_have="$wt_have$wt_atom "
  done < <(manifest_capabilities "$plugin_dir" 2>/dev/null)
  case "$wt_have" in *" workspace_read "*) pack_extra="workspace_read=1" ;; esac
fi

pack_dir="$rt/packs/$job_id"
pack_build "$repo" "$task" "$operation" "$pack_dir" "$pack_extra"

# `plan` (v1-m3): the reserved task id has no `.orchid/tasks/plan.md` to
# read at all -- `fm_get` on a nonexistent file is an awk open-failure, not
# an empty read, which under `set -e` would abort this launch outright.
# Guarded the same way pack_build/jobs prepare special-case the id: skip the
# read entirely and fall through to the repo default below.
task_file="$state/tasks/$task.md"
if [ -f "$task_file" ]; then
  worktree="$(fm_get "$task_file" worktree)"
else
  worktree=""
fi
[ -n "$worktree" ] || worktree="$repo"

# hook ops get their own budget (hook_timeout_s, default 600) instead of the
# ordinary implement/review timeout_minutes -- hook handlers are typically
# short-lived middleware (e.g. a guidance lookup), not a full engine session.
if [ "$operation" = hook ]; then
  deadline_s="$(hook_timeout_s "$repo")"
else
  deadline_s=$(( $(config_get "$repo" timeout_minutes 60) * 60 ))
fi
# policy: read-only for everything except implement (hook ops fall through
# to read-only here same as review/critique -- lib/hooks.sh's header note:
# results are applied ONLY by the orchestrator through tier-1 verbs, never
# by the hook handler itself).
case "$operation" in implement) policy=workspace-write ;; *) policy=read-only ;; esac
model="$(config_get "$repo" model "")"
effort="$(config_get "$repo" effort medium)"

mkdir -p "$rt/requests"; req_file="$rt/requests/$job_id.json"
jq -n --arg job_id "$job_id" --arg task "$task" --argjson attempt "$attempt" \
  --arg role "$role" --arg operation "$operation" \
  --arg base_sha "$base_sha" --arg candidate_sha "$candidate_sha" \
  --arg worktree "$worktree" --arg input_pack "$pack_dir" --arg output "$output" \
  --argjson deadline_s "$deadline_s" --arg policy "$policy" \
  --arg model "$model" --arg effort "$effort" --arg hook_point "$hook_point" \
  '{request:1, job_id:$job_id, task:$task, attempt:$attempt, role:$role,
    operation:$operation, base_sha:$base_sha, candidate_sha:$candidate_sha,
    worktree:$worktree, input_pack:$input_pack, output:$output,
    deadline_s:$deadline_s, policy:$policy, model:$model, effort:$effort,
    hook_point:$hook_point}' \
  | atomic_write "$req_file"

# exe/plugin_dir already resolved above (before pack_build) -- reused here
# unchanged, never re-resolved.
mkdir -p "$(dirname "$log")"

# Env hygiene (v1-m1 Task 5; extracted to lib/spawn.sh's spawn_child_env in
# v1-m2 Task 7 so runners/orchid-tick can share it): the child NEVER
# inherits the parent's full environment. It only ever sees a fixed base
# allowlist (PATH HOME USER LANG TERM TMPDIR, any LC_*, any ORCHID_* --
# existing launch/e2e tests depend on ORCHID_* + PATH reaching the child)
# PLUS exactly the env var NAMES this plugin's plugin.conf `permissions=`
# opts into (e.g. permissions=OPENAI_API_KEY). Everything else -- including
# a name like SECRET_LEAK that happens to be set in the orchestrator's own
# environment -- is stripped before spawn. A requested permission absent
# from the parent env is simply not forwarded (nothing to forward); the
# plugin still runs and reports its own auth failure (see lib/manifest.sh's
# manifest_validate warn for the "requested but not set" diagnostic).
child_env=()
while IFS= read -r _line; do
  [ -n "$_line" ] || continue
  child_env+=("$_line")
done < <(spawn_child_env "$plugin_dir")

# T040: RECORD THE ENGINE'S EXIT STATUS, because nothing else on this machine
# ever will. This launcher returns the moment it has spawned; the engine is
# then reparented and nobody waits on it, so by the time `jobs reconcile`
# finds a manifest whose pid is gone and no envelope anywhere, "what exit code
# did it die with" is a question with no answer on disk at all. That was half
# of what made dogfood finding F35 invisible: an operator could see THAT a job
# had vanished, never why.
#
# The engine is therefore wrapped in a subshell that outlives it by exactly
# one write. Every property `jobs check` depends on is preserved: with job
# control on (below), the SUBSHELL is the process-group leader, so pgid ==
# pid still holds, `kill -- -$pgid` still fells the whole tree (engine
# included), and `kill -0 $pid` is still true for precisely as long as the
# engine runs, since the subshell is doing nothing but waiting on it. What
# changes is only that the group has one more, idle, member in it.
#
# Written last-thing-before-exit via a temp file and a rename, so a reader
# never sees a half-written status, and never sees the record at all until it
# is final.
#
# THE RECORDER MUST SURVIVE THE KILL PATHS TOO. `jobs check` answers a
# stalled or timed-out job with a process-GROUP kill (kill_stuck's
# `kill -- -$pgid`), and this subshell is that group's leader -- without a
# handler the TERM felled the recorder before its one write, so reconcile
# journaled "Exit code: unrecorded" in exactly the killed-job case the
# record was added for. `trap :` below is a real handler, NEVER `trap ''`:
# an ignored disposition is inherited across exec, which would make the
# engine itself immune to the group TERM, while a caught one is reset to
# default in the child -- so the engine still dies of the signal as before,
# the subshell finishes its wait, sees the engine's 128+signal status, and
# records it.
mkdir -p "$rt/exits"
exit_file="$rt/exits/$job_id"

# set -m (job control) around the spawn so bash puts the engine in its OWN
# process group (pgid == child pid) instead of inheriting the orchestrator's
# — without this, `jobs check`'s stall/timeout group-kill (kill -- -$pgid)
# would kill the orchestrator itself, since the manifest pgid would be ours.
set -m
if [ "${#child_env[@]}" -gt 0 ]; then
  (
    _rc=0
    trap : TERM INT HUP
    env -i "${child_env[@]}" ORCHID_DRYRUN="${ORCHID_DRYRUN:-0}" "$exe" "$req_file" </dev/null || _rc=$?
    printf '%s\n' "$_rc" > "$exit_file.tmp" && mv -f "$exit_file.tmp" "$exit_file"
  ) >> "$log" 2>&1 &
else
  (
    _rc=0
    trap : TERM INT HUP
    env -i ORCHID_DRYRUN="${ORCHID_DRYRUN:-0}" "$exe" "$req_file" </dev/null || _rc=$?
    printf '%s\n' "$_rc" > "$exit_file.tmp" && mv -f "$exit_file.tmp" "$exit_file"
  ) >> "$log" 2>&1 &
fi
pid=$!
set +m
# With job control enabled above, this single background command is the
# leader of the process group Bash created for it, so its PGID is its PID.
# Derive that value from the spawn operation itself instead of consulting
# the host process table: hardened/vendor sandboxes commonly deny `ps`
# even though process-group signalling remains available, and a `ps` query
# could race a very short-lived adapter.
pgid="$pid"

jq --argjson pid "$pid" --argjson pgid "$pgid" --argjson started_at "$(date +%s)" \
  '.pid=$pid | .pgid=$pgid | .started_at=$started_at' "$manifest" | atomic_write "$manifest"

echo "launched $job_id pid $pid"

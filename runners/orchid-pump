#!/bin/bash -p
set -euo pipefail
# tier-2, LLM-free: the pump is the cron/launchd-friendly front gate in front
# of runners/orchid-drive and (only sometimes) runners/orchid-tick. It NEVER
# builds a prompt or reads an envelope's contents -- only exit codes -- and
# does exactly one shot per invocation. Every no-op outcome below exits 0
# (cron-friendly: "nothing to do right now" is a normal poll result, never an
# error); only when it hands off does its exit code become the driver's or the
# tick's own.
#
# v1.1 Track 2 changed WHAT it hands off to. The deterministic driver
# (`orchid drive`) now gets the pass first and does nearly all of it. An LLM
# orchestrator is woken only when two independent facts agree: the driver
# exited with exactly 16, the dedicated judgment-boundary code, AND `orchid
# run boundary show` reads a recorded boundary back through its own verb.
# Anything else -- a clean pass, a generic failure, or a boundary the driver
# reported without recording -- ends the invocation without spending a token.
#
# Mutual exclusion with a live orchestrator is EXACTLY the lease-staleness
# test below (spec: "mutual exclusion via lease staleness, not flock") -- a
# live orchestrator refreshes runtime/lease.json every tick (`orchid run
# resume`/`refresh-lease`), so the pump only ever acts on an ABANDONED run.

# Capture the scheduler/operator PATH as inert data when this is a direct
# entry. A bin/orchid handoff already carries the original value without
# restoring it. Exclude either value before resolving this script's symlinks.
# The fixed directories are
# machine-local system/package-manager locations supported by Orchid; target
# checkout directories and arbitrary inherited PATH entries are never searched
# while the unattended acknowledgement is being evaluated.  Privileged Bash
# mode in the shebang also suppresses BASH_ENV and imported shell functions.
unset __orchid_entry_defer_restore
if [ "${__orchid_entry_context:-}" != 1 ]; then
  unset __orchid_entry_context __orchid_entry_path_was_set
  unset __orchid_entry_operator_path
  __orchid_entry_context=1
  __orchid_entry_path_was_set="${PATH+x}"
  __orchid_entry_operator_path="${PATH-}"
  export __orchid_entry_context __orchid_entry_path_was_set
  export __orchid_entry_operator_path
fi
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH

self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"
__orchid_entry_defer_restore=1
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/roles.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/capsuite.sh"
source "$ORCHID_ROOT/lib/ledger.sh"; source "$ORCHID_ROOT/lib/spawn.sh"
source "$ORCHID_ROOT/lib/trust.sh"
# For drive_boundary_wakes_orchestrator alone: the pump must not keep its own
# copy of which boundary kinds an orchestrator can act on. lib/drive.sh is
# pure policy (it reads and prints; it never mutates), so sourcing it costs
# the pump nothing and keeps that classification in ONE place.
source "$ORCHID_ROOT/lib/drive.sh"
# ...and lib/capability.sh for the same reason, one question later: whether the
# orchestrator chain's unavailability is a window that reopens or a shortfall
# no pass changes (INV-16). Also pure policy. See the pre-wake probe below.
source "$ORCHID_ROOT/lib/capability.sh"

# `orchid service install` invokes the pump with this internal flag while the
# scheduler itself sends stdout/stderr to /dev/null. The pump does not open the
# repo-local service log until unattended trust has succeeded below. A direct
# invocation has no flag and keeps its diagnostics on the caller's terminal.
pump_service_log=0
case "${1:-}" in
  --service-log) pump_service_log=1; shift ;;
esac
if [ "$#" -ne 0 ]; then
  echo "pump: unknown argument '$1'" >&2
  exit 2
fi

repo="${ORCHID_REPO:-$PWD}"
state="$(orchid_state "$repo")"

# 1. Not initialized (none of `.orchid/tasks`, `.orchid/journal.md`, or
# `.orchid/roadmap.md` exist) -- deliberately checked with `orchid_state`
# alone, BEFORE calling `orchid_runtime` (which `mkdir -p`s
# `.orchid/runtime` as a side effect): an uninitialized directory should be
# left untouched, not seeded with a runtime dir it never asked for. This is
# also the reason the pump cannot simply `exec` the tick unconditionally --
# the tick's own uninitialized guard (via `orchid run resume`) DIES with
# exit 1, whereas a cron-invoked pump polling a not-yet-`orchid init`'d
# directory is a normal, silent no-op, not a failure.
#
# This condition is deliberately the exact complement of orchid_split_brain
# (lib/common.sh): that helper is true when (tasks OR journal) exist
# without roadmap -- so "genuinely uninitialized" must be false on ALL
# THREE, not just tasks/roadmap. v1-m3 Task 2 review finding: the original
# two-file check let a journal.md-only checkout (a task verb wrote a
# journal entry against the wrong checkout, but no task was ever created)
# fall through here as "not an orchid repo" instead of reaching the
# split-brain arm below -- inconsistent with doctor/status, which both use
# the shared helper and flag that same state.
if [ ! -d "$state/tasks" ] && [ ! -f "$state/journal.md" ] && [ ! -f "$state/roadmap.md" ]; then
  echo "pump: not an orchid repo"
  exit 0
fi

# 2. Split-brain checkout (v1-m3 Task 2, F7): step 1 already ruled out
# BOTH tasks/ and roadmap.md being absent, so reaching here with
# roadmap.md still absent means task-verb-built state (tasks/ or
# journal.md) exists without it -- `orchid init` restores the user's own
# branch on exit, and durable .orchid state lives only on the integration
# branch, so this checkout is neither uninitialized (step 1) nor a healthy
# run (step 3, below) -- it's the wrong checkout. Distinct message, never
# spawns.
if orchid_split_brain "$repo"; then
  echo "pump: no roadmap in this checkout (split-brain — run from the integration branch)"
  exit 0
fi

# 3. run_status complete -- never spend quota / spawn anything for a run
# that has nothing left to do. roadmap.md is guaranteed present here (step
# 2 above already exited on its absence).
rs="$(fm_get "$state/roadmap.md" run_status 2>/dev/null || true)"
if [ "$rs" = complete ]; then
  echo "pump: run complete"
  exit 0
fi

# The first potentially effectful operation below is orchid_runtime (which
# creates .orchid/runtime), followed later by an outbox drain and possibly a
# headless tick. Require the operator-authored MACHINE-LOCAL acknowledgement
# before any of those can happen. The side-effect-free "not a repo",
# split-brain, and already-complete diagnostics above remain available on an
# untrusted target.
#
# Under --service-log this is a scheduler invocation whose stdout and stderr
# the cron line / launchd agent send to /dev/null, and the repo-local pump.log
# below cannot be opened before the gate has passed. Tell the gate so it also
# records the refusal in the machine-local trust store, where `orchid doctor`
# will surface it.
if [ "$pump_service_log" -eq 1 ]; then
  unattended_trust_require "$repo" "unattended pump" scheduled || exit 1
else
  unattended_trust_require "$repo" "unattended pump" || exit 1
fi

rt="$(orchid_runtime "$repo")"
if [ "$pump_service_log" -eq 1 ]; then
  # Keep a service log strictly inside the acknowledged checkout. The
  # scheduler must never open a target-controlled path: doing so would let a
  # revoked/replaced repo, or a pump.log symlink, write before this gate ran.
  # Reject symlinked/outside runtime directories and aliased/non-regular log
  # files as well, so the post-gate append cannot escape through a static
  # target-controlled filesystem object.
  repo_physical="$(cd "$repo" 2>/dev/null && pwd -P)" || {
    echo "pump: service logging refused: cannot resolve repository path" >&2
    exit 1
  }
  rt_physical="$(cd "$rt" 2>/dev/null && pwd -P)" || {
    echo "pump: service logging refused: cannot resolve runtime directory" >&2
    exit 1
  }
  case "$rt_physical/" in
    "$repo_physical/"*) ;;
    *)
      echo "pump: service logging refused: runtime directory resolves outside the repository" >&2
      exit 1
      ;;
  esac

  pump_log="$rt/pump.log"
  if [ -L "$pump_log" ]; then
    echo "pump: service logging refused: pump.log must not be a symbolic link" >&2
    exit 1
  fi
  if [ -e "$pump_log" ]; then
    if [ ! -f "$pump_log" ] || [ ! -O "$pump_log" ]; then
      echo "pump: service logging refused: pump.log must be an operator-owned regular file" >&2
      exit 1
    fi
    pump_log_meta="$(_unattended_file_security_metadata "$pump_log")" || {
      echo "pump: service logging refused: cannot inspect pump.log" >&2
      exit 1
    }
    if [ "${pump_log_meta%% *}" != 1 ]; then
      echo "pump: service logging refused: pump.log must not have hard-link aliases" >&2
      exit 1
    fi
  else
    # noclobber makes the initial creation fail closed if another filesystem
    # object appears after the checks above. The following append preserves
    # logs across ordinary scheduled invocations.
    (
      umask 077
      set -o noclobber
      : > "$pump_log"
    ) 2>/dev/null || {
      echo "pump: service logging refused: cannot safely create pump.log" >&2
      exit 1
    }
  fi
  exec >> "$pump_log" 2>&1
fi

_orchid_entry_restore_operator_path

# T035: every job launched below this line -- by the deterministic driver, or
# by an LLM orchestrator this pump wakes -- belongs to the scheduled pump, not
# to an operator sitting at a terminal. Exported once here, ahead of both
# handoffs, so `jobs prepare` records it on each manifest and `orchid jobs ls`
# can tell an operator which of the two started the job they are looking at.
export ORCHID_LAUNCHED_BY=pump

# 4. Lease staleness. `iso_to_epoch` is replicated here (not shared via
# lib/) rather than sourced from libexec/orchid-jobs: runners can't source
# libexec (that's tier-1 verb-dispatch code, not a library), and this
# five-line portable GNU/BSD `date` idiom is small enough that duplicating
# it beats inventing a new lib/*.sh file for one helper used by exactly one
# runner. Kept byte-for-byte equivalent to libexec/orchid-jobs' iso_to_epoch
# so the two never drift on parsing behavior.
_pump_iso_to_epoch() {
  local iso="$1"
  [ -n "$iso" ] || { echo 0; return; }
  date -u -d "$iso" +%s 2>/dev/null && return
  date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" +%s 2>/dev/null && return
  echo 0
}

# _pump_drain_outbox <repo> -- v1-m4 Task 7 (OUTBOX pattern, INV-01):
# `orchid notify` (tier-1) never spawns -- it only WRITES runtime/outbox/
# <qid> (the fully-composed message text, nonce included) when notify.
# channel is configured. The pump (tier-2, this file) is what actually
# LAUNCHES the channel plugin's `send`, on every pass -- called from the
# main body below right after the lease-gate decision (age computed) but
# BEFORE the stale/fresh branch, and thus BEFORE any exec of the tick: a
# fresh lease still drains the outbox (channel-send must never wait for a
# tick; draining is cheap -- a handful of file stats and, at most, one
# `send` spawn per queued question).
#
# `notify.plugin` (default `openclaw`, zero behavior change when unset)
# selects WHICH kind=notify plugin dir the pump launches -- the value is a
# plugin DIRECTORY NAME under plugins/notify/ (resolved through
# resolve_notify_dir, the exact same search path/precedence any other
# notify-plugin lookup uses), e.g. `openclaw` or `hermes` -- never a
# manifest id (plugins/notify/hermes's own id is `orchid/hermes-notify`,
# deliberately distinct from the kind=engine hermes adapter's `orchid/
# hermes`; resolve_notify_dir keys off directory name, not manifest id, so
# that distinction never surfaces here). `notify.channel` stays each
# PLUGIN's OWN inner enum/target string (OpenClaw's own channel name, or a
# hermes platform name, passed straight through) -- a separate axis from
# `notify.plugin`, unchanged by this selector's addition. A second, real
# notify plugin (plugins/notify/hermes) ships starting v1-m4's hermes
# channel task, so the "exactly one channel plugin kind this milestone
# ships" simplification this comment used to describe no longer holds --
# `notify.plugin` is that selector.
#
# Single-pump assumption: the `.tries` sidecar bump below is a plain
# read-modify-write with no lock of its own -- correct only because v1-m4
# assumes a single pump instance drives a given repo (the documented
# operational model: one launchd/cron entry per repo). Two pumps racing the
# same outbox concurrently could under-count a failure (both read the same
# stale `tries` value) and delay quarantine past `send_retry_max` attempts;
# not fixed here, since nothing in this codebase's service packaging
# (`orchid service install`) ever installs more than one.
#
# Direct spawn (not through runners/orchid-launch): acceptable here because
# this IS tier-2 code (same tier orchid-launch itself lives at), so INV-06's
# "launcher-only engine spawning" grep (which only names literal
# `plugins/engines`/`orchid-launch` text outside runners/) never applies to
# a notify-kind plugin dir either way -- but the launcher's OWN env-hygiene
# discipline is still reused verbatim (spawn_child_env, env -i, stdin from
# /dev/null) rather than re-invented, per the brief's own instruction.
_pump_drain_outbox() {
  local repo="$1" box channel to dir ep retry_max f qid text tf rc tries
  local plugin_name resolve_err
  local -a child_env
  box="$(orchid_runtime "$repo")/outbox"
  [ -d "$box" ] || return 0

  channel="$(config_get "$repo" notify.channel "")"
  [ -n "$channel" ] || return 0   # no channel configured: nothing to drain, ever
  to="$(config_get "$repo" notify.to "")"

  # notify.plugin (default "openclaw", see this function's own header) --
  # resolved ONCE per pump pass, not per queued message (every queued
  # message this pass shares the same configured plugin).
  plugin_name="$(config_get "$repo" notify.plugin openclaw)"
  resolve_err=""
  if ! dir="$(resolve_notify_dir "$plugin_name" 2>&1)"; then
    resolve_err="notify channel plugin '$plugin_name' not found on search path ($dir)"
  else
    ep="$(manifest_get "$dir" entrypoint send)"
    if [ ! -x "$dir/$ep" ]; then
      resolve_err="notify channel plugin's entrypoint '$ep' is not executable in $dir"
    fi
  fi

  retry_max="$(config_get "$repo" send_retry_max 5)"

  for f in "$box"/*; do
    [ -f "$f" ] || continue
    case "$f" in
      *.tries|*.reason-send-failed) continue ;;   # sidecar/quarantine files, not queued messages
    esac
    qid="$(basename "$f")"
    text="$(cat "$f")"

    if [ -n "$resolve_err" ]; then
      # notify.plugin itself doesn't resolve to a runnable send entrypoint
      # (missing/mistyped plugin name, or its manifest's own entrypoint
      # isn't executable) -- a CONFIG problem, not a per-message send
      # failure, but it must feed the exact same failure/quarantine path
      # below (never a silent no-op): a permanently-misconfigured
      # notify.plugin must eventually quarantine every queued message with
      # a clear reason, the same as a permanently-broken channel would,
      # rather than retry forever with nothing but a repeated stderr line
      # to show for it. No spawn happens at all in this branch.
      rc=1
    else
      # Env hygiene identical in shape to runners/orchid-launch's own spawn:
      # base allowlist (PATH/HOME/USER/LANG/TERM/TMPDIR, LC_*, ORCHID_*) plus
      # nothing else. ORCHID_NOTIFY_CHANNEL/ORCHID_NOTIFY_TO are exported only
      # for the duration of this spawn_child_env call (bash's temporary-
      # environment-on-a-command-prefix semantics), so they ride the existing
      # ORCHID_* wildcard in without a plugin.conf `permissions=` opt-in.
      child_env=()
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        child_env+=("$line")
      done < <(ORCHID_NOTIFY_CHANNEL="$channel" ORCHID_NOTIFY_TO="$to" spawn_child_env "$dir")

      rc=0
      if [ "${#child_env[@]}" -gt 0 ]; then
        env -i "${child_env[@]}" "$dir/$ep" "$qid" "$text" </dev/null >/dev/null 2>&1 || rc=$?
      else
        env -i "$dir/$ep" "$qid" "$text" </dev/null >/dev/null 2>&1 || rc=$?
      fi
    fi

    if [ "$rc" -eq 0 ]; then
      rm -f "$f" "$box/$qid.tries"
      continue
    fi

    # Failure: bump the .tries sidecar; leave the outbox file for the next
    # pump pass UNLESS this was the send_retry_max'th consecutive failure,
    # in which case quarantine it (rename with a .reason-send-failed
    # sidecar, remove the retried original) so a permanently-broken channel
    # (or a permanently-misconfigured notify.plugin -- resolve_err above)
    # can't retry forever -- BLOCKERS.md + terminal remains the complete
    # surface regardless (docs/specs/operations.md), so a quarantined
    # outbox entry loses nothing an operator can't already see there.
    tf="$box/$qid.tries"
    tries=0
    [ -f "$tf" ] && tries="$(cat "$tf" 2>/dev/null || echo 0)"
    tries=$((tries + 1))
    if [ "$tries" -ge "$retry_max" ]; then
      {
        if [ -n "$resolve_err" ]; then
          echo "send failed $tries time(s) (send_retry_max=$retry_max), quarantined: $resolve_err"
        else
          echo "send failed $tries time(s) (send_retry_max=$retry_max), quarantined"
        fi
        echo "text: $text"
      } > "$box/$qid.reason-send-failed"
      rm -f "$f" "$tf"
      echo "pump: outbox drain: $qid quarantined after $tries failed send attempt(s)${resolve_err:+ ($resolve_err)}" >&2
    else
      printf '%s\n' "$tries" > "$tf"
      if [ -n "$resolve_err" ]; then
        echo "pump: outbox drain: $qid send failed (attempt $tries/$retry_max): $resolve_err -- left for next pass" >&2
      else
        echo "pump: outbox drain: $qid send failed (attempt $tries/$retry_max, rc=$rc) -- left for next pass" >&2
      fi
    fi
  done
}

# _pump_capability_handoff <repo> <detail> <epoch> -- what the pre-wake probe
# does with a chain NO PASS CAN FIX. Prints the operator-facing line, and
# records it exactly once, durably, as a blocker. <epoch> is this pass's own,
# sampled where the drive returned it rather than read here -- see THE EPOCH IS
# THE ONE THE DRIVE JUST FENCED below.
#
# WHY THIS EXISTS AT ALL. Step 6's probe has always exited 0 on an unavailable
# orchestrator, and that is right: a rate limit, an unproven fallback, a plugin
# not installed yet are all things a later pass finds resolved, and a scheduled
# poller saying so on its terminal costs nothing. It is exactly wrong when
# every engine in the chain is short an atom `orchestrate` needs. Then the
# same line prints once per staleness window forever, no human is told, nothing
# is journaled, and the judgment boundary the driver raised -- the one this
# pass came here to wake somebody for -- is never settled by anybody. That is
# the silent dead end INV-16 exists to end, reached through the one dispatch
# path that never goes near `orchid jobs prepare`.
#
# ONE VERB, WHICH IS BOTH HALVES. `orchid notify` journals the text (kind
# `blocker`) BEFORE it appends to BLOCKERS.md, so a single call produces the
# durable journal record AND the operator surface, in that order, epoch-fenced
# and verb-locked like every other durable write. Nothing here writes state
# directly.
#
# DEDUPED ON BLOCKERS.md, which is the RECEIPT that call leaves rather than a
# mark made ahead of it: if the entry is there, the notify happened; if the
# notify died before it, the entry is absent and the next pass re-raises. The
# whole file is searched, not a bounded tail, because this condition persists
# across arbitrarily many passes and a window that scrolled past would start
# one blocker per pass -- which is precisely what the driver's own notify path
# at the foot of runners/orchid-drive guards against by comparing records.
#
# THE JUDGMENT BOUNDARY RECORD IS LEFT ALONE. `runners/orchid-drive` is its
# single routine writer and this pass has just READ it; overwriting it with an
# `operator-handoff` of the pump's own would destroy the record naming the task
# actually waiting, and the driver would re-derive its own next pass -- two
# writers alternating, one journal line each, once per pass, forever. The
# blocker is the surface a human reads (docs/specs/operations.md: BLOCKERS.md
# plus the terminal is complete), and it is raised without touching a record
# somebody else owns.
#
# THE EPOCH IS THE ONE THE DRIVE JUST FENCED, and it is READ AT THAT MOMENT
# rather than here. `orchid notify` is epoch-fenced (INV-02) and the pump owns
# no epoch of its own: this pass is inside the one runners/orchid-drive fenced
# for it, through its own `run resume`, so that value is what the write must
# carry. Sampled here instead, the fence would be vacuous -- whatever epoch is
# current at the instant of the write always satisfies `epoch_require`, so a
# session that fenced a fresh epoch while this pass ran would have its epoch
# silently borrowed. Captured immediately after the drive returns, that case is
# exactly what the refusal below reports.
_pump_capability_handoff() {
  local repo="$1" detail="$2" epoch="$3"
  local line blockers
  line="$(capability_chain_handoff_line orchestrator orchestrate role.orchestrator "$detail")"
  echo "pump: $line"
  blockers="$(orchid_state "$repo")/BLOCKERS.md"
  if [ -f "$blockers" ] && grep -qF "$line" "$blockers"; then
    echo "pump: already recorded for an operator — not raising a second blocker for a fact that has not changed"
    return 0
  fi
  if ! ORCHID_REPO="$repo" ORCHID_EPOCH="$epoch" \
       "$ORCHID_ROOT/bin/orchid" notify "$line" >/dev/null 2>&1; then
    echo "pump: could not record the capability hand-off as a blocker (epoch $epoch) — the line above is the only report of it" >&2
  fi
  return 0
}

lease_file="$rt/lease.json"
now="$(date -u +%s)"

# A MISSING lease file is stale-by-policy ONLY under run_status `running`
# (the brief's own scoping: "crashed before its first refresh" is only a
# meaningful diagnosis once a run is actually under way). `orchid init`
# leaves run_status `planning` and never writes lease.json at all -- PLANNING
# is reserved for interactive drafting (PROTOCOL.md), so a bare "no lease
# yet" here must NOT read as "abandoned run, wake it up." Same reasoning
# covers `accepting`/`blocked`: those states are reached only via a prior
# `running` phase that DID write a lease, so a genuinely missing lease file
# there would be a different anomaly than staleness -- not this gate's job
# to paper over. A PRESENT lease's staleness arithmetic below still applies
# under any non-complete run_status (accepting/blocked included): resuming
# a stale-leased run mid-acceptance or mid-block is legitimate tick work.
if [ ! -f "$lease_file" ]; then
  if [ "$rs" != running ]; then
    echo "pump: run not running (${rs:-unknown}), no lease yet"
    exit 0
  fi
  age=999999999
else
  # v1-m4: `released: true` (orchid run release-lease, PROTOCOL.md
  # COMPLETION) is the clean-session-exit affordance -- the session that
  # wrote this lease is genuinely gone, not merely between refreshes, so it
  # must read as immediately stale here regardless of how recently
  # refreshed_at itself was stamped. Closes the live-run incident where the
  # pump sat blocked for up to pump_stale_s after a session's own final
  # tick, with operators resorting to hand-backdating lease.json.
  released="$(jq -r '.released // false' "$lease_file" 2>/dev/null || echo false)"
  if [ "$released" = true ]; then
    age=999999999
  else
    refreshed_at="$(jq -r '.refreshed_at // ""' "$lease_file" 2>/dev/null || echo "")"
    refreshed_epoch="$(_pump_iso_to_epoch "$refreshed_at")"
    if [ "$refreshed_epoch" -gt 0 ]; then
      age=$(( now - refreshed_epoch ))
    else
      age=999999999   # malformed/unparseable refreshed_at treated as stale
    fi
  fi
fi

# Outbox drain (v1-m4 Task 7): AFTER the lease-gate decision (age is now
# known) but BEFORE either exit below or the tick hand-off further down --
# runs even on the fresh-lease early exit, since channel-send must never
# wait for a tick and a drain pass is cheap. See _pump_drain_outbox's own
# header for the full rationale.
_pump_drain_outbox "$repo"

stale_s="$(config_get "$repo" pump_stale_s 900)"
if [ "$age" -lt "$stale_s" ]; then
  echo "pump: lease fresh (${age}s)"
  exit 0
fi

# 5. DETERMINISTIC DRIVE FIRST (Track 2). Before any thought is given to
# waking an LLM, the deterministic driver gets the whole pass: lease refresh,
# reconcile/check/gc, dispatch, verification, review routing, unambiguous
# approval, one merge, status regeneration. That is nearly all of THE TICK,
# and none of it needs a model. The pump stays LLM-free itself -- it reads the
# driver's EXIT CODE, never its output, exactly as it has always read the
# tick's.
export ORCHID_REPO="$repo"
drive_rc=0
"$ORCHID_ROOT/runners/orchid-drive" || drive_rc=$?
# The epoch this pass is running under, read the instant the drive that fenced
# it returns. Nothing below writes durable state except the capability hand-off
# at step 6b, and that write has to carry THIS pass's epoch rather than
# whatever is current when it happens -- see _pump_capability_handoff.
pass_epoch="$(epoch_current "$repo")"

# SECOND DRAIN, and the one that matters for a boundary. `orchid notify` is
# tier-1 and only ever QUEUES (runtime/outbox/<qid>); this runner is what
# sends. The drain above ran BEFORE the pass, so every blocker the pass itself
# raised -- the judgment boundary no admitted verb can settle, an exhausted
# attempt budget, an exceeded wallclock -- would otherwise sit in the outbox
# until some LATER invocation happened to drain it. That is the wrong way
# round: the whole reason the driver raises those blockers is that a human has
# to hear about them, and the pass that produced one may be the last one
# anybody runs. Draining here reports it through the configured channel in the
# SAME invocation that found it. Cheap and unconditional (no channel
# configured returns immediately), and it changes no exit code below.
#
# One consequence, stated rather than discovered: `send_retry_max` counts
# ATTEMPTS, not passes, so against a permanently-broken channel an invocation
# that reaches this line spends two of them instead of one and a doomed
# message quarantines after about half as many invocations. That bound is what
# the counter is for, and BLOCKERS.md plus the terminal remain the complete
# operator surface either way (docs/specs/operations.md) -- whereas a blocker
# that is never sent at all has no surface but the one nobody is watching.
_pump_drain_outbox "$repo"

if [ "$drive_rc" -eq 0 ]; then
  echo "pump: deterministic drive completed the pass, no judgment boundary"
  exit 0
fi
if [ "$drive_rc" -ne 16 ]; then
  echo "pump: deterministic drive failed (exit $drive_rc)" >&2
  exit "$drive_rc"
fi

# 5b. An LLM is woken for EXACTLY ONE reason: a named judgment boundary the
# deterministic policy refused to resolve. Three independent facts must agree
# before that happens (the third is 5c, just below) -- the driver's exit code
# must be exactly 16 (the dedicated judgment-boundary code, never a generic
# nonzero), AND the boundary must be readable back through its own verb, AND
# an orchestrator must have a procedure that moves it. The verb read is not
# belt-and-braces: exit 16 alone would also be produced by a boundary the
# driver deliberately reports without recording, and a recorded boundary is
# what actually names the task and the reason an orchestrator would be woken
# to judge. No boundary record, no LLM.
boundary_rc=0
boundary_json="$("$ORCHID_ROOT/bin/orchid" run boundary show 2>/dev/null)" || boundary_rc=$?
if [ "$boundary_rc" -ne 16 ]; then
  echo "pump: drive reported a judgment boundary but none is recorded — not waking an orchestrator"
  exit 0
fi

# 5c. And exactly one MORE fact has to hold: waking an orchestrator must be
# able to move this boundary. A `blocked` task, a failed required hook, a
# worktree that cannot be proven to belong to its task -- these recur
# identically on every pass until a HUMAN acts, and PROTOCOL.md hands none of
# them to an orchestrator. Waking a model for one spends a wakeup per pump
# cycle to re-read a record and change nothing; the driver has already
# notified the operator through `orchid notify`, which is what that condition
# actually needs.
#
# That question is not answerable from the boundary KIND alone. It also needs
# the task's CURRENT STATUS (`orchid task arbitrate`, the one write the
# brokered surface admits, refuses anything but `arbitrating`) and the
# `command_surface` of the adapter that would actually be woken (a brokered
# adapter cannot run `orchid run accept` at all, so a finished run is a human's
# job however much COMPLETION reads like an orchestrator procedure). All three
# are structured facts -- a record field, a frontmatter key, a manifest key --
# and none of them is the boundary's reason text.
boundary_kind="$(printf '%s' "$boundary_json" | jq -r '.kind // ""' 2>/dev/null || echo "")"
boundary_task="$(printf '%s' "$boundary_json" | jq -r '.task // ""' 2>/dev/null || echo "")"
boundary_status=""
if [ -n "$boundary_task" ] && [ -f "$state/tasks/$boundary_task.md" ]; then
  boundary_status="$(fm_get "$state/tasks/$boundary_task.md" status)"
fi

# WHAT THIS EXIT IS NOT. Ending the invocation here is not the run stopping.
# The driver walked every task and took every edge policy allowed before it
# reported this boundary (see its own exit-code table): drive's 16 means "a
# decision is outstanding somewhere", never "no further progress is possible".
# So the next scheduled invocation drives the whole roadmap again, and the one
# boundaried task simply re-reports the same record at no cost -- exactly what
# keeps twenty-nine unrelated tasks moving while one arbitration waits for a
# human. The blocker has already been queued by the driver and sent by the
# drain above, so the human hears about it without the run being parked for
# them.
if ! drive_boundary_wakes_orchestrator "$boundary_kind" "$boundary_status" \
     "$(drive_orchestrator_surface "$repo")"; then
  echo "pump: judgment boundary [${boundary_kind:-unknown}] is operator-only — not waking an orchestrator"
  echo "pump: reported to the operator; the pass still advanced every other task, and the next pass will too"
  exit 0
fi

# 6. Dry-check only: is an orchestrator engine currently resolvable at all?
# The engine name itself is discarded -- the tick performs its own
# `resolve_role_available` call once it actually runs, so this is purely a
# GO/NO-GO probe against the exact same ledger/capsuite state the tick will
# see moments later. `2>&1 1>/dev/null` is the classic stdout/stderr swap:
# it captures ONLY resolve_role_available's stderr into `reason` (its own
# stdout -- the engine name on success -- is discarded to /dev/null), with
# no temp file needed.
#
# The STEP is passed for the same reason the tick passes it: an entry that
# cannot perform `orchestrate` must be failed over, not settled on, so this
# probe and the tick agree about which engine would actually be woken.
if reason="$(resolve_role_available "$repo" orchestrator orchestrate 2>&1 1>/dev/null)"; then
  : # an engine is available; fall through to the tick below.
else
  # 6b. NOT EVERY UNAVAILABILITY IS A WAIT. The message above is a poll result
  # -- "come back later" -- and printing it is the whole response only while
  # coming back later can help. Classify before printing it: when every entry
  # in the chain is short an atom the `orchestrate` step needs, no ledger
  # window, no `orchid plugins test` and no install changes the answer, and the
  # judgment boundary this pass came here to wake somebody for would otherwise
  # sit unread forever. That case is handed to an operator instead.
  #
  # ONLY THE FINAL ANSWER IS EMITTED. `reason` (resolve_role_available's own
  # disqualifier list, captured above rather than allowed onto the terminal) is
  # printed on the wait arm and deliberately NOT on the hand-off arm: an
  # operator meeting both a wait and a permanent refusal about one call has to
  # work out which of the two describes their repository, and only one does.
  cap_rc=0
  cap_why="$(capability_role_chain_refusal "$repo" orchestrator orchestrate)" || cap_rc=$?
  if [ "$cap_rc" -eq 1 ]; then
    _pump_capability_handoff "$repo" "$cap_why" "$pass_epoch"
    # Still 0: a hand-off recorded for a human is a normal poll outcome, not a
    # pump failure, and every other no-op arm in this file exits 0 for the same
    # cron-friendly reason.
    exit 0
  fi
  echo "pump: no capable orchestrator available ($reason)"
  exit 0
fi

# 7. Hand off. The tick does its own `run resume` (fencing a fresh epoch and
# refreshing the lease), engine pick, adapter spawn, and ledger marking --
# the pump's job ends here. `exec`, not a plain call: no pump-side work
# remains afterward, so the tick simply replaces this process and its exit
# code becomes the pump's own, verbatim.
exec "$ORCHID_ROOT/runners/orchid-tick"

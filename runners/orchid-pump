#!/bin/bash -p
set -euo pipefail
# tier-2, LLM-free: the pump is the cron/launchd-friendly front gate in front
# of runners/orchid-tick (Task 7). It NEVER builds a prompt or reads an
# envelope's contents -- only exit codes -- and does exactly one shot per
# invocation (recurring packaging is v1-m4). Every no-op outcome below exits
# 0 (cron-friendly: "nothing to do right now" is a normal poll result, never
# an error); only when it hands off to the tick does its exit code become
# the tick's own.
#
# Mutual exclusion with a live orchestrator is EXACTLY the lease-staleness
# test below (spec: "mutual exclusion via lease staleness, not flock") -- a
# live orchestrator refreshes runtime/lease.json every tick (`orchid run
# resume`/`refresh-lease`), so the pump only ever acts on an ABANDONED run.

# Capture the scheduler/operator PATH as inert data, then exclude it before
# even resolving this script's symlinks.  The fixed directories are
# machine-local system/package-manager locations supported by Orchid; target
# checkout directories and arbitrary inherited PATH entries are never searched
# while the unattended acknowledgement is being evaluated.  Privileged Bash
# mode in the shebang also suppresses BASH_ENV and imported shell functions.
unset __orchid_entry_path_was_set __orchid_entry_operator_path
__orchid_entry_path_was_set="${PATH+x}"
__orchid_entry_operator_path="${PATH-}"
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH

_orchid_unattended_restore_operator_path() {
  if [ "$__orchid_entry_path_was_set" = x ]; then
    PATH="$__orchid_entry_operator_path"
    export PATH
  else
    unset PATH
  fi
  unset __orchid_entry_path_was_set __orchid_entry_operator_path
  unset -f _orchid_unattended_restore_operator_path
}

self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/roles.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/capsuite.sh"
source "$ORCHID_ROOT/lib/ledger.sh"; source "$ORCHID_ROOT/lib/spawn.sh"
source "$ORCHID_ROOT/lib/trust.sh"

repo="${ORCHID_REPO:-$PWD}"
state="$(orchid_state "$repo")"

# 1. Not initialized (none of `.orchid/tasks`, `.orchid/journal.md`, or
# `.orchid/roadmap.md` exist) -- deliberately checked with `orchid_state`
# alone, BEFORE calling `orchid_runtime` (which `mkdir -p`s
# `.orchid/runtime` as a side effect): an uninitialized directory should be
# left untouched, not seeded with a runtime dir it never asked for. This is
# also the reason the pump cannot simply `exec` the tick unconditionally --
# the tick's own uninitialized guard (via `orchid run resume`) DIES with
# exit 1, whereas a cron-invoked pump polling a not-yet-`orchid init`'d
# directory is a normal, silent no-op, not a failure.
#
# This condition is deliberately the exact complement of orchid_split_brain
# (lib/common.sh): that helper is true when (tasks OR journal) exist
# without roadmap -- so "genuinely uninitialized" must be false on ALL
# THREE, not just tasks/roadmap. v1-m3 Task 2 review finding: the original
# two-file check let a journal.md-only checkout (a task verb wrote a
# journal entry against the wrong checkout, but no task was ever created)
# fall through here as "not an orchid repo" instead of reaching the
# split-brain arm below -- inconsistent with doctor/status, which both use
# the shared helper and flag that same state.
if [ ! -d "$state/tasks" ] && [ ! -f "$state/journal.md" ] && [ ! -f "$state/roadmap.md" ]; then
  echo "pump: not an orchid repo"
  exit 0
fi

# 2. Split-brain checkout (v1-m3 Task 2, F7): step 1 already ruled out
# BOTH tasks/ and roadmap.md being absent, so reaching here with
# roadmap.md still absent means task-verb-built state (tasks/ or
# journal.md) exists without it -- `orchid init` restores the user's own
# branch on exit, and durable .orchid state lives only on the integration
# branch, so this checkout is neither uninitialized (step 1) nor a healthy
# run (step 3, below) -- it's the wrong checkout. Distinct message, never
# spawns.
if orchid_split_brain "$repo"; then
  echo "pump: no roadmap in this checkout (split-brain — run from the integration branch)"
  exit 0
fi

# 3. run_status complete -- never spend quota / spawn anything for a run
# that has nothing left to do. roadmap.md is guaranteed present here (step
# 2 above already exited on its absence).
rs="$(fm_get "$state/roadmap.md" run_status 2>/dev/null || true)"
if [ "$rs" = complete ]; then
  echo "pump: run complete"
  exit 0
fi

# The first potentially effectful operation below is orchid_runtime (which
# creates .orchid/runtime), followed later by an outbox drain and possibly a
# headless tick. Require the operator-authored MACHINE-LOCAL acknowledgement
# before any of those can happen. The side-effect-free "not a repo",
# split-brain, and already-complete diagnostics above remain available on an
# untrusted target.
unattended_trust_require "$repo" "unattended pump" || exit 1
_orchid_unattended_restore_operator_path

rt="$(orchid_runtime "$repo")"

# 4. Lease staleness. `iso_to_epoch` is replicated here (not shared via
# lib/) rather than sourced from libexec/orchid-jobs: runners can't source
# libexec (that's tier-1 verb-dispatch code, not a library), and this
# five-line portable GNU/BSD `date` idiom is small enough that duplicating
# it beats inventing a new lib/*.sh file for one helper used by exactly one
# runner. Kept byte-for-byte equivalent to libexec/orchid-jobs' iso_to_epoch
# so the two never drift on parsing behavior.
_pump_iso_to_epoch() {
  local iso="$1"
  [ -n "$iso" ] || { echo 0; return; }
  date -u -d "$iso" +%s 2>/dev/null && return
  date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" +%s 2>/dev/null && return
  echo 0
}

# _pump_drain_outbox <repo> -- v1-m4 Task 7 (OUTBOX pattern, INV-01):
# `orchid notify` (tier-1) never spawns -- it only WRITES runtime/outbox/
# <qid> (the fully-composed message text, nonce included) when notify.
# channel is configured. The pump (tier-2, this file) is what actually
# LAUNCHES the channel plugin's `send`, on every pass -- called from the
# main body below right after the lease-gate decision (age computed) but
# BEFORE the stale/fresh branch, and thus BEFORE any exec of the tick: a
# fresh lease still drains the outbox (channel-send must never wait for a
# tick; draining is cheap -- a handful of file stats and, at most, one
# `send` spawn per queued question).
#
# `notify.plugin` (default `openclaw`, zero behavior change when unset)
# selects WHICH kind=notify plugin dir the pump launches -- the value is a
# plugin DIRECTORY NAME under plugins/notify/ (resolved through
# resolve_notify_dir, the exact same search path/precedence any other
# notify-plugin lookup uses), e.g. `openclaw` or `hermes` -- never a
# manifest id (plugins/notify/hermes's own id is `orchid/hermes-notify`,
# deliberately distinct from the kind=engine hermes adapter's `orchid/
# hermes`; resolve_notify_dir keys off directory name, not manifest id, so
# that distinction never surfaces here). `notify.channel` stays each
# PLUGIN's OWN inner enum/target string (OpenClaw's own channel name, or a
# hermes platform name, passed straight through) -- a separate axis from
# `notify.plugin`, unchanged by this selector's addition. A second, real
# notify plugin (plugins/notify/hermes) ships starting v1-m4's hermes
# channel task, so the "exactly one channel plugin kind this milestone
# ships" simplification this comment used to describe no longer holds --
# `notify.plugin` is that selector.
#
# Single-pump assumption: the `.tries` sidecar bump below is a plain
# read-modify-write with no lock of its own -- correct only because v1-m4
# assumes a single pump instance drives a given repo (the documented
# operational model: one launchd/cron entry per repo). Two pumps racing the
# same outbox concurrently could under-count a failure (both read the same
# stale `tries` value) and delay quarantine past `send_retry_max` attempts;
# not fixed here, since nothing in this codebase's service packaging
# (`orchid service install`) ever installs more than one.
#
# Direct spawn (not through runners/orchid-launch): acceptable here because
# this IS tier-2 code (same tier orchid-launch itself lives at), so INV-06's
# "launcher-only engine spawning" grep (which only names literal
# `plugins/engines`/`orchid-launch` text outside runners/) never applies to
# a notify-kind plugin dir either way -- but the launcher's OWN env-hygiene
# discipline is still reused verbatim (spawn_child_env, env -i, stdin from
# /dev/null) rather than re-invented, per the brief's own instruction.
_pump_drain_outbox() {
  local repo="$1" box channel to dir ep retry_max f qid text tf rc tries
  local plugin_name resolve_err
  local -a child_env
  box="$(orchid_runtime "$repo")/outbox"
  [ -d "$box" ] || return 0

  channel="$(config_get "$repo" notify.channel "")"
  [ -n "$channel" ] || return 0   # no channel configured: nothing to drain, ever
  to="$(config_get "$repo" notify.to "")"

  # notify.plugin (default "openclaw", see this function's own header) --
  # resolved ONCE per pump pass, not per queued message (every queued
  # message this pass shares the same configured plugin).
  plugin_name="$(config_get "$repo" notify.plugin openclaw)"
  resolve_err=""
  if ! dir="$(resolve_notify_dir "$plugin_name" 2>&1)"; then
    resolve_err="notify channel plugin '$plugin_name' not found on search path ($dir)"
  else
    ep="$(manifest_get "$dir" entrypoint send)"
    if [ ! -x "$dir/$ep" ]; then
      resolve_err="notify channel plugin's entrypoint '$ep' is not executable in $dir"
    fi
  fi

  retry_max="$(config_get "$repo" send_retry_max 5)"

  for f in "$box"/*; do
    [ -f "$f" ] || continue
    case "$f" in
      *.tries|*.reason-send-failed) continue ;;   # sidecar/quarantine files, not queued messages
    esac
    qid="$(basename "$f")"
    text="$(cat "$f")"

    if [ -n "$resolve_err" ]; then
      # notify.plugin itself doesn't resolve to a runnable send entrypoint
      # (missing/mistyped plugin name, or its manifest's own entrypoint
      # isn't executable) -- a CONFIG problem, not a per-message send
      # failure, but it must feed the exact same failure/quarantine path
      # below (never a silent no-op): a permanently-misconfigured
      # notify.plugin must eventually quarantine every queued message with
      # a clear reason, the same as a permanently-broken channel would,
      # rather than retry forever with nothing but a repeated stderr line
      # to show for it. No spawn happens at all in this branch.
      rc=1
    else
      # Env hygiene identical in shape to runners/orchid-launch's own spawn:
      # base allowlist (PATH/HOME/USER/LANG/TERM/TMPDIR, LC_*, ORCHID_*) plus
      # nothing else. ORCHID_NOTIFY_CHANNEL/ORCHID_NOTIFY_TO are exported only
      # for the duration of this spawn_child_env call (bash's temporary-
      # environment-on-a-command-prefix semantics), so they ride the existing
      # ORCHID_* wildcard in without a plugin.conf `permissions=` opt-in.
      child_env=()
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        child_env+=("$line")
      done < <(ORCHID_NOTIFY_CHANNEL="$channel" ORCHID_NOTIFY_TO="$to" spawn_child_env "$dir")

      rc=0
      if [ "${#child_env[@]}" -gt 0 ]; then
        env -i "${child_env[@]}" "$dir/$ep" "$qid" "$text" </dev/null >/dev/null 2>&1 || rc=$?
      else
        env -i "$dir/$ep" "$qid" "$text" </dev/null >/dev/null 2>&1 || rc=$?
      fi
    fi

    if [ "$rc" -eq 0 ]; then
      rm -f "$f" "$box/$qid.tries"
      continue
    fi

    # Failure: bump the .tries sidecar; leave the outbox file for the next
    # pump pass UNLESS this was the send_retry_max'th consecutive failure,
    # in which case quarantine it (rename with a .reason-send-failed
    # sidecar, remove the retried original) so a permanently-broken channel
    # (or a permanently-misconfigured notify.plugin -- resolve_err above)
    # can't retry forever -- BLOCKERS.md + terminal remains the complete
    # surface regardless (docs/specs/operations.md), so a quarantined
    # outbox entry loses nothing an operator can't already see there.
    tf="$box/$qid.tries"
    tries=0
    [ -f "$tf" ] && tries="$(cat "$tf" 2>/dev/null || echo 0)"
    tries=$((tries + 1))
    if [ "$tries" -ge "$retry_max" ]; then
      {
        if [ -n "$resolve_err" ]; then
          echo "send failed $tries time(s) (send_retry_max=$retry_max), quarantined: $resolve_err"
        else
          echo "send failed $tries time(s) (send_retry_max=$retry_max), quarantined"
        fi
        echo "text: $text"
      } > "$box/$qid.reason-send-failed"
      rm -f "$f" "$tf"
      echo "pump: outbox drain: $qid quarantined after $tries failed send attempt(s)${resolve_err:+ ($resolve_err)}" >&2
    else
      printf '%s\n' "$tries" > "$tf"
      if [ -n "$resolve_err" ]; then
        echo "pump: outbox drain: $qid send failed (attempt $tries/$retry_max): $resolve_err -- left for next pass" >&2
      else
        echo "pump: outbox drain: $qid send failed (attempt $tries/$retry_max, rc=$rc) -- left for next pass" >&2
      fi
    fi
  done
}

lease_file="$rt/lease.json"
now="$(date -u +%s)"

# A MISSING lease file is stale-by-policy ONLY under run_status `running`
# (the brief's own scoping: "crashed before its first refresh" is only a
# meaningful diagnosis once a run is actually under way). `orchid init`
# leaves run_status `planning` and never writes lease.json at all -- PLANNING
# is reserved for interactive drafting (PROTOCOL.md), so a bare "no lease
# yet" here must NOT read as "abandoned run, wake it up." Same reasoning
# covers `accepting`/`blocked`: those states are reached only via a prior
# `running` phase that DID write a lease, so a genuinely missing lease file
# there would be a different anomaly than staleness -- not this gate's job
# to paper over. A PRESENT lease's staleness arithmetic below still applies
# under any non-complete run_status (accepting/blocked included): resuming
# a stale-leased run mid-acceptance or mid-block is legitimate tick work.
if [ ! -f "$lease_file" ]; then
  if [ "$rs" != running ]; then
    echo "pump: run not running (${rs:-unknown}), no lease yet"
    exit 0
  fi
  age=999999999
else
  # v1-m4: `released: true` (orchid run release-lease, PROTOCOL.md
  # COMPLETION) is the clean-session-exit affordance -- the session that
  # wrote this lease is genuinely gone, not merely between refreshes, so it
  # must read as immediately stale here regardless of how recently
  # refreshed_at itself was stamped. Closes the live-run incident where the
  # pump sat blocked for up to pump_stale_s after a session's own final
  # tick, with operators resorting to hand-backdating lease.json.
  released="$(jq -r '.released // false' "$lease_file" 2>/dev/null || echo false)"
  if [ "$released" = true ]; then
    age=999999999
  else
    refreshed_at="$(jq -r '.refreshed_at // ""' "$lease_file" 2>/dev/null || echo "")"
    refreshed_epoch="$(_pump_iso_to_epoch "$refreshed_at")"
    if [ "$refreshed_epoch" -gt 0 ]; then
      age=$(( now - refreshed_epoch ))
    else
      age=999999999   # malformed/unparseable refreshed_at treated as stale
    fi
  fi
fi

# Outbox drain (v1-m4 Task 7): AFTER the lease-gate decision (age is now
# known) but BEFORE either exit below or the tick hand-off further down --
# runs even on the fresh-lease early exit, since channel-send must never
# wait for a tick and a drain pass is cheap. See _pump_drain_outbox's own
# header for the full rationale.
_pump_drain_outbox "$repo"

stale_s="$(config_get "$repo" pump_stale_s 900)"
if [ "$age" -lt "$stale_s" ]; then
  echo "pump: lease fresh (${age}s)"
  exit 0
fi

# 5. Dry-check only: is an orchestrator engine currently resolvable at all?
# The engine name itself is discarded -- the tick performs its own
# `resolve_role_available` call once it actually runs, so this is purely a
# GO/NO-GO probe against the exact same ledger/capsuite state the tick will
# see moments later. `2>&1 1>/dev/null` is the classic stdout/stderr swap:
# it captures ONLY resolve_role_available's stderr into `reason` (its own
# stdout -- the engine name on success -- is discarded to /dev/null), with
# no temp file needed.
if reason="$(resolve_role_available "$repo" orchestrator 2>&1 1>/dev/null)"; then
  : # an engine is available; fall through to the tick below.
else
  echo "pump: no capable orchestrator available ($reason)"
  exit 0
fi

# 6. Hand off. The tick does its own `run resume` (fencing a fresh epoch and
# refreshing the lease), engine pick, adapter spawn, and ledger marking --
# the pump's job ends here. `exec`, not a plain call: no pump-side work
# remains afterward, so the tick simply replaces this process and its exit
# code becomes the pump's own, verbatim.
export ORCHID_REPO="$repo"
exec "$ORCHID_ROOT/runners/orchid-tick"

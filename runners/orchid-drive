#!/usr/bin/env bash
set -euo pipefail
# tier-2: the DETERMINISTIC one-pass driver (Track 2). Executes exactly one
# pass of PROTOCOL.md's THE TICK -- lease refresh, reconcile/check/gc in that
# order, safe dispatch, implementer reconciliation, verification, reviewer
# routing and reconciliation, deterministic approval where policy is
# unambiguous, one serialized merge, status regeneration, final lease refresh
# -- and then exits. It is a RUNNER, not a tier-1 verb, for one reason: a pass
# legitimately spawns role jobs, and only tier-2 may spawn (INV-01/INV-06).
# `orchid drive` (libexec/orchid-drive) is a bare handoff to this file.
#
# THE TWO RULES THIS FILE EXISTS TO KEEP:
#
#   1. It never makes a free-form judgment. Every decision below reads a
#      STRUCTURED FIELD (a frontmatter key, an envelope field the kernel
#      already validates, an archetype's declared transitions, a schedule
#      predicate, an exit code) -- never prose. There is no summary parsing,
#      no "looks approved to me", nothing that could be nudged by text a
#      target repository or an engine reply happens to contain. Where policy
#      is ambiguous it STOPS at a named judgment boundary instead of guessing.
#   2. It never writes `.orchid/` itself. Every durable or cross-process
#      mutation -- task status, candidate/base sha, worktree registration,
#      journal entries, the boundary record, the merge -- goes through a named
#      verb with single-writer ownership. The only files this runner creates
#      anywhere are the ones `git worktree add` makes for a dispatch checkout,
#      outside `.orchid/` entirely. INV-13 statically enforces both rules.
#
# Unattended trust: this runner does NOT gate on the machine-local
# acknowledgement, deliberately. It is an operator-invokable verb in exactly
# the sense `orchid merge` or the tier-2 role spawner already are -- it starts
# role adapters against a task's own worktree, but it never hands a shell-
# capable orchestrator the whole repository and a free-form prompt. The gate
# that does exist stays where that risk is: `runners/orchid-pump` refuses
# before it ever reaches this file, and `runners/orchid-tick` refuses before
# it wakes an LLM.

self="$0"
while [ -L "$self" ]; do
  t="$(readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(dirname "$self")/.." && pwd -P)"
export ORCHID_ROOT

source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/roles.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/envelope.sh"
source "$ORCHID_ROOT/lib/capsuite.sh"; source "$ORCHID_ROOT/lib/ledger.sh"
source "$ORCHID_ROOT/lib/review.sh"; source "$ORCHID_ROOT/lib/archetype.sh"
source "$ORCHID_ROOT/lib/schedule.sh"; source "$ORCHID_ROOT/lib/hooks.sh"
source "$ORCHID_ROOT/lib/drive.sh"; source "$ORCHID_ROOT/lib/capability.sh"
source "$ORCHID_ROOT/lib/handoff.sh"
# findings.sh for findings_log_gate_failed alone: the merging arm at the
# bottom of this file has to tell a `gate_failed` merge from a
# `validation_failed` one, and that answer is a field in the merge log's
# header. Read through the file that owns reading those headers rather than
# re-parsed here.
source "$ORCHID_ROOT/lib/findings.sh"
source "$ORCHID_ROOT/lib/rework.sh"

# T035: name the automation that owns this pass, so every job launched from it
# records who started it (`orchid jobs ls`'s LAUNCHER column). `:-` because
# runners/orchid-pump sets `pump` around the drive it invokes and that is the
# more useful attribution of the two: it is what distinguishes a job the
# scheduled pump started from one the operator started by hand in a terminal,
# and during the wasiyyat run those two wanted different responses and could
# not be told apart at all. Read only by `jobs prepare`, which sanitizes it.
export ORCHID_LAUNCHED_BY="${ORCHID_LAUNCHED_BY:-drive}"

usage() {
  cat <<'EOF'
usage: orchid drive [--help]

Runs exactly ONE deterministic pass of THE TICK against $ORCHID_REPO (or the
current directory): refresh the lease, reconcile -> check -> gc, walk every
task through whatever edge its archetype declares, regenerate the status page,
refresh the lease again.

The only decision it makes on its own is an unambiguous arbitration: every
required review valid and bound to the task's current candidate_sha, every
verdict `approve`, every review scope-complete, and no finding at or above the
task's blocking_severity. How much that last clause does depends on the
reviewer's adapter, and this file deliberately names none of them -- INV-13
forbids the driver from referencing a plugin path, and INV-14 from branching on
an engine identifier, so the distinction below is drawn by CAPABILITY. An
adapter that asks a review for `FINDING: <low|medium|high>: <title>` lines and
parses them makes the clause LIVE: one finding at or above the task's own
blocking_severity (`orchid task show <id>`; `medium` is only the fallback when
the field is absent, and the shipped archetypes do not agree on one) stops the
pass at a judgment boundary even though every verdict said `approve`. An
adapter that asks for a VERDICT line only writes findings[] empty on every
review it files, and on an APPROVING one from it approval rests on verdict +
scope_complete.
The shipped review adapters are split between those two shapes, and this text
claims nothing about which shape the reviewer YOU have bound is: read that
adapter's own reply contract, or PROTOCOL.md's deterministic-approval arm,
before reading a clean gate as a second opinion you are already getting. On an
approving review an empty findings[] blocks nothing either way -- a reviewer
that found nothing is a valid review, not a missing one.

On a review that WITHHOLDS approval it does not stay empty, and an operator
reading the filed envelope should know why the entry is there. An objection
that exists only as prose contributes nothing to any severity gate, so
`orchid jobs reconcile` composes ONE finding from that review's free-text
summary as it files the envelope, at severity `high` -- the one rank no task's
blocking_severity filters out -- and prints a `synthesized-finding:` line
naming the file it landed in. Such an entry is tagged `synthesized: true` and
carries the summary whole in its detail: it is the kernel's fail-closed
reading of a withheld verdict, never the reviewer's own severity call. An
adapter that files its own findings is never touched, so the way to keep the
severity yours is to report it.

That leaves one case neither of those reaches, and the deterministic approval
now DISCLOSES it rather than reading the same whichever way it went: a clean
`no finding at or above <severity>` says nothing about whether the gate weighed
six findings that all ranked below the threshold or weighed an empty array. So
the approval line carries the count -- either `N finding(s) filed ... and
weighed against it`, or, when nothing was filed at all, `NO findings were
filed ... so the severity gate weighed an empty array and this approval rests
on verdict + scope_complete alone`. That second sentence is the routine and
correct reading for a verdict-only adapter; it is a disclosure, not a warning,
and it changes no decision.

At risk_tier `medium` or `high` that arbitration also needs DEPTH: at least one
of the counted reviews has to be credited to a `worktree` slot -- one routed to
an engine that could open a file the diff never showed it (manifest capability
`workspace_read`). Drawn by capability again, never by engine name, and read
from the plan PINNED for the attempt rather than from the manifests as they
stand when this pass runs: a review's depth is settled when it is dispatched,
so uninstalling or rebinding an engine afterwards can neither withdraw nor
grant it. That plan is where the claim comes from or it comes from nowhere: a
pin that is missing, unreadable, empty or bound to a candidate the task has
moved off is reported the same way, naming which of the four it was, rather
than answered from a table computed after the reviews were filed. Without one
this pass reports unproven review depth and stops at a `review-evidence`
boundary rather than approving; `orchid task arbitrate` settles it, so an
install whose only reviewers are inline is slowed to a human decision per
medium-tier task, never blocked. `low` asks for no depth at all, and no
reviewer slot is ever withheld for being inline.

At most one judgment boundary is recorded per pass. A boundary a woken
orchestrator could actually settle outranks one only an operator can, and
task-id order decides among equals. That ranking decides which stop is RECORDED
and nothing else: a stop that loses the slot does not lose its page. "Could
settle" is computed per boundary,
not per kind: it needs a verb that records the result, an adapter whose
command surface admits that verb, and a task status that verb accepts -- so a
review boundary is arbitrable from `arbitrating` and operator-only from
`reviewing`. Every boundary the pass meets is printed either way, and one no
admitted verb can settle also raises one `orchid notify` blocker per distinct
STOP, because runners/orchid-pump deliberately wakes no model for it. That
blocker DECLARES ITS ANSWER SET where the kind has one (lib/drive.sh's
drive_boundary_choices), so the page an operator reads names the answers
`orchid answer` will accept instead of leaving `<choice>` to be guessed; kinds
with no enumerable set declare none and keep the free-text contract. That set is
computed from the SAME status the ranking used, for the same reason: from
`reviewing` a review page names the review-plan remedies its reason text points
at, and from `arbitrating` it names the arbitration results -- naming the
arbitration results from `reviewing` would invite three answers whose verb
exits 3 while refusing the two that would have worked.

"Per distinct stop" is the WHOLE page budget, and it is a budget in both
directions -- no stop is asked about twice, and no stop goes unasked. When a
pass blocks a task -- attempts exhausted, the wallclock backstop, a merge whose
gate stayed red -- it does not page and then record; it records the blocked-task
boundary the block produced, in the same words the walk will compose for that
task on every later pass, and the de-dup at the foot of this file does the rest.
A notify raised outside that route is de-duplicated against nothing, so it is a
second question for one decision: the operator answers one qid, and the others
stand in BLOCKERS.md until answer_expiry_s turns them into refusals.

The other direction is why the budget counts STOPS and not records. Only one
boundary is recorded per pass, so reading the budget off the record left every
stop that lost the ranking with nothing to be compared against and no page at
all -- and blocked tasks all rank equal, so one of them held the slot on every
pass while the rest of a parked run stayed silent. The pass therefore pages every
operator-only stop it met, and asks per stop whether a page for THAT TASK
carrying that exact text is already on record (lib/drive.sh's
drive_page_on_record: a question still awaiting an answer, or one already
answered, is that stop's page; one that expired unanswered is not, because
`orchid answer` would now refuse it). The subject is compared as well as the
text because most boundary reasons do not name their task -- two tasks failing
the same hook compose the identical sentence -- and a subject-blind match reads
the second one's stop as the first one's page. The boundary RECORD is consulted
only as a fallback, for a stop whose inbox holds nothing at all: it is durable
and a blocked task's never changes, so consulting it first meant an expired page
could never be re-raised.

Between an implementer's envelope reconciling and `orchid verify` running,
some candidates need execution-requiring mechanical work an engine profile
cannot do at all: a lint fix, the mode bit on a newly added executable, a
generator whose output is checked in (but never an artifact derived from the
whole tree, such as a release-archive checksum — those belong to the
integration branch) — and committing it moves the tree out from under the
candidate the implementer's envelope was captured against. Where
`handoff_before_verify` asks for that pause, a pass stops at an
`operator-handoff` boundary instead of verifying — verifying first would
spend one of the task's rework rounds on a failure nobody was going to
fix in that round. The stop is on a durable acknowledgement bound to a
candidate (`orchid task handoff <id> --ack --reason "..."`, which advances
candidate_sha to the commit the hand-off itself produced — refusing a HEAD that
does not descend from the current candidate or does not sit on the task's
branch — and binds to that),
not on the moment, so a resumed session proceeds once it has been made and
stops again the moment a rebase, a fresh rework round, or one more commit moves
the tree out from under it. The boundary is operator-only by design: no verb an
orchestrator can run performs the work.

A task that declares an `operator_prerequisite` -- a step outside the sandbox
its verification depends on, canonically applying to the test database the
migration that task itself authored -- is NOT verified until an operator
acknowledges that step for the current candidate (`orchid task prereq-ack
<id> --reason "..."`). Until then the pass stops at a `task-prerequisite`
boundary: no suite run, no evidence written, no attempt spent, so an
environment problem is never recorded as a failing candidate. The
acknowledgement holds only for the `candidate_sha` it was given for, so it
stops counting the moment that candidate is superseded -- by any route into
`rework` (which clears it outright) and by merge's rebase-reset (which mints
a new candidate without passing through `rework` at all).

The same condition stops the same pass at `merging`, not only at `testing`:
`orchid merge` re-runs that same suite against that same store before it
touches the integration ref, so it refuses on the same predicate (exit 16)
and this driver raises the same `task-prerequisite` boundary. Gating one
stage and not the other would forgive an unapplied migration in `testing` and
charge it at merge, where the failure arm sends the task to `rework` and it
reads as a candidate defect.

The two stops are distinct and a task can be held by both. The hand-off is
repository config about mechanical work INSIDE the candidate; the prerequisite
is a per-task declaration about the world OUTSIDE it. The hand-off is raised
first, and that order matters: acknowledging it advances candidate_sha, which
would expire a prerequisite acknowledgement taken before it.

A pass that reads every task as `done` takes COMPLETION's mechanical first
step (`orchid run advance accepting`) and stops at a `run-complete` boundary,
so a finished headless run hands off instead of polling forever. Against a
brokered orchestrator that boundary is a blocker for a human: the broker
refuses `orchid run accept`, so no model can close the run.

Exit codes:
  0   the pass completed; nothing is waiting on a human judgment call
  16  A DECISION IS OUTSTANDING SOMEWHERE — not "no further progress is
      possible". The pass still walked EVERY task and took every edge policy
      could take; one task (or the run) additionally met a judgment boundary
      it refused to decide, and that record is what 16 reports (see: orchid
      run boundary show). A caller that reads 16 as "stop the run and fetch a
      human" halts twenty-nine tasks over a decision affecting one. Drive is
      idempotent, so a boundaried task simply re-reports the same record on
      the next pass at no cost: keep driving. The only thing 16 asks of an
      unattended caller is that the boundary reach a human — which the pass
      has already done, by raising one `orchid notify` blocker per distinct
      stop whenever no admitted verb can settle it.
  1   a precondition failed (uninitialized, split-brain, or a verb refused).
      THIS is the code that means the pass could not be made at all.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) echo "drive: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

ORCHID_BIN="$ORCHID_ROOT/bin/orchid"
repo="${ORCHID_REPO:-$PWD}"
state="$(orchid_state "$repo")"

drive_note() { printf 'drive: %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Preflight. The same three side-effect-free diagnostics runners/orchid-pump
# makes (uninitialized / split-brain / already complete), re-made here because
# this runner is directly invokable and must never seed runtime state into a
# directory that is not an Orchid repository.
# ---------------------------------------------------------------------------
if [ ! -d "$state/tasks" ] && [ ! -f "$state/journal.md" ] && [ ! -f "$state/roadmap.md" ]; then
  orchid_die "not initialized — run orchid init"
fi
if orchid_split_brain "$repo"; then
  orchid_die "no roadmap in this checkout (split-brain — run from the integration branch)"
fi
run_status="$(fm_get "$state/roadmap.md" run_status 2>/dev/null || true)"
if [ "$run_status" = complete ]; then
  drive_note "run_status complete, nothing to do"
  exit 0
fi

rt="$(orchid_runtime "$repo")"

# ---------------------------------------------------------------------------
# Epoch. An interactive session that already fenced one (ORCHID_EPOCH exported
# and still current) keeps it -- `drive` is then one more pass inside that
# session, not a competing owner. Anything else fences a fresh epoch through
# `orchid run resume`, exactly like runners/orchid-tick, so a pump-woken pass
# and a stale session can never both mutate state (INV-02).
# ---------------------------------------------------------------------------
current_epoch="$(epoch_current "$repo")"
if [ -n "${ORCHID_EPOCH:-}" ] && [ "$ORCHID_EPOCH" = "$current_epoch" ] && [ "$current_epoch" != 0 ]; then
  epoch="$current_epoch"
  drive_note "continuing under epoch $epoch"
else
  resume_out="$("$ORCHID_BIN" run resume)"
  epoch="${resume_out#epoch: }"
  drive_note "fenced epoch $epoch"
fi
export ORCHID_EPOCH="$epoch" ORCHID_REPO="$repo"
export ORCHID_ACTOR="${ORCHID_ACTOR:-drive}"

# ---------------------------------------------------------------------------
# Boundary accumulation. At most ONE boundary is recorded per pass, and the
# walk always continues: a task parked on a judgment call must never stall
# the tasks beside it.
#
# WHICH one, when a pass meets several: the highest-priority kind
# (drive_boundary_priority -- could a woken orchestrator settle THIS boundary,
# on THIS task, right now?), and within one priority the first encountered, so
# task-id order still decides among equals. Without that ranking a `blocked`
# task -- which raises the same operator-only boundary on EVERY pass until a
# human runs `task unblock`/`task retry`, verbs the broker refuses -- would
# permanently mask a later task's arbitrable review boundary, burning one LLM
# wakeup per pump cycle on a decision the model has no verb to make. Every
# boundary the walk meets is still NOTED, so the pass output never hides one.
#
# The ranking reads the task's status AT THE MOMENT the boundary is raised,
# together with the command surface of the adapter the pump would actually
# wake. Both matter: `orchid task arbitrate` is the only write the brokered
# surface admits, and it refuses any status but `arbitrating` -- so the same
# review-evidence condition is arbitrable from `arbitrating` and operator-only
# from `reviewing`, and a boundary whose settling verb the surface refuses at
# all (a finished run's `orchid run accept`) is operator-only everywhere.
# ---------------------------------------------------------------------------
boundary_kind=""; boundary_task=""; boundary_reason=""; boundary_status=""

# EVERY boundary the pass MEETS, not just the one it records: one line per
# distinct stop, holding `<kind>`, `<task>`, `<status>` and `<reason>`
# separated by US (\037) -- see set_boundary for why not a tab. The record
# is still one -- that is the kernel's shape -- but the PAGE budget is per
# distinct stop, and a stop that lost the ranking has no record for the de-dup
# at the foot of this file to compare, so without this list it is compared
# against nothing and announced to nobody. Blocked tasks are the case that made
# it matter: they all rank equal, so task-id order decides, so one blocked task
# took the slot on every pass and every other blocked task in the run was
# silent. See drive_page_on_record in lib/drive.sh for what stops the extra
# pages from repeating.
#
# Pass-local, like `optional_hooks_died` and `escalated_this_pass`: a fact about
# what THIS pass met, so it needs no verb and leaves nothing behind. Reasons are
# single-line by construction (drive_blocked_reason clips through
# _drive_quote_line, and every set_boundary literal is one line), so one
# separated line per boundary is a lossless carrier for them.
boundaries_met=""

# Which adapter would the pump wake, and what can it actually run? Resolved
# once per pass, just after the lease refresh below (step 1 stays literally
# first). `brokered` when no orchestrator engine resolves at all -- then
# nobody is woken for anything and every boundary belongs to a human.
orchestrator_surface=brokered

# drive_task_status <task> -- the task's current status, or empty for a
# run-level boundary (no task) or a task file that is not there.
drive_task_status() {
  local id="$1"
  [ -n "$id" ] || return 0
  [ -f "$state/tasks/$id.md" ] || return 0
  fm_get "$state/tasks/$id.md" status
}

# Pass-local record of every OPTIONAL hook point whose job was found dead
# without an envelope this pass, as " <task>:<point> " atoms. Read by
# drive_hook_gate below: a hook that can never gate must not park the step it
# guards just because its handler fell over. Deliberately pass-local -- it is
# a fact about jobs THIS pass reconciled, not durable state, so it needs no
# verb and leaves nothing behind.
optional_hooks_died=" "
set_boundary() {
  local kind="$1" task="$2" reason="$3" note tstatus met_row flat
  local nl=$'\n' sep=$'\037'
  if [ -n "$task" ]; then
    note="boundary [$kind] $task: $reason"
  else
    note="boundary [$kind]: $reason"
  fi
  tstatus="$(drive_task_status "$task")"
  # Recorded on the way past, BEFORE the ranking decides anything: a stop the
  # pass met is a stop a human may need, whether or not it wins the one record
  # slot. Deduplicated on the whole row, so an arm that raises the identical
  # boundary twice in one pass is still one stop and still one page.
  # US (\037) as the field separator, deliberately not a tab: tab is an IFS
  # WHITESPACE character, so `IFS=$'\t' read` collapses a run of them into one
  # delimiter and a run-level boundary (empty task) would hand the reader its
  # status in the task slot. A non-whitespace separator preserves the empty
  # field.
  #
  # The REASON is flattened onto one line for the row, and the reader flattens
  # the recorded reason the same way before comparing the two. Rows are
  # newline-delimited, so a reason carrying a newline would otherwise split into
  # two rows and page a truncated question -- and a page text spanning lines
  # cannot be matched back by drive_page_on_record's whole-LINE test either, so
  # every later pass would read it as a stop that had never been paged. The
  # BOUNDARY RECORD keeps the reason exactly as the arm wrote it; only the page
  # is flattened, which is what a one-line phone notification wanted anyway.
  #
  # Flattened by parameter expansion rather than through `tr`, and the reader
  # does the same, because the two sides must be BYTE-identical or the recorded
  # stop pages once per pass: a `$( ... | tr )` round trip turns a trailing
  # newline into a trailing space on one side and drops it on the other. Every
  # reason reaches here with its trailing newline already stripped (each call
  # site passes a literal or a `$( )` capture), so the two are then the same.
  flat="${reason//$nl/ }"; flat="${flat//$'\r'/ }"; flat="${flat//$sep/ }"
  met_row="$kind$sep$task$sep$tstatus$sep$flat"
  if ! grep -qxF -e "$met_row" <<<"$boundaries_met"; then
    boundaries_met="${boundaries_met:+$boundaries_met$nl}$met_row"
  fi
  if [ -n "$boundary_kind" ] && \
     [ "$(drive_boundary_priority "$kind" "$tstatus" "$orchestrator_surface")" -le \
       "$(drive_boundary_priority "$boundary_kind" "$boundary_status" "$orchestrator_surface")" ]; then
    drive_note "$note (held: [$boundary_kind] is already this pass's recorded boundary)"
    return 0
  fi
  if [ -n "$boundary_kind" ]; then
    drive_note "$note (supersedes [$boundary_kind]: no admitted verb resolves that one)"
  else
    drive_note "$note"
  fi
  boundary_kind="$kind"; boundary_task="$task"; boundary_reason="$reason"
  boundary_status="$tstatus"
  return 0
}

# drive_notify <kind> <task|""> <task-status> <text> -- raise the operator's
# page for a boundary of that kind, DECLARING the answers `orchid answer` will
# accept for it (lib/drive.sh's drive_boundary_choices). Every notify the driver
# sends goes through here rather than calling the verb directly, because a page
# whose `<choice>` placeholder is never filled in is exactly the page r-001
# shipped twenty-seven of: reachable, unanswerable, and silently accepting a
# typo as a decision. A kind with no enumerable set passes no --choice at all
# and the question keeps the free-text contract unchanged.
#
# THE STATUS IS AN ARGUMENT, not something read here, and it is the SAME status
# the boundary's priority was ranked with. Which answers a review page may name
# depends on which verb is legal out of the task's state (`orchid task
# arbitrate` exits 3 anywhere but `arbitrating`), so a page that named its set
# from a status re-read later would offer the answers of a state the boundary
# was never classified in -- the two facts have to come from one reading.
#
# EXACTLY ONE CALLER, at the foot of this file, and that is an invariant rather
# than an accident of the current arms. PROTOCOL.md promises one blocker per
# DISTINCT STOP, and the only thing that can keep that promise is the de-dup
# there: it asks, per stop, whether a page carrying exactly this text is already
# on record (lib/drive.sh's drive_page_on_record) and whether the boundary
# RECORD it is about to write already says the same thing, so a condition that
# persists for a hundred passes raises one page. A notify sent from anywhere else
# is outside that comparison altogether -- it cannot be de-duplicated against
# anything, and it mints a second qid for a stop the loop is about to page for by
# itself. Four arms did exactly that -- the exhausted-budget arm and the
# wallclock backstop, each paging a task it was about to block, and the
# stuck-merge and blocked-merge arms, each paging a boundary it recorded in the
# same breath. All four now record and let the record page. A new stop that needs
# a human takes the same route: set_boundary (or drive_block_boundary, when the
# stop is a blocked task), never a notify of its own.
#
# RECORDING IS NOT LOSING THE PAGE, which is the half the first repair of those
# four arms got wrong: the pass records ONE boundary, so a stop that lost the
# ranking used to leave nothing for the de-dup to compare and was never paged at
# all. `set_boundary` therefore accumulates every stop the pass meets and the
# loop pages each of them; the ranking still decides only which one is RECORDED.
#
# THE COUNT IS THE GUARD, in both spellings. tests/test_notify_hermes_channel.sh
# holds this file to ONE drive_notify call site AND to zero lines that run the
# `notify` verb straight off the binary, because the second spelling is how the
# blocked-merge arm kept its duplicate page through the rounds that repaired the
# first three: writing the verb out by hand reads as ordinary verb use, leaves a
# count of drive_notify sites sitting at one, and is a page nothing compares all
# the same. A fifth arm in either spelling fails a test rather than a human's
# evening.
drive_notify() {
  local kind="$1" task="$2" tstatus="$3" text="$4" choice
  local -a nargs
  nargs=(notify)
  [ -z "$task" ] || nargs+=(--task "$task")
  while IFS= read -r choice; do
    [ -n "$choice" ] || continue
    nargs+=(--choice "$choice")
  done <<< "$(drive_boundary_choices "$kind" "$tstatus")"
  nargs+=("$text")
  "$ORCHID_BIN" "${nargs[@]}" >/dev/null
}

# ---------------------------------------------------------------------------
# THE TICK step 1 -- refresh the lease, first thing, every pass.
# ---------------------------------------------------------------------------
"$ORCHID_BIN" run refresh-lease

orchestrator_surface="$(drive_orchestrator_surface "$repo")"

if [ "$run_status" = planning ]; then
  # PLANNING runs no reconcile and no check (below): plan drafting is judgment
  # work by definition (PROTOCOL.md PLANNING) and the orchestrator owns the
  # plan/critique loop end to end. It still SWEEPS and still REAPS, for the
  # reasons the two sections below spell out where they do it -- the boundary
  # is raised here, first, so it stands whatever those sections find.
  set_boundary planning "" "run_status is planning — drafting and critiquing the roadmap is judgment work (PROTOCOL.md PLANNING)"
fi

# ---------------------------------------------------------------------------
# THE TICK step 2 -- reconcile, THEN check, THEN gc. The ordering is load
# bearing (PROTOCOL.md spells out why): reconcile drains everything that
# already finished before anything is judged stuck, check reports (and kills)
# what is genuinely stalled, and only then does gc reap the manifests check
# has already had its pass over.
#
# THE ESCALATION LADDER RUNS BETWEEN CHECK AND GC, not after it. The candidates
# are COLLECTED here (the functions the ladder needs are defined further down,
# so the loop that spends the rungs cannot run until they are) and the gc call
# sits immediately after that loop rather than here. Reaping first would mean a
# pass felled between the reap and the charge had destroyed the only evidence of
# a failure it had not yet counted -- no manifest for a later sweep to find, no
# receipt in the journal, nothing anywhere. NOTHING IS RETIRED BEFORE IT HAS
# BEEN CHARGED is the ordering rule, and it is what makes the charge recoverable
# rather than merely idempotent: a crash anywhere before the reap leaves the
# manifest exactly where the next pass will find it.
# ---------------------------------------------------------------------------
reconcile_out=""; check_out=""; gc_out=""; planning_reap_out=""
escalations=""
_prepared_bound_s=$(( $(config_get "$repo" stall_minutes 10) * 60 ))
if [ "$run_status" != planning ]; then
  reconcile_out="$("$ORCHID_BIN" jobs reconcile)"
  [ -z "$reconcile_out" ] || printf '%s\n' "$reconcile_out"
  check_out="$("$ORCHID_BIN" jobs check)"
  [ -z "$check_out" ] || printf '%s\n' "$check_out"
fi

# THE SWEEP RUNS IN EVERY PHASE, PLANNING INCLUDED (T027 rework; dogfood F29).
#
# PLANNING launches jobs like any other phase -- `runners/orchid-launch plan
# plan_critic critique` and the plan hook points, PROTOCOL.md PLANNING steps 2
# and 3 -- and it launches them from the ORCHESTRATOR, not through this file's
# drive_launch. So the synchronous half of the accounting below (a launcher's
# non-zero exit journaled and charged in the same breath) does not exist in
# this phase at all: nothing wraps those launches, and a launcher that dies
# before its spawn line leaves a pid-0 manifest and no record anywhere. That is
# the ORIGINAL F29 shape, surviving in the one phase the fix had not reached.
#
# It cannot be closed by refusing to reap, either: `jobs prepare` refuses (exit
# 18) to mint a second manifest over an unlaunched one, so a PLANNING that
# never reaps is a PLANNING that can never relaunch its critique. The reap has
# to happen AND the failure has to be counted first -- which is exactly the
# ordering rule the header above states, applied to a phase that previously
# reaped without ever sweeping.
#
# WHAT IT SWEEPS THERE IS NARROWER, and deliberately EQUAL TO WHAT THAT PHASE
# REAPS. PLANNING's reap is `jobs gc --reap-prepared`, which retires exactly
# libexec/orchid-jobs' job_unlaunched_reapable -- both halves of the pid-0
# class, the never-started one and the spawned-but-never-stamped one whose log
# has been silent for `stall_minutes`. So the sweep charges both there. What it
# does NOT charge in that phase is the dead-pid arm: `--reap-prepared` does not
# touch a stamped manifest, and "dead without an acceptable envelope" is only
# true once a reconcile has drained the spool, which this phase deliberately
# does not run. Charging for something nothing is about to retire would be a
# rung spent on a manifest still sitting there for the next pass to meet again.
#
# Escalation candidates are read off the MANIFESTS, not off `jobs check`'s
# text: a manifest still on disk after reconcile, whose pid really was
# launched and is no longer alive, is precisely "a job that died without
# leaving an acceptable envelope" -- including the case `jobs check` just
# killed for stalling or timing out. Collected BEFORE gc (which is about to
# reap exactly these manifests, bar the one exception both it and the skip
# below make) together with the role/operation a relaunch needs, and with
# WHICH of the three ways the job ended without an envelope (it died, it
# never started at all, or it was spawned and never stamped a pid and then
# went silent) so the ladder can say which.
_sweep_now="$(date +%s)"
for _mf in "$rt/jobs"/*.json; do
  [ -e "$_mf" ] || continue
  # FAIL CLOSED on a manifest nothing can parse, exactly as
  # libexec/orchid-jobs' job_never_started does ("an unreadable manifest
  # falls back to the answer 'not this class'"), so a corrupt or truncated
  # file is reaped by nothing, refused over by nothing, and escalated by
  # nothing -- one posture in all three places rather than three.
  #
  # This guard REPLACES a shield the pid-0 arm below used to provide for
  # free. Until this task the loop read `[ "$_mpid" != 0 ] || continue`, so
  # the `|| echo 0` fallback on an unparseable file landed on `continue` and
  # the corrupt manifest left the loop untouched. Now that pid 0 is a case
  # this sweep HANDLES rather than skips, that same fallback would instead
  # carry a corrupt manifest into the never-started arm, where the `@tsv`
  # read below exits non-zero under this file's `set -euo pipefail` and
  # takes the ENTIRE drive pass down with it -- a whole tick lost to one bad
  # file, which is the same shape of silent wedge this task exists to close.
  jq -e . "$_mf" >/dev/null 2>&1 || continue
  _mpid="$(jq -r '.pid' "$_mf" 2>/dev/null || echo 0)"
  if [ "$_mpid" = 0 ]; then
    # ...and the OTHER ways a job ends without an envelope, which used to
    # reach no arm of this ladder at all (T027, dogfood F29). `jobs prepare`
    # mints every manifest with pid 0 and the launcher stamps the real pid
    # only after the spawn, so a pid-0 manifest is a job nothing ever saw
    # running. Nothing about that is `dead`, `stalled` or `timeout`, so the
    # ladder never engaged and the task simply waited on an envelope nobody
    # was producing.
    #
    # THE FAILURE THIS LADDER MUST NOT COUNT TWICE -- NOR ZERO TIMES. A
    # launcher that exits non-zero of its own accord is normally reported
    # synchronously: the exit status goes back to drive_launch in that same
    # pass, which journals it and spends a rung for it, and
    # runners/orchid-launch stamps `launch_exit` on the manifest it leaves
    # behind. Some passes later that corpse ages past the bound below, and an
    # unguarded sweep charges a SECOND rung for the very same physical
    # failure -- two of a three-rung ladder spent on one event, while the NEXT
    # real launch failure goes uncounted behind drive_escalate's
    # one-rung-per-slot-per-pass guard.
    #
    # IN PLANNING THERE IS NO SYNCHRONOUS HALF AT ALL. The orchestrator runs
    # `runners/orchid-launch plan plan_critic critique` itself, so nothing
    # journals or charges that launcher's exit and this sweep is the ONLY
    # accounting the incident will ever get. Which is precisely why it now runs
    # in that phase: an aged pid-0 manifest used to be handed straight to the
    # reap with no receipt behind it.
    #
    # BUT THE MARK IS NOT THE GUARD, because the launcher writes it BEFORE
    # this driver has journaled or charged anything: a pass felled in that
    # window (the machine reboots, the pump's lease is fenced, an operator
    # Ctrl-Cs) leaves a manifest that says "already reported" about a failure
    # nobody ever reported, and a sweep keyed on the mark then skips it
    # forever. That is the same silent-forever shape this whole task exists to
    # close, just one level up. So the mark is read for what it actually
    # proves -- WHY this manifest was stranded, which is worth saying in the
    # journal -- and whether the failure was already counted is asked of the
    # durable receipt the charge itself wrote (drive_failure_charged, keyed on
    # the job_id carried below). Charged synchronously: the sweep finds the
    # receipt and skips. Crashed before the charge: no receipt, and the sweep
    # is the one that counts it. Either way, once. gc retires the manifest in
    # this same pass, AFTER the charge, so nothing is reaped before it is
    # accounted for.
    _mexit="$(jq -r '.launch_exit // ""' "$_mf" 2>/dev/null || echo)"
    # The lines below are libexec/orchid-jobs' job_never_started and
    # job_unstamped_stale, inlined because a shell function does not cross a
    # verb boundary. They must stay the same tests: this sweep escalates
    # exactly the class `jobs gc` reaps and `jobs prepare` refuses over.
    #
    # never-started (no log at all) is BOUNDED by `stall_minutes`, the same
    # bound this pass hands gc below, and for the same reason: a manifest
    # younger than that may belong to a launcher sitting between its own
    # `jobs prepare` and its spawn line right now, and that one is going to
    # run. unstamped (a log that exists but has not been written to in
    # `stall_minutes`) carries its own bound in the predicate -- the spawn
    # happened, so what is being waited on is output, not a launcher.
    _mlog="$(jq -r '.log // ""' "$_mf" 2>/dev/null || echo)"
    if [ -z "$_mlog" ] || [ ! -e "$_mlog" ]; then
      [ $(( _sweep_now - $(file_mtime "$_mf") )) -gt "$_prepared_bound_s" ] || continue
      # Same class, two different things to say about it: a manifest carrying
      # the launcher's own exit status was stranded by a launcher that RAN and
      # failed, and saying "prepared and never launched" about that one throws
      # away the one diagnostic the incident left. Only reached when no
      # receipt exists for it, i.e. when this sweep really is the first to
      # account for it.
      if [ -n "$_mexit" ]; then _mkind=launch-failed; else _mkind=never-started; fi
    else
      [ $(( _sweep_now - $(file_mtime "$_mlog") )) -gt "$_prepared_bound_s" ] || continue
      # ...UNLESS ITS ENVELOPE IS ALREADY WRITTEN, exactly as the dead arm
      # below refuses to escalate a delivery that arrived. This one CAN have
      # delivered: it was spawned. (The never-started arm above needs no such
      # guard -- nothing ran to write anything.) `jobs gc` holds the manifest
      # back for the same case, so the job simply resolves next pass.
      #
      # AND ONLY WHILE THAT IS TRUE (T031). "Resolves next pass" is an
      # assumption about reconcile, and for this exact class reconcile makes
      # the opposite call: with no pid ever stamped there is nothing to
      # `kill -0`, so it refuses to read the silence as an exit and HOLDS the
      # envelope (libexec/orchid-jobs' job_liveness -> `unresolved`). Skipping
      # on the spool file alone would then have the two waiting on each other
      # -- this sweep for a reconcile that will not happen, reconcile for an
      # exit nobody can record -- while `jobs gc` spares the manifest for the
      # same spooled envelope and the task sits in an active status forever,
      # which is the silent-wedge shape the whole ladder exists to end.
      #
      # So the skip holds only while the exit CAN still be proven, and it is
      # the same positive record job_exit_recorded reads: the launcher's
      # wrapper writes $rt/exits/<job_id> after waiting on the engine, so its
      # presence means the process really is over and the next reconcile will
      # file that envelope. Absent it, this is the `untracked` class -- a
      # report from something nobody can show has stopped.
      _mjid="$(jq -r '.job_id // empty' "$_mf" 2>/dev/null || true)"
      _mkind=unstamped
      if [ -n "$_mjid" ] && [ -e "$rt/spool/$_mjid.json" ]; then
        [ ! -e "$rt/exits/$_mjid" ] || continue
        # NOT IN PLANNING, where the skip stands exactly as it always did.
        # This class is defined by reconcile HOLDING that envelope, and
        # PLANNING deliberately drains no spool at all -- so there, a spooled
        # envelope is simply one nothing has looked at yet, and reporting it as
        # a report that cannot be admitted would name a refusal nobody made.
        [ "$run_status" != planning ] || continue
        _mkind=untracked
      fi
    fi
    escalations="$escalations$(jq -r --arg kind "$_mkind" --arg lexit "$_mexit" \
      '[.task, .role, .operation, (.hook_point // ""), $kind, (.job_id // ""), $lexit] | @tsv' "$_mf")
"
    continue
  fi
  # THE DEAD-PID ARM IS NOT PLANNING'S. Everything above this line is the
  # pid-0 class, which is precisely what `jobs gc --reap-prepared` retires and
  # so precisely what that phase must account for first. This arm is the other
  # class: a manifest that DID stamp a pid, which that reap does not touch at
  # all -- and "dead without an acceptable envelope" is only true once a
  # reconcile has drained the spool, which PLANNING deliberately does not run,
  # so a job that finished cleanly this instant would read as dead-with-nothing
  # here and be charged for delivering exactly what it delivered.
  [ "$run_status" != planning ] || continue
  if kill -0 "$_mpid" 2>/dev/null; then continue; fi
  # ...UNLESS ITS ENVELOPE IS ALREADY WRITTEN. A job that exited between the
  # reconcile above and this liveness read is dead with its envelope sitting
  # in the spool, undrained -- it delivered, and the next pass's reconcile is
  # what files it. Escalating on that reading spends a rung on a delivery
  # that ARRIVED and relaunches a second engine into the same worktree over
  # it, which is the same one-event-two-rungs miscount the implementing arm
  # is careful about below; worse, this is the exact shape a no-op delivery
  # takes, so the rung would be spent where no refusal can be recorded
  # against the envelope that caused it. `jobs gc` holds the manifest for
  # precisely this case (see its own note), so the job simply reads as
  # outstanding for one more pass and resolves on the next.
  _mjid="$(jq -r '.job_id // empty' "$_mf" 2>/dev/null || true)"
  if [ -n "$_mjid" ] && [ -e "$rt/spool/$_mjid.json" ]; then continue; fi
  escalations="$escalations$(jq -r '[.task, .role, .operation, (.hook_point // ""), "died", (.job_id // ""), ""] | @tsv' "$_mf")
"
done

# ---------------------------------------------------------------------------
# Lease heartbeat around the pass's LONG SYNCHRONOUS steps.
#
# Steps 1 and 5 of THE TICK refresh the lease at the two ends of a pass, which
# is enough only while everything between them is quick. It is not: `orchid
# verify` runs the task's whole verification suite in this pass's own
# foreground, and `orchid merge` re-runs it again on the integration checkout.
# On this very repository that suite takes about fifteen minutes, against a
# `pump_stale_s` that defaults to 900 -- so a headless pass would have its own
# lease read as stale WHILE IT WAS STILL WORKING, a second pump would fence a
# fresh epoch, and the first would then die on the next verb's `epoch_require`
# under `set -e`. No pass could ever complete on such a repository.
#
# So the lease is refreshed immediately before and after each long step, and a
# background heartbeat keeps refreshing it throughout at a third of the
# staleness window (three refreshes per window: one may be lost to a slow
# filesystem and the lease still never reads stale). `run refresh-lease` is a
# named verb and takes no verb lock, so this neither breaks rule 2 nor can
# deadlock against the step it is covering.
# ---------------------------------------------------------------------------
# Two details of the subshell below are load bearing, not style:
#
#   >/dev/null 2>&1 ON THE SUBSHELL. A caller that captures this pass with
#   `out="$(orchid drive)"` is reading a pipe, and a background child that
#   inherited it holds the write end open -- the substitution would then block
#   until the heartbeat (and its own `sleep`) exited, up to one whole interval
#   after the pass finished. Detaching its descriptors removes that entirely.
#
#   A PARENT-LIVENESS CHECK. A heartbeat that outlived a pass killed mid-step
#   would keep refreshing the lease of a run nobody is driving, which is worse
#   than the staleness it exists to prevent: the pump would never pick the run
#   back up. Checking the parent pid bounds an orphan's life to one interval.
drive_lease_hb_pid=""
drive_lease_heartbeat_start() {
  local interval parent=$$
  interval=$(( $(config_get "$repo" pump_stale_s 900) / 3 ))
  [ "$interval" -ge 1 ] || interval=1
  "$ORCHID_BIN" run refresh-lease
  ( while :; do
      sleep "$interval"
      kill -0 "$parent" 2>/dev/null || exit 0
      "$ORCHID_BIN" run refresh-lease >/dev/null 2>&1 || exit 0
    done ) >/dev/null 2>&1 &
  drive_lease_hb_pid=$!
}
drive_lease_heartbeat_stop() {
  if [ -n "$drive_lease_hb_pid" ]; then
    kill "$drive_lease_hb_pid" 2>/dev/null || true
    wait "$drive_lease_hb_pid" 2>/dev/null || true
    drive_lease_hb_pid=""
  fi
  "$ORCHID_BIN" run refresh-lease
}

# ---------------------------------------------------------------------------
# Launch helper. FOUR outcomes, not two:
#
#   0        spawned.
#   14/18    a WAIT, never a failure. 14 is `no eligible engine`: the ledger
#            window reopens on its own and the identical dispatch succeeds on a
#            later pass with no operator action (PROTOCOL.md's Failover
#            paragraph). 18 is `this slot already has a never-started manifest`
#            (libexec/orchid-jobs' prepare): nothing is running, nothing was
#            spawned, and gc clears the orphan on its own once it is past
#            `stall_minutes` -- in EVERY phase, planning included, which is
#            what keeps this wait from being a state the run cannot leave.
#            Neither spends a rung of the escalation ladder --
#            a wait counted as a failure auto-blocks a task on the wall clock
#            (the reasoning drive_escalate's own header spells out for 14).
#   19       a capability-routing refusal handed to the operator (INV-16).
#   anything else
#            A JOB FAILURE, and it is escalated HERE (T027, dogfood F29). A
#            launcher that dies BEFORE its spawn line -- an input_overflow
#            pack, a missing binary, a plugin that will not resolve -- produces
#            no job, so `jobs check` has nothing to call dead, `reconcile` has
#            no envelope to mark the engine with, and every caller below used
#            to do nothing but print a note and move on. That is the run that
#            re-attempted the same broken launch 73 times with not one journal
#            entry to show for it. `task infra-fail` is the ladder's own
#            counter: it journals its reason, and auto-blocks at `infra_max`,
#            so a launch that cannot succeed now stops the task instead of
#            being retried silently forever.
#
#            ONE RUNG, ONCE -- AND AT LEAST ONCE. This is the normal place that
#            physical failure is counted, but it is not the only one, because a
#            pass can die between the launcher's exit and the charge below. So
#            the charge is made against the identity of the manifest the
#            launcher stranded, and the ageing sweep at the top of the pass
#            makes the same charge against the same identity if -- and only if
#            -- this one never landed. drive_failure_charged is the arbiter and
#            the journal is where it looks; neither arm needs to know whether
#            the other ran.
#
# The one exception is an OPTIONAL hook binding, which gates nothing: its
# handler failing to launch must not spend the TASK's infra_failures budget,
# exactly as the escalation sweep already refuses to spend one when an optional
# handler dies. It is journaled instead, so the failure is still on the record
# -- AND the pass-local fact drive_hook_gate reads is set, exactly as the sweep
# sets it for a handler that died after spawning. Without that, the two shapes
# of the same non-event diverged: a handler that died was stepped over, while a
# handler that could not even be launched left the guarded step deferred to a
# next pass that relaunched it, failed it again and deferred again -- an
# optional binding gating a step forever, which is precisely what "optional
# never gates" is there to forbid.
#
# Exit 19 (INV-16, `orchid jobs prepare`'s step-routing gate) is the WAITs'
# opposite and must never be confused with them. Nothing is waiting: the step
# needs a capability the resolved actor's manifest does not claim, and no later
# pass makes the same actor able to do the same work. Retrying it every pass
# spends nothing but wall clock; escalating it spends the task's infra_failures
# budget on infrastructure that is not broken; dispatching it anyway is what
# cost T005 two attempt cycles and T014 three. So it is handed to an operator,
# once, by name -- see drive_capability_refusal below.
# ---------------------------------------------------------------------------
drive_launch() {
  local task="$1" role="$2" op="$3" engine="${4:-}" point="${5:-}" rc=0 key=""
  local -a largs
  largs=("$task" "$role" "$op")
  [ -z "$engine" ] || largs+=(--engine "$engine")
  [ -z "$point" ] || largs+=(--hook "$point")
  "$ORCHID_ROOT/runners/orchid-launch" "${largs[@]}" || rc=$?
  if [ "$rc" -eq 0 ]; then
    return 0
  fi
  if [ "$rc" -eq 14 ]; then
    drive_note "$task: no eligible engine for role '$role' — waiting for the ledger window to reopen"
    return 14
  fi
  if [ "$rc" -eq 18 ]; then
    drive_note "$task: an unlaunched $op manifest for this slot is still on disk — nothing was spawned; gc clears it once it is past stall_minutes"
    return 18
  fi
  if [ "$rc" -eq 19 ]; then
    drive_note "$task: step '$op' cannot be routed to the actor resolved for role '$role' — see the launch output above"
    return 19
  fi
  drive_note "$task: launch failed (role '$role', operation '$op', exit $rc)"
  # The manifest this launcher stranded IS the identity of the failure, and the
  # only handle both arms of the ladder can independently derive. Empty when the
  # launcher died before it minted one at all (a `jobs prepare` that failed for
  # some reason other than 14/18/19): nothing was left on disk, so no later sweep
  # can find it and there is nothing to deduplicate against -- the charge below
  # simply happens, as it always did.
  key="$(drive_stranded_launch_job "$repo" "$task" "$role" "$op" "$point")"
  if [ "$role" = hook ] && [ -n "$point" ] && ! drive_hook_has_required "$repo" "$point"; then
    drive_note "$task: the $point hook is optional — not escalating (it gates nothing)"
    # The receipt, even though no rung is spent: it is what stops the ageing
    # sweep's own optional arm writing this same failure down a second time when
    # it meets the manifest this launcher stranded. The exempt class needs the
    # exactly-once key just as much as the charged one -- more so, in fact,
    # since nothing else about it is durable.
    "$ORCHID_BIN" journal add --task "$task" \
      "optional $point hook launch failed (exit $rc): nothing was spawned$(drive_failure_receipt "$key")" >/dev/null
    optional_hooks_died="$optional_hooks_died$task:$point "
    return "$rc"
  fi
  drive_escalate "$task" "$role" "$op" "$point" \
    "the launcher exited $rc without spawning a job" "$key"
  return "$rc"
}

# drive_stranded_launch_job <repo> <task> <role> <op> [hook-point] -- the
# job_id of the never-started manifest a failed launcher left for this slot, or
# nothing.
#
# Never-started is the same predicate every other reader uses (pid 0 AND no
# log): a launcher that got past its spawn line left an engine running, and that
# is a different class with a different owner. The `launch_exit` stamp is
# deliberately NOT part of the test -- it is best-effort by construction
# (runners/orchid-launch's own note), and a stamp that failed to land does not
# make the manifest a different manifest.
#
# AT MOST ONE CAN MATCH, which is what makes this a key rather than a guess:
# `orchid jobs prepare` refuses (exit 18) to mint a second manifest for a slot
# that already holds a never-started one, and exit 18 never reaches here.
drive_stranded_launch_job() {
  local wrepo="$1" task="$2" role="$3" op="$4" point="${5:-}"
  local wrt mf mlog
  wrt="$(orchid_runtime "$wrepo")"
  for mf in "$wrt/jobs"/*.json; do
    [ -e "$mf" ] || continue
    jq -e . "$mf" >/dev/null 2>&1 || continue
    [ "$(jq -r '.task // ""' "$mf")" = "$task" ] || continue
    [ "$(jq -r '.role // ""' "$mf")" = "$role" ] || continue
    [ "$(jq -r '.operation // ""' "$mf")" = "$op" ] || continue
    [ "$(jq -r '.hook_point // ""' "$mf")" = "$point" ] || continue
    [ "$(jq -r '.pid // 0' "$mf")" = 0 ] || continue
    # `|| echo`/`|| true` on the two BARE assignments, not decoration: this file
    # runs under `set -e`, so a jq that failed here would abort the whole pass
    # rather than skip one manifest. The tests above are guarded by their own
    # `|| continue`.
    mlog="$(jq -r '.log // ""' "$mf" 2>/dev/null || echo)"
    [ -z "$mlog" ] || [ ! -e "$mlog" ] || continue
    jq -r '.job_id // empty' "$mf" 2>/dev/null || true
    return 0
  done
  return 0
}

# drive_capability_refusal <task> <role> <operation> [hook-point] [binding] --
# what every arm does with a launch that came back 19. The refusal itself was already
# decided (and printed) by `orchid jobs prepare`; this is the driver's half of
# it, and it is deliberately the same two acts at each of the FOUR call sites
# rather than four near-identical inline blocks that could drift.
#
# THE HOOK POINT IS PASSED, NOT DROPPED. A hook launch is the one call whose
# `role` positional is a placeholder (the literal `hook`), so the point is the
# only thing that identifies which binding was refused -- and it is also what
# decides which config key the advice may name. Both strings therefore come
# from lib/drive.sh's drive_capability_handoff_text, which is where that
# distinction is documented and where a test can read it without running a
# whole drive pass.
#
# EVERY call site, and the escalation ladder's relaunch is the one that proves
# why. It is the only one whose launch is not the reason a task is being walked,
# so it is the easiest to leave as a bare `|| true` -- and a swallowed 19 there
# is the worst of the four: the pass has just spent an infra_failures rung on
# the job that DIED, the relaunch is refused for a reason no later pass changes,
# and with no boundary raised the walk meets the same task again next pass and
# spends the next rung. Three passes later the task is `blocked` on a counter
# that measures broken infrastructure, with nothing in the journal naming the
# capability that actually stopped it. That is precisely the mis-attribution
# T008 removed, reintroduced by the task adding the refusal.
#
# JOURNALED, then boundaried. The journal line is the durable record that this
# step was refused rather than merely never attempted -- without it the task's
# history shows a status that simply stopped moving, which is exactly how the
# hand-offs this rule exists to end stayed invisible for two whole runs. The
# boundary is `operator-handoff` because that is what a step no actor in the
# loop declares the capability for IS; it names no settling verb, so a human is
# notified and no model is woken to make a decision it has no verb to make.
#
# ONCE PER DISTINCT RECORD, not once per pass. This refusal persists until an
# operator acts, and the walk re-reaches it every pump cycle -- a line appended
# each time would bury the run's history under one unchanging fact, which is
# the same hazard the notify path at the foot of this file already guards.
#
# BUT KEYED ON THE JOURNAL, NOT ON THE BOUNDARY, which is where the notify
# path's shape must NOT be copied. That path compares against the boundary it is
# about to write, so its comparison is asking about a record that is certainly
# there. This one is not: `set_boundary` below only records the pass's WINNING
# boundary -- a `blocked` task met earlier in the walk, or another task refused
# on this very pass, holds it at equal priority and this refusal is noted and
# dropped. Keyed on the boundary, the dedup would then miss on every pass and
# append a line on every pass, in exactly the case the paragraph above claims to
# guard. The journal line is the one artifact this function ALWAYS writes when
# it writes anything, so it is what the dedup asks about: `journal show` reads
# the task's own index (a bounded tail, so a task whose history has churned far
# past this entry may record it a second time -- an honest re-statement after a
# long gap, not a line per pass).
#
# THE BINDING KEY IS PASSED WHERE THE CALLER KNOWS IT. `role.<role>` is the
# right advice only where a role chain is what bound the actor; a reviewer slot
# can equally have come from `review.<tier>` or from the fallback to the engine
# that built the candidate, and advice naming the wrong key is advice about
# somebody else's chain (lib/drive.sh's drive_capability_handoff_text).
#
# AND THE TASK ID GOES WITH IT, for the same caller: a reviewer slot's key
# cannot be acted on without `orchid jobs review-plan <task> --repin`, because
# the attempt's plan is pinned and a config edit does not move a pinned row.
# The id is right here at every call site, and advice that named the verb
# without the task it applies to would be one more thing to look up.
#
# AND THE JOURNAL WRITE ITSELF IS NOT THIS FILE'S OWN. The launcher this pass
# just ran records the same sentence synchronously, on `orchid jobs prepare`'s
# exit 19 -- it has to, because on the paths no driver wraps (PROTOCOL.md's
# PLANNING critique loop, a session driving the launcher by hand) it is the only
# writer there is. So on a driver pass the line is normally already there and
# this call finds it and adds nothing; what this function still owns, and what
# nothing outside the driver can write, is the BOUNDARY. Both writers share one
# sentence (lib/capability.sh's capability_step_handoff_line) and one
# once-per-distinct-line rule (orchid_journal_once), because the dedup is a
# string comparison and two copies that drifted would stop seeing each other's
# record -- appending one duplicate line per pass, which is exactly what the
# paragraph above says must not happen.
drive_capability_refusal() {
  local id="$1" role="$2" op="$3" point="${4:-}" binding="${5:-}"
  local text reason line
  text="$(drive_capability_handoff_text "$role" "$op" "$point" "$binding" "$id")"
  reason="$(printf '%s' "$text" | cut -f1)"
  line="$(printf '%s' "$text" | cut -f2-)"
  orchid_journal_once "$repo" "$id" "$line"
  set_boundary operator-handoff "$id" "$reason"
  return 0
}

# drive_job_outstanding <task> <operation> [hook-point] -- 0 iff a LIVE job
# for that task/operation (and, for hooks, that point) is still on disk.
#
# A `pid: 0` manifest with NO LOG is deliberately NOT one. `orchid jobs
# prepare` mints every manifest with pid 0 and runners/orchid-launch stamps the
# real pid only after the spawn -- and it creates the log by redirecting that
# spawn into it -- so pid 0 with no log is a job whose spawn line was provably
# never reached. Adopting one here would advance a task into an active status
# behind a job that will never produce an envelope: no `jobs check` finding, no
# infra-fail, no boundary, just a task parked in `implementing` forever. That
# is precisely the LAUNCH-FIRST-ADVANCE-ONLY-ON-A-SPAWN invariant
# drive_dispatch documents, so that manifest reads as "no job" and the caller
# relaunches -- which is safe, because it is exactly the class `jobs prepare`
# refuses to duplicate and `jobs gc` reaps.
#
# A `pid: 0` manifest WITH A FRESH LOG IS ONE (T027 rework). That is a launcher
# killed inside the window between the spawn and the pid stamp, and something
# is writing to that log right now: an engine is running with its pid recorded
# nowhere on disk. Reading it as "no job" is how a duplicate implementer got
# into the same worktree -- and it made the careful retention everywhere else
# pointless, since the manifest that was being kept as the only handle on that
# process did not stop the second one being launched over it. So it counts as
# outstanding, and the caller waits.
#
# BOUNDED, so that wait is not the new forever. `stall_minutes` without a line
# of output is the kernel's existing standard for "this is not working"
# (`jobs check` kills a stamped job over it); past that the manifest stops
# counting here, `jobs check` reports it `unstamped`, the escalation sweep
# spends one rung on it and `jobs gc` retires it -- keeping the log, since no
# pid was ever recorded to kill and that log is the only evidence left. The
# three converge on the same instant because all three ask the same predicate.
#
# ...WITH ONE EXCEPTION PAST THAT BOUND (T031). The bound above ends the wait
# because past it nothing is expected from the job any more. That is not true of
# a job which has already FILED an envelope reconcile is holding: with no pid
# ever stamped, `jobs reconcile` will not read the silence as an exit
# (libexec/orchid-jobs' job_liveness -> `unresolved`), so the engine behind that
# report may still be running and still committing. Letting a walk read "no job"
# there is what would put a second engine into the same worktree -- the exact
# duplicate-dispatch this predicate exists to prevent, arrived at one bound
# later. So it stays outstanding for as long as that envelope is held, which is
# NOT a new forever: the escalation sweep meets the identical state in the same
# pass, spends one rung and stops the pass at an operator boundary. The moment
# the job's exit is recorded the envelope files, the manifest is deleted, and
# this reads "no job" again on its own.
drive_job_outstanding() {
  local task="$1" op="$2" point="${3:-}"
  local stall_s log mf jid
  stall_s=$(( $(config_get "$repo" stall_minutes 10) * 60 ))
  for mf in "$rt/jobs"/*.json; do
    [ -e "$mf" ] || continue
    [ "$(jq -r '.task' "$mf" 2>/dev/null || echo)" = "$task" ] || continue
    [ "$(jq -r '.operation' "$mf" 2>/dev/null || echo)" = "$op" ] || continue
    if [ -n "$point" ]; then
      [ "$(jq -r '.hook_point // ""' "$mf" 2>/dev/null || echo)" = "$point" ] || continue
    fi
    if [ "$(jq -r '.pid // 0' "$mf" 2>/dev/null || echo 0)" = 0 ]; then
      log="$(jq -r '.log // ""' "$mf" 2>/dev/null || echo)"
      [ -n "$log" ] && [ -e "$log" ] || continue
      if [ $(( $(date +%s) - $(file_mtime "$log") )) -gt "$stall_s" ]; then
        jid="$(jq -r '.job_id // empty' "$mf" 2>/dev/null || echo)"
        [ -n "$jid" ] && [ -e "$rt/spool/$jid.json" ] && [ ! -e "$rt/exits/$jid" ] || continue
      fi
    fi
    return 0
  done
  return 1
}

# ---------------------------------------------------------------------------
# Hook gating. A hook is a JOB: it is launched, it reconciles on a later pass,
# and only then can its artifact be read. A one-pass driver therefore DEFERS
# the step a hook point guards rather than blocking on it -- that step simply
# happens next pass, once the envelope has landed. This keeps a pass bounded
# (nothing here ever sleeps on an engine) without letting a `:required`
# binding be skipped.
#
# A point bound only `optional` therefore defers a step at most until its job
# RESOLVES -- an envelope lands, or the job dies without one. It never parks
# the step past that: an optional handler that dies leaving nothing behind is
# noted and stepped over, exactly as lib/drive.sh's satisfaction rule already
# says optional entries never gate anything. Only a `:required` binding can
# hold a transition indefinitely, and only ever as a NAMED boundary.
#
# Returns: 0 satisfied (or the point is unbound, or bound only `optional`)
#          1 pending -- just dispatched, or still running; do nothing yet
#          2 the guarded transition is NOT taken and a boundary has been
#            raised: either a `:required` entry failed (hook-failure), or the
#            hook step could not be routed to the handler bound to this point
#            at all (operator-handoff, INV-16)
# ---------------------------------------------------------------------------
drive_hook_gate() {
  local id="$1" point="$2" attempt="$3" cand="$4"
  local bindings n_env unsat line hid first lrc spawned
  bindings="$(hooks_for "$repo" "$point")"
  [ -n "$bindings" ] || return 0

  if drive_job_outstanding "$id" hook "$point"; then
    drive_note "$id: awaiting the $point hook envelope"
    return 1
  fi

  # Envelopes are counted IN SCOPE for the current candidate: one left behind
  # by a candidate that has since moved (within this same attempt) is not
  # evidence for the one on the task now, and counting it would leave the
  # point launched-never-again and the step it guards gated forever.
  n_env="$(drive_hook_envelope_count "$repo" "$id" "$point" "$attempt" "$cand")"

  if [ "$n_env" -eq 0 ]; then
    if ! drive_hook_has_required "$repo" "$point"; then
      case "$optional_hooks_died" in
        *" $id:$point "*)
          drive_note "$id: the optional $point hook produced no envelope — stepping over it (optional never gates)"
          return 0 ;;
      esac
    fi
    first=1; spawned=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      hid="$(printf '%s' "$line" | cut -f1)"
      lrc=0
      if [ "$first" -eq 1 ]; then
        drive_launch "$id" hook hook "" "$point" || lrc=$?
        first=0
      else
        drive_launch "$id" hook hook "$hid" "$point" || lrc=$?
      fi
      if [ "$lrc" -eq 19 ]; then
        # A handler bound to this point cannot be routed the hook step at all.
        # Reported as the hand-off it is and the guarded step is NOT taken --
        # returning 2 here rather than falling through to the "dispatched,
        # deferring to the next pass" line below, which would promise an
        # envelope no job was ever started to produce.
        #
        # Unreachable while lib/capability.sh prices `hook` at nothing, and
        # written anyway: the price is a row in a table, the arm that handles
        # its consequence is control flow, and a table gaining a row must never
        # be the moment a driver first discovers it has no branch for the
        # answer.
        drive_capability_refusal "$id" hook hook "$point"
        return 2
      fi
      [ "$lrc" -eq 0 ] || break
      spawned=$(( spawned + 1 ))
    done <<< "$bindings"
    # NOTHING WAS DISPATCHED AND THE POINT IS ALREADY ANSWERED. drive_launch
    # records an optional handler whose launcher failed in the same pass-local
    # fact the dead-job sweep uses, so this is the synchronous twin of the
    # step-over above: the handler produced no envelope, it never will for this
    # candidate, and an optional binding gates nothing. Deferring instead would
    # hand the next pass exactly the same broken launch to make exactly the same
    # decision -- the step it guards would be parked for as long as the launcher
    # stayed broken, which for the shape this task exists to close (a pack that
    # cannot be built, a binary that will not resolve) is forever.
    #
    # Only when NOTHING spawned. If one binding of a multi-binding point did
    # launch, there is a live job whose envelope has to land before this point
    # can be read at all, and the ordinary deferral below is what waits for it.
    if [ "$spawned" -eq 0 ]; then
      case "$optional_hooks_died" in
        *" $id:$point "*)
          drive_note "$id: the optional $point hook could not be launched — stepping over it (optional never gates)"
          return 0 ;;
      esac
    fi
    drive_note "$id: dispatched the $point hook — deferring the step it guards to the next pass"
    return 1
  fi

  unsat="$(drive_hook_unsatisfied "$repo" "$id" "$point" "$attempt" "$cand")"
  if [ -n "$unsat" ]; then
    set_boundary hook-failure "$id" "required $point hook binding(s) without an ok envelope for this candidate: $(printf '%s' "$unsat" | tr '\n' ' ')"
    return 2
  fi
  return 0
}

# ---------------------------------------------------------------------------
# pending / rework -> whichever active status the archetype declares.
# ---------------------------------------------------------------------------
drive_dispatch() {
  local id="$1" arch="$2" from="$3"
  local tf target outcome blockers plan action path branch integ integ_head base_stamp arc lrc role_line role op wtmiss prep prep_why
  local rework_engine reps last_engine last_name lnrc rjrc
  tf="$state/tasks/$id.md"
  target="$(drive_dispatch_target "$arch" "$from")"
  if [ -z "$target" ]; then
    set_boundary operator-decision "$id" "archetype '$arch' declares no dispatch transition out of $from"
    return 0
  fi

  blockers="$(schedule_dispatch_blockers "$repo" "$id" 2>/dev/null || true)"
  if [ -n "$blockers" ]; then
    drive_note "$id: not dispatchable yet — $(printf '%s' "$blockers" | tr '\n' ';')"
    return 0
  fi

  integ="$(config_get "$repo" integration_branch orchid/integration)"
  if ! integ_head="$(git -C "$repo" rev-parse --verify -q "refs/heads/$integ" 2>/dev/null)"; then
    set_boundary operator-decision "$id" "integration branch '$integ' does not exist"
    return 0
  fi

  outcome="$(archetype_outcome "$arch")"
  if [ "$outcome" = code ]; then
    # A code-producing archetype needs an isolated checkout to build a
    # candidate in. Idempotent and crash-safe by construction: the plan below
    # never creates a second worktree for a task, and never adopts a path it
    # cannot prove belongs to this task, this branch and this repository.
    plan="$(drive_worktree_plan "$repo" "$id")"
    action="$(printf '%s' "$plan" | cut -f1)"
    path="$(printf '%s' "$plan" | cut -f2-)"
    branch="$(fm_get "$tf" branch)"
    case "$action" in
      refuse)
        set_boundary worktree-conflict "$id" "$path"
        return 0 ;;
      create)
        if ! git -C "$repo" worktree add -q "$path" -b "$branch" "$integ_head" >/dev/null 2>&1; then
          set_boundary worktree-conflict "$id" "git worktree add failed for branch $branch at $path"
          return 0
        fi
        drive_note "$id: created the dispatch worktree $path on $branch"
        "$ORCHID_BIN" task set "$id" worktree "$path"
        ;;
      adopt)
        drive_note "$id: adopted the orphan dispatch worktree $path (created before its field was recorded)"
        "$ORCHID_BIN" task set "$id" worktree "$path"
        ;;
      reuse)
        drive_note "$id: reusing the registered dispatch worktree $path"
        ;;
      *)
        set_boundary worktree-conflict "$id" "unrecognized worktree plan '$action'"
        return 0 ;;
    esac
    # base_sha is only ever STAMPED, never re-stamped: a rework re-dispatch
    # keeps the base its candidate was actually built on, so `orchid merge`'s
    # stale-base detection (and INV-07's forced re-verify) stays truthful.
    #
    # STAMPED HERE, IMMEDIATELY BELOW THE CHECKOUT AND ABOVE THE PREPARE STEP.
    # `$integ_head` was read at the top of this dispatch and is the sha the
    # `create` arm just made the task's branch at, so the stamp is only
    # truthful while it is still the same pass -- and the prepare step below
    # can end the pass. A `fail` there returns without dispatching, and until
    # the operator repairs whatever broke, every later pass re-reads
    # $integ_head; any other task that merges in the meantime moves it. Stamp
    # afterwards and the repaired pass records THAT sha against a branch built
    # on the older one, and it records it as current: `orchid merge` compares
    # base_sha with the integration head to decide whether the candidate needs
    # rebasing and re-verifying, so a candidate that really is behind is merged
    # as though it were up to date, skipping the re-verify INV-07 requires.
    # Nothing later can notice -- the two shas agree, which is exactly the
    # state the check reads as "nothing to do".
    #
    # AND IT IS THE BRANCH'S OWN BASE, NOT THIS PASS'S INTEGRATION HEAD. Only
    # the `create` arm above just made the branch at `$integ_head`; `adopt`
    # and `reuse` are reached precisely BECAUSE the branch already existed,
    # made at whatever the integration head was on the pass that created it --
    # and adopt is by definition the pass after a crash, so an unstamped
    # base_sha there is the ordinary case, not an exotic one. Stamping the
    # current head for those two writes the same false claim the timing above
    # exists to prevent, just sourced from the plan instead of from the clock:
    # a base the candidate does not descend from, recorded as though it were
    # current, which is the one state `orchid merge` reads as "no rebase, no
    # re-verify". The fork point of the branch from the integration head IS
    # the base it was built on -- equal to `$integ_head` in the `create` arm,
    # so this is one rule and not a special case. If git cannot answer (an
    # unrelated history), fall back rather than leave the field empty: a base
    # that is merely stale makes `merge` rebase and re-verify, which is the
    # safe direction, while no base at all blocks entry to `testing` outright.
    if [ -z "$(fm_get "$tf" base_sha)" ]; then
      base_stamp=""
      [ "$action" = create ] \
        || base_stamp="$(git -C "$repo" merge-base "$integ_head" "$branch" 2>/dev/null || true)"
      [ -n "$base_stamp" ] || base_stamp="$integ_head"
      "$ORCHID_BIN" task set "$id" base_sha "$base_stamp"
    fi
    # The checkout exists; now make it USABLE. A fresh worktree holds only
    # what is committed, so a project whose verification needs untracked
    # setup would hand this task's implementer a checkout its own verify
    # command cannot pass -- and report that environment's problem as the
    # candidate's. `worktree_prepare` (config, default unset) is where the
    # operator closes that gap; unconfigured, this is a no-op, and a
    # checkout already prepared with the same command is skipped rather than
    # re-prepared on every pass. Runs for reuse/adopt too, not just create:
    # the stamp lives in the worktree's own private git dir, so the ONLY
    # thing that decides is whether this exact checkout has been prepared
    # with this exact command -- which is false for the orphan a crashed
    # pass left behind, and for a worktree that predates the config.
    prep="$(worktree_prepare "$repo" "$path" "$id")"
    case "$(printf '%s' "$prep" | cut -f1)" in
      fail)
        # ON THE INFRA LADDER, NOT THE ATTEMPT COUNTER. This is the whole
        # point of the prepare step existing as its own command: folded into
        # `verify` instead, a broken bootstrap is a failed verification, which
        # spends one of the task's ATTEMPTS and reads as "the candidate is
        # wrong" -- the misdiagnosis the dogfood findings behind this feature
        # are made of. Charged through the kernel's own counter (which
        # journals its reason and auto-blocks at `infra_max`) so a bootstrap
        # nobody fixes converts into a blocked task after a bounded number of
        # passes, instead of a boundary re-raised forever. `|| true` because a
        # counter that could not be written must not take the pass down with
        # it: the boundary below is the report that actually reaches a human,
        # and it is raised either way.
        prep_why="$(printf '%s' "$prep" | cut -f2-)"
        "$ORCHID_BIN" task infra-fail "$id" \
          --reason "worktree_prepare failed for the dispatch worktree: $prep_why" || true
        # Named for the condition, not for the counter: the task stays where
        # it was and an operator has to fix the environment either way. If
        # that infra-fail was the one that hit the cap, the task is now
        # `blocked`, and the next pass reports it as such through the
        # blocked-task boundary that owns that state.
        set_boundary worktree-conflict "$id" "$prep_why"
        return 0 ;;
      ok)
        drive_note "$id: prepared the dispatch worktree $path (log: $(printf '%s' "$prep" | cut -f2-))" ;;
    esac
    # DETECT AND REPORT WHAT `worktree add` COULD NOT CARRY (lesson L003).
    # It reproduces what git TRACKS, so a gitignored dependency tree the
    # integration checkout carries -- `node_modules`, `vendor`, `.venv`, a
    # symlink into a sibling checkout -- is simply not here, and the first
    # `orchid verify` in this worktree fails on missing dependencies.
    #
    # Reported at the moment somebody can still act on it, rather than after a
    # round has been spent discovering it. This is a NOTE and not a boundary on
    # purpose: most ignored directories a worktree lacks are nobody's problem
    # (a `.cache`, a stale `target`), and stopping a dispatch for every one of
    # them would trade a lost attempt for a stalled run. The classifier is the
    # backstop if this note goes unread -- such a round is `environment`, and
    # charges no attempt.
    #
    # ASKED AFTER THE PREPARE STEP, NOT BEFORE IT -- which is where this used
    # to sit, inside the `create` arm above. `worktree_prepare` exists to put
    # exactly this state into the checkout, so a repository that has configured
    # one is the case this note was written for AND the case it is now wrong
    # about: run first, it names a gap that is about to be filled, on every
    # single dispatch, and tells the operator to go and do by hand the thing
    # their config already does. Asked afterwards the answer is simply true --
    # whatever the prepare step supplied is present and goes unmentioned,
    # whatever it did not is still named. The remedy names that key too, so an
    # operator meeting this note for the first time is pointed at the step
    # rather than at a manual copy that the next `worktree add` undoes.
    #
    # Still only for `create`: an adopted or reused checkout has been through
    # this once already, and a note repeated on every pass over a long-running
    # task is a note nobody reads.
    if [ "$action" = create ]; then
      wtmiss="$(drive_env_missing_state "$repo" "$path" || true)"
      if [ -n "$wtmiss" ]; then
        drive_note "$id: NOTE — the new worktree does not carry gitignored state the integration checkout has, which git worktree add cannot reproduce (L003); set worktree_prepare to the command that provides it if the suite needs it: $(printf '%s' "$wtmiss" | tr '\n' ' ')"
      fi
    fi
  else
    # An outcome=report archetype produces no commits, so it needs no worktree
    # and builds no candidate: it reports on what the integration branch
    # already holds. Both shas are pinned to that head so its review envelopes
    # still bind to something concrete -- the reviewing -> arbitrating gate is
    # sha-bound for every archetype, not just code-producing ones.
    if [ -z "$(fm_get "$tf" base_sha)" ]; then
      "$ORCHID_BIN" task set "$id" base_sha "$integ_head"
    fi
    if [ -z "$(fm_get "$tf" candidate_sha)" ]; then
      "$ORCHID_BIN" task set "$id" candidate_sha "$integ_head"
    fi
  fi

  # LAUNCH FIRST, ADVANCE ONLY ON A SPAWN. The order is the whole point: a
  # task advanced into an active status by a dispatch whose launch never
  # minted a manifest waits forever for an envelope nobody is producing --
  # `jobs check` sees no job, `drive_implementing` sees no envelope, and the
  # pass exits 0 with no boundary and nothing to escalate. Exit 14 (no
  # eligible engine) makes that ordinary rather than exotic: the ledger
  # window closes for minutes at a time. PROTOCOL.md's Failover paragraph
  # requires the task to stay in its PRIOR status through exactly that, so
  # the identical dispatch simply succeeds on a later pass.
  #
  # The reviewer target is the exception, and only because it needs none of
  # this: `drive_reviewing` recomputes the routing table and relaunches the
  # slots that are missing on EVERY pass, so a reviewing task with no job is
  # always picked back up.
  role_line="$(drive_role_for_status "$target")"
  role=""; op=""
  if [ -n "$role_line" ]; then
    role="$(printf '%s' "$role_line" | cut -f1)"
    op="$(printf '%s' "$role_line" | cut -f2)"
  fi
  if [ -n "$role" ] && [ "$role" != reviewer ]; then
    if drive_job_outstanding "$id" "$op"; then
      # A pass that died between the spawn and the advance below already left
      # the job running: adopt it rather than spawning a second one.
      drive_note "$id: adopting the $op job an earlier pass already spawned"
    else
      # T025: rework failover. Two consecutive rework rounds whose failure
      # output was byte-identical (kernel-recorded as
      # `rework_signature_repeats`, see libexec/orchid-task) say something the
      # exit code alone never does: this engine, on this task, is not
      # converging -- it is producing the same answer to the same question.
      # The task's own budget is not the place to spend that discovery, so the
      # NEXT attempt is routed to the next eligible entry in the same role's
      # chain, excluding the engine that filed the last candidate.
      #
      # Strictly a preference. No alternate entry (a one-engine chain, an
      # untested fallback, a ledger window shut on the rest) simply dispatches
      # as usual and says so -- degrading to "same engine, but now it can SEE
      # its previous failure" is still strictly better than the loop this
      # replaces, and stalling a dispatchable task over a routing nicety would
      # not be.
      #
      # Computed HERE, inside the arm that actually spawns, and never in the
      # adopt arm above: the journal entry below asserts "this attempt runs on
      # <engine>", and a re-entrant pass (one that died between the spawn and
      # the advance) adopts a job already running on the OLD engine. Deciding
      # the reroute before that fork would journal a reroute that never
      # happened, once per recovering pass, and the reroute record is exactly
      # what an operator reads to find out which engine produced which
      # candidate.
      rework_engine=""
      if [ "$from" = rework ]; then
        reps="$(fm_get "$tf" rework_signature_repeats)"
        case "$reps" in ''|*[!0-9]*) reps=0 ;; esac
        # The kernel records this field from the implement envelope's
        # self-reported `.engine`, which adapters emit in qualified form
        # ("orchid/claude"), and the kernel's own strip only removes the
        # first-party "orchid/" prefix -- so a third-party actor arrives here
        # as "acme/foo", which is NOT how a role chain names it. It has to be
        # translated before the exclusion below can bite.
        last_engine="$(fm_get "$tf" implementer_engine_id)"
        # ...but a repeated signature only indicts an ENGINE when the failure
        # was an engine's to answer. A red repo-wide `merge_gate` is not: it is
        # a check the repository applies to everything, which this task was
        # never asked about, and libexec/orchid-task calls it "the one merge
        # failure that repeats identically until somebody outside this task
        # acts". It clears the identical-signature test by construction, on the
        # first repeat, for reasons no implementer chose and no alternate
        # engine can change -- so rerouting on it spends a second engine's
        # round on a wall it cannot move and leaves a durable line blaming the
        # engine that ran for an answer that was never its to give. The
        # non-convergence STOP below still applies (the loop is genuinely
        # stuck, whoever is at fault, and the boundary it raises says which);
        # only this attribution is withheld.
        if [ "$reps" -ge 2 ] && ! rework_streak_attributable "$state" "$id"; then
          drive_note "$id: rework signature unchanged $reps times, but the repeated failure is the repository's own merge_gate — no engine can converge on that, so the role is not rerouted"
          reps=0
        fi
        # ...and it only indicts an engine ORCHID CAN NAME. A chain is walked by
        # INSTALL-DIRECTORY name; this field holds a MANIFEST ID. The two
        # coincide for every plugin `orchid plugins install` placed -- which is
        # why the bare `${id##*/}` strip this used to do read correctly in every
        # fixture and every shipped layout -- but they are not the same fact,
        # and a vendored, hand-placed or renamed directory separates them. Then
        # the strip names a chain entry that does not exist,
        # `resolve_role_available` excludes nothing, and the walk hands back THE
        # ENGINE THAT JUST FAILED -- while the journal below records, durably
        # and in the operator's own words, that this attempt was routed to a
        # different one. That record is the only place anyone can learn which
        # engine produced which candidate, so a false entry in it is worse than
        # a reroute that never happened.
        #
        # The actor is therefore RESOLVED through the registry that installed it
        # (resolve_engine_name_any: the directory a binding uses, or the
        # qualified id an installed manifest claims), never guessed at -- the
        # same refusal lib/review.sh's _review_engine_name_for_qid and
        # lib/capability.sh's routing gate already make about the same field.
        #
        # AND WHEN IT CANNOT BE NAMED, THE REROUTE IS DROPPED RATHER THAN AIMED.
        # Nothing installed answering to it (uninstalled since) and two plugins
        # claiming one id (INV-10 refuses to pick between them) both leave this
        # pass unable to say which chain entry did not converge. Falling back to
        # the basename, or to whichever engine the role resolves to right now,
        # would put a name orchid cannot stand behind into a durable indictment.
        #
        # Dropping it costs less than it looks like it should, which is why this
        # is the cheap side of the trade rather than a sacrifice: what is
        # withheld is the PREFERENCE and its record, never the round. The
        # dispatch below still happens, and if the unnameable actor is
        # unresolvable because it is no longer installed, `resolve_role_available`
        # skips it on its own ("not found on search path") and the next entry
        # takes the work anyway -- the same destination, minus a journal line
        # this pass could not have written truthfully. The engine that does run
        # still SEES the previous failure, which is the substantive half of this
        # feature, and the non-convergence stop still ends the loop.
        if [ "$reps" -ge 2 ] && [ -n "$last_engine" ]; then
          lnrc=0
          last_name="$(resolve_engine_name_any "$last_engine" 2>/dev/null)" || lnrc=$?
          if [ "$lnrc" -eq 0 ] && [ -n "$last_name" ]; then
            last_engine="$last_name"
          else
            drive_note "$id: rework signature unchanged $reps times, but the actor that filed the last candidate ('$last_engine') resolves to no single installed plugin, so the chain entry to exclude cannot be named — dispatching on the same chain, and claiming no reroute"
            reps=0
          fi
        fi
        # AND NO RECORDED ACTOR IS THE SAME ANSWER, for the same reason. An
        # adapter is not REQUIRED to report `.engine` (reconcile only
        # cross-checks it when present) and libexec/orchid-task writes this
        # field only when it finds one, so a round whose envelope was absent,
        # refused as a no-op delivery, or degraded (T040) records nothing about
        # who ran it. On a chain that never reports, the field is EMPTY, which
        # this arm can see and does. On a MIXED chain the same round used to
        # leave the PREVIOUS round's value standing, which no state visible
        # here distinguishes from a current one; that was the kernel record's
        # to fix and it is fixed there rather than guessed at here -- `task
        # advance implementing -> testing` now CLEARS the field when the
        # round's own envelope names no engine, so a stale name never reaches
        # this walk and "empty" means exactly one thing at this line.
        #
        # This arm used to guess: fall back to whichever engine the role
        # resolves to right now, "absent a ledger change, exactly the one that
        # ran last time". That claim is false in precisely the situation the
        # guess is consulted in, and this feature is what makes it false. The
        # walk below deliberately routes AWAY from the chain primary, so from
        # the second reroute onward the engine that ran last is the ALTERNATE
        # while the guess still names the primary. The exclusion then excludes
        # an engine that did not run, the walk hands back the one that did, and
        # the journal records -- durably, in the operator's own words -- "an
        # identical failure signature under '<primary>' -- this attempt runs on
        # '<alternate>'" when the last round was the alternate's and this one is
        # the alternate's too. Two false halves and no reroute at all, in the
        # single record that answers which engine produced which candidate.
        #
        # NOR IS THERE A NARROWER GUESS THAT HOLDS. "Only guess on the FIRST
        # crossing (`reps` exactly 2), where the previous round cannot have been
        # rerouted" is true of the streak and false of the dispatch: a reroute
        # withheld for any of the reasons above leaves the round on the default
        # anyway, a ledger window or a capsuite record can move that default
        # between passes, and `orchid jobs prepare --engine` puts a round on an
        # engine no chain walk would have picked. Every one of those breaks the
        # correspondence between "what the role resolves to" and "what ran", and
        # a guess that is right most of the time is exactly how a durable record
        # comes to be trusted while being wrong.
        #
        # So an unrecorded actor is treated exactly as an unnameable one above:
        # the PREFERENCE and its record are withheld, never the round. The
        # dispatch still happens on the same chain, the engine that runs still
        # SEES the previous failure, and the non-convergence stop still ends the
        # loop. PROTOCOL.md says the exclusion reads the kernel-written
        # `implementer_engine_id` and nothing else; with no such record there is
        # no engine to name, and inventing one is not a weaker version of naming
        # it.
        if [ "$reps" -ge 2 ] && [ -z "$last_engine" ]; then
          drive_note "$id: rework signature unchanged $reps times, but no implementer_engine_id is recorded for the round that filed the last candidate, so the chain entry to exclude cannot be named — dispatching on the same chain, and claiming no reroute"
          reps=0
        fi
        if [ "$reps" -ge 2 ] && [ -n "$last_engine" ]; then
          if rework_engine="$(resolve_role_available "$repo" "$role" "$op" "$last_engine" 2>/dev/null)"; then
            # Journal only after drive_launch proves this reroute spawned --
            # and only if it really is a DIFFERENT engine. Unreachable while
            # that walk's exclusion is an exact match on the chain entry, which
            # is precisely why the check is here: the sentence below is a claim
            # about two names being different, and the one bug this arm has
            # already shipped was that claim going unchecked while the exclusion
            # silently matched nothing. Cheap enough to assert rather than
            # assume, and inert for as long as the assumption holds.
            if [ "$rework_engine" = "$last_engine" ]; then
              rework_engine=""
              drive_note "$id: rework signature unchanged $reps times under '$last_engine', and the chain walk returned that same engine — no reroute is claimed for a dispatch that is not one"
            fi
          else
            rework_engine=""
            drive_note "$id: rework signature unchanged $reps times under '$last_engine', but role '$role' has no other eligible engine — dispatching on the same chain"
          fi
        fi
      fi
      lrc=0
      drive_launch "$id" "$role" "$op" "$rework_engine" || lrc=$?
      if [ "$lrc" -eq 14 ] || [ "$lrc" -eq 18 ]; then
        # The documented WAITs (see drive_launch). No boundary: nothing is
        # wrong, and both clear without anyone doing anything -- the ledger
        # window reopens on its own, and gc reaps the orphaned manifest.
        drive_note "$id: staying in $from — nothing was spawned, so there is nothing to wait for"
        return 0
      fi
      if [ "$lrc" -eq 19 ]; then
        # The opposite of a wait (INV-16). The task stays in $from -- it has
        # not been advanced, so no envelope is awaited and no attempt is spent
        # -- and the step is handed over by name.
        drive_capability_refusal "$id" "$role" "$op"
        return 0
      fi
      if [ "$lrc" -ne 0 ]; then
        # Any OTHER launch failure is broken infrastructure, not a wait.
        # drive_launch has already journaled it and spent a rung of the
        # escalation ladder (which auto-blocks at infra_max, so it cannot be
        # retried forever); the boundary is what stops THIS pass and tells a
        # human, since the task itself stays dispatchable.
        set_boundary operator-decision "$id" \
          "dispatch launch for role '$role' failed (exit $lrc); $id stays in $from and nothing was spawned"
        return 0
      fi
      if [ -n "$rework_engine" ]; then
        # The record says THIS ATTEMPT RUNS on the alternate, so spawning is
        # its precondition. A refused/failed launch must leave no durable line
        # claiming a reroute occurred. Record it before the state advance so
        # a crash after this point still explains the outstanding job the
        # next pass adopts.
        rjrc=0
        "$ORCHID_BIN" journal add --task "$id" \
          "rework routed to a different engine: $reps consecutive attempts produced an identical failure signature under '$last_engine' — this attempt runs on '$rework_engine'" >/dev/null || rjrc=$?
        if [ "$rjrc" -ne 0 ]; then
          set_boundary operator-decision "$id" \
            "rework reroute spawned on '$rework_engine', but its journal record failed (exit $rjrc); the task stays in $from and the next pass will adopt the outstanding job"
          return 0
        fi
        drive_note "$id: rework signature unchanged $reps times under '$last_engine' — routed this attempt to '$rework_engine'"
      fi
    fi
  fi

  arc=0
  "$ORCHID_BIN" task advance "$id" "$target" \
    --reason "dispatching: deps satisfied ($from -> $target)" >/dev/null || arc=$?
  if [ "$arc" -ne 0 ]; then
    set_boundary operator-decision "$id" "dispatch advance $from -> $target refused (exit $arc)"
    return 0
  fi
  drive_note "$id: $from -> $target"

  if [ -z "$role" ]; then
    drive_note "$id: no launch is defined for status $target — nothing spawned"
    return 0
  fi
  if [ "$role" = reviewer ]; then
    drive_reviewing "$id" "$arch"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# implementing -- turn the implementer's own envelope into a candidate.
# ---------------------------------------------------------------------------
drive_implementing() {
  local id="$1" arch="$2" tf envf envb wt cand floor arc why
  local dirty drc verdict
  local advreason="implementer envelope ok"
  tf="$state/tasks/$id.md"
  why=""; envb=""

  # A LIVE implement job outranks EVERY envelope on disk. Asked first, before
  # anything is read, because it decides both of the readings below.
  #
  # `jobs reconcile` deletes a job's manifest in the same step that files its
  # envelope, so an implement job still outstanding has filed nothing: whatever
  # envelope this task has is one an EARLIER dispatch left, and the live job was
  # started precisely because that envelope was not good enough. Reading it
  # again while its own replacement is being written is wrong in both
  # directions, and this arm is the only one where both can be true at once:
  #
  #   AS A FAILURE, it re-counts. drive_implement_failed reads DURABLE evidence:
  #   reconcile files every implement envelope of an attempt as a sibling
  #   (-a<n>-implementer.json, .2.json, ...) and removes none of them. So the
  #   moment one implementer reports non-ok, that predicate is true for the
  #   whole REST of the attempt -- including the entire lifetime of the relaunch
  #   the escalation below is about to start. Unguarded, the ladder then runs on
  #   the wall clock instead of on failures: pass N infra-fails 1/3 and
  #   relaunches, pass N+1 reads the same stale envelope and infra-fails 2/3 --
  #   spawning a SECOND implementer into the same worktree, on the same branch,
  #   while the first is still committing to it -- and pass N+2 auto-blocks the
  #   task with two or three engines still writing to that checkout.
  #
  #   AS AN ACCEPTANCE, it advances work nobody vouched for. The stale envelope
  #   is compared against a worktree the live job is MOVING: the instant that
  #   job makes its first commit, an envelope already refused as a no-op
  #   delivery (below) stops looking like one -- HEAD is off the floor -- and an
  #   unguarded walk would advance that half-written tree to testing on the
  #   authority of an envelope written before any of it existed, and stamp it as
  #   the candidate while its author is still typing. The mark described by
  #   lib/drive.sh's drive_delivery_refused closes that door permanently; this
  #   guard closes it for the window the relaunch is alive, which is the window
  #   in which the worktree can move under an envelope that never mentioned it.
  #
  # Every sibling arm already asks this question before it spawns
  # (drive_hook_gate, drive_dispatch, drive_reviewing); this one asked nobody.
  #
  # WHY THE CONCURRENCY GUARD LIVES HERE AND NOT IN `orchid jobs prepare`.
  # Refusing, inside the mint verb, to add a job while one is outstanding for
  # the same task+operation looks like the stronger, more central fix. It is
  # neither:
  #
  #   * It is WRONG for two of the four operations. A dual-review tier routes
  #     two `review` jobs for one task on purpose, each to a different engine
  #     (lib/review.sh's routing table), and a point with two hook bindings
  #     launches two `hook` jobs for one task and one point (drive_hook_gate's
  #     dispatch loop). A blanket refusal breaks both; an operation-keyed
  #     exemption list is a hardcoded policy branch inside a verb whose whole
  #     job is to mint an identity.
  #   * It cannot answer the question it would be asked. "Is a job already
  #     outstanding" is not "does a manifest exist": an unstamped manifest may
  #     be a launch that died before its spawn with nothing running, which is
  #     exactly why drive_job_outstanding refuses to read one as live. prepare
  #     would have to re-derive that liveness rule, and getting it wrong turns a
  #     recoverable orphan into a permanent refusal to relaunch -- at the one
  #     moment recovery is needed.
  #   * It is the wrong tier. Whether to have a second engine running is a
  #     dispatch decision, and dispatch is tier-2's alone (INV-01/INV-06).
  #     prepare mints identity; it is not told, and must not guess, whether its
  #     caller intends concurrency.
  #
  # So CONCURRENCY stays a single driver-side question, asked by the one
  # predicate all four arms share. That is unchanged by T027, and this note is
  # still the authority on it. libexec/orchid-jobs' `prepare` arm carries a
  # pointer back to it.
  #
  # What T027 did add to `prepare` is not this guard and does not weaken any of
  # the three arguments above. It refuses a second manifest only when the slot
  # already holds a NEVER-STARTED one -- pid 0 AND no log, so the spawn line
  # provably was never reached (libexec/orchid-jobs' job_never_started).
  # Against each argument in turn: it is not operation-blind, because a
  # legitimate duplicate is a second job someone intends to RUN and this only
  # ever sees one that never ran; it does not re-derive a liveness rule it
  # could get wrong, because "no engine was ever spawned" is not a guess; and
  # it is not a dispatch decision, because refusing to mint a second orphan for
  # a slot that already has one takes no position on how many engines may run
  # -- it bounds this verb's OWN litter. The one hazard the second argument
  # really names, a refusal that outlives the thing it refuses over, is closed
  # by construction: the refusal and `jobs gc`'s reap share the one predicate,
  # and that reap runs in every phase.
  if drive_job_outstanding "$id" implement; then
    drive_note "$id: awaiting the implementer envelope (a relaunched implement job is still running — the envelope it was launched over is not a fresh failure)"
    return 0
  fi

  envf="$(drive_implement_envelope "$repo" "$id")"

  # AN OK ENVELOPE IS NOT EVIDENCE THAT WORK HAPPENED. A dispatch can report
  # `ok` with a summary that is pure commentary -- the findings it was handed,
  # restated; its sources, listed -- over a worktree whose HEAD never moved and
  # whose tree is clean. Advancing on that spends a full verify and a full
  # review round re-proving a defect this run already arbitrated, and burns a
  # rework attempt on a candidate nobody touched.
  #
  # So an envelope that delivered nothing is simply NOT AN ACCEPTABLE ENVELOPE,
  # and saying it that way -- by dropping it here, before anything reads it --
  # is what keeps this half of the problem from growing a second ladder beside
  # the one below. The arm below is the ONLY place an implement failure is
  # accounted: the guard above already deferred the whole walk if a relaunch is
  # in flight, and it escalates at most once per pass through the one
  # `drive_escalate` call each shape reaches. One event, one rung, whichever
  # shape produced it. `why` carries only WHICH failure this is, never how it
  # is counted; `envb` carries WHICH envelope, so the refusal can be made to
  # stick to it.
  if [ -n "$envf" ]; then
    if ! drive_has_transition "$arch" implementing testing; then
      set_boundary operator-decision "$id" "archetype '$arch' declares no implementing -> testing edge"
      return 0
    fi
    wt="$(fm_get "$tf" worktree)"; [ -n "$wt" ] || wt="$repo"
    if ! cand="$(git -C "$wt" rev-parse HEAD 2>/dev/null)"; then
      set_boundary worktree-conflict "$id" "cannot read HEAD of the task worktree $wt"
      return 0
    fi
    if drive_delivery_is_noop "$repo" "$id" "$cand"; then
      floor="$(drive_delivery_floor "$repo" "$id")"
      # WHICH no-op this is decides who answers it, so the tree is read and the
      # task's own two shas are compared before anything is charged. A sha
      # comparison cannot see a tree: an unmoved HEAD over a worktree full of
      # uncommitted edits is a dispatch that did the work and failed to commit
      # it, not one that sat still, and the ladder's recovery -- relaunch the
      # implementer into that same worktree -- would hand the next dispatch a
      # tree it did not create and cannot account for. `.orchid/` is excluded
      # by the reader itself, being no part of any candidate.
      #
      # NOR CAN IT SEE WHETHER A CANDIDATE EXISTS AT ALL. The floor is the
      # candidate_sha where the task has one and the base_sha where it does
      # not, so "HEAD is still the floor" is TWO situations, and only one of
      # them is a delivery failure (lesson L039): with the floor at the base
      # nothing was ever produced, while with the floor at a candidate ahead of
      # that base the work is already on disk and this round merely added
      # nothing to it. The verdict asks that question; this arm routes on the
      # answer.
      drc=0
      dirty="$(handoff_worktree_dirty "$wt")" || drc=$?
      verdict="$(drive_delivery_verdict "$repo" "$id" "$cand" "$dirty" "$drc")"
      case "$verdict" in
        nothing)
          why="implement envelope reported ok but delivered nothing: worktree HEAD $cand is unchanged from the task's recorded $floor, and the tree is clean — the dispatch left no commit and no edit"
          envb="$(basename "$envf")"
          envf="" ;;
        unchanged)
          # A CANDIDATE EXISTS AND THIS ROUND ADDED NOTHING TO IT. Not a rung,
          # not a boundary: the task is ADVANCED on the candidate it already
          # has, and the journal says that is what happened and why.
          #
          # ADVANCE rather than stop, because a stop here is the defect this
          # arm was taught to stop causing. The case is produced by ordinary
          # operation -- a rebase rewrites the task's commits, the driver
          # re-stamps the new HEAD as candidate_sha, the next round dispatches
          # and the implementer truthfully reports that the work it is being
          # asked for is already in place -- so every run with concurrency
          # above one reaches it, and answering it with a human wakes an
          # operator per rebased task to say "yes, that is your own candidate".
          # Nor is it unbounded: from here the candidate takes the ordinary
          # route, and an engine that keeps adding nothing to a candidate that
          # keeps failing verification spends the ATTEMPT budget -- which is
          # the right budget, bounding defects in work that WAS delivered --
          # and reaches a human at its cap like any other rework round.
          #
          # And nothing is charged to the job-delivery ladder, whose recovery
          # is to relaunch the implementer: there is nothing here to relaunch
          # FOR. The envelope is not marked refused either -- it is being
          # accepted, over the candidate it truthfully describes.
          advreason="implementer envelope ok over the candidate the task already had: worktree HEAD $cand is unchanged and its tree is clean, but that sha is the recorded candidate_sha and it is ahead of the recorded base_sha $(fm_get "$tf" base_sha) — a candidate exists and this round added nothing to it, which is a routing question and not a delivery failure, so nothing is charged and no envelope is refused"
          drive_note "$id: the ok envelope added no commit, but the task's recorded candidate $cand is ahead of its base — a candidate exists and this round added nothing to it, so this is a routing question and not a delivery failure: advancing on the existing candidate, charging nothing"
          ;;
        uncommitted)
          # Not a rung. Nothing is charged, nothing is relaunched and the
          # envelope is NOT marked refused: whether that work is committed onto
          # the branch or thrown away is a decision about somebody's real
          # output, and both resolutions leave this arm correct on the next
          # pass -- committed, HEAD is off the floor and the envelope is
          # ordinary delivery; discarded, the tree is clean and this becomes
          # whichever of the two clean arms above the task's own shas select. A
          # mark here would break the first of those by making the envelope
          # unselectable after the work landed.
          drive_note "$id: implementing -> testing REFUSED — the ok envelope committed nothing, but the dispatch DID leave uncommitted work behind ($dirty)"
          set_boundary operator-decision "$id" \
            "implement envelope reported ok but committed nothing: worktree HEAD $cand is unchanged from the task's recorded $floor, and the dispatch left uncommitted work in $wt ($dirty) — commit it onto the task branch or discard it; relaunching an implementer over it would hand the next dispatch a tree it did not write"
          return 0 ;;
        *)
          # `uninspected`, and anything this arm has not been taught -- the one
          # word it can never see here is `delivered`, which the is_noop guard
          # above already excluded. A tree that could not be READ takes the same
          # direction as a dirty one and is never folded into the clean case: an
          # inspection that answers "clean" when it could not look would spend a
          # rung and relaunch over a worktree nobody has seen, the fail-open
          # shape lib/handoff.sh exists to close. An unrecognized verdict stops
          # here for the same reason -- a `case` that fell through to the
          # refusal would charge a rung on a state it could not name.
          set_boundary worktree-conflict "$id" \
            "implement envelope reported ok with worktree HEAD $cand unchanged from the task's recorded $floor, and its tree is '$verdict' rather than clean — $dirty"
          return 0 ;;
      esac
    fi
  fi

  if [ -z "$envf" ]; then
    # The no-op delivery above, if that is what dropped the envelope. It is a
    # JOB-DELIVERY failure and takes the same rung the arm below takes, never
    # one of its own: `infra_failures` (which relaunches the implementer and
    # auto-blocks at `infra_max`) and never `attempts`, whose budget exists to
    # bound defects in work that was actually delivered. Nothing is written to
    # `candidate_sha` either -- there is no new candidate to record, and
    # restamping the same sha would record nothing while touching `updated` on
    # a task that did not move. (The mark below does touch `updated`, and
    # should: a refusal on record IS a change of state, unlike a sha rewritten
    # to its own value.)
    #
    # AND THE REFUSAL IS MADE TO STICK, by recording the envelope it refused --
    # drive_delivery_refused documents the two doors an unmarked one walks back
    # in through. ORDER: escalate first, mark second. Both writes go through
    # named verbs and neither can be made atomic with the other, so the order is
    # a choice about which half a pass killed between them leaves behind. A lost
    # MARK costs at most one duplicate rung on a ladder that ends at a human
    # anyway. A lost ESCALATION would leave a task with no relaunch, no live
    # job, no acceptable envelope and no boundary -- parked in `implementing`
    # forever, the exact disappearing act this walk exists to end.
    if [ -n "$why" ]; then
      drive_note "$id: implementing -> testing REFUSED — the ok envelope moved no commit (worktree HEAD $cand, recorded $floor)"
      drive_escalate "$id" implementer implement "" "$why"
      "$ORCHID_BIN" task set "$id" refused_envelopes \
        "$(drive_delivery_refusal_list "$repo" "$id" "$envb")" >/dev/null
      return 0
    fi
    if drive_implement_failed "$repo" "$id"; then
      drive_escalate "$id" implementer implement "" "implement envelope reconciled with a non-ok status"
      return 0
    fi
    # A refusal already on record, with nothing outstanding and nothing
    # acceptable on disk. The mark is what makes this state possible -- it is
    # the one signal in this walk that DELETES itself, unlike a non-ok envelope,
    # which stays readable and re-escalates every pass until the cap fetches a
    # human. So the refusal stands in for it: the relaunch it started is neither
    # running nor has it filed anything (no eligible engine at the time, a
    # launch that failed, a job that died before writing), and waiting on it
    # would be waiting forever. Same ladder, same cap, one honest reason.
    if drive_delivery_refused_any "$repo" "$id"; then
      drive_escalate "$id" implementer implement "" \
        "the implement relaunch after a refused no-op delivery is neither running nor has it filed an envelope"
      return 0
    fi
    drive_note "$id: awaiting the implementer envelope"
    return 0
  fi

  # The reason is a VARIABLE because this arm is reached by two roads and the
  # journal is the only place the difference is ever recorded: an envelope that
  # delivered a new commit, and (above) one that added nothing to a candidate
  # the task already had. `drive_note` prints to the pass and is gone with it;
  # the reason goes through the verb, into the journal, where an operator
  # reading back a run can see WHICH of the two this round was and why it was
  # not charged. The advance itself is the same advance either way -- one
  # candidate_sha write, one transition (docs tripwire in tests/test_docs.sh).
  "$ORCHID_BIN" task set "$id" candidate_sha "$cand"
  arc=0
  "$ORCHID_BIN" task advance "$id" testing --reason "$advreason" >/dev/null || arc=$?
  if [ "$arc" -ne 0 ]; then
    set_boundary operator-decision "$id" "implementing -> testing refused (exit $arc) — inspect the candidate's own commits"
    return 0
  fi
  drive_note "$id: implementing -> testing (candidate $cand)"
  return 0
}

# ---------------------------------------------------------------------------
# testing -- `orchid verify` runs synchronously, in this pass's own
# foreground. There is no job here for check/reconcile to see.
# ---------------------------------------------------------------------------
drive_verify_fail_pending_consume() {
  local id="$1" tf mark crc=0
  tf="$state/tasks/$id.md"
  mark="$(fm_get "$tf" verify_fail_pending)"
  [ -n "$mark" ] || return 0
  "$ORCHID_BIN" task set "$id" verify_fail_pending "" >/dev/null || crc=$?
  if [ "$crc" -ne 0 ]; then
    set_boundary operator-decision "$id" \
      "the deferred verify failure was accounted, but its receipt '$mark' could not be consumed (exit $crc) — clear it with: orchid task set $id verify_fail_pending \"\""
    return 1
  fi
  drive_note "$id: consumed deferred verify-failure receipt $mark"
  return 0
}

# drive_rework_nonconvergence_stop <task> <failure-context> -- after ANY edge
# has landed in rework and captured its evidence, stop a byte-identical loop at
# the configured threshold. Both testing and merging can produce that edge;
# keeping the judgment here prevents the merge-validation family from evading
# the stop simply because its failure was discovered one phase later.
#
# ONE STOP, ONE PAGE, THROUGH THE ROUTE EVERY OTHER BLOCK TAKES. This arm used
# to do what the four arms drive_notify's header names did: raise its own
# `orchid notify` AND record a boundary in its own third wording. That is three
# questions for one decision -- the direct page (compared against nothing, so it
# de-duplicates against nothing), the boundary the foot of this file pages for on
# this pass, and the DIFFERENT boundary the blocked walk recomposes on the next
# pass through drive_block_boundary. The operator answers one qid and the others
# stand in BLOCKERS.md until `answer_expiry_s` turns them into refusals.
#
# So the stop blocks the task and then records the boundary its own block
# produced, exactly as drive_testing's exhausted-budget arm and the merging arm
# do. drive_block_boundary derives BOTH the kind and the reason from the journal
# entry `task advance` just wrote, so this pass and every later walk of the same
# blocked task compose byte-identical records -- which is what the de-dup at the
# foot of this file needs to raise one blocker for a condition that persists, and
# what gives the page a declared answer set (`unblock | retry | reverify |
# defer`) instead of a bare `<choice>` placeholder. lib/drive.sh's
# drive_blocked_kind files a non-convergence cause under `operator-decision`,
# which is the kind docs/specs/kernel.md's rework-feedback rule names.
#
# THE REASON IS THEREFORE THE DURABLE ONE, and it is composed to fit
# lib/drive.sh's `_DRIVE_QUOTE_MAX` so the page carries it whole. The long prose
# this arm used to put on a one-shot notify now lives where prose belongs: in
# `drive_note`, read by whoever is watching the pass. What has to survive onto
# the page an operator meets over and over is shorter and fixed -- that the loop
# is not converging, how many rounds said so, WHOSE wall it is, and the file to
# read -- because a reason clipped mid-word is a page that names half a path.
#
# Returns 0 only when the task really is blocked. Returns 1 both when the streak
# is below the threshold AND when the block was REFUSED: in the second case a
# boundary is already recorded, and the caller's ordinary reporting is still the
# truth, because the task really is still in `rework` and the next pass really
# will dispatch it again. Claiming `rework -> blocked` on a refused advance --
# or recording a boundary that asserts the stop succeeded -- would leave an
# operator looking for a blocked task that is not there. Call only as an `if`
# condition under set -e.
drive_rework_nonconvergence_stop() {
  local id="$1" context="$2" tf reps nc_max rwlog rel whose remedy culprit reason barc
  tf="$state/tasks/$id.md"
  [ "$(fm_get "$tf" status)" = rework ] || return 1
  reps="$(fm_get "$tf" rework_signature_repeats)"
  case "$reps" in ''|*[!0-9]*) reps=0 ;; esac
  nc_max="$(config_get "$repo" rework_nonconvergence_max 3)"
  case "$nc_max" in ''|*[!0-9]*) nc_max=3 ;; esac
  [ "$nc_max" -gt 0 ] && [ "$reps" -ge "$nc_max" ] || return 1

  rwlog="$(rework_latest_log "$state" "$id" 0 2>/dev/null || true)"
  # Named the way every other evidence pointer in this file is named --
  # repo-relative, not as the absolute path `rework_latest_log` returns. The
  # page is one line on a phone; a machine-local prefix spends thirty of its
  # characters saying nothing the operator did not already know.
  rel=".orchid/reviews/"
  [ -z "$rwlog" ] || rel=".orchid/reviews/${rwlog##*/}"
  # WHOSE WALL IT IS. The stop itself is correct either way -- a loop this stuck
  # needs a person, whatever put it there -- so only the attribution moves. A red
  # repo-wide `merge_gate` repeats identically by construction and is frequently
  # not this task's doing at all: without this clause the one boundary an
  # operator re-reads on every pass tells them to look at a loop and an engine,
  # when what is red is the repository. Read from the captured evidence's own
  # header, never inferred (the same rule findings_log_gate_failed applies for
  # the merging arm above), and the dispatch side withholds the engine reroute on
  # the same answer. With NO captured log there is nothing to read it from, so
  # the sentence claims neither party rather than guessing one.
  whose=""; remedy=""; culprit=""
  if [ -n "$rwlog" ]; then
    if findings_log_gate_failed "$rwlog"; then
      whose="repo merge_gate "
      remedy="fix the repository; "
      culprit=" — and what repeats is the repository's own merge_gate, which this candidate was never asked about: no further implementer round can turn it green, so fix the repository (or this candidate, if the gate names it) rather than re-dispatching"
    else
      whose="candidate-suite "
    fi
  fi
  reason="rework not converging: $reps identical ${whose}rounds; ${remedy}see $rel"

  barc=0
  "$ORCHID_BIN" task advance "$id" blocked --reason "$reason" >/dev/null || barc=$?
  if [ "$barc" -ne 0 ]; then
    drive_note "$id: $context, signature unchanged $reps times — rework -> blocked REFUSED (exit $barc); the task is still in rework$culprit"
    set_boundary operator-decision "$id" \
      "rework is not converging ($reps consecutive attempts produced a byte-identical failure signature; see $rel) but rework -> blocked was REFUSED (exit $barc) — the task is still in rework and the next pass will dispatch it again; stop it by hand with: orchid task advance $id blocked --reason \"...\"$culprit"
    return 1
  fi
  drive_note "$id: $context, signature unchanged $reps times — rework -> blocked (not converging)$culprit"
  drive_block_boundary "$id"
  return 0
}

drive_testing() {
  local id="$1" arch="$2" tf vrc attempt cand hg guidance attempts budget arc
  local hstate hdetail
  local cls_line cls cls_reason prior_waived wmark waiver_reason
  local clsrc ifrc fsrc floor_mark jrc barc after_attempts after_status
  local pending pending_prefix pending_digest evidence_digest resume_failure
  local hook_bindings prc
  wmark="$(drive_waiver_mark)"
  tf="$state/tasks/$id.md"
  cls=""; cls_line=""; evidence_digest=""

  # THE OPERATOR HAND-OFF (PROTOCOL.md, THE TICK's implementing arm). Between
  # the implementer's envelope reconciling and `orchid verify` running there
  # is a point at which execution-requiring mechanical work belongs to an
  # operator: a lint fix, the mode bit on a newly added executable, a
  # generator whose output is checked in -- but never an artifact derived from
  # the WHOLE TREE, which conflicts unresolvably if regenerated per candidate
  # and belongs to the integration branch instead (lesson L022). An engine
  # profile that denies on the command STRING can perform none of it (lesson
  # L017), so verifying before it has been done is not merely early -- it is
  # a guaranteed FAIL that spends one of the task's rework rounds
  # (`rework_max`, or its own `attempt_budget`) on work nobody was going to do
  # in that round, and sends the implementer back a failure it cannot act on.
  #
  # Where a repository asks for that pause (`handoff_before_verify`), the pass
  # STOPS here at a named boundary instead of verifying. The stop is on the
  # ACKNOWLEDGEMENT, never on the moment: `handoff_ack` bound to this exact
  # candidate_sha is what a resumed session or a second driver pass reads to
  # tell "already performed" from "still outstanding". That is what keeps this
  # from being an infinite loop in one direction and a silent walk-past in the
  # other -- and it is why the acknowledgement dies with the candidate it was
  # made against (a rebase, a fresh rework round), rather than with the task.
  #
  # RAISED BEFORE THE PREREQUISITE BELOW, and the order is load-bearing rather
  # than arbitrary (T024). Acknowledging a hand-off ADVANCES `candidate_sha`
  # onto the commit the mechanical steps produced, and `prerequisite_ack` is
  # bound to `candidate_sha` by the same rule `handoff_ack` is -- so an
  # operator who takes the prerequisite first has it expired by the hand-off
  # they take second, and meets this arm again. Raising the hand-off first is
  # what routes them through the two stops in the order that costs one command
  # each. Nothing is enforced by it: taking them out of order still converges,
  # one extra `prereq-ack` later, and the boundary raised then says exactly
  # which candidate the expired acknowledgement was for.
  hstate="$(handoff_state "$repo" "$id")"
  if [ "$(printf '%s' "$hstate" | cut -f1)" = outstanding ]; then
    hdetail="$(printf '%s' "$hstate" | cut -f2-)"
    set_boundary operator-handoff "$id" \
      "verification is held until this candidate's operator-owned mechanical steps are performed and recorded — $hdetail (then: orchid task handoff $id --ack --reason ...)"
    return 0
  fi

  # BEFORE the suite runs, not after it fails (T024, dogfood F26). A declared
  # step outside this sandbox must be acknowledged for the current candidate.
  # Stop without evidence or an attempt charge until it is.
  if handoff_prereq_unmet "$tf"; then
    if handoff_prereq_stale "$tf"; then
      set_boundary task-prerequisite "$id" \
        "operator prerequisite acknowledged for candidate $(fm_get "$tf" prerequisite_ack), superseded by $(fm_get "$tf" candidate_sha): $(fm_get "$tf" operator_prerequisite) — re-take it for the current candidate, then: orchid task prereq-ack $id --reason \"...\""
    else
      set_boundary task-prerequisite "$id" \
        "unacknowledged operator prerequisite: $(fm_get "$tf" operator_prerequisite) — do it, then: orchid task prereq-ack $id --reason \"...\""
    fi
    return 0
  fi

  attempt=$(( $(fm_get "$tf" attempts) + 1 ))
  cand="$(fm_get "$tf" candidate_sha)"; [ -n "$cand" ] || cand=none
  pending="$(fm_get "$tf" verify_fail_pending)"
  pending_prefix="a$attempt:$cand:"
  resume_failure=0

  # `on_verify_fail` is asynchronous: its job is launched in one pass and its
  # envelope is reconciled in a later one. The failed verify evidence is a
  # SINGLE mutable file, however. Re-running `orchid verify` while that hook is
  # pending overwrites the failure before drive_verify_class can read it; a
  # transient PASS then advances to reviewing with the failed round neither
  # charged nor journalled. `verify_fail_pending` is the crash-resumption
  # receipt for that exact round: attempt + candidate + evidence digest.
  #
  # A matching receipt means "resume the failure arm", never "verify again".
  # A stale receipt is cleared before a genuinely new run. The digest is
  # checked below, immediately before classification; changed or missing
  # evidence fails CLOSED as candidate-owned rather than letting substituted
  # bytes buy a waiver.
  case "$pending" in
    "$pending_prefix"*)
      resume_failure=1
      drive_note "$id: resuming the deferred verify failure for attempt $attempt without rerunning or overwriting its evidence"
      ;;
    "") ;;
    *)
      prc=0
      "$ORCHID_BIN" task set "$id" verify_fail_pending "" >/dev/null || prc=$?
      if [ "$prc" -ne 0 ]; then
        set_boundary operator-decision "$id" \
          "stale verify_fail_pending '$pending' could not be cleared (exit $prc) — clear it with: orchid task set $id verify_fail_pending \"\""
        return 0
      fi
      pending=""
      ;;
  esac

  vrc=0
  if [ "$resume_failure" -eq 0 ]; then
    drive_lease_heartbeat_start
    "$ORCHID_BIN" verify "$id" >/dev/null 2>&1 || vrc=$?
    drive_lease_heartbeat_stop
    # `orchid verify` independently enforces the same gate. State can change
    # after the preflight above; exit 16 is still an operator stop, never a
    # candidate failure or a spent attempt.
    #
    # EACH REFUSAL ARM RETURNS, and the returns are the load-bearing half of
    # them (T031 attempt-5 rework). Everything below this block is the
    # CANDIDATE-FAILURE arm: it classifies the verify log, spends a rework
    # round and sends the implementer a failure to act on. A refusal that
    # merely recorded its boundary and fell through would be carried into all
    # of that -- the operator's stop reported AND the candidate charged for a
    # suite that never judged it. `vrc` is non-zero for both, so the
    # `[ "$vrc" -eq 0 ]` gate below cannot tell them apart; the return is what
    # does.
    if [ "$vrc" -eq 16 ]; then
      set_boundary task-prerequisite "$id" \
        "orchid verify refused: an operator prerequisite is not acknowledged for this candidate — orchid task prereq-ack $id --reason \"...\""
      return 0
    fi
    if [ "$vrc" -eq 20 ]; then
      # T031: the verifier refused because the worktree was not the recorded
      # candidate (or moved while the suite ran). That establishes no defect
      # in the candidate, so stop for the operator instead of charging it.
      set_boundary worktree-conflict "$id" \
        "verify refused: the task worktree is not the recorded candidate_sha — see .orchid/reviews/$id-verify.log"
      return 0
    fi
  else
    vrc=1
  fi
  if [ "$vrc" -eq 0 ]; then
    if ! drive_has_transition "$arch" testing reviewing; then
      set_boundary operator-decision "$id" "archetype '$arch' declares no testing -> reviewing edge"
      return 0
    fi
    arc=0
    "$ORCHID_BIN" task advance "$id" reviewing --reason "verify passed" >/dev/null || arc=$?
    if [ "$arc" -ne 0 ]; then
      set_boundary operator-decision "$id" "testing -> reviewing refused (exit $arc) — the verify evidence is not bound to the current candidate"
      return 0
    fi
    drive_note "$id: verify PASS, testing -> reviewing"
    drive_reviewing "$id" "$arch"
    return 0
  fi

  # Preserve this exact failure BEFORE a bound asynchronous hook can defer the
  # rest of the arm. The task verb is the durable-state writer (INV-13); the
  # driver never edits frontmatter directly. No binding means no deferral and
  # therefore no receipt is needed.
  hook_bindings="$(hooks_for "$repo" on_verify_fail)"
  if [ "$resume_failure" -eq 0 ] && [ -n "$hook_bindings" ]; then
    evidence_digest=missing
    if [ -f "$state/reviews/$id-verify.log" ]; then
      evidence_digest="$(_orchid_file_sha256 "$state/reviews/$id-verify.log")"
      evidence_digest="${evidence_digest%% *}"
    fi
    pending="a$attempt:$cand:$evidence_digest"
    prc=0
    "$ORCHID_BIN" task set "$id" verify_fail_pending "$pending" >/dev/null || prc=$?
    if [ "$prc" -ne 0 ]; then
      set_boundary operator-decision "$id" \
        "verify failed, but its deferred-hook receipt could not be recorded (exit $prc) — preserve this round with: orchid task set $id verify_fail_pending '$pending'"
      return 0
    fi
  fi

  hg=0
  drive_hook_gate "$id" on_verify_fail "$attempt" "$cand" || hg=$?
  [ "$hg" -eq 0 ] || return 0
  guidance="$(drive_hook_guidance "$repo" "$id" on_verify_fail "$attempt")"
  if [ -n "$guidance" ]; then
    # FLATTENED HERE, not refused downstream (T034, dogfood F34). This is the
    # one caller of `task set` whose value is engine-written prose: a hook's
    # `.artifact.guidance` is whatever the hook plugin chose to say, and
    # multi-line advice is the natural thing to write. Frontmatter holds one
    # line per key, so `task set` now refuses a newline outright -- which is
    # right for an operator typing the value, and wrong here: the guidance is
    # ADVISORY (it never changes a routing decision), so a refusal would abort
    # an autonomous rework round over a formatting detail nobody chose. Folding
    # it to one line keeps every word of it attached to the task. Before both
    # changes this path could destroy the task file mid-run, with no operator
    # present at all.
    guidance="$(printf '%s' "$guidance" | tr '\n' ' ')"
    "$ORCHID_BIN" task set "$id" hook_guidance "$guidance"
    drive_note "$id: attached the on_verify_fail hook's guidance to the task"
  fi

  # Classify the failure BEFORE anything charges it (lib/drive.sh,
  # drive_verify_class). Read the evidence now: the rework advance below
  # invalidates the verify log on its way through.
  #
  # THE CLASSIFIER MAY NOT KILL THE PASS, and that is not defensive padding.
  # This library is sourced into a `set -euo pipefail` runner and read through
  # a command substitution, so any non-zero it returns -- a pin check that died
  # in a way its own arm did not anticipate, a git that could not answer --
  # propagated straight out as the PASS's exit
  # status. That exits with a code this runner does not document (0, 16 or 1),
  # leaves every task after this one in the walk untouched with no boundary and
  # no journal line, and does it at the one moment the run is already failing.
  # A classifier that cannot answer is the case the strict default was written
  # for, so it takes the strict default and SAYS the classifier itself is what
  # failed -- charging the attempt, exactly as an unreadable evidence log does.
  clsrc=0
  if [ "$resume_failure" -eq 1 ]; then
    pending_digest="${pending##*:}"
    evidence_digest=missing
    if [ -f "$state/reviews/$id-verify.log" ]; then
      evidence_digest="$(_orchid_file_sha256 "$state/reviews/$id-verify.log")"
      evidence_digest="${evidence_digest%% *}"
    fi
  else
    pending_digest="$evidence_digest"
  fi
  if [ "$resume_failure" -eq 1 ] && [ "$pending_digest" != "$evidence_digest" ]; then
    cls=candidate
    cls_reason="the failed evidence changed while its on_verify_fail hook was deferred (recorded digest $pending_digest, current digest $evidence_digest); charging per the strict default rather than classifying substituted or missing bytes"
  else
    cls_line="$(drive_verify_class "$repo" "$tf" "$state/reviews/$id-verify.log")" || clsrc=$?
  fi
  if [ -z "$cls" ] && { [ "$clsrc" -ne 0 ] || [ -z "$cls_line" ]; }; then
    cls=candidate
    cls_reason="the failure could not be classified — the classifier itself did not answer (exit $clsrc, ${#cls_line} bytes); charging per the strict default rather than forgiving a round nothing was able to read"
  elif [ -z "$cls" ]; then
    cls="${cls_line%%$'\t'*}"
    cls_reason="${cls_line#*$'\t'}"
  fi

  if [ "$cls" != candidate ]; then
    # This sentence is the durable contract of every non-candidate arm, not
    # merely of the one that reaches `task advance --waive-attempt`. Several
    # correct early exits preserve the attempts counter without taking that
    # edge -- an infra cap blocks, recurrence holds in testing, and an
    # archetype may declare no rework edge at all. If only the successful
    # advance carries the marker, those equally uncharged outcomes leave an
    # operator inferring policy from a counter that happened not to move.
    waiver_reason="$(drive_waiver_reason "$cls" "$cls_reason")"
    # The edge is checked BEFORE anything is charged. A task whose archetype
    # has no testing -> rework edge is going to an operator either way, and
    # spending environment budget on a round that never advances would charge
    # for a refusal -- the same "charged for something that is not the
    # candidate" mistake this whole path exists to stop, one budget over.
    if ! drive_has_transition "$arch" testing rework; then
      jrc=0
      "$ORCHID_BIN" journal add --task "$id" \
        "$waiver_reason — held in testing because archetype '$arch' declares no testing -> rework edge; neither the attempt nor the environment budget was charged" >/dev/null || jrc=$?
      if [ "$jrc" -ne 0 ]; then
        set_boundary operator-decision "$id" \
          "verify failed ($cls), the attempt was not charged, and the required journal record failed (exit $jrc); archetype '$arch' declares no testing -> rework edge"
        return 0
      fi
      drive_verify_fail_pending_consume "$id" || return 0
      set_boundary operator-decision "$id" "verify failed ($cls) and archetype '$arch' declares no testing -> rework edge"
      return 0
    fi
    # Not the candidate's failure, so not the candidate's attempt. It is still
    # a failure that must be counted somewhere, or an environment fault would
    # loop this task forever at zero cost: `infra_failures` is the kernel's
    # existing budget for exactly this, with its own journal-first discipline
    # and its own `infra_max` auto-block. Rework is then entered WAIVED, whose
    # `attempt_waiver` journal entry carries the classification and its reason
    # -- so "this failure was not charged, and here is why" is a durable,
    # greppable fact rather than an inference from a counter that did not move.
    #
    # Read this task's OWN waived-round history. The guard used to key on
    # `infra_failures`, which also counts a dead job manifest and a launch that
    # could not spawn -- an unrelated earlier one then held the task for an
    # operator before the single retry that is supposed to happen.
    prior_waived="$(drive_waived_rounds "$state/journal.md" "$id" || true)"
    case "$prior_waived" in ''|*[!0-9]*) prior_waived=0 ;; esac
    # Charged through the verb, and its REFUSAL is a boundary rather than the
    # end of the pass. Every other verb call in this file already captures its
    # status this way; these were the ones that did not, and on the one path
    # where the run is already failing that turned a refusal into an
    # undocumented exit code with the rest of the walk silently skipped.
    ifrc=0
    "$ORCHID_BIN" task infra-fail "$id" \
      --reason "$waiver_reason" >/dev/null || ifrc=$?
    if [ "$ifrc" -ne 0 ]; then
      jrc=0
      "$ORCHID_BIN" journal add --task "$id" \
        "$waiver_reason — task infra-fail refused exit $ifrc, so the environment budget was not charged either" >/dev/null || jrc=$?
      if [ "$jrc" -eq 0 ]; then
        drive_verify_fail_pending_consume "$id" || return 0
      fi
      set_boundary operator-decision "$id" \
        "task infra-fail refused this $cls verify failure (exit $ifrc), so the round was neither charged to the environment budget nor waived; attempt-not-charged journal record exit $jrc: $cls_reason"
      return 0
    fi
    if [ "$(fm_get "$tf" status)" = blocked ]; then
      drive_note "$id: verify FAIL ($cls, $wmark) — infra_failures cap reached, testing -> blocked"
      set_boundary operator-decision "$id" "repeated non-candidate verify failures ($cls): $cls_reason"
      return 0
    fi
    # NONE of the waivable classes is a thing the IMPLEMENTER clears: a
    # checksum is re-pinned by an operator, an exec bit set by one, a missing
    # dependency tree provisioned by whoever dispatches, and a quarantined
    # assertion fixed in the test.
    # Re-dispatching the implementer against any of them produces the identical
    # failure and nothing else, so the second one stops here rather than
    # grinding out the rest of `infra_max` on retries that cannot work. The
    # first still retries: the fault may have been cleared between the two
    # passes, and one bad round is not yet a reason to stop a run for a human.
    #
    # The count is across CLASSES on purpose (drive_waived_rounds): a task that
    # waived a hand-off and then waived a missing dependency tree has had two
    # rounds that told nobody anything about the candidate.
    if [ "$prior_waived" -ge 1 ]; then
      drive_note "$id: verify FAIL ($cls, $wmark) — recurring non-candidate fault, testing held for an operator"
      drive_verify_fail_pending_consume "$id" || return 0
      set_boundary operator-decision "$id" "$cls verify failure on a task that has already had $prior_waived non-candidate round(s) waived — an operator clears this; the implementer cannot, and another identical re-dispatch cannot: $cls_reason"
      return 0
    fi
    # The floor is recorded BEFORE the advance, while this round's envelopes
    # are still the newest on disk. Without it the waived round -- which by
    # design leaves `attempts` where it is -- re-resolves the envelope the
    # round just now being waived produced, re-stamps a worktree HEAD that
    # never moved as the candidate, and re-verifies an unchanged candidate.
    # A floor that could not be RECORDED therefore stops the pass here rather
    # than waiving anyway: waiving without it trades a failed write for a loop.
    fsrc=0
    floor_mark="$(drive_implement_floor_mark "$repo" "$id" || true)"
    if [ -n "$floor_mark" ]; then
      "$ORCHID_BIN" task set "$id" implement_floor "$floor_mark" >/dev/null || fsrc=$?
    else
      fsrc=1
    fi
    if [ "$fsrc" -ne 0 ]; then
      drive_verify_fail_pending_consume "$id" || return 0
      set_boundary operator-decision "$id" \
        "the waived round's implement floor could not be recorded (exit $fsrc), and waiving without it re-verifies the candidate that just failed: $cls_reason"
      return 0
    fi
    arc=0
    "$ORCHID_BIN" task advance "$id" rework --waive-attempt \
      --reason "$waiver_reason" >/dev/null || arc=$?
    if [ "$arc" -ne 0 ]; then
      drive_verify_fail_pending_consume "$id" || return 0
      set_boundary operator-decision "$id" "testing -> rework refused (exit $arc)"
      return 0
    fi
    drive_note "$id: verify FAIL ($cls, $wmark) — testing -> rework"
    return 0
  fi

  # The rework budget is orchestrator-enforced (docs/specs/kernel.md), not a
  # verb gate. Only reached on a CHARGED candidate failure -- a waived round
  # above never counts against this budget, which is the point of classifying
  # first. T026 made the budget configurable per repository and grantable per
  # task through `orchid task retry --attempts N`; preserve that recovery path
  # here instead of restoring the old literal-three dead end.
  #
  # ONE VERB DOES ASK THE SAME QUESTION, and this sentence exists so the claim
  # above is not read as more than it is: `orchid merge` compares against this
  # same budget on a `gate_failed` merge (T007). It has to, because there the
  # charge and the edge that follows it are one transaction inside the verb --
  # there is no moment between them for this runner to intervene, and a task
  # left in `rework` over budget would be re-dispatched by the very next pass.
  # It reads the number through schedule_attempt_budget, exactly as the line
  # below does, so what is duplicated is the comparison and never the cap.
  attempts="$(fm_get "$tf" attempts)"; [ -n "$attempts" ] || attempts=0
  budget="$(schedule_attempt_budget "$repo" "$id")"
  if [ "$attempts" -ge "$budget" ]; then
    # BLOCK FIRST, THEN RECORD THE BOUNDARY THE BLOCK PRODUCED -- one stop, one
    # record, one page. This arm used to raise its own `orchid notify` before
    # the block and then record an `operator-decision` boundary in its own
    # words, which minted a SECOND question for the same decision on this pass
    # (the boundary at the foot of this file is notified too) and a THIRD on the
    # next one, when the blocked walk restated the same stop in its own third
    # wording and the field-by-field de-dup therefore saw a new record. Only the
    # first of those three carried a declared answer set; the other two invited
    # free text for a question with four known answers, and answering any one
    # left the others standing in BLOCKERS.md until answer_expiry_s turned them
    # into refusals.
    #
    # THE EVIDENCE POINTER MOVES INTO THE BLOCK'S OWN REASON, which is where it
    # belonged: the journal entry `task advance` writes here is what
    # drive_blocked_cause reads back on this pass AND on every later one, so the
    # verify log is named on the page each time instead of only on the one-shot
    # notify this line dropped. T026's task-specific budget is retained in the
    # same sentence, and `retry --attempts N` is named by the shared reason.
    "$ORCHID_BIN" task advance "$id" blocked \
      --reason "attempts exhausted ($attempts/$budget): see .orchid/reviews/$id-verify.log" >/dev/null
    drive_note "$id: verify FAIL, attempts exhausted ($attempts/$budget) — testing -> blocked"
    drive_block_boundary "$id"
    return 0
  fi
  if ! drive_has_transition "$arch" testing rework; then
    # `testing -> rework` is the ordinary charge path, but it is not a
    # meta-contract requirement for custom code archetypes. A genuine
    # candidate failure must still consume its round. Charge and block in one
    # locked kernel verb; leaving the task in testing with an uncharged defect
    # would make repeated passes free.
    barc=0
    "$ORCHID_BIN" task advance "$id" blocked --charge-attempt \
      --reason "verify failed (candidate, attempt charged — archetype '$arch' declares no testing -> rework edge; $cls_reason): see .orchid/reviews/$id-verify.log" >/dev/null || barc=$?
    if [ "$barc" -ne 0 ]; then
      jrc=0
      "$ORCHID_BIN" journal add --task "$id" \
        "verify failed (candidate, attempt not charged): archetype '$arch' declares no testing -> rework edge, and charge-and-block refused exit $barc; strict classification reason: $cls_reason" >/dev/null || jrc=$?
      if [ "$jrc" -eq 0 ]; then
        drive_verify_fail_pending_consume "$id" || return 0
      fi
      set_boundary operator-decision "$id" \
        "candidate verify failure could not be charged: archetype '$arch' declares no testing -> rework edge and testing -> blocked --charge-attempt refused (exit $barc; journal exit $jrc)"
      return 0
    fi
    drive_note "$id: verify FAIL (candidate, attempt charged), testing -> blocked — archetype '$arch' declares no testing -> rework edge"
    set_boundary operator-decision "$id" \
      "candidate verify failure was charged and blocked because archetype '$arch' declares no testing -> rework edge — correct the archetype's recovery edges first; orchid task retry $id --reason \"...\" [--attempts N] moves it to rework only if that state has a dispatch edge, while orchid task reverify $id --reason \"...\" requires a declared blocked -> testing edge"
    return 0
  fi
  arc=0
  "$ORCHID_BIN" task advance "$id" rework \
    --reason "verify failed (candidate, attempt charged — $cls_reason): see .orchid/reviews/$id-verify.log" >/dev/null || arc=$?
  if [ "$arc" -ne 0 ]; then
    # A refusal can happen before OR after the rework verb's journal-first
    # accounting. Re-read both owned fields. Never double-charge a partially
    # completed transaction, and never charge a task another actor already
    # moved out of testing.
    after_attempts="$(fm_get "$tf" attempts)"; [ -n "$after_attempts" ] || after_attempts=0
    after_status="$(fm_get "$tf" status)"
    if [ "$after_attempts" -gt "$attempts" ]; then
      jrc=0
      "$ORCHID_BIN" journal add --task "$id" \
        "verify failed (candidate, attempt already charged): testing -> rework returned exit $arc after attempts moved $attempts -> $after_attempts; task status is $after_status, so the fallback did not charge it again" >/dev/null || jrc=$?
      if [ "$jrc" -eq 0 ]; then
        drive_verify_fail_pending_consume "$id" || return 0
      fi
      set_boundary operator-decision "$id" \
        "testing -> rework returned exit $arc after charging the candidate attempt ($attempts -> $after_attempts; status $after_status) — inspect the interrupted transition; no second charge was made"
      return 0
    fi
    if [ "$after_status" = testing ] && [ "$after_attempts" -eq "$attempts" ]; then
      barc=0
      "$ORCHID_BIN" task advance "$id" blocked --charge-attempt \
        --reason "verify failed (candidate, attempt charged after testing -> rework refused exit $arc — $cls_reason): see .orchid/reviews/$id-verify.log" >/dev/null || barc=$?
      if [ "$barc" -eq 0 ]; then
        drive_note "$id: verify FAIL (candidate, attempt charged), testing -> blocked after testing -> rework refused exit $arc"
        set_boundary operator-decision "$id" \
          "candidate verify failure was charged and task blocked after testing -> rework refused (exit $arc) — orchid task retry $id --reason \"...\" [--attempts N] retries through rework; orchid task reverify $id --reason \"...\" re-runs verification alone"
        return 0
      fi
    else
      barc=not-attempted
    fi
    jrc=0
    "$ORCHID_BIN" journal add --task "$id" \
      "verify failed (candidate, attempt not charged): testing -> rework refused exit $arc, then charge-and-block $barc (status $after_status, attempts $after_attempts); strict classification reason: $cls_reason" >/dev/null || jrc=$?
    if [ "$jrc" -eq 0 ]; then
      drive_verify_fail_pending_consume "$id" || return 0
    fi
    set_boundary operator-decision "$id" \
      "candidate verify failure could not be charged: testing -> rework refused (exit $arc), charge-and-block $barc (status $after_status, attempts $after_attempts; journal exit $jrc)"
    return 0
  fi
  # T025: an unchanged failure signature is evidence the loop is not
  # converging, not a fresh failure. The advance above just captured this
  # round's evidence and updated the streak; read it back and stop the loop
  # once the same output has come back `rework_nonconvergence_max` times in a
  # row. Without this the run spends its whole attempt budget re-asking a
  # question it has already been answered three times identically, which is
  # exactly what dogfood finding F27 recorded.
  #
  # Deliberately NOT waived (the T019 attempt-classification coordination):
  # an identical signature CONSUMES its attempt. docs/specs/kernel.md's
  # attempt-fairness rule reserves `--waive-attempt` for a failure signature
  # DISJOINT from the prior attempt's -- "distinct forward progress" -- and
  # says the cap "targets repeated identical failures". Waiving the
  # identical case would invert that: the one shape the budget exists to stop
  # would be the one shape that never spends it, and a task could loop
  # forever on a wall it is not moving. The convergence stop below is what
  # ends the loop EARLY; the attempt budget stays the outer backstop.
  if drive_rework_nonconvergence_stop "$id" "verify FAIL"; then
    return 0
  fi

  drive_note "$id: verify FAIL (candidate, attempt charged), testing -> rework"
  return 0
}

# ---------------------------------------------------------------------------
# reviewing -- route slots off `orchid jobs review-plan`, then advance once
# the kernel's own envelope count is satisfiable.
# ---------------------------------------------------------------------------
drive_reviewing() {
  local id="$1" arch="$2" tf tier need have routing unsat line slot eng label lrc arc
  local pin_rc pin_detail pin_output pin_line src
  tf="$state/tasks/$id.md"
  [ "$(fm_get "$tf" status)" = reviewing ] || return 0
  tier="$(fm_get "$tf" risk_tier)"; [ -n "$tier" ] || tier=low
  need="$(review_required_count "$tier")"
  have="$(drive_reviewer_envelope_count "$repo" "$id")"

  # The routing table is the SLOT LEDGER, not just a dispatch list: which
  # slots exist, which engine each was routed to, and therefore which of them
  # a filed review can and cannot be credited to.
  #
  # PINNED, not recomputed, and pinned on the FIRST reviewing pass rather than
  # at the first dispatch: `--pin` is idempotent, so the cost of calling it
  # every pass is one no-op verb, and the benefit is that the ledger is
  # written down before any evidence can be filed against it. A plan that is
  # still being recomputed live re-routes a slot the moment its engine's
  # health changes, and the review that slot already filed then belongs to
  # nothing -- the r-002 dead end (lib/review.sh's "PINNED plan" header).
  # Pinning is a dispatch precondition, not a best-effort optimization. If its
  # durable write or journal record fails, falling back to the live table and
  # launching reviewers recreates the exact race this pin closes: evidence is
  # produced against a plan that was never recorded and may move before the
  # next pass. Preserve the verb's diagnostic in the boundary and dispatch
  # nobody. A reviewing task with no candidate_sha is likewise malformed,
  # rather than permission to use an unbound live plan.
  pin_rc=0
  pin_output="$("$ORCHID_BIN" jobs review-plan "$id" --pin 2>&1)" || pin_rc=$?
  routing=""; pin_detail=""
  while IFS= read -r pin_line; do
    [ -n "$pin_line" ] || continue
    if review_plan_row_valid "$pin_line"; then
      routing="${routing}${routing:+$'\n'}${pin_line}"
    else
      pin_detail="${pin_detail}${pin_detail:+$' '}${pin_line}"
    fi
  done <<< "$pin_output"
  # A successful pin has one stdout grammar, and lib/review.sh's
  # `review_plan_row_valid` is its single definition -- deliberately NOT a copy
  # kept here beside the reader. The copy that used to live here fixed the row
  # at three fields, so T012's depth column turned every row of a correct pin
  # into a "diagnostic" and the driver stopped dispatching reviewers entirely.
  # Keep a diagnostic written to stderr out of the table, and fail closed on it
  # -- degraded ledger reads must not turn a jq diagnostic into a reviewer slot.
  if [ "$pin_rc" -eq 0 ] && [ -n "$pin_detail" ]; then pin_rc=1; fi
  if [ "$pin_rc" -ne 0 ]; then
    [ -n "$pin_detail" ] || pin_detail="$(printf '%s\n' "$pin_output" | tail -n 2 | tr '\n' ' ')"
    [ -n "$pin_detail" ] || pin_detail="no diagnostic returned"
    set_boundary review-evidence "$id" \
      "review-plan pin failed (exit $pin_rc), so no reviewer was dispatched: $pin_detail Expected: repair the durable review-plan/journal write path and rerun drive"
    return 0
  fi
  if [ -z "$routing" ]; then
    set_boundary review-evidence "$id" \
      "review-plan pin returned no slots, so no reviewer was dispatched. Expected: repair reviewer routing and rerun drive"
    return 0
  fi
  unsat=""
  if [ -n "$routing" ]; then
    unsat="$(drive_review_slots_unsatisfied "$repo" "$id" "$routing")"
  fi

  if [ "$have" -ge "$need" ] && [ -n "$unsat" ]; then
    # Enough envelopes for the kernel's own count, but a routed slot still has
    # none of its own -- two reviews from ONE engine where the table routed
    # two DIFFERENT ones. Relaunching would only add a third review to a set
    # the kernel already counts as complete, so this stops instead, at a
    # boundary a woken orchestrator can settle by reading the evidence.
    #
    # The boundary NAMES ITS REMEDIES. This stop is raised while the task is
    # `reviewing`, where no arbitration verb is legal, so an operator who is
    # told only what is wrong has nothing to do but hand-edit durable state --
    # which is how r-002 lost T024. Both named actions are verbs, both record
    # what they did, and `--adopt-evidence` refuses outright when crediting
    # the filed reviews would lower the independence bar rather than record
    # it, so naming it here can never talk anyone past the gate.
    set_boundary review-evidence "$id" \
      "$have of $need review envelope(s) bound to the current candidate, but slot(s) $(printf '%s' "$unsat" | cut -f1 | tr '\n' ' ')have no review of their own — the tier's engine independence is unproven. Expected: 'orchid jobs review-plan $id --adopt-evidence' when those envelopes were dispatched for the slots the plan has since re-routed, otherwise 'orchid task advance $id blocked --reason ...' to hand it to a human"
    return 0
  fi

  if [ "$have" -ge "$need" ]; then
    if ! drive_has_transition "$arch" reviewing arbitrating; then
      set_boundary operator-decision "$id" "archetype '$arch' declares no reviewing -> arbitrating edge"
      return 0
    fi
    arc=0
    "$ORCHID_BIN" task advance "$id" arbitrating \
      --reason "review reconciled: $have of $need required envelope(s) bound to the current candidate" >/dev/null || arc=$?
    if [ "$arc" -ne 0 ]; then
      set_boundary review-evidence "$id" "reviewing -> arbitrating refused by the kernel envelope gate (exit $arc)"
      return 0
    fi
    drive_note "$id: reviewing -> arbitrating ($have/$need reviews reconciled)"
    drive_arbitrating "$id" "$arch"
    return 0
  fi

  if drive_job_outstanding "$id" review; then
    drive_note "$id: awaiting review envelopes ($have/$need)"
    return 0
  fi

  if [ -z "$routing" ]; then
    set_boundary operator-decision "$id" "no reviewer routing table could be computed"
    return 0
  fi
  if [ -z "$unsat" ]; then
    # Short of the tier's count, yet every routed slot is already credited:
    # the table and the count disagree, and dispatching "some slot" to make up
    # the difference would be guessing. Named, not silently retried forever --
    # and, like the boundary above, told which verb settles it.
    set_boundary review-evidence "$id" \
      "$have of $need review envelope(s) bound to the current candidate, but the routing table has no unfilled slot to dispatch. Expected: 'orchid jobs review-plan $id --repin' to rebind the attempt to the current routing table, otherwise 'orchid task advance $id blocked --reason ...' to hand it to a human"
    return 0
  fi
  # An all-inline table on a tier that requires depth is journaled ONCE per
  # dispatching pass, before any slot goes out and by the same rule the
  # session-independent label follows: a degraded review never passes
  # silently. This is not a refusal -- every routed slot is still dispatched,
  # and an inline reviewer on a diff it can actually inspect is often the
  # only genuine engine independence an install has. It is the record that
  # says why `drive_review_decision` will decline to call the result a
  # DETERMINISTIC approval and hand the arbiter the decision instead.
  if review_depth_required "$tier" && ! review_routing_has_depth "$routing"; then
    "$ORCHID_BIN" journal add --task "$id" \
      "no worktree-capable reviewer slot for risk_tier $tier: every routed reviewer is inline (diff-only), so approval needs an arbiter" >/dev/null
  fi

  # Dispatch exactly the slots that have no review of their own -- never
  # "every slot numbered above the count", which re-dispatches the wrong slot
  # the moment a relaunched one lands out of order.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    slot="$(printf '%s' "$line" | cut -f1)"
    eng="$(printf '%s' "$line" | cut -f2)"
    label="$(printf '%s' "$line" | cut -f3)"
    case "$slot" in
      ''|*[!0-9]*) continue ;;
    esac
    if [ "$label" = session-independent ]; then
      # Never let a degraded independence pass silently -- the journal line IS
      # the record (PROTOCOL.md's risk-tiered review policy).
      "$ORCHID_BIN" journal add --task "$id" \
        "reviewer slot $slot is session-independent only: $eng, same as the implementer's" >/dev/null
    fi
    lrc=0
    drive_launch "$id" reviewer review "$eng" || lrc=$?
    if [ "$lrc" -eq 14 ]; then
      # A slot cannot fail over the way a role dispatch can: the escalation
      # ladder deliberately never relaunches a reviewer, because that would go
      # back through the role's default chain instead of the SLOT's engine
      # (PROTOCOL.md), and the plan is pinned besides. So "no eligible engine"
      # is only a WAIT here while the ledger says the window reopens by
      # itself; anything else -- an engine at its failure threshold (which can
      # only clear by being dispatched, which it no longer is), one
      # uninstalled, one that lost its role eligibility -- would wait forever
      # with nobody told. That is the same silent dead end this task exists to
      # close, so it stops, names the slot, and names the verb that rebinds it.
      if [ "$(ledger_effective_status "$repo" "$eng")" = rate_limited ]; then
        break
      fi
      set_boundary review-evidence "$id" \
        "reviewer slot $slot is pinned to engine '$eng', which cannot be dispatched (no eligible engine) — a slot never fails over to another engine on its own. Expected: 'orchid jobs review-plan $id --repin' to rebind this attempt's unfilled slot(s) to engines that can run, otherwise 'orchid task advance $id blocked --reason ...' to hand it to a human"
      return 0
    fi
    if [ "$lrc" -eq 19 ]; then
      # NAME THE KEY THIS SLOT'S ENGINE ACTUALLY RESOLVED FROM. The slot may
      # have come from `role.reviewer`'s chain, from `review.<tier>`'s, or from
      # neither -- review_routing's session-independent fallback hands slot 1
      # the engine that built the candidate, and that arm skips the reviewer
      # eligibility check every chain entry passes, so it is the slot most
      # likely to be refused here and the one `role.reviewer` describes worst.
      # The status is discarded on purpose: both answers are advice, and the
      # phrase the fallback prints is the one an operator needs.
      #
      # THE KEY IS HALF THE REMEDY. Binding a capable engine at it moves LIVE
      # routing, and this slot is a PINNED row -- so the walk would keep
      # dispatching the refused engine and the boundary would survive an edit
      # that did exactly what it was told. drive_capability_handoff_text's
      # reviewer arm therefore names `orchid jobs review-plan <id> --repin`
      # too: the same verb the exit-14 refusal a few lines above already
      # expects, so one slot's two stops send an operator the same way.
      src="$(review_slot_engine_source "$repo" "$id" "$slot" "$eng" || true)"
      drive_capability_refusal "$id" reviewer review "" "$src"
      break
    fi
    [ "$lrc" -eq 0 ] || break
  done <<< "$unsat"
  return 0
}

# ---------------------------------------------------------------------------
# arbitrating -- the one place a decision is actually made, and the only place
# this driver will ever refuse to make one.
# ---------------------------------------------------------------------------
drive_arbitrating() {
  local id="$1" arch="$2" tf attempt cand hg decision verdict detail arc
  tf="$state/tasks/$id.md"
  [ "$(fm_get "$tf" status)" = arbitrating ] || return 0
  [ -n "$arch" ] || arch=feature
  attempt=$(( $(fm_get "$tf" attempts) + 1 ))
  cand="$(fm_get "$tf" candidate_sha)"

  hg=0
  drive_hook_gate "$id" before_arbitration "$attempt" "$cand" || hg=$?
  [ "$hg" -eq 0 ] || return 0

  decision="$(drive_review_decision "$repo" "$id")"
  verdict="$(printf '%s' "$decision" | cut -f1)"
  detail="$(printf '%s' "$decision" | cut -f2-)"
  case "$verdict" in
    approve)
      arc=0
      "$ORCHID_BIN" task arbitrate "$id" --result approve \
        --reason "deterministic approval: $detail" >/dev/null || arc=$?
      if [ "$arc" -ne 0 ]; then
        set_boundary operator-decision "$id" "task arbitrate --result approve refused (exit $arc)"
        return 0
      fi
      drive_note "$id: arbitrated approve — $detail"
      ;;
    evidence)
      set_boundary review-evidence "$id" "$detail"
      ;;
    conflict)
      set_boundary review-conflict "$id" "$detail"
      ;;
    *)
      set_boundary operator-decision "$id" "the review policy returned an unrecognized decision '$verdict'"
      ;;
  esac
  return 0
}

# ---------------------------------------------------------------------------
# blocked -- always a boundary. The on_blocker hook runs once per attempt so
# its artifact is on hand for whoever resolves the block.
# ---------------------------------------------------------------------------
#
# THE PAGE STATES THE CAUSE, not just the status. "task is blocked" is the
# status restated back at the operator, and this is the boundary they re-read on
# every pass over an already-blocked task. The three remedies it names differ by
# exactly the thing that sentence left out: `unblock` records guidance, `retry`
# grants another round, `reverify` re-runs verification alone. Choosing between
# them without knowing what went wrong is a guess, and the answer to a page is
# not a thing to guess at. The cause was recorded in the journal the moment the
# block happened; drive_blocked_cause reads that back, and says so plainly when
# the journal holds none rather than inventing one.
#
# The remedy list is the WHOLE list PROTOCOL.md's boundary table names, not the
# two verbs that predate `reverify` (T026 rework) -- and it is the same list
# lib/drive.sh's drive_boundary_choices declares as the answers `orchid answer`
# will accept for BOTH the kinds this helper files, because a verb named here
# and refused there is a page that contradicts itself. A verb missing from HERE
# is a verb no operator discovers.
#
# BOTH kinds, and that is the half a repository-gate block shipped without. One
# reason text serves them, so a set declared for `blocked-task` alone is the same
# self-contradiction reached by the other route: this very sentence, naming three
# verbs on the task, went out under `operator-decision` on a page that declared
# no answers at all -- the bare `<choice>` placeholder, for the one stop whose
# answers are fully known.
#
# BOTH FACTS COME OUT OF lib/drive.sh's drive_blocked_reason, which is also what
# the arms that BLOCK a task call (drive_testing's exhausted-budget arm and the
# wallclock backstop below), and that sharing is the point rather than tidiness:
# a task blocked on this pass is recorded here in the same words it will be
# recorded in on the next one, so the boundary de-dup at the foot of this file
# sees one record persisting instead of two records replacing each other, and
# the human gets one page instead of one per pass.
#
# THE KIND IS DERIVED IN THE LIBRARY, beside the reason, and both from the same
# durable cause. A capped repo-wide gate is a judgment about the repository, not
# a task defect (T023), and that distinction has to survive EVERY later walk of
# the blocked task as well as the merge pass that first blocked it, or the record
# changes and one stop mints a second qid. Deriving it here rather than in this
# file is what lets a test compose the page the driver files instead of its own
# reading of it: a `case` copied into the coverage is how the gate-blocked page
# came to declare no answer set while the test asserted four.
drive_block_boundary() {
  local id="$1" cause
  cause="$(drive_blocked_cause "$state/journal.md" "$id" || true)"
  set_boundary "$(drive_blocked_kind "$cause")" "$id" "$(drive_blocked_reason "$id" "$cause")"
}

drive_blocked() {
  local id="$1" tf attempt cand hg
  tf="$state/tasks/$id.md"
  attempt=$(( $(fm_get "$tf" attempts) + 1 ))
  cand="$(fm_get "$tf" candidate_sha)"
  hg=0
  drive_hook_gate "$id" on_blocker "$attempt" "$cand" || hg=$?
  [ "$hg" -ne 2 ] || return 0
  drive_block_boundary "$id"
  return 0
}

# ---------------------------------------------------------------------------
# The escalation ladder, rendered deterministically. PROTOCOL.md's prose
# ladder spends its first occurrence on a free relaunch that touches no
# counter; a driver has no per-attempt memory outside `.orchid`, and inventing
# a private retry-counter file would be exactly the un-verbed cross-process
# state rule 2 above forbids. So EVERY occurrence goes through `orchid task
# infra-fail` -- the kernel-owned counter, which journals its own reason and
# auto-blocks at `infra_max` -- and the relaunch happens for as long as that
# cap has not blocked the task. Same ladder, same bound, one counter, no
# hidden state.
# ---------------------------------------------------------------------------
#
# ONE RUNG PER PASS, per task/operation/hook-point. The ladder counts JOB
# FAILURES, and a pass has at most one of those per slot to report -- but
# several separate arms can reach the same slot in one pass: the escalation
# sweep above (a manifest whose pid is dead, one that never started at all, or
# one that was spawned and never stamped a pid),
# drive_launch (a launcher that exited without spawning) and drive_implementing
# below (a reconciled non-ok envelope, a refused no-op delivery, or a refusal
# already on record with nothing left running -- one of the three at most, each
# returning where it stands). They normally cannot both fire, because the
# sweep's own relaunch leaves a live job the walk then defers to. `drive_launch`
# exit 14 breaks exactly that: no engine was eligible, so nothing spawned, and
# the walk reads the attempt's older non-ok envelope as a second failure. A
# closed ledger window is a WAIT, never a failure (see drive_launch), so
# spending a rung on it would auto-block a task at 3/3 on two real failures and
# one rate limit. Pass-local, like `optional_hooks_died`: a fact about what THIS
# pass already counted, so it needs no verb and leaves nothing behind.
#
# ONE RUNG ACROSS PASSES, TOO, and that half cannot be pass-local: the two arms
# that can charge one stranded launch are separated by a crash, not by a few
# lines. `key` (the job_id of the manifest that failure left behind) is the
# optional sixth argument, and when it is given the charge is both DEDUPED
# against the journal receipt an earlier charge wrote and STAMPED with a receipt
# of its own. Callers with no job to name -- a non-ok envelope, a refused
# delivery -- pass nothing and are unaffected: their evidence is durable
# already, and the pass-local guard is the only one they ever needed.
escalated_this_pass=" "
drive_escalate() {
  local id="$1" role="$2" op="$3" point="$4" why="$5" key="${6:-}"
  local norelaunch="${7:-}" tf slot tstatus receipt lrc
  tf="$state/tasks/$id.md"
  # Asked BEFORE anything else, including the missing-task-file arm below: a
  # charge that has already been recorded must not be re-journaled either, or
  # the record grows one duplicate entry per pass for as long as the manifest
  # survives, and the journal stops being a count of what happened.
  if [ -n "$key" ] && drive_failure_charged "$repo" "$key"; then
    drive_note "$id: $why — job $key is already on the ladder's record, so this is the same failure, not another rung"
    return 0
  fi
  # The one writer of the receipt token drive_failure_charged reads back, and it
  # is built by the same function that reads it (lib/drive.sh) so the two can
  # never drift into a dedup that silently never matches -- which would fail in
  # the double-charging direction, quietly, on a path only a crash exercises.
  receipt="$(drive_failure_receipt "$key")"
  if [ ! -f "$tf" ]; then
    # The reserved `plan` id, and anything else with no task file: there is no
    # infra_failures counter to spend and no status to block. The failure is
    # still journaled, because the alternative -- a note on stdout that the
    # next pass overwrites -- is exactly the silence this ladder exists to end.
    # The receipt rides along even here, so the dedup above answers for this
    # arm on the next pass exactly as it does for a charged one.
    drive_note "$id: $why (no task file — journaled, but there is no counter to spend)"
    "$ORCHID_BIN" journal add --task "$id" \
      "$why (role $role, operation $op)$receipt" >/dev/null
    return 0
  fi
  slot="$id:$op:$point"
  case "$escalated_this_pass" in
    *" $slot "*)
      drive_note "$id: $why — already escalated $op this pass, so this is the same failure, not another rung"
      return 0 ;;
  esac
  escalated_this_pass="$escalated_this_pass$slot "
  "$ORCHID_BIN" task infra-fail "$id" --reason "$why (role $role, operation $op)$receipt"
  tstatus="$(fm_get "$tf" status)"
  if [ "$tstatus" = blocked ]; then
    drive_note "$id: infra_failures cap reached — now blocked"
    return 0
  fi
  # PLANNING SPENDS THE RUNG BUT NEVER RELAUNCHES (T027 rework). This ladder
  # now runs in that phase, because a stranded launcher there is a failure like
  # any other and used to be reaped in silence -- but the phase itself
  # dispatches nothing: the walk below does not run, PROTOCOL.md's PLANNING
  # procedure gives the plan/critique loop to the orchestrator end to end, and
  # a relaunch made from here would be the one thing in the whole pass that
  # spawned an engine. Counting the failure and reaping its manifest is what
  # this phase owes the incident; deciding what to launch next is the
  # orchestrator's, and the reap is what leaves it free to make that decision
  # (`jobs prepare` no longer refuses).
  #
  # BEFORE the pending/rework arm, deliberately. Every task file that exists
  # during PLANNING was made by a `task create` in this same phase and is
  # therefore `pending`, so putting this second would leave it unreachable and
  # unprovable -- a guard that reads as covering the phase while the arm below
  # is what actually returns.
  if [ "$run_status" = planning ]; then
    drive_note "$id: not relaunching during PLANNING — the phase dispatches nothing; the failure is counted and its manifest reaped, and the orchestrator relaunches when the plan loop is ready"
    return 0
  fi
  # A task still waiting to be dispatched is not relaunched from here either.
  # Its failed job belongs to a dispatch that never completed, so the ordering
  # that dispatch owns has not run: a task first dispatched into `pending` has
  # no worktree recorded at all, and a relaunch made before the walk creates
  # one hands the engine the REPOSITORY checkout as its workspace (both
  # lib/pack.sh and the launcher fall back to the repo when the task records no
  # worktree). drive_dispatch redoes the whole sequence in this same pass --
  # worktree, then launch, then advance -- so nothing is lost by leaving it there.
  case "$tstatus" in
    pending|rework)
      drive_note "$id: leaving the relaunch to the dispatch walk — $id is still $tstatus, so dispatch (not this ladder) is what launches it"
      return 0 ;;
  esac
  # A reviewer job is the one relaunch this ladder does NOT make. A review
  # belongs to a SLOT, and a slot's engine is decided by the routing table --
  # relaunching here would go back through the role's default chain and could
  # land a second review from the slot that already reported, which is exactly
  # the same-engine pair drive_review_slots_unsatisfied exists to refuse. The
  # `reviewing` walk relaunches the slot that is actually missing, with its own
  # engine, on this same pass.
  if [ "$role" = reviewer ]; then
    drive_note "$id: leaving the relaunch to the reviewing walk, which knows which SLOT is missing"
    return 0
  fi
  # A CALLER THAT KNOWS THE JOB MAY NOT HAVE STOPPED (T031). The rung above is
  # the whole of this ladder's answer for that class: dispatching the work again
  # would put a second engine into a worktree the first may still be committing
  # to. Passed in rather than derived here, because only the sweep can see the
  # difference -- the same manifest with its envelope held is `untracked`, and
  # without one is the ordinary `unstamped` corpse this does relaunch for. The
  # caller raises the boundary that keeps the task from parking silently.
  if [ -n "$norelaunch" ]; then
    drive_note "$id: not relaunching — $why; a second engine in that worktree is the duplicate-implementer defect this ladder must not cause"
    return 0
  fi
  # The relaunch gets the SAME exit-19 arm as the other three call sites. A
  # ladder that swallowed it would keep charging rungs for a refusal no rung
  # can clear (see drive_capability_refusal's header): the rung already spent
  # above belongs to the job that died, and this is where the pass stops
  # spending more and says whose work it is instead. Every OTHER launch failure
  # stays swallowed here on purpose -- drive_launch has already noted it, and
  # the ladder's whole design is that a failed relaunch is just the next rung.
  lrc=0
  drive_launch "$id" "$role" "$op" "" "$point" || lrc=$?
  if [ "$lrc" -eq 19 ]; then
    # `$point` rides along: this relaunch covers hook jobs too (it is the same
    # `$point` the launch above was given), and a hook refusal reported as a
    # `role.hook` binding names a key that does not exist.
    drive_capability_refusal "$id" "$role" "$op" "$point"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Escalate whatever died since the last pass, before the walk reads status.
# ---------------------------------------------------------------------------
if [ -n "$escalations" ]; then
  while IFS= read -r _line; do
    [ -n "$_line" ] || continue
    _etask="$(printf '%s' "$_line" | cut -f1)"
    _erole="$(printf '%s' "$_line" | cut -f2)"
    _eop="$(printf '%s' "$_line" | cut -f3)"
    _epoint="$(printf '%s' "$_line" | cut -f4)"
    _ekind="$(printf '%s' "$_line" | cut -f5)"
    _ekey="$(printf '%s' "$_line" | cut -f6)"
    _eexit="$(printf '%s' "$_line" | cut -f7)"
    case "$_ekind" in
      # A launcher that RAN and failed, whose synchronous charge never landed
      # (had it landed, drive_escalate's receipt check would have skipped this
      # manifest). The exit status it stamped is the one diagnostic the incident
      # left behind, so it is what goes in the journal -- worded exactly as
      # drive_launch words it, because it is the same event.
      launch-failed) _ewhy="the launcher exited $_eexit without spawning a job" ;;
      never-started) _ewhy="job was prepared and never launched — no engine ever started, so no envelope was ever coming" ;;
      unstamped)     _ewhy="job was spawned but never recorded a pid, and wrote nothing for stall_minutes — there was no pid to signal and no envelope came" ;;
      # The same manifest as `unstamped`, with one difference that changes who
      # answers it: AN ENVELOPE IS SITTING IN THE SPOOL. So this is not a job
      # that produced nothing -- it is a job that produced a report which
      # cannot be admitted, because nothing on this machine can show the
      # process behind it has stopped (T031). Never relaunched over, and the
      # arm below stops the pass at a named boundary instead.
      untracked)     _ewhy="job was spawned but never recorded a pid and has been silent for stall_minutes, and it filed an envelope that cannot be admitted — with no pid to signal and no exit recorded, nothing can show it has stopped" ;;
      *)             _ewhy="job died without an acceptable envelope" ;;
    esac
    # THE RESERVED `plan` ID IS NOT SKIPPED (T027 rework). It used to be, and
    # that skip was the whole of F29 preserved in one line: `plan` names the
    # plan-scoped critique and plan-hook jobs (`orchid task create plan` is
    # refused outright, so there is never a task file for one), which meant
    # every stranded PLANNING launcher fell out of the ladder here even once the
    # sweep above had found it. There is no counter to spend for `plan` -- that
    # is a fact about the id, and drive_escalate is where it is handled, in the
    # arm that journals the failure instead. Deciding it HERE, by name, threw
    # away the journal entry too.
    #
    # An OPTIONAL hook point's handler dying is not an infrastructure failure
    # of the TASK: the binding gates nothing, so it must not spend the task's
    # infra_failures budget (which auto-blocks at the cap) nor be relaunched
    # into the same wall pass after pass. Recorded for drive_hook_gate, which
    # steps over the point instead.
    if [ "$_erole" = hook ] && [ -n "$_epoint" ] && ! drive_hook_has_required "$repo" "$_epoint"; then
      optional_hooks_died="$optional_hooks_died$_etask:$_epoint "
      drive_note "$_etask: the optional $_epoint hook produced no envelope ($_ewhy) — not escalating (it gates nothing)"
      # ...AND STILL ON THE RECORD, EXACTLY ONCE. "Gates nothing" is a statement
      # about the task's budget, not about whether the failure happened: the
      # manifest is reaped a few lines below and a `drive_note` lives only in
      # this pass's stdout, so without this the only trace of a hook handler
      # that could not run would be gone by the next pass -- the F29 silence
      # again, in the one class deliberately exempted from the counter. The
      # receipt is the ladder's own key, so a handler whose launcher already
      # journaled this synchronously (drive_launch's optional arm, which stamps
      # the same key) is not written down a second time.
      if ! drive_failure_charged "$repo" "$_ekey"; then
        "$ORCHID_BIN" journal add --task "$_etask" \
          "optional $_epoint hook: $_ewhy — not escalated (the binding gates nothing)$(drive_failure_receipt "$_ekey")" >/dev/null
      fi
      continue
    fi
    # AN ENGINE NOBODY CAN SEE IS NOT RELAUNCHED OVER (T031). Every other class
    # on this ladder recovers by dispatching the work again. This one cannot:
    # the job that failed to report acceptably may not have STOPPED, and a
    # second engine in the same worktree while the first is still committing is
    # precisely the r-002/T013 defect this task exists to close, reached from
    # the other end. The rung is still spent -- a round that ends this way
    # really did cost the run one -- and the pass stops for a human instead of
    # dispatching.
    #
    # THE BOUNDARY IS RAISED HERE, NOT INSIDE drive_escalate, and every pass.
    # The CHARGE is deduplicated by its receipt and returns early once counted;
    # the STOP is a statement about the state right now, which stays true on
    # every later pass until somebody resolves it. Raised from inside the
    # charge, the second pass would count nothing, say nothing and walk on --
    # leaving a task parked in an active status with no live job, no acceptable
    # envelope and no boundary, which is the disappearing act the walk below is
    # careful about in its own arms.
    #
    # AND THE REMEDY IT NAMES IS A VERB (attempt-6 rework). This boundary used
    # to end with a `printf` redirected straight into `.orchid/runtime/exits/`,
    # which asked the operator to hand-write the single fact this whole task
    # exists to protect -- "that process has stopped" -- with nothing between a
    # mistyped job id and a filed report. `orchid jobs record-exit` is the same
    # write with the checks the kernel would have made anyway: the id is held to
    # the minted shape before it becomes a path, the job must still be
    # outstanding, its liveness must actually be the unresolved state this
    # boundary is about, and a record the launcher already wrote is never
    # replaced. An operator following instructions gets those for free; one
    # typing a path gets none of them.
    if [ "$_ekind" = untracked ]; then
      drive_escalate "$_etask" "$_erole" "$_eop" "$_epoint" "$_ewhy" "$_ekey" norelaunch
      set_boundary operator-decision "$_etask" \
        "job $_ekey filed an envelope and cannot be shown to have stopped: it never recorded a pid, so there is nothing to signal and nothing that proves it exited, and its report is being held rather than filed — read $rt/logs/$_ekey.log and check whether an engine is still running against this task's worktree. If one is, nothing needs doing: the envelope reconciles on its own as soon as that process exits and its status is recorded. If none is, record that it ended so the held report can be admitted: orchid jobs record-exit $_ekey <exit code>"
      continue
    fi
    drive_escalate "$_etask" "$_erole" "$_eop" "$_epoint" "$_ewhy" "$_ekey"
  done <<< "$escalations"
fi

# ---------------------------------------------------------------------------
# ...AND ONLY NOW REAP. Both classes the sweep collected above are retired here:
# the dead manifests (`--older-than-s 0`, since `check` has already had its pass
# over them) and the unlaunched ones (`--prepared-older-than-s`, this pass's own
# `stall_minutes` margin).
#
# AFTER THE LADDER, DELIBERATELY. A manifest is the only durable trace a failed
# job leaves, and the ladder's receipt is written from it; reaping first would
# mean a pass felled between the reap and the charge had thrown away a failure
# it never counted, with nothing left for any later pass to find. Running the
# ladder first costs nothing in the other direction: a charge repeated because
# this reap never happened is refused by the receipt on the next pass.
#
# The relaunch drive_escalate makes for a never-started manifest is therefore
# refused (exit 18) while its orphan is still on disk, and lands on the next
# pass once this reap has run -- one pass of latency for that one class, in
# exchange for a failure that can no longer be lost. Nothing else changes: an
# orphan whose task is `pending`/`rework` was always left to the dispatch walk
# below (which runs after this reap either way), and the dead class is not
# refused over at all.
#
# THE MARGIN IS PASSED, NOT ASSUMED (T027 rework; dogfood F41). It exists
# because THIS caller is automatic and cannot know whether a launcher is
# sitting between its own `jobs prepare` and its spawn line right now --
# reaping that manifest would delete the pack and request document out from
# under a live launch. That is a fact about an unattended sweep, not about
# the verb, so it is spelled here where it is true. `orchid jobs gc
# --older-than-s 0` typed by an operator who has looked at the manifest means
# exactly what it says; the last two runs both ended with that operator
# deleting files by hand because it did not.
# ---------------------------------------------------------------------------
#
# PLANNING REAPS TOO, AND FROM HERE (T027 rework). It runs the never-started
# reap -- and ONLY that, never the dead-job reap, which must not run before a
# reconcile the phase deliberately skips. Without a reaper in this phase the
# exit-18 refusal would be permanent: the phase that cannot run gc is the phase
# that can never clear the thing gc clears, and the run would sit in PLANNING
# with the identical critique relaunch refused forever.
#
# What moved is WHERE it runs, and that is the fix. This reap used to happen in
# the planning pre-pass, before the sweep and the ladder above -- so an aged
# pid-0 critique manifest was deleted with no journal receipt and no
# escalation, and the launcher failure vanished exactly as F29 describes. It is
# the same ordering rule as the non-planning branch, and it has to be: NOTHING
# IS RETIRED BEFORE IT HAS BEEN CHARGED.
if [ "$run_status" != planning ]; then
  gc_out="$("$ORCHID_BIN" jobs gc --older-than-s 0 --prepared-older-than-s "$_prepared_bound_s")"
  [ -z "$gc_out" ] || printf '%s\n' "$gc_out"
else
  planning_reap_out="$("$ORCHID_BIN" jobs gc --reap-prepared --older-than-s "$_prepared_bound_s")"
  [ -z "$planning_reap_out" ] || printf '%s\n' "$planning_reap_out"
fi

# ---------------------------------------------------------------------------
# `jobs check`'s wallclock backstop is report-only by design; acting on it is
# this driver's job, and the action is always the same: tell a human.
# ---------------------------------------------------------------------------
if [ -n "$check_out" ]; then
  while IFS= read -r _line; do
    [ -n "$_line" ] || continue
    _bstatus="$(printf '%s' "$_line" | cut -f2)"
    [ "$_bstatus" = budget-exceeded ] || continue
    _btask="$(printf '%s' "$_line" | cut -f1)"
    [ -f "$state/tasks/$_btask.md" ] || continue
    [ "$(fm_get "$state/tasks/$_btask.md" status)" != blocked ] || continue
    # Same as the exhaustion arm: block, and let the boundary the block produces
    # carry the page. This loop runs BEFORE the walk below, so the task it just
    # blocked is walked as `blocked` on this very pass and raises its
    # blocked-task boundary here rather than a pass later -- the page is not
    # deferred, only de-duplicated. The `orchid notify` this line used to send
    # itself was a second question for the same stop, minted moments before the
    # boundary's own.
    "$ORCHID_BIN" task advance "$_btask" blocked --reason "wallclock budget exceeded" >/dev/null
    drive_note "$_btask: wallclock budget exceeded — blocked"
  done <<< "$check_out"
fi

# ---------------------------------------------------------------------------
# THE TICK step 3 -- the walk. Every task, in id order, routed purely off its
# CURRENT status and its archetype's DECLARED edges. There is no branch on an
# archetype's name anywhere below: `feature`, the shipped `review` archetype
# and a repository's own custom archetype all take the same code path and
# differ only in what their manifests declare.
# ---------------------------------------------------------------------------
merging_ids=""
walk_n=0; walk_done_n=0
if [ "$run_status" != planning ]; then
  while IFS= read -r _row; do
    [ -n "$_row" ] || continue
    _id="$(printf '%s' "$_row" | cut -f1)"
    _tstatus="$(printf '%s' "$_row" | cut -f2)"
    [ -n "$_id" ] || continue
    _tf="$state/tasks/$_id.md"
    [ -f "$_tf" ] || continue
    walk_n=$(( walk_n + 1 ))
    [ "$_tstatus" != "done" ] || walk_done_n=$(( walk_done_n + 1 ))
    _arch="$(fm_get "$_tf" archetype)"; [ -n "$_arch" ] || _arch=feature
    if ! archetype_validate "$_arch" >/dev/null 2>&1; then
      set_boundary operator-decision "$_id" "archetype '$_arch' failed validation (rejected, fail closed)"
      continue
    fi
    case "$_tstatus" in
      done) ;;
      blocked) drive_blocked "$_id" ;;
      pending|rework) drive_dispatch "$_id" "$_arch" "$_tstatus" ;;
      implementing) drive_implementing "$_id" "$_arch" ;;
      testing) drive_testing "$_id" "$_arch" ;;
      reviewing) drive_reviewing "$_id" "$_arch" ;;
      arbitrating) drive_arbitrating "$_id" "$_arch" ;;
      merging) merging_ids="$merging_ids $_id" ;;
      *) set_boundary operator-decision "$_id" "unrecognized task status '$_tstatus'" ;;
    esac
  done < <("$ORCHID_BIN" task list | LC_ALL=C sort)
fi

# ---------------------------------------------------------------------------
# COMPLETION (PROTOCOL.md's procedure of that name). A run whose tasks are ALL
# done has nothing left for the walk above to move, and `done` is the one
# status that raises no boundary -- so without this, a finished headless run
# would poll forever: every pass clean, exit 0, run_status never leaving
# `running`, and nobody woken to notice the run is over.
#
# The mechanical half is taken here (step 1: `run advance accepting`, a
# transition whose entire precondition is the fact just counted). The judgment
# half is NOT: requirement coverage and the operator's acceptance commands are
# an orchestrator's evidence-producing work, and `orchid run accept` demands
# that evidence file, so the pass stops at a named boundary and hands it over.
#
# Counted from the statuses the walk READ, i.e. as of the start of this pass:
# the pass that merges the last task exits 0 on its own progress, and the
# boundary is raised by the next one. A boundary never lands in the same
# breath as the work that produced the state it names.
# ---------------------------------------------------------------------------
if [ "$walk_n" -gt 0 ] && [ "$walk_done_n" -eq "$walk_n" ]; then
  if [ "$run_status" = running ]; then
    accept_rc=0
    "$ORCHID_BIN" run advance accepting --reason "all tasks done" >/dev/null || accept_rc=$?
    if [ "$accept_rc" -eq 0 ]; then
      drive_note "every task is done — run_status running -> accepting"
    else
      drive_note "every task is done, but run advance accepting was refused (exit $accept_rc)"
    fi
  fi
  set_boundary run-complete "" \
    "every task is done — the acceptance checks and 'orchid run accept --evidence' behind PROTOCOL.md's COMPLETION are judgment work no verb decides"
fi

# ---------------------------------------------------------------------------
# merging -- at most ONE per pass, lowest task id first. `orchid merge` is
# transactional and CAS-guarded, so serializing here is a throughput choice,
# not a safety one; the verb would refuse a second concurrent merge anyway.
# ---------------------------------------------------------------------------
if [ -n "$merging_ids" ]; then
  merge_id=""
  for _cand in $merging_ids; do
    if [ -z "$merge_id" ]; then merge_id="$_cand"; fi
  done
  merge_tf="$state/tasks/$merge_id.md"
  merge_attempt=$(( $(fm_get "$merge_tf" attempts) + 1 ))
  merge_cand="$(fm_get "$merge_tf" candidate_sha)"
  merge_hg=0
  drive_hook_gate "$merge_id" before_merge "$merge_attempt" "$merge_cand" || merge_hg=$?
  if [ "$merge_hg" -eq 0 ]; then
    merge_rc=0
    # Fingerprint the validation log BEFORE the call, so the rule below can
    # ask "did THIS run write it" rather than merely "is a file there".
    # `orchid merge` deletes any previous attempt's copy as its first
    # committed act, which covers every way it can die once it has started --
    # but not the one way it can die before it starts: a run lock it did not
    # get (an operator merging by hand while a pass is walking). That die
    # leaves the task in `merging` with an earlier attempt's log untouched on
    # disk, and reading its presence as evidence would send someone to a log
    # about a candidate and a merged tree that no longer exist -- the
    # dangling-evidence defect of lesson L023, arriving by the one route the
    # verb cannot close from the inside. Content, not mtime: a log rewritten
    # inside the same coarse timestamp is still a different log, and a log
    # that is byte-identical to the one already there tells an operator
    # nothing this run learned.
    merge_log="$state/reviews/$merge_id-merge.log"
    merge_log_before=""
    [ ! -f "$merge_log" ] || merge_log_before="$(cksum <"$merge_log" 2>/dev/null || true)"
    # Same heartbeat as `verify` above, and for the same reason: `orchid
    # merge` re-runs the task's whole verification suite on the integration
    # checkout before it touches a ref.
    drive_lease_heartbeat_start
    merge_out="$("$ORCHID_BIN" merge "$merge_id" 2>&1)" || merge_rc=$?
    drive_lease_heartbeat_stop
    [ -z "$merge_out" ] || printf '%s\n' "$merge_out"
    # Branch on the POST-MERGE STATUS, never on the exit code alone: exit 1 is
    # ambiguous between two genuinely different outcomes (PROTOCOL.md's
    # merging bullet).
    merge_status="$(fm_get "$merge_tf" status)"
    # WHICH failure it was, read from the evidence header `orchid merge` wrote
    # rather than inferred from anything here (T007). The status cannot say:
    # `rework` is equally a merge conflict, a rebase conflict, a red task
    # suite and a red repo-wide `merge_gate`, and the exit code is 1 for all
    # four. The distinction is not cosmetic — a `gate_failed` is a statement
    # about the REPOSITORY, is frequently nothing the task author did, and is
    # the only one of the four that charges the task a round. Collapsing it
    # into "merge validation failed" reports a repository condition as this
    # candidate's defect, in the one line an operator watching a pass reads.
    #
    # An `if`, never `cmd && var=1`: this runner is `set -e`, where the
    # chained form is a bare failing command on the ordinary path (no gate,
    # or a green one) and kills the pass between the merge and its reporting.
    merge_gate_red=0
    if findings_log_gate_failed "$state/reviews/$merge_id-merge.log"; then
      merge_gate_red=1
    fi
    case "$merge_status" in
      done)
        drive_note "$merge_id: merged" ;;
      rework)
        if drive_rework_nonconvergence_stop "$merge_id" "merge validation failed"; then
          :
        elif [ "$merge_gate_red" -eq 1 ]; then
          drive_note "$merge_id: repo-wide merge_gate FAILED (gate_failed, attempt charged) — back to rework for the next pass; the candidate's own suite is not what went red"
        else
          drive_note "$merge_id: merge validation failed — back to rework for the next pass"
        fi ;;
      blocked)
        # TWO ROUTES TAKE `merging -> blocked`, and they need opposite reports.
        # ONE `blocked)` arm, because `case` runs the FIRST pattern that
        # matches and a second one further down this same `esac` is dead code
        # -- the route it was written for would silently get the other one's
        # message.
        #
        #   1. a red repo-wide `merge_gate` whose charge just spent the task's
        #      last rework round (libexec/orchid-merge's gate arm). Every
        #      further round would re-run the same gate against the same
        #      repository for the same colour, so the pass stops for a human
        #      instead of dispatching one. There IS a validation log, it names
        #      what went red, and clearing it is a judgment about the
        #      REPOSITORY -- so: operator-decision, pointing at that log,
        #      through the same boundary an exhausted verify budget uses.
        #
        #   2. a merge validation worktree whose `worktree_prepare` step keeps
        #      failing: that arm charges the infra ladder and the kernel's own
        #      counter blocks the task at `infra_max`. It dies BEFORE the
        #      suite or the gate runs, and after the verb's opening `rm -f` of
        #      any previous attempt's log -- so there is no merge log at all.
        #      Naming one would send an operator to a file that is not there,
        #      about a failure it would not describe if it were (lesson L023),
        #      and would report an unrepaired environment as a repository
        #      condition. So: the blocked task it is, through the boundary
        #      that owns that state, naming no log.
        #
        # Split on the EVIDENCE, never on the exit code (1 for both) or the
        # status (`blocked` for both): `merge_gate_red` above answers "does a
        # log record that the gate RAN and came back red", and on this edge
        # every route to `blocked` is downstream of that `rm -f`, so a log
        # that is here is one this run wrote.
        #
        # WITHOUT the `merge_log_before`/`after` fingerprint the `merging` arm
        # applies, and that is not an oversight. The fingerprint exists for
        # the one die that precedes the verb's `rm -f` -- a run lock this
        # process did not get -- and that die cannot reach this arm at all: a
        # merge that never started cannot have moved the task out of
        # `merging`. Every other route here deletes the old log first, so
        # "there is a log" already means "this run wrote it", and a second
        # test could only ever turn a correct answer into a wrong one. The
        # durable cause also lets drive_block_boundary reproduce the SAME kind
        # and reason on later passes, so this distinction does not mint a
        # second page when the blocked task is walked again (T009).
        if [ "$merge_gate_red" -eq 1 ]; then
          drive_note "$merge_id: repo-wide merge_gate red with the rework budget spent (gate_failed, attempt charged) — merging -> blocked; see .orchid/reviews/$merge_id-merge.log"
        else
          # The other current route is the exhausted infrastructure ladder.
          # Keep it distinct so the pass never asserts a gate failure whose
          # evidence does not exist.
          drive_note "$merge_id: merge left the task blocked (exit $merge_rc) with no failing merge_gate recorded in .orchid/reviews/$merge_id-merge.log"
        fi
        drive_block_boundary "$merge_id" ;;
      testing)
        "$ORCHID_BIN" journal add --task "$merge_id" \
          "re-review scope: full — the rebase minted a new candidate, so prior evidence is invalid" >/dev/null
        drive_note "$merge_id: base moved — rebased; re-verify and re-review required (INV-07)" ;;
      merging)
        if [ "$merge_rc" -eq 15 ]; then
          set_boundary hook-failure "$merge_id" "merge refused: a required before_merge hook has no ok envelope for this candidate"
        elif [ "$merge_rc" -eq 16 ]; then
          # T024 (dogfood F26). `orchid merge` gates its revalidation on the
          # same operator prerequisite `orchid verify` gates on, and refuses
          # with the judgment-boundary code rather than running the suite. Same
          # boundary KIND as the testing arm above, because it is the same
          # condition and the same remedy — an operator takes the step and runs
          # `orchid task prereq-ack` (which accepts `merging` for this).
          #
          # Not pre-checked before the `orchid merge` call the way the testing
          # arm pre-checks before `orchid verify`, and that asymmetry is
          # deliberate: whether the prerequisite matters here depends on
          # whether the base has moved, which only merge knows. On a stale base
          # it rebase-resets to `testing` without running any suite, and that
          # reset is what CLEARS a stale ack. Pre-empting it here would raise a
          # boundary in place of the transition that resolves it.
          if handoff_prereq_stale "$merge_tf"; then
            set_boundary task-prerequisite "$merge_id" \
              "merge refused: the prerequisite acknowledgement is for candidate $(fm_get "$merge_tf" prerequisite_ack), superseded by $(fm_get "$merge_tf" candidate_sha): $(fm_get "$merge_tf" operator_prerequisite) — re-take it, then: orchid task prereq-ack $merge_id --reason \"...\""
          else
            set_boundary task-prerequisite "$merge_id" \
              "merge refused: merge re-runs the suite against the same store and the operator prerequisite is unacknowledged for this candidate: $(fm_get "$merge_tf" operator_prerequisite) — do it, then: orchid task prereq-ack $merge_id --reason \"...\""
          fi
        else
          # Point at evidence that is ACTUALLY THERE (lesson L023). The
          # validation log exists only once merge got as far as running the
          # suite; the ways it can be left in `merging` short of that -- a
          # `worktree_prepare` step that failed, a temp worktree it could not
          # create, a missing verify command -- write no log at all, and the
          # verb deletes any stale copy from a previous attempt before it can
          # be mistaken for this one's. So a log THIS RUN WROTE is the
          # distinction, and when there is none the verb's own last line
          # (which names the prepare log, for the case that has one) is the
          # only record there is.
          #
          # "This run wrote it" is the test, not "a file exists": a log whose
          # bytes are exactly the ones that were there before the call
          # outlived its run and is treated as absent (see the fingerprint
          # above).
          merge_log_after=""
          [ ! -f "$merge_log" ] || merge_log_after="$(cksum <"$merge_log" 2>/dev/null || true)"
          merge_evidence="see .orchid/reviews/$merge_id-merge.log"
          if [ -z "$merge_log_after" ] || [ "$merge_log_after" = "$merge_log_before" ]; then
            # `|| true` is required, not defensive: this file runs under
            # `set -euo pipefail`, and a verb that printed nothing (or only
            # blank lines) makes grep exit 1, which would take the whole pass
            # down at the exact moment it is trying to explain a failure.
            merge_evidence="$(printf '%s\n' "$merge_out" | grep -v '^[[:space:]]*$' | tail -n 1 || true)"
            merge_evidence="${merge_evidence:-the verb produced no output}"
            merge_evidence="${merge_evidence:0:300}"
          fi
          # operator-decision: a config/CAS problem has no enumerable answer
          # set, so this page stays free text on purpose -- and it is the
          # BOUNDARY's page, not one raised here beside it. This arm used to do
          # both, which minted two qids for one stuck merge: its own notify,
          # and the one the record below is notified for at the foot of this
          # file. The evidence pointer moved into the record's reason so the
          # surviving page still names the log, and so a merge that stays stuck
          # for the same reason on the next pass re-reports one record instead
          # of raising a fresh question per pass.
          set_boundary operator-decision "$merge_id" "merge left the task in merging (exit $merge_rc) — a config/CAS problem, not a candidate defect: $merge_evidence"
        fi ;;
      *)
        set_boundary operator-decision "$merge_id" "merge left the task in an unexpected status '$merge_status'" ;;
    esac
  fi
fi

# ---------------------------------------------------------------------------
# Record (or release) the boundary through its own verb -- the single writer
# of that record -- so the pump reads the same fact back through `orchid run
# boundary show` instead of inspecting a file.
# ---------------------------------------------------------------------------
if [ -n "$boundary_kind" ]; then
  # A boundary no orchestrator procedure resolves is one runners/orchid-pump
  # deliberately will NOT wake a model for, so the only way it reaches a human
  # is a notification. Sent exactly once per distinct STOP -- every operator-only
  # boundary this pass MET, not only the one it recorded.
  #
  # THE RECORD IS ONE; THE STOPS ARE NOT, and reading the budget off the record
  # starved the difference. This loop used to run over `$boundary_kind` alone,
  # de-duplicated against the previous record read back through the same verb.
  # That is a complete rule only while one stop exists: a pass that meets several
  # records the highest-ranked one, and every other stop it met leaves no record,
  # so the comparison has nothing to say about it and it is announced to nobody.
  # Blocked tasks are where that bit. They are all operator-only, so they all
  # rank equal, so the first in task-id order takes the slot on every pass --
  # forever, since only a human clears a block. Twenty-six other blocked tasks
  # raised no page at all, and none of them was masked by a DECISION: they were
  # masked by a slot. That silence is also a regression this task introduced by
  # its own repair, because the four arms that block a task used to page it
  # directly, outside the ranking, before those pages were retired as duplicates.
  #
  # So the pass pages every operator-only stop it met, and the de-dup moves off
  # the record and onto the stop: lib/drive.sh's drive_page_on_record asks
  # whether a question for this TASK carrying exactly this page text is already
  # on record and still counts as that stop's page. A condition persisting for a
  # hundred passes still raises one blocker -- its own, standing unanswered, is
  # what silences the ninety-nine.
  #
  # THE RECORD IS THE FALLBACK, AND ONLY THAT. It is still consulted, because a
  # runtime whose questions have been swept away would otherwise re-page every
  # stop it ever raised -- but it is consulted SECOND, and only for a stop whose
  # inbox is empty. The record is durable and a blocked task's never changes, so
  # asking it first suppressed the page whenever it matched and the question's
  # expiry could never be seen: the operator's page aged past `answer_expiry_s`,
  # `orchid answer` began refusing it, and the record went on reporting the stop
  # as announced. That is the one case the oracle exists to re-raise, so a STALE
  # answer (exit 2) overrides the record outright.
  prev_boundary="$("$ORCHID_BIN" run boundary show 2>/dev/null || true)"
  prev_kind="$(printf '%s' "$prev_boundary" | jq -r '.kind // ""' 2>/dev/null || echo "")"
  prev_task="$(printf '%s' "$prev_boundary" | jq -r '.task // ""' 2>/dev/null || echo "")"
  prev_reason="$(printf '%s' "$prev_boundary" | jq -r '.reason // ""' 2>/dev/null || echo "")"
  # Flattened by the SAME three expansions set_boundary applies to the reason it
  # puts in a row -- see there for why this may not go through `tr`. Comparing a
  # recorded multi-line reason against its flattened row would never match, and
  # the recorded stop would page once per pass.
  prev_reason="${prev_reason//$'\n'/ }"
  prev_reason="${prev_reason//$'\r'/ }"
  prev_reason="${prev_reason//$'\037'/ }"
  while IFS=$'\037' read -r page_kind page_task page_status page_reason; do
    [ -n "$page_kind" ] || continue
    # `$page_status` -- the status read when this boundary was RAISED, the same
    # one drive_boundary_priority ranked it with. The page's answer set and the
    # ranking are two readings of one fact, so they come from one reading of it
    # (lib/drive.sh's drive_boundary_choices), which is why the status rides in
    # the accumulated row rather than being re-read here.
    if drive_boundary_wakes_orchestrator "$page_kind" "$page_status" "$orchestrator_surface"; then
      continue
    fi
    page_text="judgment boundary [$page_kind] needs an operator: $page_reason"
    # 0 paged / 2 stale (paged, but no longer answerable) / 1 never paged. Read
    # through `|| on_record=$?` because the two nonzero answers are both normal
    # returns of a reader this `set -e` pass must not die on.
    on_record=0
    drive_page_on_record "$repo" "$page_task" "$page_text" || on_record=$?
    if [ "$on_record" -eq 0 ]; then
      drive_note "not notified: [$page_kind]${page_task:+ $page_task} already has a page on record for this stop"
      continue
    fi
    if [ "$on_record" -ne 2 ] && \
       [ "$prev_kind" = "$page_kind" ] && [ "$prev_task" = "$page_task" ] && \
       [ "$prev_reason" = "$page_reason" ]; then
      continue
    fi
    drive_notify "$page_kind" "$page_task" "$page_status" "$page_text"
    drive_note "notified: [$page_kind] is operator-only, so no orchestrator will be woken for it"
  done <<< "$boundaries_met"
  if [ -n "$boundary_task" ]; then
    "$ORCHID_BIN" run boundary set --kind "$boundary_kind" --task "$boundary_task" \
      --reason "$boundary_reason" >/dev/null
  else
    "$ORCHID_BIN" run boundary set --kind "$boundary_kind" --reason "$boundary_reason" >/dev/null
  fi
else
  "$ORCHID_BIN" run boundary clear --reason "deterministic drive resolved every step this pass" >/dev/null
fi

# ---------------------------------------------------------------------------
# THE TICK step 5 -- before sleeping. Both status calls are best effort: a
# broken status page must never fail a pass that actually made progress.
# ---------------------------------------------------------------------------
"$ORCHID_BIN" status --explain || true
"$ORCHID_BIN" status --html >/dev/null 2>&1 || drive_note "status --html failed (left for the next pass)"
"$ORCHID_BIN" run refresh-lease

# 16 reports that a decision is OUTSTANDING, never that the pass was
# abandoned: every task above was walked and every edge policy could take was
# taken before this line is reached. The distinction is the whole difference
# between an unattended pump that keeps the other twenty-nine tasks moving and
# one that parks a run for seven hours over an arbitration affecting one task.
# See the exit-code table in usage() above, and runners/orchid-pump's own
# handling of this code.
if [ -n "$boundary_kind" ]; then
  exit 16
fi
exit 0

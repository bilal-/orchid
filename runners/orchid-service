#!/bin/bash -p
set -euo pipefail
# tier-2, effectful: schedules the ALREADY one-shot, lease-gated pump
# (runners/orchid-pump, v1-m2 Task 8) via the host's own scheduler -- a
# launchd agent on macOS, a marker-guarded crontab line everywhere else --
# so a run proceeds semi-attended without a hand-run nohup loop. This
# script is the ONLY place that ever shells out to launchctl/crontab
# (mirrors runners/orchid-launch being the only spawner, INV-06); the tier-1
# libexec/orchid-service is a bare handoff, nothing more.
#
# Every subverb accepts --dry-run: the exact launchctl/crontab command(s)
# are PRINTED, prefixed "DRY-RUN:", instead of run. What else it skips is
# not symmetric between install and uninstall, and the asymmetry is the
# point rather than an oversight:
#
#   INSTALL renders and PLACES for real (the plist under
#     ~/Library/LaunchAgents, the local .orchid/runtime/pump.cron record kept
#     as the linux-side install record -- see _svc_install_linux below for why
#     that record exists -- and both halves of the binding record described
#     under TEARDOWN ORDERING). Everything it creates is INERT without the
#     scheduler call that was skipped: a plist nobody loaded, a record whose
#     only effect is to make the removal guard conservative and `orchid
#     doctor` mention a schedule, and `uninstall` reverses all of it. The test
#     suite depends on that: it asserts real template rendering and real
#     placement without ever touching a live launchctl/crontab.
#
#   UNINSTALL removes NOTHING under --dry-run. Its file work is not placement,
#     it is the destruction of the only records that name a schedule the dry
#     run has deliberately left running -- the plist `launchctl unload` needs
#     the path of, and the binding record that is the sole thing tying that
#     schedule to a checkout. Performed for a schedule still loaded, a
#     "preview" would manufacture exactly the invisible leftover this file's
#     TEARDOWN ORDERING exists to prevent, and would do it in the one mode an
#     operator runs expecting no consequences.
#
# The removal path stays covered: ORCHID_SERVICE_DEBUG_SCHEDULER_LOG (see
# _svc_scheduler_exec) is a test-only seam that stubs the one system call and
# leaves every removal real.

# Service installation is itself an unattended trust boundary. Preserve the
# installing operator's PATH only as data for the scheduler artifact, capturing
# it here for a direct entry or accepting the inert value carried by the generic
# bin/orchid dispatcher. Use a fixed machine-local system/package-manager
# search path from the first instruction onward. Thus bash, self-resolution
# helpers, and every identity tool run before acknowledgement cannot come from
# a target-controlled PATH entry. Privileged Bash mode also ignores
# BASH_ENV/imported functions.
unset __orchid_entry_defer_restore
if [ "${__orchid_entry_context:-}" != 1 ]; then
  unset __orchid_entry_context __orchid_entry_path_was_set
  unset __orchid_entry_operator_path
  __orchid_entry_context=1
  __orchid_entry_path_was_set="${PATH+x}"
  __orchid_entry_operator_path="${PATH-}"
  export __orchid_entry_context __orchid_entry_path_was_set
  export __orchid_entry_operator_path
fi
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH

self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"
__orchid_entry_defer_restore=1
source "$ORCHID_ROOT/lib/common.sh"
source "$ORCHID_ROOT/lib/trust.sh"
# For `status` alone: reading the bound run's own run_status, so an operator
# asking "is this schedule still doing anything?" is answered rather than
# merely told a schedule exists. Function definitions only, no side effects.
source "$ORCHID_ROOT/lib/frontmatter.sh"

PUMP_LOG_TAIL_LINES=20

_svc_usage() {
  cat <<'EOF'
usage: orchid service <install|uninstall|status> [options]

Schedules the orchid pump (runners/orchid-pump -- one-shot, lease-gated) to
run on a fixed interval via the host's own scheduler, so a run proceeds on a
semi-attended cadence without a hand-run nohup loop. macOS installs a
launchd agent (~/Library/LaunchAgents); every other platform falls back to
a crontab line.

  install    render + install (or replace) the schedule for --repo.
               refuses when --repo has no .orchid/ (not an orchid repo).
               also refuses until this machine has an acknowledgement from
               `orchid trust unattended <repo> --reason <reason>`.
               idempotent: re-running install for the same repo REPLACES
               its existing schedule (same label/marker) in place -- it
               never stacks a second launchd job or a second crontab line.
  uninstall  remove exactly what install created for --repo (the plist
               file + its launchctl load, or the marker-guarded crontab
               line), and clear the binding record. idempotent: refuses
               cleanly (a plain message, no launchctl/crontab touched) when
               nothing is installed for --repo -- safe to call blind.
               removes nothing, and refuses, when the scheduler could not
               unload an agent it still reports as loaded: the plist and
               the binding are all that could ever name it again.
               under --dry-run it removes NOTHING and prints what it would
               remove: the schedule is still running, and the records it
               would delete are the only things that name it.
  status     report installed/loaded state, the binding record, whether the
               bound run has already finished (every wake after that is a
               certain no-op), the teardown ordering, and the tail of --repo's
               .orchid/runtime/pump.log. Always exits 0 -- a status query is
               never a failure, even when nothing is installed.

TEARDOWN ORDERING. A schedule outlives the run it serves: nothing removes it
when the last task merges. `install` records what it bound itself to (a
binding record inside the repo, and a machine-local copy under
~/.orchid/services/ that survives the repo's removal), and the rule that
record exists to keep is:

    uninstall the service FIRST, then remove the integration worktree.

Reversed, a launchd agent / crontab line keeps waking on a schedule against a
deleted directory, and the record naming the leftover schedule went into the
bin with it. `orchid doctor` warns about any binding whose repository is gone,
and about any whose run has already reached a terminal state -- the certain
waste the pump can only report to a scheduler's /dev/null; a pump whose target
is gone refuses loudly instead of polling forever; and every checkout removal
orchid itself performs refuses while a binding is live.

options:
  --repo <path>    target repo (default: $ORCHID_REPO, else the cwd)
  --interval-s N   install only: override pump_interval_s (config default
                     240) for this install
  --dry-run        print the exact launchctl/crontab commands instead of
                     running them. install still renders + places its
                     (inert) files for real; uninstall removes nothing at
                     all -- it would be deleting the records naming a
                     schedule this run has left installed
EOF
}

# _svc_hash12 <string> -- first 12 hex chars of the string's sha256, used
# to derive a repo's launchd label / cron marker deterministically. Prefers
# sha256sum (near-universal on Linux); falls back to shasum -a 256 (macOS's
# always-available Perl-based tool, which typically lacks sha256sum).
_svc_hash12() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | cut -c1-12
  else
    printf '%s' "$1" | shasum -a 256 | cut -c1-12
  fi
}
_svc_label() { echo "com.orchid.pump.$(_svc_hash12 "$1")"; }

# _svc_platform -- "darwin" (launchd) or "linux" (cron fallback, the
# default for anything that isn't Darwin). ORCHID_SERVICE_OS is a TEST-ONLY
# seam (never documented in --help, not an operator-facing knob): it lets
# this suite exercise BOTH scheduler branches deterministically regardless
# of which OS actually runs the tests, the same way other tests inject a
# fixed HOME/ORCHID_ENGINES_DIR rather than depending on the real host.
_svc_platform() {
  local p="${ORCHID_SERVICE_OS:-$(uname -s)}"
  case "$p" in
    Darwin) echo darwin ;;
    *) echo linux ;;
  esac
}

# _svc_quote_cmd <cmd...> -- the command as ONE line with every argument
# shell-quoted (printf %q), so it is exactly re-runnable/copy-pastable and
# never a lossy plain join (an argument containing a space would otherwise
# print ambiguously).
_svc_quote_cmd() {
  local out="" a
  for a in "$@"; do out="${out:+$out }$(printf '%q' "$a")"; done
  printf '%s\n' "$out"
}
_svc_dryprint() { echo "DRY-RUN: $(_svc_quote_cmd "$@")"; }

# _svc_scheduler_exec <cmd...> / _svc_scheduler_eval <pipeline> -- the two
# forms every scheduler MUTATION in this file goes through: `launchctl
# load`/`unload` and both crontab pipelines. `status`'s two read-only queries
# (`launchctl list`, `crontab -l | grep`) stay direct -- they change nothing,
# so there is nothing for a stub to protect, and status is asked under
# --dry-run wherever a test asks it at all.
#
# ORCHID_SERVICE_DEBUG_SCHEDULER_LOG is a TEST-ONLY seam (never documented in
# --help, not an operator-facing knob), the same kind as ORCHID_SERVICE_OS and
# ORCHID_SERVICE_DEBUG_CRON_CMD_FILE above: when set, the command is APPENDED
# to that file instead of run, and everything else takes the real,
# non-`--dry-run` path.
#
# It exists because `--dry-run` and "the real path" are no longer the same
# code below. A dry run must not remove the plist, the cron record or the
# binding (see _svc_uninstall_darwin's own header for why), so a suite that can
# only ever invoke `--dry-run` -- and this one can only ever do that, since a
# real uninstall talks to the host's own launchd or rewrites the operator's
# real crontab -- would have no way left to exercise removal at all. This seam
# stubs exactly one system call and leaves every removal, record and refusal it
# is guarding real.
#
# ORCHID_SERVICE_DEBUG_SCHEDULER_FAIL is the second half of the same seam, and
# it exists because a stub that can only SUCCEED cannot reach the arm that
# matters most: what a real uninstall does when `launchctl unload` FAILS (see
# _svc_unload_darwin). It is an ERE matched against the quoted command line; a
# stubbed call that matches returns 1 instead of 0, and is still logged, so a
# test can fail the unload alone (launchd still reports the job -- the
# dangerous case) or the unload and the `list` together (nothing was loaded --
# the ordinary case). Ignored entirely unless the log seam above is set.
#
# A herestring, not `_svc_quote_cmd "$@" | grep -q`: this file runs under
# `pipefail`, and `grep -q` exits the moment it matches, so a producer still
# writing could take a SIGPIPE and hand the pipeline a nonzero status on the
# very input that MATCHED -- inverting the answer.
_svc_scheduler_stub_fails() {
  [ -n "${ORCHID_SERVICE_DEBUG_SCHEDULER_FAIL:-}" ] || return 1
  local cmd; cmd="$(_svc_quote_cmd "$@")"
  grep -qE "$ORCHID_SERVICE_DEBUG_SCHEDULER_FAIL" <<<"$cmd"
}
_svc_scheduler_exec() {
  local rc=0
  if [ -n "${ORCHID_SERVICE_DEBUG_SCHEDULER_LOG:-}" ]; then
    _svc_quote_cmd "$@" >> "$ORCHID_SERVICE_DEBUG_SCHEDULER_LOG"
    _svc_scheduler_stub_fails "$@" && rc=1
    return "$rc"
  fi
  "$@"
}
_svc_scheduler_eval() {
  if [ -n "${ORCHID_SERVICE_DEBUG_SCHEDULER_LOG:-}" ]; then
    printf '%s\n' "$1" >> "$ORCHID_SERVICE_DEBUG_SCHEDULER_LOG"
    return 0
  fi
  # eval is safe here: $1 is entirely this script's own fixed pipeline syntax
  # plus values _svc_cron_pipeline_* already ran through `printf %q` -- see
  # those functions' own header.
  eval "$1"
}

# _svc_sed_escape <string> -- escapes sed REPLACEMENT metacharacters for the
# `s|__TOKEN__|<escaped>|g` idiom (same escaping libexec/orchid-init already
# uses for __INTEGRATION_BRANCH__): `|` (the delimiter itself), `&` (whole-
# match backreference), and `\` (escape introducer) all need a literal
# backslash ahead of them in the replacement text, or a path containing any
# of the three would corrupt the substitution instead of being inserted
# verbatim. This escapes for SED's syntax only -- it says nothing about
# whether the resulting text is well-formed in whatever format it's being
# substituted INTO (see _svc_xml_escape below, which must run first for the
# plist template: sed-escaping alone was the review-flagged bug -- a repo
# path containing a bare `&`, `<`, or `>` rendered non-well-formed XML that
# `launchctl load` would refuse, while this script still reported success).
_svc_sed_escape() { printf '%s' "$1" | sed -e 's/[|&\\]/\\&/g'; }

# _svc_xml_escape <string> -- escapes the three XML metacharacters that are
# illegal bare inside plist element content: `&` (must run FIRST -- doing
# `<`/`>` first would corrupt when this step's own `&`-insertion is then
# re-escaped) becomes `&amp;`, `<` becomes `&lt;`, `>` becomes `&gt;`. Run
# on every value BEFORE _svc_sed_escape (which then escapes the LITERAL `&`
# characters these entities themselves contain, for sed's own syntax) --
# the two escaping passes target two different downstream consumers (the
# XML parser vs. sed's replacement-string grammar) and must compose in
# exactly this order, never merged into one pass.
#
# v1-m4 (static status page): the escaping itself now lives in
# lib/common.sh's `orchid_html_escape` (`orchid status --html` needs the
# exact same "make text safe inside an XML/HTML element" behavior for
# arbitrary operator-authored text) -- this stays a thin wrapper, same
# name, so every call site below is untouched.
_svc_xml_escape() {
  orchid_html_escape "$1"
}

# _svc_plist_value <string> -- the full escaping pipeline for one value
# destined for the plist template: XML-escape for the target FORMAT, then
# sed-escape the result for the substitution MECHANISM. Centralized so
# _svc_render_plist can't apply the two passes out of order or forget one.
_svc_plist_value() { _svc_sed_escape "$(_svc_xml_escape "$1")"; }

# _svc_install_path -- the PATH baked into the rendered plist/cron artifacts
# at `orchid service install` time (review finding: a launchd agent gets
# only launchd's own bare default PATH, /usr/bin:/bin:/usr/sbin:/sbin, and
# a marker-guarded crontab line's shell is scarcely richer -- neither ever
# sources an interactive shell's profile, so `jq` (Homebrew) and every
# engine CLI the pump's tick execs (claude/codex/hermes -- npm/Homebrew
# paths) would be unfindable on a stock machine). Prefers the INSTALLING
# user's own resolved $PATH (the value in effect right now, in this
# process, when `install` runs) -- the same PATH the operator's own shell
# already uses to find those exact binaries. Falls back to a documented,
# reasonable composition only in the degenerate case of $PATH being unset/
# empty (never expected interactively, but cheap to guard).
_svc_install_path() {
  local p=""
  if [ "${__orchid_entry_path_was_set:-}" = x ]; then
    p="${__orchid_entry_operator_path-}"
  fi
  [ -n "$p" ] || p="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin"
  echo "$p"
}

_svc_render_plist() {
  local label="$1" repo="$2" parent="$3" interval="$4" pump_exe="$5" path_val="$6"
  sed -e "s|__LABEL__|$(_svc_plist_value "$label")|g" \
      -e "s|__REPO__|$(_svc_plist_value "$repo")|g" \
      -e "s|__TMPDIR__|$(_svc_plist_value "$parent")|g" \
      -e "s|__INTERVAL__|$(_svc_plist_value "$interval")|g" \
      -e "s|__ORCHID_PUMP__|$(_svc_plist_value "$pump_exe")|g" \
      -e "s|__PATH__|$(_svc_plist_value "$path_val")|g" \
      "$ORCHID_ROOT/templates/launchd.orchid-pump.plist"
}

# _svc_cron_minutes <interval_s> -- cron's finest granularity is one
# MINUTE; floors interval_s/60 (integer division) at 1 so a sub-60s
# interval never renders `*/0` (which cron would either reject or treat as
# "every minute" inconsistently across implementations -- never emitted).
_svc_cron_minutes() {
  local m=$(( $1 / 60 ))
  [ "$m" -ge 1 ] || m=1
  echo "$m"
}

_svc_cron_record_path() { echo "$1/.orchid/runtime/pump.cron"; }

# _svc_cron_escape <string> -- escapes the target FORMAT's own metacharacter
# for a crontab command field: an unescaped `%` is cron's line-continuation/
# stdin-feed marker (everything after it, and every subsequent `%`-delimited
# segment, is joined with newlines and fed to the command's stdin instead of
# staying part of the command line) -- a repo/log path containing a bare
# `%` would silently truncate the installed command at that character.
# `\%` is cron's own escape for a literal percent.
_svc_cron_escape() { printf '%s' "$1" | sed -e 's/%/\\%/g'; }

# _svc_shq <string> -- POSIX single-quote-wrap for the cron line's OWN sh
# parse (review Minor: the crontab WRITE is safely %q-quoted via
# _svc_cron_pipeline_install/printf %q, but the rendered LINE ITSELF is
# handed to /bin/sh unquoted -- a repo/log/pump path containing a space or
# quote character produced a silently broken scheduled command at cron-exec
# time). Applied AFTER _svc_cron_escape: cron's own %-handling is a plain
# textual scan of the crontab line that happens BEFORE any shell ever parses
# it, so % must already be escaped in the value regardless of quoting; a
# literal `'` inside the value is closed-quote/escaped-quote/reopen-quote
# (`'\''`), the standard POSIX idiom, so the SHELL sees the value as one
# argument/assignment no matter what it contains.
_svc_shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

_svc_render_cron_line() {
  local label="$1" repo="$2" parent="$3" interval_s="$4" pump_exe="$5" path_val="$6" mins
  local repo_e parent_e pump_e path_e
  mins="$(_svc_cron_minutes "$interval_s")"
  repo_e="$(_svc_shq "$(_svc_cron_escape "$repo")")"
  parent_e="$(_svc_shq "$(_svc_cron_escape "$parent")")"
  pump_e="$(_svc_shq "$(_svc_cron_escape "$pump_exe")")"
  path_e="$(_svc_shq "$(_svc_cron_escape "$path_val")")"
  echo "*/$mins * * * * ORCHID_REPO=$repo_e TMPDIR=$parent_e PATH=$path_e $pump_e --service-log >> /dev/null 2>&1 # orchid-service:$label"
}

# _svc_print_binding <repo> -- the teardown half of `status`. An operator
# asking "what is installed here?" is usually one step away from tearing the
# checkout down, and the ordering that must hold (uninstall, THEN remove) is
# exactly the thing the live-run finding says is written down nowhere. So it
# is printed here, next to the schedule it constrains, rather than left to a
# doc page.
#
# It also answers the question an operator is really asking, which is not "is a
# schedule installed" but "is it still doing anything". A run never leaves a
# terminal state on its own, so from the last merge onward every wake of this
# schedule is a certain no-op -- and the pump's own report of that is printed
# before it opens the repo-local service log, so under a real launchd agent or
# cron line it goes to /dev/null. Said here, and by `orchid doctor` for every
# binding on the machine, through the one shared predicate.
_svc_print_binding() {
  local repo="$1" rec rs
  rec="$(orchid_service_repo_record "$repo")"
  if [ -f "$rec" ]; then
    echo "  binding:  $rec"
    # The target's own liveness first, on the same shared predicate the pump
    # refuses with and `orchid doctor` warns on: a schedule whose repository is
    # gone has nothing to say about run_status, and reporting the run's state
    # for a checkout that cannot be driven at all names the wrong problem.
    if ! orchid_checkout_git_alive "$repo"; then
      echo "  target:   $repo is no longer a git checkout -- the pump refuses every wake against it"
    fi
    rs="$(fm_get "$repo/.orchid/roadmap.md" run_status 2>/dev/null || true)"
    if orchid_run_status_terminal "$rs"; then
      echo "  run:      $rs -- this run is over; every further wake of this schedule is a certain no-op"
    elif orchid_run_status_awaits_operator "$rs"; then
      # Not "over" and deliberately not worded as if it were: every task is
      # done, but `accepting -> running` is a legal edge and this run may still
      # be accepted. What no wake of this schedule can do is accept it.
      echo "  run:      $rs -- every task is done and only an operator can accept the run; no wake of this schedule can:"
      echo "              $(orchid_run_accept_command "$repo")"
    fi
    echo "  teardown: this checkout is bound to a live schedule -- uninstall it BEFORE removing $repo:"
    echo "              $(orchid_service_uninstall_command "$repo")"
  fi
}

# _svc_print_uninstalled <repo> <label> -- the one wording both platform
# branches report a successful uninstall with. The second line is the whole
# point of the teardown ordering: this is the moment the checkout becomes safe
# to delete, so it is said here rather than left for the operator to infer.
# Omitted when the checkout is already gone (an uninstall reaching a removed
# repository is the reversed ordering being cleaned up after, and telling
# somebody a deleted directory is safe to delete reads as a bug).
_svc_print_uninstalled() {
  local repo="$1" label="$2"
  echo "orchid: service uninstalled for $repo (label $label)"
  [ -d "$repo" ] || return 0
  echo "  $repo is now safe to remove"
}

# _svc_print_dry_uninstall <repo> <label> <artifact> -- what a --dry-run
# uninstall says INSTEAD of removing anything. It names each thing a real run
# would delete, which is the preview an operator asked for, and then says
# plainly that the schedule is still installed -- because the one thing a
# preview must never leave behind is a belief that the teardown has happened.
# Only artifacts that are actually there are named: a binding whose plist never
# landed would otherwise be told its plist is about to go.
#
# Deliberately NOT prefixed "DRY-RUN:", which in this file means one thing and
# one thing only: a launchctl/crontab command line, printed verbatim so it can
# be pasted or compared byte-for-byte against the string the real path evals
# (tests/test_service.sh asserts exactly that). These lines describe removals,
# not commands, and adding them to that prefix would quietly turn a shared
# spelling into two.
_svc_print_dry_uninstall() {
  local repo="$1" label="$2" artifact="$3" rec
  echo "orchid: --dry-run: nothing was removed — the schedule for $repo (label $label) is still installed"
  [ ! -e "$artifact" ] || echo "  would remove: $artifact"
  if orchid_service_binding_present "$repo" "$label"; then
    rec="$(orchid_service_repo_record "$repo")"
    echo "  would clear:  the service binding for $repo ($rec, and its machine-local copy)"
  fi
  echo "  re-run without --dry-run to actually end it; until then $repo must not be removed"
}

_svc_print_log_tail() {
  local log="$1"
  echo "  log: $log"
  if [ -f "$log" ]; then
    echo "  --- last $PUMP_LOG_TAIL_LINES line(s) of pump.log ---"
    tail -n "$PUMP_LOG_TAIL_LINES" "$log"
  else
    echo "  (no pump.log yet)"
  fi
}

# ---------------------------------------------------------------------------
# darwin (launchd)
# ---------------------------------------------------------------------------

# _svc_unload_darwin <repo> <label> <plist> -- run the unload a real uninstall
# needs, and answer whether the removals after it may proceed. Returns 0 to
# proceed; refuses, changing nothing, otherwise.
#
# WHY THIS IS NOT `|| true`. An earlier revision swallowed a failed `launchctl
# unload` and went straight on to `rm -f` the plist and clear the binding. That
# is this task's own finding arrived at from the other side: with the unload
# having failed the agent is STILL LOADED, and the two things removed next are
# the only path an unload can name it by and the only record on this machine
# that names the schedule at all. What is left behind is a live launchd job, a
# removal guard that now waves the checkout through, and an `orchid doctor`
# with nothing to report -- the invisible leftover, minted by the verb whose
# entire purpose is to prevent it, and reported to the operator as success.
#
# BUT A FAILED UNLOAD IS NOT THE SAME FACT AS A LOADED AGENT, and refusing on
# the exit status alone would wedge an ordinary state. `install` writes the
# plist BEFORE it loads it, so anything that failed in between leaves a plist
# launchd never knew about, and `launchctl unload` fails for exactly that too
# -- the state `uninstall` most needs to be able to clear. The two are told
# apart by asking launchd itself: `launchctl list <label>` succeeds only for a
# job it currently holds. Asked ONLY after a failure, so the ordinary path
# makes no extra system call and behaves precisely as it did before.
#
# THE LINUX BRANCH NEEDS NO EQUIVALENT: `_svc_uninstall_linux` runs its crontab
# pipeline without `|| true`, so under this file's `set -e` a failed rewrite
# aborts before the record and the binding are touched -- the same conservative
# residue, reached by the shell rather than by hand.
_svc_unload_darwin() {
  local repo="$1" label="$2" plist="$3" err=""
  err="$(_svc_scheduler_exec launchctl unload "$plist" 2>&1)" && return 0
  # `list` nonzero means launchd holds no job under this label, so the failure
  # above was the never-loaded case and the removals after it are safe.
  _svc_scheduler_exec launchctl list "$label" >/dev/null 2>&1 || return 0
  [ -z "$err" ] || echo "orchid: launchctl: $err" >&2
  echo "orchid: refusing to remove anything for $repo (label $label): 'launchctl unload' failed and launchd still reports that job as loaded" >&2
  echo "orchid: the plist is the only path an unload can name that agent by, and the binding record is the only thing that names the schedule at all — both are left exactly as they were" >&2
  orchid_die "unload it by hand, then re-run: launchctl unload $(printf '%q' "$plist") && $(orchid_service_uninstall_command "$repo")"
}

_svc_install_darwin() {
  local repo="$1" interval_s="$2" dry="$3"
  local label; label="$(_svc_label "$repo")"
  local agents_dir="$HOME/Library/LaunchAgents"
  local plist_path="$agents_dir/$label.plist"
  local parent; parent="$(cd "$repo/.." && pwd -P)"
  local rt log pump_exe path_val existed=0
  rt="$(orchid_runtime "$repo")"   # repo already confirmed initialized by the caller
  log="$rt/pump.log"
  pump_exe="$ORCHID_ROOT/runners/orchid-pump"
  path_val="$(_svc_install_path)"
  [ -f "$plist_path" ] && existed=1

  # RECORD WHAT THIS SCHEDULE IS BOUND TO, BEFORE THERE IS A SCHEDULE. The
  # ordering is the point (see lib/common.sh's own header): a binding record
  # with no schedule behind it is harmless and self-correcting -- the removal
  # guard is merely conservative about this checkout, `orchid doctor` names the
  # binding, and `uninstall` clears it -- while a schedule with no record is
  # exactly the invisible leftover this whole mechanism exists to prevent.
  # Written the other way round, every failure between the two (a plist that
  # renders but will not move, a `launchctl load` that errors out under this
  # file's `set -e`) leaves the agent installed and unnameable.
  #
  # Fatal, unlike the warning an earlier revision printed here: nothing has
  # been installed at this point, so refusing costs the operator a retry rather
  # than a live schedule nothing can find.
  orchid_service_binding_write "$repo" "$label" darwin "$plist_path" "$interval_s" \
    || orchid_die "could not record the service binding for $repo — refusing to install a schedule nothing would be able to name"

  mkdir -p "$agents_dir"
  local tmp="$plist_path.tmp.$$"
  _svc_render_plist "$label" "$repo" "$parent" "$interval_s" "$pump_exe" "$path_val" > "$tmp"
  mv "$tmp" "$plist_path"

  # Idempotent re-install: unload the PRIOR load (best-effort -- if it was
  # never actually loaded, or launchd has no record of it, that's fine, not
  # an error) before loading the freshly-rendered file, so a second `install`
  # for the same repo replaces the running schedule in place rather than
  # erroring "already loaded" or silently leaving the old copy active.
  #
  # `|| true` is right HERE and wrong in uninstall, and the asymmetry is the
  # whole of _svc_unload_darwin's header: this path removes nothing and ends
  # with a `launchctl load` of a plist that is still on disk under a binding
  # that still names it, so a swallowed failure leaves the schedule findable.
  # Uninstall's next two statements delete exactly those two things.
  if [ "$existed" -eq 1 ]; then
    if [ "$dry" -eq 1 ]; then _svc_dryprint launchctl unload "$plist_path"
    else _svc_scheduler_exec launchctl unload "$plist_path" >/dev/null 2>&1 || true
    fi
  fi
  if [ "$dry" -eq 1 ]; then
    _svc_dryprint launchctl load "$plist_path"
  else
    _svc_scheduler_exec launchctl load "$plist_path"
  fi

  echo "orchid: service installed for $repo"
  echo "  label:      $label"
  echo "  plist:      $plist_path"
  echo "  interval_s: $interval_s"
  echo "  log:        $log"
  echo "  binding:    $(orchid_service_repo_record "$repo")"
  echo "  teardown:   uninstall this schedule BEFORE removing $repo -- $(orchid_service_uninstall_command "$repo")"
}

_svc_uninstall_darwin() {
  local repo="$1" dry="$2"
  local label; label="$(_svc_label "$repo")"
  local plist_path="$HOME/Library/LaunchAgents/$label.plist"
  # A binding record with no plist behind it is a REACHABLE state, not a
  # contradiction: install writes the record first, so anything that fails
  # between the two leaves one. That record makes the removal guard refuse the
  # checkout, so the verb the guard names has to be able to clear it -- refusing
  # here on the artifact alone would wedge a checkout that has no schedule at
  # all. Nothing is installed only when NEITHER is there.
  if [ ! -f "$plist_path" ] && ! orchid_service_binding_present "$repo" "$label"; then
    orchid_die "no service installed for $repo (label $label)"
  fi
  if [ ! -f "$plist_path" ]; then
    if [ "$dry" -eq 1 ]; then
      echo "orchid: no launchd agent for $repo (label $label) — a real uninstall would clear the binding record it left behind" >&2
    else
      echo "orchid: no launchd agent for $repo (label $label) — clearing the binding record it left behind" >&2
    fi
  elif [ "$dry" -eq 1 ]; then
    _svc_dryprint launchctl unload "$plist_path"
  else
    # Not `|| true`: a failed unload may mean the agent is still loaded, and
    # the two removals below are the only things that can ever name it again.
    # See _svc_unload_darwin's own header.
    _svc_unload_darwin "$repo" "$label" "$plist_path"
  fi
  # THE DRY RUN STOPS HERE, holding everything. `launchctl unload` was printed
  # rather than run, so the agent is still loaded -- and the plist below is the
  # path a real unload needs, while the binding is the only record naming the
  # schedule at all. Removing either now would leave a live agent that nothing
  # can name and nothing can unload by path: the invisible leftover, minted by
  # the flag an operator runs precisely to avoid consequences.
  if [ "$dry" -eq 1 ]; then
    _svc_print_dry_uninstall "$repo" "$label" "$plist_path"
    return 0
  fi
  rm -f "$plist_path"
  orchid_service_binding_remove "$repo" "$label"
  _svc_print_uninstalled "$repo" "$label"
}

_svc_status_darwin() {
  local repo="$1" dry="$2"
  local label; label="$(_svc_label "$repo")"
  local plist_path="$HOME/Library/LaunchAgents/$label.plist"
  echo "orchid service status: $repo"
  echo "  platform: darwin"
  echo "  label:    $label"
  if [ ! -f "$plist_path" ]; then
    echo "  installed: no"
  else
    echo "  installed: yes"
    echo "  plist:     $plist_path"
    local interval
    interval="$(grep -A1 '<key>StartInterval</key>' "$plist_path" 2>/dev/null | tail -n1 | grep -o '[0-9]\+' || true)"
    [ -n "$interval" ] && echo "  interval_s: $interval"
    if [ "$dry" -eq 1 ]; then
      _svc_dryprint launchctl list "$label"
      echo "  loaded:    unknown (--dry-run -- not queried)"
    else
      if launchctl list "$label" >/dev/null 2>&1; then
        echo "  loaded:    yes"
      else
        echo "  loaded:    no"
      fi
    fi
  fi
  _svc_print_binding "$repo"
  _svc_print_log_tail "$repo/.orchid/runtime/pump.log"
}

# ---------------------------------------------------------------------------
# linux (cron fallback)
# ---------------------------------------------------------------------------
# `crontab -l`/`crontab -` talk to the REAL per-user system crontab -- there
# is no HOME-style redirection knob for them, unlike launchd's plist file.
# So install keeps a repo-local record, `.orchid/runtime/pump.cron`
# (exactly the line last installed), as the durable, filesystem-only
# artifact status/uninstall reason from -- the linux-side analogue of the
# plist file itself on macOS. This is what makes install/uninstall/status
# fully testable under --dry-run without ever touching the real crontab
# (this suite's own machine may not even run linux, or may have a real
# crontab of its own that must never be read or mutated by a test).

# _svc_cron_pipeline_install <marker> <line> / _svc_cron_pipeline_uninstall
# <marker> -- build the ONE canonical shell command string for each
# mutating crontab operation. Both the --dry-run print and the real `eval`
# below read this SAME string (never two hand-written near-duplicates) --
# closes a review-flagged drift where an earlier revision's --dry-run print
# had silently diverged from the real command it claimed to describe
# (missing the `|| true` guard, and a `(...)` subshell in the print vs. the
# real path's `{...}` group -- semantically different: `(...)` would have
# hidden the `crontab -` write inside a subshell, sent to the terminal
# instead of piped). `$marker`/`$line` are individually `printf %q`-quoted
# so a repo path containing a space/quote/`$`/backtick can't break out of
# its argument position once this string is eval'd.
_svc_cron_pipeline_install() {
  local marker="$1" line="$2"
  echo "{ crontab -l 2>/dev/null | grep -vF $(printf '%q' "$marker") || true; printf '%s\n' $(printf '%q' "$line"); } | crontab -"
}
_svc_cron_pipeline_uninstall() {
  local marker="$1"
  echo "{ crontab -l 2>/dev/null | grep -vF $(printf '%q' "$marker") || true; } | crontab -"
}

# _svc_emit_cron_seam <pipeline> -- TEST-ONLY debug seam. `install`/
# `uninstall` run as their OWN process (invoked via command substitution
# or a plain call from the test), so a plain `export` inside this script
# never reaches back into the test's own shell -- it dies with the
# subprocess. When ORCHID_SERVICE_DEBUG_CRON_CMD_FILE is set (only ever by
# tests/test_service.sh), this writes the exact pipeline string used for
# BOTH the --dry-run print and the real `eval` to that file, verbatim, no
# trailing newline -- proof the two surfaces are reading the same value,
# not merely that they currently happen to look alike. A no-op, and the
# env var otherwise unreferenced, when unset.
_svc_emit_cron_seam() {
  [ -n "${ORCHID_SERVICE_DEBUG_CRON_CMD_FILE:-}" ] || return 0
  printf '%s' "$1" > "$ORCHID_SERVICE_DEBUG_CRON_CMD_FILE"
}

_svc_install_linux() {
  local repo="$1" interval_s="$2" dry="$3"
  local label; label="$(_svc_label "$repo")"
  local parent; parent="$(cd "$repo/.." && pwd -P)"
  local rt log pump_exe path_val record line marker
  rt="$(orchid_runtime "$repo")"
  log="$rt/pump.log"
  pump_exe="$ORCHID_ROOT/runners/orchid-pump"
  path_val="$(_svc_install_path)"
  record="$(_svc_cron_record_path "$repo")"
  line="$(_svc_render_cron_line "$label" "$repo" "$parent" "$interval_s" "$pump_exe" "$path_val")"
  marker="# orchid-service:$label"

  # Same binding record as the darwin branch, written for the same reason and
  # in the same place in the sequence: BEFORE the scheduler artifact exists.
  # The `artifact` here is the local pump.cron record rather than the crontab
  # itself, matching what uninstall/status already reason from on this branch.
  orchid_service_binding_write "$repo" "$label" linux "$record" "$interval_s" \
    || orchid_die "could not record the service binding for $repo — refusing to install a schedule nothing would be able to name"

  printf '%s\n' "$line" > "$record"

  # Idempotent re-install: strip any PRIOR line carrying this exact label's
  # marker before appending the fresh one, so a second `install` for the
  # same repo replaces its own line rather than stacking a duplicate --
  # see _svc_cron_pipeline_install's own header for the `|| true`/grouping
  # reasoning.
  local pipeline; pipeline="$(_svc_cron_pipeline_install "$marker" "$line")"
  _svc_emit_cron_seam "$pipeline"
  if [ "$dry" -eq 1 ]; then
    echo "DRY-RUN: $pipeline"
  else
    # _svc_scheduler_eval, not a bare `eval`: it carries the eval-safety
    # reasoning ($pipeline is this script's own fixed syntax plus two
    # `printf %q`-quoted values) and the test-only stub seam in one place.
    _svc_scheduler_eval "$pipeline"
  fi

  echo "orchid: service installed for $repo"
  echo "  label:      $label"
  echo "  crontab:    $line"
  echo "  interval_s: $interval_s (floored to $(_svc_cron_minutes "$interval_s") min for cron)"
  echo "  log:        $log"
  echo "  binding:    $(orchid_service_repo_record "$repo")"
  echo "  teardown:   uninstall this schedule BEFORE removing $repo -- $(orchid_service_uninstall_command "$repo")"
}

_svc_uninstall_linux() {
  local repo="$1" dry="$2"
  local label; label="$(_svc_label "$repo")"
  local record; record="$(_svc_cron_record_path "$repo")"
  # The cron record lives INSIDE the checkout, so a schedule that outlived its
  # repository has none left to reason from -- and that is precisely the case
  # an operator most needs uninstall for. Either half of the binding is enough
  # to proceed: the machine-local copy is the one that survives the checkout,
  # and the repo-local one is what an install that failed before it wrote the
  # cron record leaves behind. With either, the marker is still removable from
  # the real crontab, which is where the leftover schedule actually lives.
  if [ ! -f "$record" ] && ! orchid_service_binding_present "$repo" "$label"; then
    orchid_die "no service installed for $repo (label $label)"
  fi
  local marker="# orchid-service:$label"
  local pipeline; pipeline="$(_svc_cron_pipeline_uninstall "$marker")"
  _svc_emit_cron_seam "$pipeline"
  if [ "$dry" -eq 1 ]; then
    echo "DRY-RUN: $pipeline"
    # Same stop, same reason, as the darwin branch above: the crontab line is
    # still there, and the pump.cron record plus the binding are what name it.
    _svc_print_dry_uninstall "$repo" "$label" "$record"
    return 0
  fi
  _svc_scheduler_eval "$pipeline"
  rm -f "$record"
  orchid_service_binding_remove "$repo" "$label"
  _svc_print_uninstalled "$repo" "$label"
}

_svc_status_linux() {
  local repo="$1" dry="$2"
  local label; label="$(_svc_label "$repo")"
  local record; record="$(_svc_cron_record_path "$repo")"
  echo "orchid service status: $repo"
  echo "  platform: linux"
  echo "  label:    $label"
  if [ ! -f "$record" ]; then
    echo "  installed: no"
  else
    echo "  installed: yes"
    echo "  crontab:   $(cat "$record")"
    local marker="# orchid-service:$label"
    if [ "$dry" -eq 1 ]; then
      echo "DRY-RUN: crontab -l 2>/dev/null | grep -F $(printf '%q' "$marker")"
      echo "  confirmed: unknown (--dry-run -- not queried)"
    else
      # Captured first, then matched with a herestring -- never `crontab -l |
      # grep -qF` (T016's sweep of the class T010 named). `grep -q` exits at
      # its first match and SIGPIPEs `crontab`, and under this file's `set -o
      # pipefail` that kill-by-signal status becomes the pipeline's, so an
      # installed schedule reads as "confirmed: no". This is the shape with
      # the largest real producer in the kernel -- an operator's whole crontab
      # -- so a long one makes the race likelier rather than rarer, and the
      # answer is what an operator checking whether `install` took reads.
      local cron_lines
      cron_lines="$(crontab -l 2>/dev/null || true)"
      if grep -qF "$marker" <<<"$cron_lines"; then
        echo "  confirmed: yes"
      else
        echo "  confirmed: no"
      fi
    fi
  fi
  _svc_print_binding "$repo"
  _svc_print_log_tail "$repo/.orchid/runtime/pump.log"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

sub="${1:-}"; shift || true
case "$sub" in
  -h|--help|help|"") _svc_usage; exit 0 ;;
  install|uninstall|status) ;;
  *) orchid_die "usage: orchid service <install|uninstall|status> [--repo <path>] [--interval-s N] [--dry-run]" ;;
esac

repo_arg=""; interval_arg=""; dry_run=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      [ -n "${2:-}" ] || orchid_die "--repo requires a value"
      repo_arg="$2"; shift 2 ;;
    --interval-s)
      [ -n "${2:-}" ] || orchid_die "--interval-s requires a value"
      interval_arg="$2"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    *) orchid_die "orchid service $sub: unknown argument '$1'" ;;
  esac
done
[ "$sub" = install ] || [ -z "$interval_arg" ] \
  || orchid_die "--interval-s is only valid with 'install'"

# _svc_bound_repo_by_path <path> -- the CANONICAL repo path a machine-local
# binding was installed against, when <path> names one exactly. The label every
# subverb derives is a hash of the canonical path, and `pwd -P` cannot resolve
# a directory that no longer exists -- so for a checkout that is gone, the
# binding record is the only thing left that can name the path the schedule was
# hashed from. Exact string match against the recorded value, which is what
# `orchid doctor` prints back at the operator.
_svc_bound_repo_by_path() {
  local want="$1" label repo
  while IFS="$(printf '\t')" read -r label repo; do
    [ -n "$label" ] || continue
    [ -n "$repo" ] || continue
    if [ "$repo" = "$want" ]; then
      printf '%s\n' "$repo"
      return 0
    fi
  done < <(orchid_service_bindings)
  return 1
}

repo_in="${repo_arg:-${ORCHID_REPO:-$PWD}}"
if [ -d "$repo_in" ]; then
  repo="$(cd "$repo_in" && pwd -P)"
elif [ "$sub" = uninstall ] && repo="$(_svc_bound_repo_by_path "$repo_in")"; then
  # A schedule outlives what it points at, so uninstall -- and ONLY uninstall
  # -- must work against a repository that is already gone. Refusing here would
  # make the leftover launchd agent / crontab line unremovable by the very
  # command `orchid doctor` names for it. `install` still refuses (there is
  # nothing to install for), and so does `status` (it reports on a checkout).
  echo "orchid: $repo no longer exists — removing its leftover schedule from the machine-local binding record" >&2
else
  orchid_die "no such repo directory: $repo_in"
fi
plat="$(_svc_platform)"

# `install` is the only arm that crosses the unattended boundary, and the
# stale-root gate below may not sit ahead of it -- so that boundary is crossed
# HERE, before the dispatch, rather than inside the arm it belongs to.
# Dry-run still renders and places scheduler artifacts, so it crosses the same
# boundary as a real install and is gated identically. Status/uninstall remain
# available after revocation so an operator can always inspect or remove an
# existing schedule.
if [ "$sub" = install ]; then
  [ -d "$repo/.orchid" ] \
    || orchid_die "cannot install service for uninitialized repo (no .orchid/ found): $repo -- run 'orchid init' first"
  unattended_trust_require "$repo" "service installation" || exit 1
fi

# The stale-root gate, at the first line its own contract allows (T016). This
# runner holds the fixed entry PATH for its whole run and so never calls
# _orchid_entry_restore_operator_path, which is where lib/common.sh fires the
# gate for every other trust-boundary entry point -- so without this call the
# gate would arm here and never fire, and an `orchid service install` run out
# of a stale integration checkout would render its scheduler artifacts from
# pre-merge templates.
#
# ONE placement, on the straight-line path ABOVE the dispatch, and that is the
# whole point rather than a tidiness preference. Written once per arm -- which
# is how this first shipped -- a fourth arm added tomorrow would arm the gate
# and never fire it, and tests/inv/test_INV-15_no_optional_gate.sh section 4
# could not see it: that scan asks whether a deferring entry point FILE calls a
# firing site, and this file would still call one, twice, in the arms nobody
# added. A gate skipped by omission, inside the guard the invariant against
# gates skipped by omission exists to protect. Here there is no ACTING arm to
# forget, because every one of them is below this line.
#
# THE USAGE ARM IS ABOVE IT, and that is a rule rather than this file's own
# exemption. `-h`, `--help`, `help` and a bare invocation are answered by
# _svc_usage at the dispatch above and exit without reaching this call --
# exactly as they do in libexec/orchid-trust, the other entry point that fires
# this gate itself. The gate belongs AFTER the operator's command has been
# validated, so a mistyped verb is answered with its own diagnosis instead of a
# refusal about the checkout; and a usage text names no repository, resolves no
# record and reports nothing an operator could act on about a target, since at
# that point `--repo` has not even been read. The two verbs are held to that
# together -- and to the acting arm that must still refuse out of the same stale
# root -- by tests/inv/test_INV-15_no_optional_gate.sh section 8.
orchid_root_stale_gate

case "$sub" in
  install)
    interval_s="${interval_arg:-$(config_get "$repo" pump_interval_s 240)}"
    case "$interval_s" in
      ''|*[!0-9]*) orchid_die "--interval-s must be a positive integer (got '$interval_s')" ;;
    esac
    [ "$interval_s" -gt 0 ] || orchid_die "--interval-s must be a positive integer (got '$interval_s')"
    if [ "$plat" = darwin ]; then
      _svc_install_darwin "$repo" "$interval_s" "$dry_run"
    else
      _svc_install_linux "$repo" "$interval_s" "$dry_run"
    fi
    ;;
  uninstall)
    if [ "$plat" = darwin ]; then
      _svc_uninstall_darwin "$repo" "$dry_run"
    else
      _svc_uninstall_linux "$repo" "$dry_run"
    fi
    ;;
  status)
    if [ "$plat" = darwin ]; then
      _svc_status_darwin "$repo" "$dry_run"
    else
      _svc_status_linux "$repo" "$dry_run"
    fi
    ;;
esac

#!/bin/bash -p
set -euo pipefail
# tier-2, effectful: the headless tick. Fences a fresh epoch, resolves the
# orchestrator role's available engine, builds a one-shot `orchestrate`
# request, and spawns the adapter SYNCHRONOUSLY (foreground `with_timeout`
# wait, unlike runners/orchid-launch's background `&` spawn -- there is no
# job to poll later; the tick either produced an envelope by the time this
# script returns, or it didn't).
#
# Deliberately NOT routed through `orchid jobs prepare`/spool (lib/spawn.sh's
# header aside, this is the other reason orchid-tick is its own runner
# rather than a jobs-prepare call): a tick is not a task job, and its
# envelope must never enter `jobs reconcile`'s manifest-matching path --
# ledger_mark below is this runner's own, private disposal of the envelope.

# The direct tick is an unattended entry point, not merely a pump
# implementation detail. Capture the operator PATH without consulting it when
# direct; a bin/orchid handoff already carries the original value as inert
# data. Then use only fixed machine-local system/package-manager directories
# for self-resolution and the complete trust decision. The shebang's
# privileged mode also prevents BASH_ENV and imported functions from running
# first.
unset __orchid_entry_defer_restore
if [ "${__orchid_entry_context:-}" != 1 ]; then
  unset __orchid_entry_context __orchid_entry_path_was_set
  unset __orchid_entry_operator_path
  __orchid_entry_context=1
  __orchid_entry_path_was_set="${PATH+x}"
  __orchid_entry_operator_path="${PATH-}"
  export __orchid_entry_context __orchid_entry_path_was_set
  export __orchid_entry_operator_path
fi
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH

self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"
__orchid_entry_defer_restore=1
source "$ORCHID_ROOT/lib/common.sh"; source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/manifest.sh"; source "$ORCHID_ROOT/lib/roles.sh"
source "$ORCHID_ROOT/lib/resolver.sh"; source "$ORCHID_ROOT/lib/capsuite.sh"
source "$ORCHID_ROOT/lib/ledger.sh"; source "$ORCHID_ROOT/lib/envelope.sh"
source "$ORCHID_ROOT/lib/spawn.sh"; source "$ORCHID_ROOT/lib/trust.sh"

repo="${ORCHID_REPO:-$PWD}"; state="$(orchid_state "$repo")"

# Never spend quota on a finished run: no roadmap (uninitialized) reads as
# "" here, which also just falls through to the resume step below and lets
# `orchid run resume` itself refuse with its own "not initialized" message.
rs="$(fm_get "$state/roadmap.md" run_status 2>/dev/null || true)"
if [ "$rs" = complete ]; then
  echo "tick: run_status complete, nothing to do"
  exit 0
fi

# This direct runner is an unattended entry point in its own right (the pump
# is not assumed to be its only caller). Gate before orchid_runtime creates a
# directory, before `run resume` fences an epoch, and before any adapter is
# resolved or spawned.
unattended_trust_require "$repo" "headless tick" || exit 1
_orchid_entry_restore_operator_path
rt="$(orchid_runtime "$repo")"

# `orchid run resume` fences a fresh epoch (breaking a stale lock per
# policy) and requires initialized state -- its own guard, not re-checked
# here. ORCHID_EPOCH/ORCHID_REPO are exported for two reasons: (a)
# resolve_engine_exe below consults $ORCHID_REPO for repo-local trusted
# engines, and (b) both cross into the spawned adapter's stripped
# environment via spawn_child_env's ORCHID_* allowlist, so the orchestrator
# engine's real `orchid` verb calls (task advance, journal add, ...) see the
# same epoch/repo this tick just fenced -- without this export the child's
# every verb call would fail epoch_require against a stale/unset epoch.
resume_out="$("$ORCHID_ROOT/bin/orchid" run resume)"
epoch="${resume_out#epoch: }"
export ORCHID_EPOCH="$epoch" ORCHID_REPO="$repo"

# Exit 14 (no eligible engine) propagates verbatim: `resolve_role_available`
# prints its own per-entry disqualifier to stderr; under `set -e` this bare
# assignment aborts the script with that same code, not a rewritten 1
# (the pump's next pass retries once ledger/capsuite state has moved on).
engine="$(resolve_role_available "$repo" orchestrator)"

# Command-surface label (v1.1, Track 1). `brokered` means this adapter runs
# its orchestrator against the argument-validating broker
# (runners/orchid-orchestrator-command) and nothing else; `soft` means its
# vendor CLI offers no enforceable per-command restriction, so the only thing
# between a prompt-injecting repository and the host is the machine-local
# unattended acknowledgement this runner already required above. Printed on
# every tick, from the manifest rather than from documentation, so an
# operator reading a pump log can always see which of the two just ran. An
# absent or unrecognized label reads as `soft`: this field may weaken its own
# claim by omission, never strengthen it.
tick_engine_dir="$(resolve_engine_dir "$engine" 2>/dev/null || true)"
command_surface=soft
if [ -n "$tick_engine_dir" ]; then
  command_surface="$(manifest_get "$tick_engine_dir" command_surface soft)"
fi
case "$command_surface" in
  brokered|soft) ;;
  *) command_surface=soft ;;
esac
echo "tick: orchestrator $engine command_surface=$command_surface"

# Actor identity for this tick's journal entries: rides ORCHID_* into the
# spawned adapter's stripped environment (spawn_child_env's allowlist,
# below), and from there into the orchestrator engine's own `orchid`
# verb calls (task advance, journal add, ...) -- so a headless tick's
# journal reads "claude/orchestrator tick-e7" instead of the previous
# generic "operator e7" (libexec/orchid-journal's ORCHID_ACTOR fallback).
export ORCHID_ACTOR="${engine}/orchestrator tick-e${epoch}"

job_id="tick-e${epoch}"
mkdir -p "$rt/requests" "$rt/logs"
req_file="$rt/requests/$job_id.json"
log="$rt/logs/$job_id.log"
out_envelope="$rt/logs/$job_id.envelope.json"

deadline_s=$(( $(config_get "$repo" timeout_minutes 60) * 60 ))
model="$(config_get "$repo" model "")"
effort="$(config_get "$repo" effort medium)"

jq -n --arg job_id "$job_id" --arg worktree "$repo" --arg output "$out_envelope" \
  --argjson deadline_s "$deadline_s" --arg model "$model" --arg effort "$effort" \
  '{request:1, job_id:$job_id, task:"run", role:"orchestrator", operation:"orchestrate",
    deadline_s:$deadline_s, policy:"workspace-write", output:$output,
    worktree:$worktree, input_pack:"", model:$model, effort:$effort}' \
  | atomic_write "$req_file"

exe="$(resolve_engine_exe "$engine")" || orchid_die "cannot resolve engine '$engine'"
plugin_dir="$(dirname "$exe")"

child_env=()
while IFS= read -r _line; do
  [ -n "$_line" ] || continue
  child_env+=("$_line")
done < <(spawn_child_env "$plugin_dir")

# Synchronous spawn: no `set -m`/background `&` (unlike orchid-launch) --
# there is no manifest/pgid to record and nothing else to do while this
# process runs, so the tick simply waits for it (bounded by with_timeout).
_tick_spawn_adapter() {
  if [ "${#child_env[@]}" -gt 0 ]; then
    env -i "${child_env[@]}" ORCHID_DRYRUN="${ORCHID_DRYRUN:-0}" "$exe" "$req_file" </dev/null >> "$log" 2>&1
  else
    env -i ORCHID_DRYRUN="${ORCHID_DRYRUN:-0}" "$exe" "$req_file" </dev/null >> "$log" 2>&1
  fi
}
set +e
with_timeout "$deadline_s" _tick_spawn_adapter
set -e

# A missing/invalid envelope (adapter crashed, was killed on timeout before
# writing, or wrote something that doesn't parse/validate) is treated as a
# plain `failed` mark -- ledger_mark's own switch buckets failed/timeout/
# auth/malformed identically (consecutive-failure counting), so nothing is
# lost by collapsing "no envelope at all" into that same bucket rather than
# inventing a seventh status.
#
# failure_kind (v1-m5 T008) rides along for the same reason `jobs reconcile`
# reads it: an engine bound to `role.orchestrator` that declines `orchestrate`
# as an operation it never claimed has refused by design, not failed, and must
# not be charged a consecutive failure for saying so. It is deliberately left
# EMPTY on the no-envelope fallback below -- an adapter that wrote nothing at
# all has made no claim about anything, so that path stays a plain fault.
if [ -f "$out_envelope" ] && envelope_validate "$out_envelope" 2>/dev/null; then
  status="$(jq -r .status "$out_envelope")"
  failure_kind="$(jq -r '.failure_kind // empty' "$out_envelope")"
  actions_n="$(jq -r '(.actions // []) | length' "$out_envelope")"
else
  status=failed
  failure_kind=""
  actions_n=0
fi

ledger_mark "$repo" "$engine" "$status" "" "$failure_kind"
echo "tick: $engine $status actions=$actions_n"
[ "$status" = ok ]

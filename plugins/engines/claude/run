#!/usr/bin/env bash
set -euo pipefail
# tier-3 engine adapter: `run <request.json>`. Invoked ONLY by runners/orchid-launch
# (INV-06) — never directly. Writes ONLY to the request's `output` path (plus its
# own stdout/stderr, captured into the launcher's log) — no other durable state.
# Fallback implementer and reviewer: same request/envelope contracts as
# plugins/engines/codex/run. See docs/specs/plugins.md.
self="$0"
while [ -L "$self" ]; do
  t="$(readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(dirname "$self")/../../.." && pwd)"
source "$ORCHID_ROOT/lib/common.sh"
source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/heartbeat.sh"

# The stale-root gate, fired explicitly (INV-15). An engine adapter lives
# outside bin/, libexec/ and runners/, so lib/common.sh's source-time fire does
# not cover this path: loading the library above ARMED the guard and left the
# firing to this file. It is worth the line because an adapter executes
# $ORCHID_ROOT's own libraries and role profiles, so a stale installation root
# is precisely the stale-adapter shape lesson L018 records. Idempotent, and a
# no-op for every root not parked on its configured integration branch, so an
# ordinary run pays nothing for it.
orchid_root_stale_gate

req="${1:?usage: run <request.json>}"
job_id="$(jq -r .job_id "$req")";         task="$(jq -r .task "$req")"
operation="$(jq -r .operation "$req")";   worktree="$(jq -r .worktree "$req")"
input_pack="$(jq -r .input_pack "$req")"; output="$(jq -r .output "$req")"
# `// ""` (rather than a bare `.base_sha`): the `orchestrate` request
# document (runners/orchid-tick) carries neither field -- a missing key
# would otherwise stringify to the literal text "null" here.
base_sha="$(jq -r '.base_sha // ""' "$req")"; candidate_sha="$(jq -r '.candidate_sha // ""' "$req")"

write_envelope() {  # status extra-json
  local extra="${2:-}"; [ -n "$extra" ] || extra='{}'
  jq -n --arg job_id "$job_id" --arg task "$task" --arg operation "$operation" \
        --arg status "$1" --arg base_sha "$base_sha" --arg candidate_sha "$candidate_sha" \
        --argjson extra "$extra" \
        '{contract:1, job_id:$job_id, task:$task, operation:$operation, status:$status,
          engine:"orchid/claude", base_sha:$base_sha, candidate_sha:$candidate_sha} + $extra' \
    | atomic_write "$output"
}
classify() {  # combined stdout+stderr text -> rate_limited|auth|failed
  # HERESTRINGS, never `printf ... | grep -q` (T016's sweep of the class T010
  # named). $1 is the whole of a vendor CLI's combined output, so it is the
  # LARGEST producer any matcher in this tree is fed: `grep -q` exits at its
  # first match, SIGPIPEs a `printf` with most of that still to write, and
  # under this adapter's `set -o pipefail` the kill-by-signal status becomes
  # the pipeline's. A genuine rate-limit notice then classifies as plain
  # `failed`, lib/ledger.sh charges an attempt instead of scheduling the
  # backoff, and the bigger the transcript the likelier it is.
  if grep -qiE 'rate limit|usage limit|429' <<<"$1"; then echo rate_limited
  elif grep -qiE 'login|auth|unauthorized' <<<"$1"; then echo auth
  else echo failed
  fi
}

# Capability-refusal marker (v1-m5 T008; same meaning as
# plugins/engines/agy/run's): declining an operation this adapter never
# claimed is designed behaviour, so `lib/ledger.sh` must not charge it toward
# engine_fail_threshold. Genuine faults below never carry it.
REFUSAL='{"failure_kind":"capability"}'

# Operation gate precedes DRYRUN: an unsupported operation fails the same way
# whether or not ORCHID_DRYRUN is set (no dryrun short-circuit for unknowns).
case "$operation" in implement|review|critique|orchestrate) ;;
  *)
    echo "orchid/claude: unsupported operation '$operation'" >&2
    write_envelope failed "$REFUSAL"
    exit 1 ;;
esac

if [ "${ORCHID_DRYRUN:-0}" = "1" ]; then
  case "$operation" in
    implement)       write_envelope ok '{"summary":"dryrun"}' ;;
    review|critique) write_envelope ok '{"verdict":"approve","scope_complete":true,"findings":[]}' ;;
    orchestrate)     write_envelope ok '{"actions":[],"summary":"dryrun"}' ;;
  esac
  exit 0
fi

err_file="$(mktemp)"; trap 'rm -f "$err_file"' EXIT

# orchestrate: runners/orchid-tick's headless-tick operation. The prompt is
# PROTOCOL.md's full text (the same tick procedure a human/skill front-end
# already executes, per its own preamble) plus a fixed instruction block
# naming the concrete repo/binary paths this exact process resolved --
# `$worktree` (== the request's ORCHID_REPO) and `$ORCHID_ROOT` (this
# adapter's own self-resolved root, computed above from `$0`, independent of
# whatever the stripped child environment does or doesn't carry). Every
# verb invocation the CLI makes is expected to echo a matching
# `ORCHID-ACTION: <command>` line, which this adapter greps back out of the
# transcript into the envelope's `actions[]` -- an empty array (CLI made no
# verb calls this tick) is still `ok` as long as the CLI itself exited 0.
#
# Headless flags: `--permission-mode acceptEdits --allowedTools
# "Bash(<broker>:*)"`. Two separate findings shaped this line.
#
# F8 (dogfood): a real pump-driven tick ran and executed ZERO verbs -- claude
# exited 0 having politely explained it lacked permission to run Bash.
# acceptEdits alone authorizes FILE EDITS only; it does not allowlist the Bash
# tool at all. The orchestrator's entire job is running commands, so the Bash
# tool must be allowlisted for this branch to do anything.
#
# v1.1 Track 1: it used to be allowlisted WHOLESALE (`--allowedTools Bash`),
# which is a general shell on the operator's machine, handed to a model whose
# context is full of target-repository text. The manifest now labels this
# adapter `command_surface=brokered` and this is what earns that label: the
# only executable admitted is runners/orchid-orchestrator-command, the
# default-deny, argument-validating broker that accepts a short list of exact
# read forms plus `orchid task arbitrate`, `journal add`, `lessons add`,
# `notify` and `run boundary clear` -- and refuses trust/service/config/
# plugin/init/start/runner/vendor invocations outright. The mechanical tick is
# no longer this model's job either: `orchid drive` already ran it, and this
# branch is only ever reached for a named judgment boundary.
#
# This is a real vendor-enforced restriction on WHICH command may run, not
# prompt policy -- but it is not OS containment: it is the vendor CLI's own
# allowlist, and the broker itself still runs unsandboxed. The separate
# machine-local unattended-trust gate is what makes an operator acknowledge
# that residual risk before this branch can be reached at all. See
# tests/probes/probe-claude-tick.sh for the real round-trip.
#
# And it is a restriction on COMMANDS ONLY -- Track 1 honesty, so nobody
# reads more into the label than it earns. `--allowedTools` scopes the Bash
# tool; `acceptEdits` leaves the vendor's own file-write tools auto-approved,
# so this model can create/edit files anywhere the process can reach:
# `.orchid/` included, and -- when ORCHID_ROOT sits inside the driven
# repository, as it does when Orchid drives itself -- the broker script
# below included. The "Never hand-edit anything under .orchid/" and "never
# contact any remote" lines in the instructions are PROMPT POLICY, not
# enforcement, and are written here as such.
#
# WHY THE NOTIFY FORM BELOW CARRIES `--choice` (v1-m4 T009). A boundary this
# model hands on to a human arrives as one channel message, and r-001 shipped
# twenty-seven of those whose only instruction was `orchid answer <qid>
# <choice> --nonce <n>` -- with `<choice>` free text validated against
# nothing, so the page could not say what it would accept and a typo was
# recorded silently as a decision. runners/orchid-drive declares a set for
# every boundary kind that has one (lib/drive.sh's drive_boundary_choices),
# and this branch is the OTHER producer of those pages: a boundary the driver
# routed to a woken model, which the model then judges to be a human's after
# all. Left out here, exactly the pages a model escalates keep the
# unanswerable shape -- and this is the adapter the run's own orchestrator
# role resolves to, so that is not a hypothetical half. The broker already
# admits and validates the flag (runners/orchid-orchestrator-command's
# `notify` arm), so this is instruction text over an existing surface rather
# than new surface. Omitting it stays explicitly permitted, because a
# question whose honest answer is a sentence must not be gated on a menu.
if [ "$operation" = orchestrate ]; then
  broker="$ORCHID_ROOT/runners/orchid-orchestrator-command"
  protocol="$(cat "$ORCHID_ROOT/PROTOCOL.md" 2>/dev/null || true)"
  instructions="A deterministic driver has ALREADY executed this tick's mechanical steps against the repository at $worktree (lease, reconcile/check/gc, dispatch, verify, review routing, unambiguous approval, merge, status). You were woken for ONE reason: a judgment boundary deterministic policy refused to resolve. The ONLY command you may run is the brokered command surface $broker, which takes an orchid verb form as its arguments -- no other executable, no bare \`orchid\`, no engine launcher, no git, no shell pipeline. Start by running: $broker run boundary show. Read the named task with $broker task show <id>, its reviews with $broker jobs review-plan <id>, and the recent record with $broker journal tail -n 20. Then record exactly one decision: $broker task arbitrate <id> --result approve|request-changes --reason \"<why>\" when the boundary is an arbitration you can settle, or $broker notify --task <id> [--choice <value>]... \"<what a human must decide>\" when it is not -- declare one --choice per permitted answer whenever the question has an enumerable set (orchid answer then refuses anything outside it and names the valid ones, so the page says what may be answered instead of leaving <choice> to be guessed); omit --choice entirely when the honest answer is prose. Record anything durable you learned with $broker journal add --task <id> --kind arbitration \"<text>\" or $broker lessons add --scope repo --invalidate-when \"<when>\" \"<lesson>\". When you approve despite a finding you judge REAL but out of this task's scope, record that finding before you clear the boundary: $broker journal add --task <id> --kind ledger \"<the finding>\", one finding per entry, because the ledger is what the NEXT run's planning cross-check reads back -- a real defect left open with no ledger entry leaves the next plan nothing to be held to. Do not, however, excuse one: never journal add --kind plan_deferral, since deciding a carried-forward finding may be skipped belongs to the operator's orchid plan defer, and this surface refuses that kind. Finish with $broker run boundary clear --reason \"<what you decided>\" once, and only once, the boundary is genuinely resolved. Never hand-edit anything under .orchid/. Never run 'git push', never fetch/pull, never contact any remote -- every mutation stays repo-local; only the operator moves anything to origin. For every command you run, print one line of the exact form: ORCHID-ACTION: <command>."
  prompt="$protocol"$'\n\n'"$instructions"

  # Streaming + heartbeat (v1-m3, round 2 of the live-run finding -- see
  # lib/heartbeat.sh's header for the full rationale). Round 1's `| tee
  # /dev/stderr` alone proved insufficient against the REAL engine:
  # tests/probes/probe-stream-buffering.sh found claude BUFFERED too (all
  # output arrives in one shot at exit). orchid_run_engine_cli backgrounds
  # claude directly (so it can track its own real pid) and runs a
  # heartbeat alongside it that appends a liveness line to this script's
  # own stderr (-> job log, via orchid-tick's synchronous spawn or the
  # launcher, whichever spawned this adapter) every ORCHID_HB_INTERVAL_S
  # seconds for as long as claude's pid is alive -- log mtime now advances
  # for the WHOLE run regardless of when/whether claude itself flushes.
  stdout=""; rc=0
  orchid_run_engine_cli "$err_file" stdout rc "$worktree" "$prompt" \
    claude -p --permission-mode acceptEdits --allowedTools "Bash($broker:*)"
  stderr="$(cat "$err_file")"

  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$stderr" >&2
    write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
    exit 1
  fi

  # `|| true` (same idiom as the verdict_line grep below, in the review path):
  # under `set -euo pipefail`, a `grep` with zero matches (no ORCHID-ACTION
  # lines this tick -- a legitimate, still-`ok` outcome per this branch's own
  # header comment) exits 1, and pipefail promotes that to the WHOLE
  # pipeline's status even though sed/jq downstream both exit 0 -- without
  # this guard, `set -e` would abort the script right here, before any
  # envelope is ever written, and orchid-tick would misread a healthy CLI
  # exit as a crashed engine. `jq -R -s -c` on empty stdin still yields `[]`
  # after the length>0 filter, so the actions array comes out correctly
  # empty either way.
  actions_json="$(printf '%s\n' "$stdout" | grep '^ORCHID-ACTION: ' | sed 's/^ORCHID-ACTION: //' \
    | jq -R -s -c 'split("\n") | map(select(length > 0))' || true)"
  # Belt-and-braces fallback (v1-m3): if the CLI interleaved its streams
  # such that ORCHID-ACTION lines landed on its own stderr rather than
  # stdout, `$stdout` alone would miss them even though they reached the
  # log via the tee above. `$stderr` (captured to err_file by the `2>`
  # redirect on the CLI invocation itself, unaffected by the stdout-side
  # tee) is already available with no extra plumbing, so a zero-actions
  # primary parse re-greps it before settling on a genuinely empty `[]`.
  if [ "$(printf '%s' "$actions_json" | jq 'length')" -eq 0 ]; then
    actions_json="$(printf '%s\n' "$stderr" | grep '^ORCHID-ACTION: ' | sed 's/^ORCHID-ACTION: //' \
      | jq -R -s -c 'split("\n") | map(select(length > 0))' || true)"
  fi
  last_line="$(printf '%s\n' "$stdout" | awk 'NF{l=$0} END{print l}')"
  summary="${last_line:0:200}"; [ -n "$summary" ] || summary="tick complete"
  write_envelope ok "$(jq -n --argjson a "$actions_json" --arg s "$summary" '{actions:$a, summary:$s}')"
  exit 0
fi

if [ "$operation" = implement ]; then
  prompt=""
  [ -f "$input_pack/context.md" ] && prompt="$(cat "$input_pack/context.md")"$'\n\n'
  prompt="$prompt$(cat "$input_pack/task.md")"$'\n\n'
  # T025: on a rework attempt the pack carries rework.md -- the verbatim
  # output of the run that failed last time, plus whether that failure has
  # repeated unchanged. Placed AFTER the spec and immediately before the
  # rules, so it reads as the most recent fact about this task rather than as
  # background. Absent on a first attempt, which is why this is conditional
  # and not a required pack item.
  [ -f "$input_pack/rework.md" ] && prompt="$prompt$(cat "$input_pack/rework.md")"$'\n\n'
  prompt="${prompt}Rules: work only in this directory; edit files to satisfy the task; never touch any .orchid/ path."

  # v0b2 F2, judgment call: apply the same stdin fix as codex's adapter to
  # remove the leading-dash argv risk (task.md frontmatter starts with
  # "---"). Unlike codex, `claude -p` has no `-`-as-prompt-arg convention;
  # its own --help documents `-p, --print` as "useful for pipes" and it
  # reads the prompt from stdin whenever no positional prompt argument is
  # given, so simply omitting the argv prompt (rather than passing `-`)
  # is the fix here. Verified against the installed `claude --help` text
  # during this fix, not by spending real quota on a live round trip (the
  # probes/ directory's real-CLI tests are manual/operator-run only, see
  # tests/probes/README.md). Lower stakes than the codex fix either way:
  # per docs/dogfood-notes.md, this adapter's implement path can't self-
  # commit under acceptEdits, so claude is already review-only in practice.
  #
  # Streaming + heartbeat (v1-m3, round 2 -- see lib/heartbeat.sh and the
  # orchestrate branch above for the full rationale): real claude was found
  # BUFFERED, so `rc`/`stdout` now come from orchid_run_engine_cli, which
  # backgrounds claude directly (feeding the prompt via a temp file/stdin
  # redirect instead of a `printf | claude` pipe -- a pipe would cost us
  # claude's own real pid, which the heartbeat needs for a truthful `cpu`
  # reading) and runs a liveness heartbeat alongside it.
  orchid_run_engine_cli "$err_file" stdout rc "$worktree" "$prompt" \
    claude -p --permission-mode acceptEdits
  stderr="$(cat "$err_file")"

  if [ "$rc" -eq 0 ]; then
    last_line="$(printf '%s\n' "$stdout" | awk 'NF{l=$0} END{print l}')"
    summary="${last_line:0:200}"; [ -n "$summary" ] || summary="implemented"

    # v0b2 F3: engines edit, the ADAPTER commits. claude headless won't
    # commit at all (probe finding, see docs/dogfood-notes.md), so the
    # adapter -- which runs UNSANDBOXED -- stages and commits the engine's
    # edits itself after the CLI exits.
    set +e
    add_err="$(cd "$worktree" && git add -A 2>&1)"
    add_rc=$?; set -e
    if [ "$add_rc" -ne 0 ]; then
      write_envelope failed "$(jq -n --arg s "git add -A failed: $add_err" '{summary:$s}')"
      exit 1
    fi

    if ! (cd "$worktree" && git diff --cached --quiet); then
      # Engine left staged-worthy edits uncommitted: the adapter makes
      # exactly one commit for them. The SUBJECT is independently
      # sanitized from raw stdout (v1-m4 F11: a live run shipped literal
      # junk here -- "T001: ```" and "T002: - `git diff --check` passes."
      # -- when the reply's own last non-empty line was a bare fence or an
      # unsanitized bullet) via commit_subject_from_output (lib/common.sh,
      # shared with plugins/engines/codex/run's identical shape), which
      # falls back to the task's own title when nothing in the reply
      # survives sanitization.
      subject="$(commit_subject_from_output "$stdout" "$(fm_get "$input_pack/task.md" title)")"
      msg="${task}: ${subject}"
      set +e
      commit_err="$(cd "$worktree" && git commit -q -m "$msg" 2>&1)"
      commit_rc=$?; set -e
      if [ "$commit_rc" -ne 0 ]; then
        write_envelope failed "$(jq -n --arg s "git commit failed: $commit_err" '{summary:$s}')"
        exit 1
      fi
      candidate_sha="$(cd "$worktree" && git rev-parse HEAD)"
      commits_json="$(jq -n --arg s "$candidate_sha" '[$s]')"
    else
      # Nothing new to stage. The engine may ALSO have committed on its own
      # -- accept those commits idempotently instead of double-committing.
      # Only truly empty history is a failure.
      commits_raw="$(cd "$worktree" && git rev-list "${base_sha}..HEAD" 2>/dev/null || true)"
      commits_json="$(printf '%s' "$commits_raw" | jq -R -s -c 'split("\n") | map(select(length > 0))')"
      if [ "$(printf '%s' "$commits_json" | jq 'length')" -eq 0 ]; then
        write_envelope failed '{"summary":"engine produced no changes"}'
        exit 1
      fi
      candidate_sha="$(cd "$worktree" && git rev-parse HEAD)"
    fi

    write_envelope ok "$(jq -n --arg s "$summary" --argjson c "$commits_json" '{summary:$s, commits:$c}')"
    exit 0
  fi
  printf '%s\n' "$stderr" >&2
  write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
  exit 1
fi

# review | critique
manifest_line="$(jq -r '"pack manifest: items=" + ([.items[].name] | join(",")) + " omitted=" + ([.omitted[]] | join(","))' "$input_pack/pack.json")"
if [ -f "$input_pack/task.md" ]; then
  ac="$(fm_get "$input_pack/task.md" acceptance_criteria)"
  stop="$(fm_get "$input_pack/task.md" stop_condition)"
  # THIS task's threshold, read from the pack's own task.md (lib/pack.sh
  # copies the file whole, frontmatter included) -- never a hardcoded
  # default. The shipped archetypes disagree: templates/task.md and
  # templates/task-test.md set `blocking_severity: high`, task-migrate and
  # task-refactor set `medium`. A prompt that says "medium by default" is
  # therefore simply wrong for some archetypes, on the very gate this
  # milestone made live -- it would push a reviewer to spend `medium` on
  # something that will not stop a `high`-threshold task, or to withhold one
  # believing it will. The `[ -n ]` fallback is the SAME default
  # lib/drive.sh's own gate applies when the key is absent, so the prompt and
  # the gate can never state different thresholds.
  bsev="$(fm_get "$input_pack/task.md" blocking_severity)"; [ -n "$bsev" ] || bsev=medium
  # THE ARBITER'S STANDING OBJECTION (T032, dogfood F33), read from the same
  # pack task.md as everything above -- lib/pack.sh copies the file whole, so
  # a field the kernel writes reaches every adapter without a new pack item.
  # Empty on the overwhelming majority of reviews, and the whole block below
  # is omitted then; a task only carries one after an arbiter recorded
  # `request-changes` on it and no arbitration has cleared it.
  objection="$(fm_get "$input_pack/task.md" unresolved_objection)"
  # AND WHO RAISED IT, from the field the arbitration wrote it with. An
  # operator's objection and this run's own orchestrator's are worth different
  # things to a reviewer -- one is a human who read the merged source, the
  # other is a model that read this diff -- and the prompt must not describe
  # either as the other. Defaulted like `bsev` above, and to the same stricter
  # reading the kernel's own gate takes on an absent field.
  objection_by="$(fm_get "$input_pack/task.md" unresolved_objection_by)"
  [ -n "$objection_by" ] || objection_by=operator
  diff="$(cat "$input_pack/diff.patch" 2>/dev/null || true)"
  # Reply contract (v1-m4 T006): VERDICT **plus** the same `FINDING:
  # <low|medium|high>: <title>` line shape the critique prompt below already
  # specifies. The verdict contract itself is unchanged (still the exact
  # last-line-match `verdict_line` grep below reads); the FINDING lines are
  # purely additive, and a reply carrying none is still a well-formed review.
  #
  # Why (dogfood finding): reviews used to be asked for a VERDICT line ONLY,
  # so every review envelope carried `findings: []` verbatim and the
  # reviewer's actual reasoning survived only if it happened to land in prose
  # in the engine log -- which is reaped. One T003 round lost three reported
  # findings that way. findings[] is the only durable, structured place a
  # review's reasoning lives (lib/envelope.sh's review/critique union), and
  # it is what the driver's blocking_severity gate reads (lib/drive.sh).
  #
  # SEVERITY IS A GATE, NOT A LABEL -- and the prompt has to say so. Populated
  # findings[] make that gate live: ONE finding at or above this task's own
  # `blocking_severity` (read above, never assumed) on an otherwise-approving
  # review is a `review-conflict` boundary that HALTS the run. Reviewers
  # habitually approve-with-nits, and "one line per issue found" alone invites
  # exactly that -- a severity spent on a nit stops a run that nobody meant to
  # stop. So the three severities are defined in the prompt in terms of what
  # each one DOES, phrased against the threshold rather than assuming it, and
  # `low` is named as the home for anything worth mentioning but not worth
  # blocking on. The parser and the envelope schema are unchanged; this only
  # tells the model what it is choosing.
  #
  # AND A REPLY THAT WITHHOLDS APPROVAL IS ASKED FOR PROSE TOO (T033, dogfood
  # F32). This adapter wrote no `summary` at all until now, which was harmless
  # while findings[] carried everything -- but a `request-changes` reply whose
  # FINDING lines all get dropped by the best-effort scrape below (or that
  # files none) leaves an envelope with an empty findings[] AND no prose, and
  # `orchid jobs reconcile`'s synthesis then has nothing to lift into the
  # severity gate but a placeholder. `REASON:` is the same optional line
  # plugins/engines/codex/run and plugins/engines/agy/run already carry into
  # `summary`, captured by the same idiom at the foot of this file, so the one
  # field every gate reads is never populated from nothing. The prompt names
  # the consequence rather than the mechanism: a reviewer who wants the
  # severity to stay its own call reports the finding itself.
  prompt="Acceptance criteria: $ac
Stop condition: $stop
$manifest_line

Diff:
$diff

Reply with:
VERDICT: approve OR request-changes
One line per issue found, exactly: FINDING: <low|medium|high>: <title>
(omit FINDING lines entirely when there are none).
REASON: one sentence

Severity decides what happens next, so pick it for consequence, not for
emphasis. This task's blocking_severity is $bsev: a finding at or above $bsev
STOPS the run for human arbitration even when your verdict is approve.
- high: must not ship as written — correctness, safety, or data loss.
- medium: a real defect or a missed acceptance criterion — worth halting the
  run over wherever the threshold above reaches it.
- low: worth telling the author, never worth stopping for — style, naming,
  wording, optional cleanups. Use low for anything you would call a nit.

A request-changes verdict carries at least one FINDING line. Severity gates
read findings[] and nothing else, so an objection written only as prose is
weighed by nothing: if you withhold approval without one, the kernel composes
a high-severity finding from your REASON line on your behalf. Reporting the
finding yourself is how the severity stays your call."
  # WHY THE REVIEWER IS TOLD (T032, dogfood F33). On the run this comes from,
  # a reviewer that had itself said `request-changes` twice returned `approve`
  # on the third round with the objected-to defect untouched -- which is what a
  # reviewer handed the same diff and no memory will do. The arbitration is the
  # one thing it could not re-derive from the pack, so it is handed over
  # explicitly, and the question is narrowed to it: "was this addressed", not
  # "form an opinion". Appended LAST, after the reply contract, deliberately --
  # it is the first thing this round must answer, and it must not read as one
  # more consideration buried above the instructions.
  [ -z "$objection" ] || prompt="$prompt

AN ARBITER REJECTED AN EARLIER ROUND OF THIS TASK and that objection is still
recorded as unresolved. It was raised by: $objection_by (operator = the human
running this repository; orchestrator = this run's own arbiter). The objection:
  $objection
Judge this round on whether that objection was addressed, before anything
else, and say which in your REASON line. If it was not addressed, withhold
approval and file it as a FINDING -- do not re-form an opinion from scratch
and do not approve around it because the rest of the diff looks right. A
reviewer approving here with that defect untouched is the exact failure this
paragraph exists to stop."
else
  # v1-m3: a PLAN pack (task id `plan`, role.plan_critic) has no task.md/
  # diff.patch at all -- lib/pack.sh's _pack_build_plan builds
  # requirements.md + the draft roadmap.md (non-truncatable) plus tasks.md
  # (every current tasks/*.md concatenated) and lessons.md when present.
  # Judge the DRAFT PLAN, not a diff -- and the reply contract gains a
  # third line shape (`FINDING:`) alongside VERDICT, since a plan critique's
  # whole point is surfacing findings[] the operator folds back into the
  # draft (see lib/envelope.sh's review/critique union + PROTOCOL PLANNING
  # step 2), not a single approve/request-changes verdict alone.
  reqs="$(cat "$input_pack/requirements.md" 2>/dev/null || true)"
  roadmap_body="$(cat "$input_pack/roadmap.md" 2>/dev/null || true)"
  tasks_body="$(cat "$input_pack/tasks.md" 2>/dev/null || true)"
  lessons_body=""
  [ -f "$input_pack/lessons.md" ] && lessons_body="$(cat "$input_pack/lessons.md")"
  prompt="Requirements:
$reqs

Draft roadmap:
$roadmap_body

Tasks:
$tasks_body"
  [ -n "$lessons_body" ] && prompt="$prompt

Lessons:
$lessons_body"
  prompt="$prompt

$manifest_line

Critique this draft plan against the requirements: is every requirement
covered, are tasks correctly scoped and sequenced, are acceptance criteria
and verification commands concrete? Reply with:
VERDICT: approve OR request-changes
One line per issue found, exactly: FINDING: <low|medium|high>: <title>
(omit FINDING lines entirely when there are none)."
fi

# Same F2 stdin fix as the implement path above (line ~65).
#
# Streaming + heartbeat (v1-m3; round 1 was `| tee /dev/stderr`; that
# idiom is still what happens internally (see lib/heartbeat.sh), but
# round 2's real-CLI probe (tests/probes/probe-stream-buffering.sh) found
# claude BUFFERED -- tee-ing a stream that never arrives until process
# exit doesn't make it arrive sooner, so the job log still sat at zero
# bytes for a real run's whole duration and `jobs check`'s log-mtime stall
# detector could still falsely kill it). orchid_run_engine_cli
# (lib/heartbeat.sh) is the definitive fix: it backgrounds claude directly
# -- prompt fed via a temp file/stdin redirect rather than a `printf |
# claude` pipe, since a pipe would cost us claude's own real pid -- and
# runs a background heartbeat alongside it that appends one `[hb ...]
# engine pid <pid> cpu <ps time>` line to this script's own stderr (-> job
# log, via the launcher's `>> "$log" 2>&1`) every ORCHID_HB_INTERVAL_S
# seconds for as long as claude's real pid stays alive -- proving the
# ENGINE IS ALIVE instead of trying (and, per the probe, failing) to prove
# it's still producing output. `stdout`/`rc` come back exactly as
# `stdout="$(cmd 2>err | tee /dev/stderr)"`/`$?` used to; claude's own
# stderr is still fully redirected to err_file, unaffected by any of this.
# See lib/heartbeat.sh's header comment for the full design and the
# accepted trade-off (a hung-but-alive engine now runs to the request's
# own deadline_s rather than being stall-killed early).
orchid_run_engine_cli "$err_file" stdout rc "$worktree" "$prompt" claude -p
stderr="$(cat "$err_file")"

if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$stderr" >&2
  write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
  exit 1
fi

# Exact-match only: the last line that IS (not merely contains) a verdict
# line, so a reply that only echoes back the reply-contract instruction
# ("VERDICT: approve OR request-changes") never satisfies this — it must
# fall through to malformed rather than being read as an approval.
verdict_line="$(printf '%s\n' "$stdout" | grep -iE '^VERDICT:[[:space:]]*(approve|request-changes)[[:space:]]*$' | tail -n1 || true)"
verdict=""
# Herestrings, same rule as classify above (T016's sweep of the class T010
# named). $verdict_line is one line, so the race is remote here — but the
# shape is the thing that gets copied into the next adapter, where the
# producer is not one line, and tests/inv/test_INV-15_no_optional_gate.sh
# holds the whole shipped tree to the shape rather than to a risk estimate.
if grep -qiE '^VERDICT:[[:space:]]*approve[[:space:]]*$' <<<"$verdict_line"; then verdict=approve
elif grep -qiE '^VERDICT:[[:space:]]*request-changes[[:space:]]*$' <<<"$verdict_line"; then verdict=request-changes
fi
if [ -z "$verdict" ]; then
  write_envelope malformed '{}'
  exit 1
fi

any_trunc="$(jq '[.items[]?.truncated // false] | any' "$input_pack/pack.json")"
scope_complete=true; [ "$any_trunc" = "true" ] && scope_complete=false

# findings[] (v1-m3; extended to `review` in v1-m4 T006): BOTH operations
# that reach this point -- `review` and `critique` -- are asked for `FINDING:`
# lines by their own prompt above, so both parse them here. Each matched line
# is `FINDING: <low|medium|high>: <title>`; cut -f2- (not a second split on
# ":") so a title containing its own colon is kept intact. A line whose
# severity token doesn't match exactly one of the three, or whose title is
# empty, is silently dropped rather than failing the whole reply -- this is a
# best-effort scrape of free text, not a strict parser (which is also why a
# reply that merely echoes the instruction line back, severity token
# `<low|medium|high>` and all, contributes nothing).
#
# An empty result stays the literal `[]` and is NOT an error: a reviewer that
# genuinely found nothing to report is a valid, still-`ok` review, and on an
# APPROVING one the driver's blocking_severity gate (lib/drive.sh) reads an
# empty findings[] as "nothing blocking", exactly as it always has. On a reply
# that WITHHOLDS approval the array does not stay empty for long (T033): what
# this adapter writes is unchanged, but `orchid jobs reconcile` composes one
# `high` finding from the envelope's `summary` as it files it, since an
# objection no gate can weigh is the defect dogfood F32 named. That is the
# reason the REASON line below is captured at all.
findings_json='[]'
findings_ndjson=""
while IFS= read -r rest; do
  [ -n "$rest" ] || continue
  sev="$(printf '%s' "$rest" | cut -d: -f1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
  title="$(printf '%s' "$rest" | cut -d: -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  case "$sev" in low|medium|high) ;; *) continue ;; esac
  [ -n "$title" ] || continue
  findings_ndjson="$findings_ndjson$(jq -n --arg s "$sev" --arg t "$title" '{severity:$s, title:$t}')"$'\n'
done < <(printf '%s\n' "$stdout" | grep '^FINDING:' | sed 's/^FINDING:[[:space:]]*//')
[ -z "$findings_ndjson" ] || findings_json="$(printf '%s' "$findings_ndjson" | jq -s -c '.')"

# Optional REASON line (last one wins, the same idiom the VERDICT grep above
# uses) carried into the envelope's `summary` -- character for character
# plugins/engines/codex/run's and plugins/engines/agy/run's, including the
# 200-character cut, so the three shipped reviewers put their prose in one
# place. ABSENT rather than a placeholder when the reply has no REASON line:
# lib/envelope.sh's review/critique union never requires `summary`, every
# reply written before this contract existed stays valid, and inventing text
# here would hand reconcile's synthesis a sentence no reviewer wrote.
reason_line="$(printf '%s\n' "$stdout" | grep '^REASON:' | tail -n1 || true)"
reason="$(printf '%s' "$reason_line" | sed 's/^REASON:[[:space:]]*//')"
reason="${reason:0:200}"
if [ -n "$reason" ]; then
  write_envelope ok "$(jq -n --arg v "$verdict" --argjson sc "$scope_complete" --argjson f "$findings_json" --arg s "$reason" '{verdict:$v, scope_complete:$sc, findings:$f, summary:$s}')"
else
  write_envelope ok "$(jq -n --arg v "$verdict" --argjson sc "$scope_complete" --argjson f "$findings_json" '{verdict:$v, scope_complete:$sc, findings:$f}')"
fi
exit 0

#!/usr/bin/env bash
set -euo pipefail
# tier-3 engine adapter: `run <request.json>`. Invoked ONLY by runners/orchid-launch
# (INV-06) — never directly. Writes ONLY to the request's `output` path (plus its
# own stdout/stderr, captured into the launcher's log) — no other durable state.
# See docs/specs/plugins.md (request document / result envelope contracts).
self="$0"
while [ -L "$self" ]; do
  t="$(readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(dirname "$self")/../../.." && pwd)"
source "$ORCHID_ROOT/lib/common.sh"
source "$ORCHID_ROOT/lib/frontmatter.sh"

req="${1:?usage: run <request.json>}"
job_id="$(jq -r .job_id "$req")";         task="$(jq -r .task "$req")"
operation="$(jq -r .operation "$req")";   worktree="$(jq -r .worktree "$req")"
input_pack="$(jq -r .input_pack "$req")"; output="$(jq -r .output "$req")"
# `// ""` (rather than a bare `.base_sha`): the `orchestrate` request
# document (runners/orchid-tick) carries neither field -- a missing key
# would otherwise stringify to the literal text "null" here.
base_sha="$(jq -r '.base_sha // ""' "$req")"; candidate_sha="$(jq -r '.candidate_sha // ""' "$req")"

# Engine id is overridable so a reduced-capability wrapper (e.g. codex-review)
# can stamp its OWN id in envelopes instead of borrowing this shared adapter's
# default -- see plugins/engines/codex-review/run. Unset = back-compat: plain
# codex/run is unaffected.
ENGINE_ID="${ORCHID_ENGINE_ID:-orchid/codex}"

write_envelope() {  # status extra-json
  local extra="${2:-}"; [ -n "$extra" ] || extra='{}'
  jq -n --arg job_id "$job_id" --arg task "$task" --arg operation "$operation" \
        --arg status "$1" --arg base_sha "$base_sha" --arg candidate_sha "$candidate_sha" \
        --arg engine "$ENGINE_ID" \
        --argjson extra "$extra" \
        '{contract:1, job_id:$job_id, task:$task, operation:$operation, status:$status,
          engine:$engine, base_sha:$base_sha, candidate_sha:$candidate_sha} + $extra' \
    | atomic_write "$output"
}
classify() {  # combined stdout+stderr text -> rate_limited|auth|failed
  if printf '%s' "$1" | grep -qiE 'rate limit|usage limit|429'; then echo rate_limited
  elif printf '%s' "$1" | grep -qiE 'login|auth|unauthorized'; then echo auth
  else echo failed
  fi
}

# Allowed-ops gate precedes the operation gate AND DRYRUN: a wrapper adapter
# (e.g. codex-review) can restrict which operations it permits via
# ORCHID_ALLOWED_OPS (comma list) so it fails closed on anything outside its
# manifest's declared capabilities -- e.g. codex-review has no
# workspace_write, so it must refuse `implement` even though the shared
# codex/run underneath supports it. Unset = permit all (back-compat: plain
# codex/run is unaffected). Mirrors the agy operation-gate-before-dryrun
# ordering below.
if [ -n "${ORCHID_ALLOWED_OPS:-}" ]; then
  _allowed_ops=",${ORCHID_ALLOWED_OPS},"
  case "$_allowed_ops" in
    *",$operation,"*) ;;
    *)
      echo "$ENGINE_ID: operation '$operation' not permitted for $ENGINE_ID" >&2
      write_envelope failed "$(jq -n --arg s "operation $operation not permitted for $ENGINE_ID" '{summary:$s}')"
      exit 1 ;;
  esac
fi

# Operation gate precedes DRYRUN: an unsupported operation fails the same way
# whether or not ORCHID_DRYRUN is set (no dryrun short-circuit for unknowns) —
# mirrors agy/claude and removes the last producer of ok-without-operation-
# payload envelopes (lib/envelope.sh no longer accepts those regardless).
case "$operation" in implement|review|critique|orchestrate) ;;
  *)
    echo "orchid/codex: unsupported operation '$operation'" >&2
    write_envelope failed '{}'
    exit 1 ;;
esac

if [ "${ORCHID_DRYRUN:-0}" = "1" ]; then
  case "$operation" in
    implement)       write_envelope ok '{"summary":"dryrun"}' ;;
    review|critique) write_envelope ok '{"verdict":"approve","scope_complete":true,"findings":[]}' ;;
    orchestrate)     write_envelope ok '{"actions":[],"summary":"dryrun"}' ;;
  esac
  exit 0
fi

err_file="$(mktemp)"; trap 'rm -f "$err_file"' EXIT

# orchestrate: runners/orchid-tick's headless-tick operation. Same prompt
# shape as plugins/engines/claude/run's orchestrate branch (PROTOCOL.md's
# full text + a fixed instruction block naming this process's own resolved
# $worktree/$ORCHID_ROOT paths); see that adapter's comment for the full
# rationale. codex's own conventions, unlike claude's: prompt piped via
# stdin with `-` as the trailing prompt arg (task.md-shaped leading-dash
# text would otherwise be read as a flag by codex's clap parser -- same F2
# fix as the implement path above) and `--skip-git-repo-check` (an
# orchestrate tick's worktree is the operator's own checkout, not a fresh
# clone codex would otherwise refuse as untrusted).
if [ "$operation" = orchestrate ]; then
  protocol="$(cat "$ORCHID_ROOT/PROTOCOL.md" 2>/dev/null || true)"
  instructions="Execute ONE tick of the tick procedure described above against the repository at $worktree. Use only \`orchid\` verbs (the binary at $ORCHID_ROOT/bin/orchid) and $ORCHID_ROOT/runners/orchid-launch to launch engines -- never hand-edit anything under .orchid/. For every verb invocation you make, print one line of the exact form: ORCHID-ACTION: <command>"
  prompt="$protocol"$'\n\n'"$instructions"

  set +e
  stdout="$(cd "$worktree" && printf '%s' "$prompt" | codex exec --sandbox workspace-write -c approval_policy='"never"' --skip-git-repo-check - 2>"$err_file")"
  rc=$?; set -e
  stderr="$(cat "$err_file")"

  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$stderr" >&2
    write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
    exit 1
  fi

  # `|| true` (same idiom as the verdict_line grep below, in the review path):
  # under `set -euo pipefail`, a `grep` with zero matches (no ORCHID-ACTION
  # lines this tick -- a legitimate, still-`ok` outcome per this branch's own
  # header comment) exits 1, and pipefail promotes that to the WHOLE
  # pipeline's status even though sed/jq downstream both exit 0 -- without
  # this guard, `set -e` would abort the script right here, before any
  # envelope is ever written, and orchid-tick would misread a healthy CLI
  # exit as a crashed engine. `jq -R -s -c` on empty stdin still yields `[]`
  # after the length>0 filter, so the actions array comes out correctly
  # empty either way.
  actions_json="$(printf '%s\n' "$stdout" | grep '^ORCHID-ACTION: ' | sed 's/^ORCHID-ACTION: //' \
    | jq -R -s -c 'split("\n") | map(select(length > 0))' || true)"
  last_line="$(printf '%s\n' "$stdout" | awk 'NF{l=$0} END{print l}')"
  summary="${last_line:0:200}"; [ -n "$summary" ] || summary="tick complete"
  write_envelope ok "$(jq -n --argjson a "$actions_json" --arg s "$summary" '{actions:$a, summary:$s}')"
  exit 0
fi

if [ "$operation" = implement ]; then
  prompt=""
  [ -f "$input_pack/context.md" ] && prompt="$(cat "$input_pack/context.md")"$'\n\n'
  prompt="$prompt$(cat "$input_pack/task.md")"$'\n\n'
  prompt="${prompt}Rules: work only in this directory; edit files to satisfy the task; never touch any .orchid/ path."

  # v0b2 F2: prompt piped via stdin with `-` as the prompt arg, not a bare
  # argv string -- codex's clap parser reads a leading "-"/"--" argv prompt
  # (task.md frontmatter starts with "---") as a flag, and separately
  # refuses an untrusted worktree without --skip-git-repo-check. `codex` is
  # the last element of the pipe, so under this script's own `set -o
  # pipefail` (line 2) `rc` below is codex's own exit status, never printf's.
  set +e
  stdout="$(cd "$worktree" && printf '%s' "$prompt" | codex exec --sandbox workspace-write -c approval_policy='"never"' --skip-git-repo-check - 2>"$err_file")"
  rc=$?; set -e
  stderr="$(cat "$err_file")"

  if [ "$rc" -eq 0 ]; then
    last_line="$(printf '%s\n' "$stdout" | awk 'NF{l=$0} END{print l}')"
    summary="${last_line:0:200}"; [ -n "$summary" ] || summary="implemented"

    # v0b2 F3: engines edit, the ADAPTER commits. The adapter runs
    # UNSANDBOXED (unlike codex under --sandbox workspace-write, which can't
    # write a linked worktree's git index/lock — see docs/dogfood-notes.md),
    # so it stages and commits the engine's edits itself after the CLI exits.
    set +e
    add_err="$(cd "$worktree" && git add -A 2>&1)"
    add_rc=$?; set -e
    if [ "$add_rc" -ne 0 ]; then
      write_envelope failed "$(jq -n --arg s "git add -A failed: $add_err" '{summary:$s}')"
      exit 1
    fi

    if ! (cd "$worktree" && git diff --cached --quiet); then
      # Engine left staged-worthy edits uncommitted: the adapter makes
      # exactly one commit for them.
      msg="${task}: ${summary:0:60}"
      set +e
      commit_err="$(cd "$worktree" && git commit -q -m "$msg" 2>&1)"
      commit_rc=$?; set -e
      if [ "$commit_rc" -ne 0 ]; then
        write_envelope failed "$(jq -n --arg s "git commit failed: $commit_err" '{summary:$s}')"
        exit 1
      fi
      candidate_sha="$(cd "$worktree" && git rev-parse HEAD)"
      commits_json="$(jq -n --arg s "$candidate_sha" '[$s]')"
    else
      # Nothing new to stage. The engine may ALSO have committed on its own
      # (e.g. a full-access codex run) -- accept those commits idempotently
      # instead of double-committing. Only truly empty history is a failure.
      commits_raw="$(cd "$worktree" && git rev-list "${base_sha}..HEAD" 2>/dev/null || true)"
      commits_json="$(printf '%s' "$commits_raw" | jq -R -s -c 'split("\n") | map(select(length > 0))')"
      if [ "$(printf '%s' "$commits_json" | jq 'length')" -eq 0 ]; then
        write_envelope failed '{"summary":"engine produced no changes"}'
        exit 1
      fi
      candidate_sha="$(cd "$worktree" && git rev-parse HEAD)"
    fi

    write_envelope ok "$(jq -n --arg s "$summary" --argjson c "$commits_json" '{summary:$s, commits:$c}')"
    exit 0
  fi
  printf '%s\n' "$stderr" >&2
  write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
  exit 1
fi

# review | critique
ac="$(fm_get "$input_pack/task.md" acceptance_criteria)"
stop="$(fm_get "$input_pack/task.md" stop_condition)"
manifest_line="$(jq -r '"pack manifest: items=" + ([.items[].name] | join(",")) + " omitted=" + ([.omitted[]] | join(","))' "$input_pack/pack.json")"
diff="$(cat "$input_pack/diff.patch" 2>/dev/null || true)"
prompt="Acceptance criteria: $ac
Stop condition: $stop
$manifest_line

Diff:
$diff

End your reply with exactly: VERDICT: approve OR request-changes"

# Same F2 stdin fix as the implement path above (line ~66).
set +e
stdout="$(cd "$worktree" && printf '%s' "$prompt" | codex exec --sandbox read-only --skip-git-repo-check - 2>"$err_file")"
rc=$?; set -e
stderr="$(cat "$err_file")"

if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$stderr" >&2
  write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
  exit 1
fi

# Exact-match only: the last line that IS (not merely contains) a verdict
# line, so a reply that only echoes back the reply-contract instruction
# ("VERDICT: approve OR request-changes") never satisfies this — it must
# fall through to malformed rather than being read as an approval.
verdict_line="$(printf '%s\n' "$stdout" | grep -iE '^VERDICT:[[:space:]]*(approve|request-changes)[[:space:]]*$' | tail -n1 || true)"
verdict=""
if printf '%s' "$verdict_line" | grep -qiE '^VERDICT:[[:space:]]*approve[[:space:]]*$'; then verdict=approve
elif printf '%s' "$verdict_line" | grep -qiE '^VERDICT:[[:space:]]*request-changes[[:space:]]*$'; then verdict=request-changes
fi
if [ -z "$verdict" ]; then
  write_envelope malformed '{}'
  exit 1
fi

any_trunc="$(jq '[.items[]?.truncated // false] | any' "$input_pack/pack.json")"
scope_complete=true; [ "$any_trunc" = "true" ] && scope_complete=false
write_envelope ok "$(jq -n --arg v "$verdict" --argjson sc "$scope_complete" '{verdict:$v, scope_complete:$sc, findings:[]}')"
exit 0

#!/usr/bin/env bash
set -euo pipefail
# tier-3 engine adapter: `run <request.json>`. Invoked ONLY by runners/orchid-launch
# (INV-06) — never directly. Writes ONLY to the request's `output` path (plus its
# own stdout/stderr, captured into the launcher's log) — no other durable state.
# Inline reviewer only (review|critique): the pack travels IN the prompt, agy never
# touches the worktree. See docs/specs/plugins.md (request/envelope contracts).
self="$0"
while [ -L "$self" ]; do
  t="$(readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(dirname "$self")/../../.." && pwd)"
source "$ORCHID_ROOT/lib/common.sh"
source "$ORCHID_ROOT/lib/frontmatter.sh"
source "$ORCHID_ROOT/lib/heartbeat.sh"

req="${1:?usage: run <request.json>}"
job_id="$(jq -r .job_id "$req")";         task="$(jq -r .task "$req")"
operation="$(jq -r .operation "$req")";   worktree="$(jq -r .worktree "$req")"
input_pack="$(jq -r .input_pack "$req")"; output="$(jq -r .output "$req")"
base_sha="$(jq -r .base_sha "$req")";     candidate_sha="$(jq -r .candidate_sha "$req")"

write_envelope() {  # status extra-json
  local extra="${2:-}"; [ -n "$extra" ] || extra='{}'
  jq -n --arg job_id "$job_id" --arg task "$task" --arg operation "$operation" \
        --arg status "$1" --arg base_sha "$base_sha" --arg candidate_sha "$candidate_sha" \
        --argjson extra "$extra" \
        '{contract:1, job_id:$job_id, task:$task, operation:$operation, status:$status,
          engine:"orchid/agy", base_sha:$base_sha, candidate_sha:$candidate_sha} + $extra' \
    | atomic_write "$output"
}
# A CAPABILITY REFUSAL, not a fault (v1-m5 T008). Every `write_envelope failed
# "$REFUSAL"` below is this adapter declining work it never claimed it could
# do -- an operation outside review|critique, a plan pack it has no prompt
# shape for, a diff over its own inline byte cap. The envelope status stays
# `failed` (nothing downstream changes: the review is still not evidence and
# the slot still gets relaunched), but `failure_kind:"capability"` tells
# `lib/ledger.sh` not to charge agy a consecutive failure for behaving
# correctly. Live on r-002, three refusals of diffs ~1% over the cap marked
# this engine `failing` and cost the whole run a reviewer. Faults -- a nonzero
# rc from the CLI, an unparseable reply -- deliberately do NOT carry it.
REFUSAL='{"failure_kind":"capability"}'

classify() {  # combined stdout+stderr text -> rate_limited|auth|failed
  if printf '%s' "$1" | grep -qiE 'rate limit|usage limit|429'; then echo rate_limited
  elif printf '%s' "$1" | grep -qiE 'login|auth|unauthorized'; then echo auth
  else echo failed
  fi
}

case "$operation" in
  review|critique) ;;
  *)
    echo "orchid/agy: unsupported operation '$operation' (review|critique only)" >&2
    write_envelope failed "$REFUSAL"
    exit 1 ;;
esac

if [ "${ORCHID_DRYRUN:-0}" = "1" ]; then
  write_envelope ok '{"verdict":"approve","scope_complete":true}'
  exit 0
fi

# v1-m3: a PLAN pack (task id `plan`, role.plan_critic) has no task.md/
# diff.patch at all -- lib/pack.sh's _pack_build_plan builds requirements.md
# + roadmap.md + tasks.md instead (see plugins/engines/codex/run and
# plugins/engines/claude/run's own plan-pack branches). agy is an INLINE,
# diff-only reviewer (its whole design is "judge from the diff text alone,
# no tools, no worktree") and has no equivalent plan-critique prompt --
# without this guard, the `fm_get "$input_pack/task.md" ...` below would
# awk-error on a nonexistent file and the adapter would exit having written
# NO envelope at all (an F6-class silent failure: reconcile would never see
# this job, so it would just sit `prepared`/`running` forever instead of
# failing loudly). Fail closed with a real envelope instead.
if [ ! -f "$input_pack/task.md" ] || [ ! -f "$input_pack/diff.patch" ]; then
  echo "orchid/agy: agy has no plan-critique mode -- bind an engine with a plan-critique prompt (codex/claude)" >&2
  write_envelope failed "$REFUSAL"
  exit 1
fi

diff_file="$input_pack/diff.patch"
diff_bytes="$(wc -c <"$diff_file" 2>/dev/null | tr -d ' ')"; diff_bytes="${diff_bytes:-0}"
max_bytes="$(config_get "$worktree" agy_max_bytes 100000)"
if [ "$diff_bytes" -gt "$max_bytes" ]; then
  echo "orchid/agy: diff.patch is $diff_bytes bytes (> agy_max_bytes=$max_bytes); route to a worktree-capable reviewer" >&2
  write_envelope failed "$REFUSAL"
  exit 1
fi

ac="$(fm_get "$input_pack/task.md" acceptance_criteria)"
stop="$(fm_get "$input_pack/task.md" stop_condition)"
manifest_line="$(jq -r '"pack manifest: " +
  ([.items[] | .name + "(" + (.bytes|tostring) + "b,truncated:" + (.truncated|tostring) + ")"] | join(" "))' \
  "$input_pack/pack.json")"
diff="$(cat "$diff_file" 2>/dev/null || true)"
prompt="Acceptance criteria: $ac
Stop condition: $stop
$manifest_line

Diff:
$diff

Do not use any tools. Do not run any commands. Judge from the diff text alone.
Reply with exactly two lines:
VERDICT: approve OR request-changes
REASON: one sentence"

err_file="$(mktemp)"; trap 'rm -f "$err_file"' EXIT

# Streaming + heartbeat (v1-m3; round 1 was `| tee /dev/stderr`; that
# idiom is still what happens internally (see lib/heartbeat.sh), but
# round 2's real-CLI probe (tests/probes/probe-stream-buffering.sh,
# codex/claude only -- agy wasn't part of that probe, but the same
# buffering risk applies to any CLI) showed tee-ing a stream that never
# arrives until process exit doesn't make it arrive sooner: the job log
# would still sit at zero bytes for a real run's whole duration and `jobs
# check`'s log-mtime stall detector could still falsely kill it).
# orchid_run_engine_cli (lib/heartbeat.sh) is the definitive fix: it
# backgrounds agy directly (agy takes its prompt as an argv, not stdin --
# passed straight through in "$@" below, so no temp-file/stdin plumbing is
# needed the way codex/claude require) and runs a background heartbeat
# alongside it that appends one `[hb ...] engine pid <pid> cpu <ps time>`
# line to this script's own stderr (-> job log, via the launcher's `>>
# "$log" 2>&1`) every ORCHID_HB_INTERVAL_S seconds for as long as agy's
# real pid stays alive -- proving the ENGINE IS ALIVE instead of relying on
# it to flush output. `stdout`/`rc` come back exactly as `stdout="$(cmd
# 2>err | tee /dev/stderr)"`/`$?` used to; agy's own stderr is still fully
# redirected to err_file, unaffected by any of this. See
# lib/heartbeat.sh's header comment for the full design and the accepted
# trade-off (a hung-but-alive engine now runs to the request's own
# deadline_s rather than being stall-killed early).
stdout=""; rc=0
orchid_run_engine_cli "$err_file" stdout rc "-" "-" agy -p "$prompt"
stderr="$(cat "$err_file")"

if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$stderr" >&2
  write_envelope "$(classify "$stdout"$'\n'"$stderr")" '{}'
  exit 1
fi

# Exact-match only: the last line that IS (not merely contains) a verdict
# line, so a reply that only echoes back the reply-contract instruction
# ("VERDICT: approve OR request-changes") never satisfies this — it must
# fall through to malformed rather than being read as an approval.
verdict_line="$(printf '%s\n' "$stdout" | grep -iE '^VERDICT:[[:space:]]*(approve|request-changes)[[:space:]]*$' | tail -n1 || true)"
verdict=""
if printf '%s' "$verdict_line" | grep -qiE '^VERDICT:[[:space:]]*approve[[:space:]]*$'; then verdict=approve
elif printf '%s' "$verdict_line" | grep -qiE '^VERDICT:[[:space:]]*request-changes[[:space:]]*$'; then verdict=request-changes
fi
if [ -z "$verdict" ]; then
  # No output ever reaches the launcher's job log otherwise: `stdout` here is
  # a local variable, not a stream, so a tool-denial-empty reply (dogfood
  # F6 -- headless print-mode auto-denies a tool call, agy exits 0 with
  # nothing on stdout) would leave NO trace anywhere that the reply was
  # empty/unparseable. Diagnose on stderr, which the launcher DOES capture.
  echo "orchid/agy: malformed reply (no VERDICT line); raw output follows:" >&2
  printf '%s\n' "$stdout" >&2
  write_envelope malformed '{}'
  exit 1
fi

any_trunc="$(jq '[.items[]?.truncated // false] | any' "$input_pack/pack.json")"
scope_complete=true; [ "$any_trunc" = "true" ] && scope_complete=false

# Optional REASON line (last one wins, same idiom as the VERDICT line above)
# carried into the envelope's `summary` -- mirrors codex/run's summary
# idiom, but stays absent rather than falling back to placeholder text when
# the reply has no REASON line at all.
reason_line="$(printf '%s\n' "$stdout" | grep '^REASON:' | tail -n1 || true)"
reason="$(printf '%s' "$reason_line" | sed 's/^REASON:[[:space:]]*//')"
reason="${reason:0:200}"
if [ -n "$reason" ]; then
  write_envelope ok "$(jq -n --arg v "$verdict" --argjson sc "$scope_complete" --arg s "$reason" '{verdict:$v, scope_complete:$sc, summary:$s}')"
else
  write_envelope ok "$(jq -n --arg v "$verdict" --argjson sc "$scope_complete" '{verdict:$v, scope_complete:$sc}')"
fi
exit 0

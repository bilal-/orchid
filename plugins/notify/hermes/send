#!/usr/bin/env bash
set -euo pipefail
# kind=notify entrypoint. Contract (docs/specs/plugins.md, "notify channel"
# row): `send <question-id> <text>`, plus the OPTIONAL read-only
# `--inbound-probe` mode this plugin declares in its manifest (see that
# branch's own header below). No repo access, no stdin, no exit-code
# guessing -- this script's own exit code IS the send outcome the pump acts
# on (0 -> outbox file removed; nonzero -> left for retry, see runners/
# orchid-pump's outbox drain). Launched ONLY by runners/orchid-pump (tier-2,
# via the launcher-hygiene env: env -i + lib/spawn.sh's spawn_child_env),
# never directly by any tier-1 verb -- `orchid notify` itself only ever
# WRITES `runtime/outbox/<qid>` (INV-01: tier-1 never spawns).
#
# Config reaches this script as two ORCHID_*-prefixed env vars (base-
# allowlisted by spawn_child_env's env hygiene -- see runners/orchid-pump's
# outbox-drain header for how they get exported before the spawn):
#   ORCHID_NOTIFY_CHANNEL  <- notify.channel config (a hermes platform:
#                             telegram|discord|slack|signal|... -- whatever
#                             `hermes send --list` shows configured)
#   ORCHID_NOTIFY_TO       <- notify.to config (OPTIONAL for this plugin --
#                             see below; unlike openclaw's send, an empty
#                             value is not an error)
#
# Verified invocation shape (flag/format research, HELP TEXT ONLY -- no real
# `hermes send` was ever executed by this task; `hermes send --list` was run
# to confirm it is a read-only diagnostic, per its own --help description,
# not a send):
#   Hermes Agent v0.19.0 (2026.7.20), `hermes send --help`. The task brief's
#   own verified shape matches the installed CLI exactly:
#     usage: hermes send [-h] [-t TARGET] [-f PATH] [-s LINE] [-l] [-q]
#                        [--json] [message]
#     -t, --to TARGET   Delivery target. Format: 'platform' (home channel),
#                       'platform:chat_id', 'platform:chat_id:thread_id', or
#                       'platform:#channel-name'. Examples: telegram,
#                       telegram:-1001234567890:17585, discord:#ops,
#                       slack:C0123ABCD, signal:+15551234567.
#     message           Positional. Message text (stdin/--file also exist,
#                       neither used here -- see below).
#   Exit codes (from `hermes send --help`): 0 ok, 1 delivery/backend error,
#   2 usage error -- both nonzero, so this adapter's `exec` passes either
#   straight through unchanged, exactly the "nonzero -> retry" contract the
#   pump needs; no exit-code translation happens or is needed here.
#   So the real call is:
#     hermes send --to <target> "<text>"
#   No LLM/agent loop and no running gateway is required for bot-token
#   platforms (Telegram/Discord/Slack/Signal) per `hermes send --help`'s own
#   description -- reuses the gateway's platform credentials
#   (~/.hermes/.env + ~/.hermes/config.yaml) directly.
#
# Target composition (this plugin's own mapping, not a hermes flag): hermes,
# unlike openclaw, has a "home channel" default -- passing the bare platform
# name with no chat id is a legitimate target (whatever
# `~/.hermes/config.yaml` designates as that platform's home channel), so
# `notify.to` is OPTIONAL here:
#   ORCHID_NOTIFY_TO empty  -> --to "$channel"            (home channel)
#   ORCHID_NOTIFY_TO set    -> --to "$channel:$to"         (explicit target)
# The message text is passed as the single positional argv value (not
# stdin, not --file) -- $text already carries "<qid>: ..." (orchid-notify
# built it that way), so nothing else here needs to re-embed it, matching
# how openclaw's send passes the composed text via one flag/arg rather than
# splitting it across stdin and argv.
#
# `--dry-run` does not appear anywhere in `hermes send --help` -- there is no
# such flag to avoid; PENDING-VALIDATION: this invocation has not yet been
# run against a live, configured Hermes gateway with a real platform
# connected -- that is the live hero-demo dogfood (a later controller task),
# not this build task.

# -- inbound probe mode (v1-m4 T009, manifest `inbound_probe=--inbound-probe`)
# The ONE argument that puts this entrypoint into a read-only liveness probe
# instead of a send (docs/specs/plugins.md, "The inbound probe"). Handled
# before the `send <qid> <text>` argument contract below, which is otherwise
# completely unchanged -- runners/orchid-pump never passes this flag (a qid
# is always `q-<epoch>-<hex>`), so the send path cannot reach this branch.
# Same shape, same flag spelling and the same three exit codes as
# plugins/notify/openclaw/send's own probe, deliberately: doctor's branch is
# written once against the contract, not once per plugin.
#
# WHY THIS PLUGIN NEEDS ONE AT ALL, given `send` does not. The two legs have
# genuinely different dependencies here, and that asymmetry is the whole
# outage: `hermes send` talks to the platform's bot-token API directly using
# the gateway's stored credentials and needs NO running gateway (see the
# header above), while a reply coming BACK is delivered to the gateway
# process, which is what would hand it to a channel-side agent. So hermes
# can send perfectly while the return leg is dead -- which is exactly what
# happened on r-001: the gateway was down for a day, blockers kept arriving
# on the operator's phone, and the answer typed back was lost with no local
# trace (lesson L011). `hermes gateway status` is the CLI's own report of
# that fact, so omitting the key here would assert "no way to tell" on
# behalf of a plugin that can in fact tell.
#
# Exit code IS the verdict; one line of detail on stdout is what `orchid
# doctor` prints beside it:
#   0  reachable      -- POSITIVELY determined the inbound transport is up
#   1  unreachable    -- POSITIVELY determined it is down
#   2  undetermined   -- could not tell (and says why)
# Anything else, or doctor's own timeout, is also read as undetermined.
#
# WHAT THIS PROVES, EXACTLY. It probes the GATEWAY -- the process an
# operator's reply is physically delivered to -- because that is the leg that
# actually failed in the outage above. It does NOT prove that a channel-side
# agent is installed and will turn a reply into a real `orchid answer`
# invocation against this repo -- orchid ships no inbound listener and neither
# starts nor supervises that agent, so nothing here can observe it. Doctor
# labels those two facts apart; this branch's own wording must never imply
# the second.
#
# PENDING-VALIDATION, and stronger here than for the send shape above: unlike
# `hermes send --help`, `hermes gateway status` has NOT been read from an
# installed CLI by this task -- this build task could execute nothing at all.
# Both its EXISTENCE and its OUTPUT are therefore treated as untrusted. A
# build with no such subcommand is caught by the unknown-subcommand branch
# and answers 2 (undetermined), never 1, so a version difference can never
# masquerade as an outage; and only tokens this branch can recognize with
# confidence produce a 0/1 verdict, with anything unfamiliar exiting 2 and
# the raw line quoted rather than guessing. A wrong "unreachable" is a false
# alarm that teaches an operator to ignore the line; a wrong "reachable" is
# exactly the unproven-ok this probe exists to remove.
if [ "${1:-}" = --inbound-probe ]; then
  [ $# -eq 1 ] || { echo "--inbound-probe takes no further arguments"; exit 2; }
  probe_channel="${ORCHID_NOTIFY_CHANNEL:-}"
  [ -n "$probe_channel" ] || { echo "notify.channel is unset, so there is no channel to probe"; exit 2; }
  command -v hermes >/dev/null 2>&1 \
    || { echo "the hermes CLI is not on PATH, so nothing here can query gateway state"; exit 2; }

  # Never `exec`, never let `set -e` fire: a nonzero exit here is DATA.
  probe_rc=0
  probe_out="$(hermes gateway status 2>&1)" || probe_rc=$?

  # First line only, by parameter expansion rather than `| head -n1`: the
  # caller gets one line of detail, and a pipeline here would be one more
  # SIGPIPE/pipefail hazard inside a script that runs under `set -o pipefail`.
  probe_first="${probe_out%%$'\n'*}"

  if [ "$probe_rc" -ne 0 ]; then
    # An unrecognized subcommand is a CLI-VERSION difference, not evidence
    # about the gateway -- reporting "down" for it would be a false alarm on
    # a perfectly healthy system, and it is the likelier of the two misreads
    # here because nobody has run this subcommand against a real hermes yet.
    # Everything else that makes `gateway status` itself fail (gateway not
    # running, socket refused, auth expired) IS a determination: the process
    # a reply must be delivered to cannot currently be queried at all.
    # `usage:` only where a CLI actually prints it -- at the start of a line.
    # As a bare substring it would also swallow a gateway error that merely
    # quotes the word, and answer "this build has no gateway status" for a
    # gateway that is genuinely down. That misread fails SAFE (undetermined
    # rather than a false alarm), which is why it is anchored rather than
    # dropped. `invalid choice` is argparse's own wording for an unknown
    # subcommand, which is the parser hermes's CLI is built on.
    case "$probe_out" in
      *"nknown command"*|*"nrecognized"*|*"nknown subcommand"*|*"o such command"*|*"nvalid choice"*|[Uu]sage:*|*$'\n'[Uu]sage:*)
        echo "this hermes build does not support 'gateway status' (exit $probe_rc: $probe_first)"
        exit 2 ;;
    esac
    echo "'hermes gateway status' failed (exit $probe_rc: $probe_first) -- the gateway your replies are delivered to is not answering"
    exit 1
  fi
  [ -n "$probe_out" ] || { echo "'hermes gateway status' exited 0 and printed nothing, so there is no state here to read"; exit 2; }

  # WHICH LINES get judged, most specific evidence first. Judging the whole
  # blob would let one unrelated platform's row condemn a healthy return leg
  # (a multi-platform gateway prints several), which is the same false alarm
  # the word-boundary discipline below exists to prevent.
  #   1. the rows naming the configured channel -- the best evidence there is,
  #      and when there is any, it is the ONLY evidence considered
  #   2. failing that, the rows naming the gateway itself, then the rows whose
  #      LABEL is a status word, then -- only if it names no subject of its
  #      own -- the first line, judged in that order until one of them
  #      determines something
  #
  # STEP 1 IS EXCLUSIVE, NOT MERELY FIRST-RANKED, and that is a choice with a
  # visible cost: output that names the channel only in an ENUMERATION
  #     gateway: running
  #     platforms: telegram, discord
  # answers UNDETERMINED, because the enumeration row is the only evidence
  # considered and it carries no status word -- even though the gateway row
  # directly above plainly says running. Ranking the tiers instead (channel
  # rows first, then falling through to the gateway's own state) would answer
  # REACHABLE there, and it is tempting because that verdict is right in this
  # example. It is refused anyway, on this file's own priority: a row that
  # names the channel and says something this probe cannot read is weak
  # evidence that the CLI reports per-channel state AND that this channel's
  # state is not one of the healthy words -- so falling through to the
  # gateway's state would be inventing REACHABLE out of a line that was never
  # understood, on a CLI whose output nobody here has ever observed. A wrong
  # "undetermined" costs an operator one manual check; a wrong "reachable"
  # tells them their answers are getting through while every one is dropped.
  # Absence of a channel row (step 2's own case) is a different situation and
  # is treated differently on purpose: nothing was misread there, because
  # there was nothing to read. tests/test_notify_hermes_channel.sh pins both.
  #
  # The channel name comes from config and is interpolated into an ERE, so a
  # name carrying regex metacharacters falls back to a FIXED-string match
  # instead -- an invalid-regex error from grep would otherwise end up quoted
  # back to the operator as if it were hermes's own status output.
  #
  # Note what step 2 deliberately does NOT do, and where this differs from
  # openclaw's probe: openclaw's `channels status` is documented to ENUMERATE
  # channels, so a channel missing from it is itself a determination (exit 1).
  # Nothing establishes that `hermes gateway status` lists platforms at all,
  # so absence of the channel here is absence of evidence -- it falls through
  # to the gateway's own state rather than declaring the return leg dead.
  case "$probe_channel" in
    *[!A-Za-z0-9_-]*)
      probe_rows="$(grep -iF -- "$probe_channel" <<<"$probe_out" || true)" ;;
    *)
      probe_rows="$(grep -iE -e "(^|[^[:alnum:]_-])${probe_channel}([^[:alnum:]_-]|$)" <<<"$probe_out" || true)" ;;
  esac
  if [ -z "$probe_rows" ]; then
    # THE SERVICE-MANAGED SHAPE, and why this is a ranked LIST rather than one
    # picked line. A gateway run under launchd/systemd reports through its
    # supervisor, which puts a unit HEADER on the line that names the gateway
    #     * hermes-gateway.service - Hermes Gateway
    # and the actual verdict on an indented label line below it
    #          Active: active (running) since ...
    # Picking the gateway row and taking its silence for the whole answer read
    # that as "not one this probe recognizes" -- undetermined for a return leg
    # that is plainly up, on the deployment shape a supervised gateway most
    # commonly has. So the gateway rows are judged FIRST and, only if none of
    # them determines anything, the status-LABEL rows are judged next.
    #
    # The label set is fixed and contains no platform name, so a per-platform
    # row (`discord: disconnected`) cannot reach the label tier and condemn a
    # channel it says nothing about -- which is the property step 1 above
    # exists to protect.
    #
    # AND THE LAST-RESORT TIER IS HELD TO THAT SAME PROPERTY, which is why the
    # first line is admitted CONDITIONALLY rather than always. Output with no
    # channel row, no gateway row and no status label still deserves a reading
    # -- a `gateway status` that answers with the bare word `running` has said
    # something -- but appending the first line unconditionally hands the
    # verdict to whatever happens to be printed first, and on this CLI nobody
    # here has ever observed that is as likely to be a sibling platform's row
    # as the gateway's own state. `discord: disconnected` would then read as
    # "the channel carrying telegram is NOT up" (a false alarm about a row that
    # never mentions telegram), and `discord: connected` as REACHABLE -- the
    # worse of the two errors, and the exact invention step 1 is exclusive to
    # prevent, arrived at through the back door. So a first line that NAMES
    # something -- a `<word>:` or `<word>=` row whose label the tier above
    # already declined to recognize -- is not judged at all; it is only quoted
    # back with the undetermined verdict below. A line with no such label
    # names nothing but the thing being asked about, and is judged.
    probe_rows="$(grep -iE -e '(^|[^[:alnum:]_-])gateway([^[:alnum:]_-]|$)' <<<"$probe_out" || true)"
    probe_labels="$(grep -iE -e '^[^[:alnum:]]*(active|status|state|health|service|gateway)[[:space:]]*[:=]' <<<"$probe_out" || true)"
    probe_bare="$probe_first"
    if grep -qE -e '^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*[:=]' <<<"$probe_first"; then
      probe_bare=""
    fi
    probe_rows="$(printf '%s\n%s\n%s\n' "$probe_rows" "$probe_labels" "$probe_bare" | grep -v '^[[:space:]]*$' || true)"
  fi

  probe_channel_lower="$(printf '%s' "$probe_channel" | tr '[:upper:]' '[:lower:]')"
  probe_judged=""
  while IFS= read -r probe_line; do
    [ -n "$probe_line" ] || continue
    # The line quoted back on an undetermined verdict is the FIRST (most
    # specific) candidate, not the last one tried: the operator is being shown
    # the evidence this probe would most like to have understood.
    [ -n "$probe_judged" ] || probe_judged="$probe_line"
    probe_lower="$(printf '%s' "$probe_line" | tr '[:upper:]' '[:lower:]')"
    # Negatives FIRST: "not running" contains "running", so a positive-first
    # order would read a stopped gateway as up -- the one mistake this probe
    # must never make.
    #
    # But each negative is matched as a WHOLE WORD, and against the row with
    # the channel's OWN NAME elided, because these run against an entire status
    # row -- name included. Bare substrings fail in exactly the way this file
    # also refuses to fail for `*ok*`/`*error*` below: `*down*` calls a channel
    # named `downtime-alerts` dead, and reads a healthy "telegram connected
    # (last shutdown 2d ago)" as NOT connected. Either one makes doctor print
    # "Answers sent on this channel are being lost" about a row that says
    # connected -- the false alarm that teaches an operator to ignore this
    # line, on the one check whose whole job is to be believed.
    #
    # Each negated form is spelled out here rather than left to the positive
    # test: "not ready" contains the whole word "ready", so a row hermes writes
    # that way is a negation the positives would otherwise read as up. So is
    # `inactive`, which is the whole word a service manager reports a stopped
    # unit with (`Active: inactive (dead)`) -- without it the label row above
    # would answer undetermined in exactly the case the tier was added for.
    probe_status="${probe_lower//"$probe_channel_lower"/ }"
    if grep -qE -e '(^|[^a-z0-9_-])((not|never)[[:space:]]+(running|started|connected|online|ready|active|reachable|healthy)|stopped|disconnect(ed|ing)?|inactive|offline|unauthor[a-z]*|unhealthy|expired|down|unreachable)([^a-z0-9_-]|$)' \
         <<<"$probe_status"; then
      echo "hermes reports the gateway carrying channel '$probe_channel' as NOT up: $probe_line"
      exit 1
    fi
    # Deliberately NARROW, in both directions. No bare `*ok*`/`*fail*`/`*error*`
    # substring tests: `*ok*` matches "broken" (and "token expired"), and a
    # healthy row reading "running, 0 errors" would trip `*error*`. Either way a
    # substring that loose invents a verdict out of a word fragment. A row
    # matching neither list is not a verdict at all -- the next candidate is
    # tried, and if none of them decides, exit 2 below quotes the first one,
    # which is the honest answer for output nobody has verified against a live
    # gateway yet. A truly down gateway is caught by the nonzero-exit branch
    # above, not by string matching.
    #
    # `up` is absent from this list on purpose, though it is the word an
    # operator would reach for: as a whole word it also matches "could not
    # bring up the gateway", whose negation none of the forms above catch --
    # a false REACHABLE, the worse of the two errors, out of a status line
    # that says the opposite.
    #
    # And matched with the negatives' own two disciplines, WHOLE WORDS against
    # the NAME-ELIDED row, because the same two failures mirror exactly onto
    # this side: a bare `*active*` reads "deactivated" as up, and a channel
    # named `ready-queue` or `online-ops` would invent a verdict out of its own
    # name. This direction is the worse one to get wrong -- a false
    # NOT-reachable only cries wolf, while a false REACHABLE tells an operator
    # their answers are getting through on a channel that is dropping every one
    # of them.
    if grep -qE -e '(^|[^a-z0-9_-])(running|connected|online|ready|active|healthy)([^a-z0-9_-]|$)' \
         <<<"$probe_status"; then
      echo "hermes reports the gateway carrying channel '$probe_channel' up: $probe_line"
      exit 0
    fi
  done <<<"$probe_rows"
  # `${probe_judged:-$probe_first}`: when NOTHING was judgeable -- the tiers
  # above admitted no row at all, because the only thing printed named some
  # other subject -- the operator is still owed the line this probe was
  # looking at. Quoting it is not the same as judging it, and it is the whole
  # difference between "I could not read this" and a verdict invented from it.
  echo "hermes's gateway status line for channel '$probe_channel' is not one this probe recognizes: ${probe_judged:-$probe_first}"
  exit 2
fi

qid="${1:?usage: send <question-id> <text>}"
text="${2:?usage: send <question-id> <text>}"
: "$qid"   # accepted per the notify-channel contract; not otherwise used --
           # $text already carries "<qid>: ..." (orchid-notify built it that
           # way), so nothing else here needs to re-embed it.

channel="${ORCHID_NOTIFY_CHANNEL:?ORCHID_NOTIFY_CHANNEL not set (notify.channel config missing or empty)}"
to="${ORCHID_NOTIFY_TO:-}"

target="$channel"
[ -z "$to" ] || target="$channel:$to"

exec hermes send --to "$target" "$text"

#!/bin/bash -p
set -euo pipefail

# Security bootstrap for every dispatched command. The dispatcher may itself
# be reached through an operator PATH containing a target-repository shim. Its
# interpreter and the helpers used to resolve an installed symlink therefore
# come from machine-local, fixed locations. Keep the original PATH only as
# inert data for lib/common.sh: ordinary/manual verbs restore it at their first
# source of that library, while trust-boundary verbs hold the fixed path until
# they have inspected and reported authorization. The dispatcher remains
# deliberately verb-agnostic.
unset __orchid_entry_context __orchid_entry_path_was_set
unset __orchid_entry_operator_path __orchid_entry_defer_restore
__orchid_entry_context=1
__orchid_entry_path_was_set="${PATH+x}"
__orchid_entry_operator_path="${PATH-}"
export __orchid_entry_context __orchid_entry_path_was_set
export __orchid_entry_operator_path
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
unset CDPATH

self="$0"
while [ -L "$self" ]; do
  t="$(command readlink "$self")"
  case "$t" in /*) self="$t" ;; *) self="$(command dirname "$self")/$t" ;; esac
done
ORCHID_ROOT="$(cd "$(command dirname "$self")/.." && pwd -P)"; export ORCHID_ROOT

cmd="${1:-help}"; [ $# -gt 0 ] && shift
if [ "$cmd" = help ] || [ "$cmd" = -h ] || [ "$cmd" = --help ]; then
  echo "usage: orchid <command> [args]"; echo "commands:"
  for f in "$ORCHID_ROOT"/libexec/orchid-*; do [ -e "$f" ] && echo "  ${f##*/orchid-}"; done
  exit 0
fi
# This dispatcher is deliberately dumb: it never special-cases a verb by
# name or decides which subverbs are read-only vs. mutating (e.g. `config
# list` vs. `config commit`, v1-m4) -- every libexec/orchid-* script owns
# its own subverb dispatch, locking, and epoch fencing internally. Same
# rule when a verb's libexec/orchid-* file is itself just a tier-1 -> tier-2
# handoff to an effectful runners/ script (v1-m4: `service` forwards
# straight through to runners/orchid-service, the launchctl/crontab side of
# `orchid service install/uninstall/status`, mirroring the `jobs`/runners/
# orchid-launch split docs/specs/kernel.md's determinism boundary
# describes) -- this dispatcher doesn't know or care that the effectful
# work actually happens one hop further down.
exe="$ORCHID_ROOT/libexec/orchid-$cmd"
# A VERB THAT IS NOT EXECUTABLE IS NOT AN UNKNOWN VERB. Both used to fail the
# same `[ -x ]` test and be reported the same way, and they are different facts
# with different fixes: `unknown command` about a file that is sitting right
# there sends the reader to look for something that was never missing.
#
# It is the routine outcome of ADDING a verb, not an exotic state. An
# implementer profile may not run `chmod` (lesson L017) and several engines
# recreate every file they touch at 0644, so a new libexec/orchid-<verb>
# arriving mode 644 is ordinary -- lib/drive.sh already classifies exactly this
# as an operator hand-off and declines to charge the attempt for it. This is the
# one place that described it as something else.
#
# Still deliberately verb-agnostic: the dispatcher is reporting a fact about its
# OWN dispatch decision, not branching on which verb it is.
if [ ! -x "$exe" ]; then
  if [ -e "$exe" ]; then
    echo "orchid: '$cmd' is not executable: $exe exists but its mode bit is not set, so it cannot be dispatched. Set it: chmod +x $exe (and, if it is tracked, record the mode: git -C \"\$(dirname \"$exe\")/..\" update-index --chmod=+x libexec/orchid-$cmd)" >&2
    exit 2
  fi
  echo "orchid: unknown command '$cmd'" >&2
  exit 2
fi
exec /bin/bash -p "$exe" "$@"
